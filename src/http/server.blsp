; the listener runs under a supervisor (auto-restart)
(defmodule http/server
  "HTTP/1.1 TCP server: a supervised listener process plus per-connection workers.
  Hardening (read timeout, request-size cap, max connections, generic error pages,
  graceful-shutdown drain) is configurable via the config map passed to `start` — see
  docs/robustness.md. `stop` drains in-flight connections before tearing the server down."
  (:use http/request)
  (:use http/response)
  (:use http/websocket)
  ; carrier->bytes — bridge the already-buffered body prefix back to raw bytes for spooling
  (:use http/util)
  (:alias proc/supervisor)
  (:alias telemetry))
; Per-connection / per-listener limits, overridable per `start` (docs/robustness.md):
;   :read-timeout-ms   — idle wait for request bytes before answering 408 and closing
;   :max-request-bytes — accumulated request bytes before answering 413 and closing
;   :max-connections   — concurrent connections; the listener refuses any over this
;   :error-handler     — (fn (request err-message) -> response) for a handler that raises;
;                        default `server-error-resp`, a generic 500 that leaks no internals
;                        (the detail goes to the [:hatch :request :exception] telemetry event)
;   :shutdown-grace-ms — on `stop`, how long to let in-flight connections finish before
;                        hard-killing stragglers (stop first stops accepting new ones)
;   :tls               — nil (plaintext, default) or `{:cert <pem> :key <pem>}` to serve
;                        HTTPS/WSS: the listener terminates TLS (tls-listen) and accepted
;                        sockets are transparent, so handlers/`worker--run` are unchanged
;   :check-origin      — WebSocket upgrade Origin policy (CSWSH guard): true = same-origin
;                        only (default), false = allow any, or a list of allowed Origin
;                        header values (see websocket/origin-allowed?)
;   :spool-threshold   — nil (default, off) or a byte count: a request whose Content-Length
;                        exceeds it is STREAMED to a temp file (chunk-by-chunk, never held
;                        whole in memory) and the handler receives `:body-file` (a path)
;                        instead of an in-memory `:body`. Bounds worker memory for large
;                        uploads. Still subject to `:max-request-bytes`. When nil, every
;                        request uses the in-memory buffered path (unchanged).
;   :spool-dir         — directory for spool temp files (default "/tmp"); each spooled
;                        request writes one `hatch-upload-<token>` file, deleted after the
;                        handler returns unless it moved it (see web/conn `save-body`)
(def default-config
  {:read-timeout-ms 30000
   :max-request-bytes 8388608
   :max-connections 1024
   :error-handler (fn (request err) (server-error-resp))
   :shutdown-grace-ms 5000
   :tls nil
   :check-origin true
   :spool-threshold nil
   :spool-dir "/tmp"})

(defn supervisor-name (port)
  "The registered name of the supervisor for the listener on `port` — port-derived so
  several servers (distinct ports) can run in one VM without name collisions."
  (keyword (str "http-supervisor-" port)))

(defn listener-name (port)
  "The registered name of the listener process on `port` (see `supervisor-name`)."
  (keyword (str "http-listener-" port)))

(defn start (port handler &optional (ws-handler nil) (config {}))
  "Start a supervised HTTP listener on `port`, dispatching requests to `handler`.
  Optional `ws-handler` receives `(sock request)` on WebSocket upgrades. Optional
  `config` overrides `default-config`'s limits (merged over it).

  The listener runs under a one-for-one supervisor: if it crashes it is restarted
  (re-binding the port — freed because a dead process's sockets are now closed on
  exit) and re-registered as `:http-listener`, so a transient fault doesn't take the
  whole server down. In-flight connections are unaffected — each is its own unlinked
  worker process. Returns the supervisor pid; `(stop)` tears it down.

  The listener is `:transient` (restarted only on an abnormal exit), bounded to 5
  restarts / 10s so a hard fault (e.g. the port is taken) eventually gives up. tcp-listen
  runs INSIDE the listener process — accepts go to the calling process's mailbox — so
  the child's :start spawns `listen-and-serve` rather than binding the socket here."
  (let (cfg (merge default-config config)
        sup (supervisor/start-supervisor [{:id :http-listener
                                           :name (listener-name port)
                                           :start (fn ()
                                                    (spawn (listen-and-serve port
                                                             handler ws-handler cfg)))
                                           :restart :transient}]
              {:strategy :one-for-one :max-restarts 5 :max-seconds 10}))
    (register (supervisor-name port) sup)
    (sleep 50)
    sup))

(defn listen-and-serve (port handler ws-handler config)
  (let (tls (get config :tls)
        lsock (bind-retry port 25 tls)
        scheme (if tls "https" "http"))
    (println (str "listening on " scheme "://localhost:" port))
    (listener-loop lsock handler ws-handler config (list))))

(defn bind-retry (port attempts tls)
  "Bind a listening socket on `port`, retrying briefly while the address is still in use.
  Uses `tls-listen` (terminating TLS with `tls`'s `:cert`/`:key` PEM) when `tls` is set,
  else plaintext `tcp-listen`. On a supervised restart the new listener can race the
  crashed one's socket teardown: the runtime frees a dead process's sockets on exit, but
  the accept thread releases the bound port a beat later. Rather than let the bind fail,
  retry for a short window (the port frees within a couple ms). Gives up after `attempts`
  tries (~250ms), re-raising the original error so a genuinely-taken port still surfaces."
  (try
    (if tls
      (tls-listen "0.0.0.0" port (get tls :cert) (get tls :key))
      (tcp-listen "0.0.0.0" port))
    (catch e
      (if (and (> attempts 1) (includes? (error-message e) "in use"))
        (do (sleep 10) (bind-retry port (- attempts 1) tls))
        (error (error-message e))))))

(defn drain-and-wait (listener)
  "Ask `listener` to drain (stop accepting, let in-flight connections finish up to
  :shutdown-grace-ms, then kill stragglers) and block until it reports `:drained` — or
  until it's already gone. Monitors so a dead listener can't hang us."
  (let (m (monitor listener))
    (send listener [:drain (self)])
    (receive
      (:drained nil)
      ([:down ^m _ _] nil))
    (demonitor m)
    ; flush a late down
    (receive ([:down ^m _ _] nil) (after 0 nil))
    nil))
(defn stop (port)
  "Gracefully stop the HTTP server on `port`: the listener stops accepting, lets in-flight
  connections finish (up to :shutdown-grace-ms, then hard-kills stragglers), and only then
  is the supervisor torn down — so a clean `stop` doesn't cut off active requests."
  (let (sup (whereis (supervisor-name port))
        listener (whereis (listener-name port)))
    (if sup
      (do
        (when listener (drain-and-wait listener))
        (supervisor/stop-supervisor sup))
      (println (str "http/server: no server running on port " port)))))

; The listener carries the live in-flight worker pids: it `monitor`s each worker and drops
; it on the worker's `[:down …]`, refuses (closes) a connection over `:max-connections`
; rather than spawning unboundedly, and on `:drain` (graceful `stop`) waits for those
; workers to finish before letting the process exit.
(defn- listener-without
  (workers pid)
  "`workers` minus `pid` — order is irrelevant, it's a bag of in-flight worker pids."
  (fold (fn (acc w) (if (= w pid) acc (cons w acc))) (list) workers))

(defn- listener-kill-all
  (workers)
  "Hard-kill every worker in `workers` (drain deadline reached). Returns nil."
  (fold (fn (_ w) (exit w :kill) nil) nil workers))

(defn- listener-drain
  (workers deadline from)
  "Wait for the in-flight `workers` to finish, up to `deadline` (ms epoch); past it, hard-
  kill the stragglers. Either way reply `:drained` to `from` and let the listener exit.
  Late `[:tcp-accept]`s (a connection that slipped in as we closed the socket) are refused."
  (if (empty? workers)
    (send from :drained)
    (let (remaining (- deadline (now)))
      (if (<= remaining 0)
        (do (listener-kill-all workers) (send from :drained))
        (receive
          ([:down _ pid _] (listener-drain (listener-without workers pid) deadline from))
          ([:tcp-accept _ client] (do (tcp-close client) (listener-drain workers deadline from)))
          (after remaining (do (listener-kill-all workers) (send from :drained))))))))

(defn- listener-loop
  (lsock handler ws-handler config workers)
  (receive
    ([:tcp-accept ^lsock client]
      (if (>= (count workers) (get config :max-connections))
        (do
          ; over capacity — refuse without spawning a worker
          (tcp-close client)
          (listener-loop lsock handler ws-handler config workers))
        (let (worker (spawn (worker-run client handler ws-handler config "")))
          ; Read the connection in binary mode from the very first byte — set here, before
          ; the socket is handed to the worker, so there's no window where the reader would
          ; UTF-8-lossily decode (and corrupt) a binary request body (a file upload). The
          ; worker bridges each `bytes` chunk to a byte-faithful carrier string (one codepoint
          ; per byte), on which the text-based request parser is exactly byte-correct.
          (tcp-set-binary client true)
          (monitor worker)
          (tcp-controlling-process client worker)
          (listener-loop lsock handler ws-handler config (cons worker workers)))))
    ([:down _ pid _] (listener-loop lsock
                       handler
                       ws-handler
                       config
                       (listener-without workers pid)))
    ([:drain from] (do
                     (tcp-close lsock)
                     (listener-drain workers (+ (now) (get config :shutdown-grace-ms)) from)))
    (:stop (tcp-close lsock)
      (println "http/server: stopped"))))

(defn head-complete? (buf)
  "True once the request head terminator (`\\r\\n\\r\\n`) is present in `buf` — i.e. the head can
  be parsed and we can decide how to handle the body."
  (includes? buf "\r\n\r\n"))

(defn tail3 (s)
  "The last ≤3 characters of `s` — the overlap `worker--read-head` keeps between reads so a head
  terminator split across a read boundary is still detected, without re-scanning the whole buffer."
  (let (n (string-length s))
    (if (<= n 3) s (substring s (- n 3) n))))

(defn- worker-run
  (sock handler ws-handler config buf)
  "Handle one request off `sock`, then loop for the next (keep-alive) or close. Reads the head
  in O(n) (`worker--read-head`), then hands off to `worker--dispatch`, which routes the body to
  the spool / in-memory-drain / incremental-de-chunk path so no path re-buffers the body."
  (cond
    ; Request-size cap: a client streaming an unbounded request (or a huge body) would
    ; otherwise grow `buf` until OOM. Reject once the accumulated bytes exceed the cap.
    (> (string-length buf) (get config :max-request-bytes))
      (do
        (tcp-send sock (format-response {:status 413 :body "<h1>413 Payload Too Large</h1>"}))
        (tcp-close sock))
    ; Head fully received → decide how to read the body.
    (head-complete? buf) (worker-dispatch sock handler ws-handler config buf)
    ; Head still arriving → accumulate reads in O(n) until the terminator lands.
    else
      (worker-read-head sock handler ws-handler config (list buf) (tail3 buf) (string-length buf))))

(defn- worker-read-head
  (sock handler ws-handler config chunks carry got)
  "Accumulate socket reads until the request head is complete, in O(n): each read is consed onto
  `chunks` (O(1)) and only a 3-byte `carry` is re-scanned for the `\\r\\n\\r\\n` terminator — so a
  head split across many reads never re-copies or re-scans the whole buffer (the old `(str buf
  chunk)` + full `index-of` per read was O(n²), a cheap slow-loris CPU amplifier). Once the
  terminator lands the chunks are joined once and dispatched. Bounds the idle wait (→ 408) and
  the accumulated size (→ 413)."
  (receive
    ; binary mode → `chunk` is a `bytes` value; bridge it to the byte-faithful carrier string.
    ([:tcp ^sock chunk] (let (piece (bytes->carrier chunk)
                              got (+ got (string-length piece)))
                          (cond
                            (> got (get config :max-request-bytes))
                              (do
                                (tcp-send sock
                                  (format-response {:status 413
                                                    :body "<h1>413 Payload Too Large</h1>"}))
                                (tcp-close sock))
                            (includes? (str carry piece) "\r\n\r\n")
                              (worker-run sock
                                handler
                                ws-handler
                                config
                                (join "" (reverse (cons piece chunks))))
                            else
                              (worker-read-head sock
                                handler
                                ws-handler
                                config
                                (cons piece chunks)
                                (tail3 (str carry piece))
                                got))))
    ([:tcp-closed ^sock] nil)
    (after (get config :read-timeout-ms)
      (do
        (tcp-send sock (format-response {:status 408 :body "<h1>408 Request Timeout</h1>"}))
        (tcp-close sock)))))

(defn bad-request-close (sock msg)
  "Answer a generic 400 and close. Doesn't reflect the parser message (it echoes attacker-
  controlled bytes) — the detail goes to telemetry instead."
  (telemetry/emit [:hatch :request :bad-request] {} {:error msg})
  (tcp-send sock (format-response {:status 400 :body "<h1>400 Bad Request</h1>"}))
  (tcp-close sock))

(defn expects-continue? (head)
  "True if the request head asked for a `100 Continue` interim response (RFC 7231 §5.1.1:
  `Expect: 100-continue`)."
  (= (lower (trim (get (get head :headers {}) :expect ""))) "100-continue"))

(defn maybe-continue (sock head)
  "Send a `100 Continue` interim response when the client asked for it (`Expect: 100-continue`),
  BEFORE we block waiting for the request body. Without it, such a client (curl for bodies >1KB,
  many HTTP libraries) holds its body waiting for the interim while the server waits for the
  body — a deadlock that only breaks when the read timeout answers 408 and the upload fails."
  (when (expects-continue? head)
    (try (tcp-send sock (string->utf8-bytes "HTTP/1.1 100 Continue\r\n\r\n")) (catch _ nil))))

(defn- worker-dispatch
  (sock handler ws-handler config buf)
  "Dispatch a request whose head is fully buffered in `buf`. Parses the head ONCE, then routes
  the body to the right reader — spool to disk / O(n) in-memory drain / incremental de-chunk —
  so no path re-buffers the body. A body that already landed whole (and every WebSocket upgrade)
  falls through to `dispatch-complete`; malformed framing answers 400."
  (match (try-parse-head buf)
    ([:head head body-start clen]
      (cond
        ; Large non-chunked body over :spool-threshold → stream to a temp file (never held whole
        ; in memory); the handler gets `:body-file` instead of `:body`. Off by default.
        (spool-body? config head clen ws-handler)
          (do
            (maybe-continue sock head)
            (spool-begin sock handler ws-handler config buf head body-start clen))
        ; Body still arriving over several reads → drain by length in O(n) (collect reads in a
        ; list, join once) rather than re-`str`ing the whole buffer per read.
        (partial-body? buf head body-start clen ws-handler)
          (do
            (maybe-continue sock head)
            (buffered-begin sock handler ws-handler config buf head body-start clen))
        ; Body already complete/empty (or a WebSocket upgrade) → parse it whole and run it.
        else (dispatch-complete sock handler ws-handler config buf)))
    ; Chunked body → decode incrementally (only the newly-arrived bytes each read) instead of
    ; re-de-chunking the whole buffer on every read.
    ([:chunked head body-start] (do
                                  (maybe-continue sock head)
                                  (chunked-begin sock handler ws-handler config buf head body-start)))
    ; Malformed framing → 400 (mirrors `try-parse`'s :error path).
    ([:error msg] (bad-request-close sock msg))
    ; head-complete? gated us here, so :incomplete cannot occur; be defensive.
    (_ (dispatch-complete sock handler ws-handler config buf))))

(defn dispatch-complete (sock handler ws-handler config buf)
  "Fast path: the request (head + any body) is fully buffered. Parse it whole and either perform
  the WebSocket upgrade or run the handler."
  (match (try-parse buf)
    ([:ok request remainder]
      (if (and ws-handler (upgrade-request? request))
        ; CSWSH guard: a WebSocket upgrade isn't bound by the same-origin policy, yet the browser
        ; still sends the user's cookies — so a cross-origin Origin must be refused before the 101,
        ; or another site could open an authenticated session. Policy is `:check-origin` (default:
        ; same-origin); see websocket/origin-allowed?.
        (if (origin-allowed? request (get config :check-origin))
          (let (key (get (get request :headers) :sec-websocket-key ""))
            ; WebSocket framing is binary (control bytes ≥ 0x80, masked payloads). Switch the
            ; socket to binary mode BEFORE the 101 — the client only sends frames after it sees the
            ; 101, so this closes the race where the reader would otherwise decode the first
            ; frame(s) as UTF-8-lossy text and corrupt them (the ws-handler may do a slow registry
            ; lookup before its own tcp-set-binary, leaving a window the client beats).
            (tcp-set-binary sock true)
            (tcp-send sock (upgrade-response key))
            (ws-handler sock request))
          (do
            (tcp-send sock (format-response {:status 403 :body "<h1>403 Forbidden</h1>"}))
            (tcp-close sock)))
        (dispatch-buffered sock handler ws-handler config request remainder)))
    ; With the head complete and every incomplete-body case routed above, this is only reached
    ; with a complete request; keep the incomplete recursion as a safety net.
    ([:incomplete] (receive
                     ([:tcp ^sock chunk] (worker-run sock
                                           handler
                                           ws-handler
                                           config
                                           (str buf (bytes->carrier chunk))))
                     ([:tcp-closed ^sock] nil)
                     (after (get config :read-timeout-ms)
                       (do
                         (tcp-send sock
                           (format-response {:status 408 :body "<h1>408 Request Timeout</h1>"}))
                         (tcp-close sock)))))
    ([:error msg] (bad-request-close sock msg))))

; ---- buffered request dispatch (shared by the fast path and the O(n) body drain) ----

(defn dispatch-buffered (sock handler ws-handler config request remainder)
  "Run `handler` on a fully-buffered `request`, send the response, then either loop for the
  next pipelined request (`remainder`) on a kept-alive socket or close. Shared by the
  single-read fast path and the streamed-body drain so both get identical telemetry,
  error isolation, keep-alive and HEAD handling."
  (let (t0 (now)
        response (try
                   (handler request)
                   (catch e
                     ; Don't leak internals: the detail goes to telemetry (a logging hook),
                     ; the body is whatever :error-handler returns (a generic 500 by default).
                     (do
                       (telemetry/emit [:hatch :request :exception]
                         {}
                         {:method (get request :method)
                          :path (get request :path)
                          :error (error-message e)})
                       ((get config :error-handler) request (error-message e))))))
    ; Telemetry: one fire-and-forget event per handled request (handlers run in the
    ; telemetry listener, so a slow/buggy one can never slow or crash this worker).
    (telemetry/emit [:hatch :request :stop]
      {:duration (- (now) t0)}
      {:method (get request :method)
       :path (get request :path)
       :status (get response :status 200)})
    ; Decide keep-alive once, then stamp the Connection header to match what we do with the
    ; socket. HEAD suppresses the body while keeping the equivalent GET's headers.
    (let (ka (keep-alive? request response)
          response (assoc-in response [:headers :connection] (if ka "keep-alive" "close")))
      (tcp-send sock (format-response response (= (get request :method) "HEAD")))
      (if ka
        (worker-run sock handler ws-handler config remainder)
        (tcp-close sock)))))

; ---- O(n) in-memory body drain (non-chunked bodies that arrive over several reads) ----
; The fast path re-`str`s the whole growing buffer on every socket read, which is O(n²) in
; the number of reads — fine for a request that lands in one packet, but a large upload
; (multipart/form-data carries a Content-Length, so it takes this path, not chunked) arrives
; over many reads and pays quadratic copying. Once the head is in we know the exact body
; length, so we stop re-buffering: collect the remaining body reads in a list (O(1) per read)
; and `join` exactly once when the declared length is reached. Spooling (when enabled and over
; its threshold) streams to disk; this is the in-memory equivalent for bodies kept in memory.

(defn partial-body? (buf head body-start clen ws-handler)
  "True when a non-chunked, body-bearing request's body has NOT fully arrived yet — exactly the
  case the fast path would drain with O(n²) `str`ing. False for empty bodies, WebSocket upgrades,
  and already-complete requests (all handled by the fast path)."
  (and (> clen 0)
    (< (string-length buf) (+ body-start clen))
    (not (and ws-handler (upgrade-request? head)))))

(defn- buffered-begin
  (sock handler ws-handler config buf head body-start clen)
  "Start an O(n) in-memory body drain: reject if the declared request size blows the cap,
  else seed the drain with the body bytes already in `buf` and read the rest by length."
  (if (> (+ body-start clen) (get config :max-request-bytes))
    (do
      (tcp-send sock (format-response {:status 413 :body "<h1>413 Payload Too Large</h1>"}))
      (tcp-close sock))
    (let (already (substring buf body-start (string-length buf)))
      (buffered-drain sock
        handler
        ws-handler
        config
        head
        (list already)
        (string-length already)
        clen))))

(defn- buffered-drain
  (sock handler ws-handler config head chunks got clen)
  "Accumulate incoming body reads (carrier chunks, newest-first) in `chunks` until `clen`
  bytes are in hand, then `join` once, split off any pipelined `remainder`, and dispatch.
  Bounds the idle wait (slow-loris → 408) exactly like the fast path."
  (if (>= got clen)
    (let (all (join "" (reverse chunks))
          body (substring all 0 clen)
          remainder (substring all clen (string-length all))
          request (assoc head :body body))
      (dispatch-buffered sock handler ws-handler config request remainder))
    (receive
      ([:tcp ^sock chunk] (buffered-drain sock
                            handler
                            ws-handler
                            config
                            head
                            (cons (bytes->carrier chunk) chunks)
                            (+ got (count chunk))
                            clen))
      ([:tcp-closed ^sock] nil)
      (after (get config :read-timeout-ms)
        (do
          (tcp-send sock
            (format-response {:status 408 :body "<h1>408 Request Timeout</h1>"}))
          (tcp-close sock))))))

; ---- O(n) incremental de-chunk drain (Transfer-Encoding: chunked bodies) ----
; The buffered path de-chunks by re-running the whole decoder over the entire buffer on every
; socket read (via `try-parse`), so a chunked body arriving over R reads is decoded ~R times —
; O(n²), and the decoder itself `(str acc …)`-accumulated each chunk (a second O(n²)). Here we
; keep only the *undecoded* tail plus the decoded pieces so far (see request/dechunk-step),
; decode each chunk exactly once, and `join` the body once at the terminating 0-size chunk.
; Chunked bodies have no Content-Length (so they can't be spooled by size); this is their
; in-memory, memory-capped reader.

(defn- chunked-begin
  (sock handler ws-handler config buf head body-start)
  "Start an incremental de-chunk drain, seeded with the body bytes already in `buf`."
  (chunked-drain sock
    handler
    ws-handler
    config
    head
    (substring buf body-start (string-length buf))
    (list)
    0))

(defn- chunked-drain
  (sock handler ws-handler config head pending decoded dlen)
  "Decode whatever chunks are fully present in `pending`, keep only the undecoded tail, and read
  more until the terminating 0-size chunk. `decoded` holds decoded pieces (newest-first), `dlen`
  their total length — capped at :max-request-bytes (a chunked body has no Content-Length, so this
  is its size bound). Bounds the idle wait (slow-loris → 408)."
  (match (dechunk-step pending 0 decoded dlen)
    ([:ok body remainder] (dispatch-buffered sock
                            handler
                            ws-handler
                            config
                            (assoc head :body body)
                            remainder))
    ([:error msg] (bad-request-close sock msg))
    ([:more tail decoded dlen] (if (> (+ dlen (string-length tail)) (get config :max-request-bytes))
                                 (do
                                   (tcp-send sock
                                     (format-response {:status 413
                                                       :body "<h1>413 Payload Too Large</h1>"}))
                                   (tcp-close sock))
                                 (receive
                                   ([:tcp ^sock chunk] (chunked-drain sock
                                                         handler
                                                         ws-handler
                                                         config
                                                         head
                                                         (str tail (bytes->carrier chunk))
                                                         decoded
                                                         dlen))
                                   ([:tcp-closed ^sock] nil)
                                   (after (get config :read-timeout-ms)
                                     (do
                                       (tcp-send sock
                                         (format-response {:status 408
                                                           :body "<h1>408 Request Timeout</h1>"}))
                                       (tcp-close sock))))))))

; ---- large-body streaming to disk (opt-in via :spool-threshold) ----

(defn body-method? (m)
  "True for a method that carries a request body worth spooling (POST/PUT/PATCH)."
  (or (= m "POST") (= m "PUT") (= m "PATCH")))

(defn spool-body? (config head clen ws-handler)
  "True when :spool-threshold is configured and this non-chunked request's Content-Length exceeds
  it (a large, body-bearing, non-WS-upgrade request) → stream it to disk. A no-op (false) unless
  :spool-threshold is set, so the default server never leaves the in-memory path."
  (let (thr (get config :spool-threshold))
    (and (not (nil? thr))
      (> clen thr)
      (body-method? (get head :method))
      (not (and ws-handler (upgrade-request? head))))))

(defn- spool-path
  (config)
  "A fresh unique temp path under :spool-dir for one spooled request body."
  (str (get config :spool-dir "/tmp") "/hatch-upload-" (random-token 16)))

(defn- spool-begin
  (sock handler ws-handler config buf head body-start clen)
  "Start spooling: reject if the declared length blows the request cap, else write the body
  bytes already sitting in `buf` to a fresh temp file and stream the rest off the socket."
  (if (> clen (get config :max-request-bytes))
    (do
      (tcp-send sock (format-response {:status 413 :body "<h1>413 Payload Too Large</h1>"}))
      (tcp-close sock))
    (let (path (spool-path config)
          already (substring buf body-start (string-length buf))
          alen (string-length already)
          take (min alen clen)
          prefix (if (= take alen) already (substring already 0 take)))
      ; the prefix came in via the carrier buffer; bridge it back to raw bytes. Later
      ; chunks arrive as `bytes` off the binary socket and are appended verbatim.
      (spool-append path (carrier->bytes prefix))
      (spool-drain sock handler ws-handler config head path take clen))))

(defn- spool-drain
  (sock handler ws-handler config head path written clen)
  "Append incoming body chunks to `path` until `clen` bytes are stored, then dispatch. Bounds
  the idle wait (slow-loris → 408) and deletes the partial spool on a stalled/closed socket."
  (if (>= written clen)
    (spool-dispatch sock handler config head path clen)
    (receive
      ([:tcp ^sock chunk] (let (n (count chunk)
                                take (min n (- clen written))
                                piece (if (= take n) chunk (subbytes chunk 0 take)))
                            (spool-append path piece)
                            (spool-drain sock
                              handler
                              ws-handler
                              config
                              head
                              path
                              (+ written take)
                              clen)))
      ([:tcp-closed ^sock] (do (spool-cleanup path) nil))
      (after (get config :read-timeout-ms)
        (do
          (spool-cleanup path)
          (tcp-send sock (format-response {:status 408 :body "<h1>408 Request Timeout</h1>"}))
          (tcp-close sock))))))

(defn- spool-cleanup
  (path)
  "Delete a spool temp file, ignoring 'already gone' (the handler may have moved it)."
  (try (delete-file path) (catch _e nil)))

(defn- spool-append
  (path piece)
  "Append `piece` (bytes) to the spool file `path`; on a write error (disk full, a spool-dir
  that lost write permission) delete the partial temp file before re-raising, so a failed
  upload can't leak an abandoned `hatch-upload-*` file (repeated failures → disk exhaustion)."
  (try
    (append-bytes path piece)
    (catch e (do (spool-cleanup path) (error (str "spool write failed: " (error-message e)))))))

(defn- spool-dispatch
  (sock handler config head path clen)
  "Run the handler on a spooled request (body on disk as `:body-file`), send the response, and
  remove the temp file unless the handler moved it. A spooled request always closes the
  connection afterwards — no keep-alive/pipelining bookkeeping across a multi-megabyte body."
  (let (request (assoc head :body "" :body-file path :body-length clen)
        t0 (now)
        response (try
                   (handler request)
                   (catch e
                     (do
                       (telemetry/emit [:hatch :request :exception]
                         {}
                         {:method (get request :method)
                          :path (get request :path)
                          :error (error-message e)})
                       ((get config :error-handler) request (error-message e)))))
        response (assoc-in response [:headers :connection] "close"))
    (telemetry/emit [:hatch :request :stop]
      {:duration (- (now) t0)}
      {:method (get request :method)
       :path (get request :path)
       :status (get response :status 200)})
    (tcp-send sock (format-response response (= (get head :method) "HEAD")))
    (spool-cleanup path)
    (tcp-close sock)))

(defn keep-alive? (request response)
  "True if the connection should be reused for another request. Either side signalling
  `Connection: close` ends it. Otherwise the default follows the request's HTTP version:
  HTTP/1.1 persists unless closed, HTTP/1.0 closes unless the request opted in with
  `Connection: keep-alive` (RFC 7230 §6.3)."
  (let (version (get request :version "1.1")
        req-conn (lower (get-in request [:headers :connection] ""))
        resp-conn (lower (get-in response [:headers :connection] "")))
    (cond
      (= resp-conn "close") false
      (= req-conn "close") false
      (= version "1.0") (= req-conn "keep-alive")
      else true)))
