(defmodule http/response
  "HTTP/1.1 response serialization. `format-response` returns an ADR-139 iolist —
  `[head-bytes, body-bytes]` — that `tcp-send` flattens straight onto the socket with no
  monolithic combined buffer (a bodyless/HEAD response is just the head `bytes`). The leaves
  are `bytes`, never strings: `tcp-send` UTF-8-encodes a string leaf (ADR-141), so a string
  body with any multibyte char (an em dash, an arrow, any non-ASCII prose) would be encoded
  twice — the bytes doubled and the response truncated at the too-short Content-Length.
  `(bytes-concat (format-response …))` materialises the whole response when one value is
  needed. A `:body` may be a string, a `bytes` value, or an iolist."
  (:use http/util))

(defn bodyless-status? (status)
  "True for a status that MUST NOT carry a message body or `Content-Length` (RFC 7230
  §3.3.1/§3.3.2): 1xx informational, 204 No Content, and 304 Not Modified. Emitting either
  on these desyncs a keep-alive client, which reads the next response's bytes as this body."
  (or (and (>= status 100) (< status 200))
    (= status 204)
    (= status 304)))

(defn format-response (resp &optional (head? false))
  "Serialize a response map to an HTTP/1.1 response string ready to send over TCP.

  `head?` serializes a response to a HEAD request: the status line and headers (including
  the `Content-Length` the equivalent GET would report) are emitted, but the body is not.
  A 1xx/204/304 response carries no body or `Content-Length` regardless of `head?`; the
  `Connection` header is emitted only when the caller set one (http/server decides
  keep-alive vs close and stamps it), never forced here."
  (let (status (get resp :status 200)
        bodyless (bodyless-status? status)
        ; The body may be a string, a `bytes` value (binary — images), or an iolist (a
        ; nested string/bytes tree, ADR-139). Flatten it to `bytes` exactly once with
        ; `bytes-concat`: its byte count is the Content-Length, and it is the body leaf of
        ; the response iolist. `bodyless` skips it entirely (no body, no Content-Length).
        body-bytes (if bodyless nil (bytes-concat (or (get resp :body) "")))
        headers (get resp :headers {})
        ; A 1xx/204/304 MUST NOT carry a body/Content-Length (RFC 7230 §3.3): strip any the
        ; handler set, or a stray Content-Length desyncs a keep-alive client (it reads that
        ; many bytes of the next response as this body).
        headers (if bodyless
                  (dissoc (dissoc (dissoc headers :content-length) :content-type)
                    :transfer-encoding)
                  headers)
        headers (if (or bodyless (contains? headers :content-type))
                  headers
                  (assoc headers :content-type "text/html; charset=utf-8"))
        headers (if bodyless headers (assoc headers :content-length (str (count body-bytes)))))
    (let (head-block (str "HTTP/1.1 "
                       status
                       " "
                       (status-text status)
                       "\r\n"
                       (string/join "" (map format-header (map-pairs headers)))
                       "\r\n"))
      ; Return an ADR-139 iolist: `tcp-send` flattens `[head, body]` straight onto the
      ; socket with no monolithic combined buffer. Leaves are `bytes` (already UTF-8), so a
      ; multibyte body is not re-encoded — tcp-send would UTF-8-encode a *string* leaf
      ; (ADR-141), doubling it and truncating at the too-short Content-Length; encoding to
      ; `bytes` up front sends each body byte exactly once. `(bytes-concat …)` materialises
      ; the whole response for a caller (e.g. a test) that wants one value.
      (let (head-bytes (string->utf8-bytes head-block))
        (if (or bodyless head?)
          head-bytes
          [head-bytes body-bytes])))))

; ---- chunked streaming (Transfer-Encoding: chunked) --------------------------
; The write-side twin of http/request's chunked *reader*. A handler that returns a response
; carrying a `:stream` function (see web/conn `stream-resp`, web/stream for SSE) is sent with
; these: the head with `Transfer-Encoding: chunked` (no Content-Length), then one `chunk` per
; blob the handler produces, then `last-chunk` to close the body. Lets a response be produced
; incrementally (SSE, a large file read block-by-block) without buffering it whole.

(defn- int->hex-acc
  (n acc)
  (if (= n 0)
    acc
    (let (d (rem n 16))
      (int->hex-acc (quot n 16) (str (string/substring "0123456789abcdef" d (+ d 1)) acc)))))

(defn int->hex (n)
  "The lowercase hexadecimal string for a non-negative integer `n` (`0` → \"0\") — the size
  prefix of a chunked-transfer chunk."
  (if (= n 0) "0" (int->hex-acc n "")))

(defn chunk (data)
  "Encode `data` (a string, `bytes`, or ADR-139 iolist) as one HTTP/1.1 chunked-transfer chunk:
  the payload's byte length in hex, CRLF, the payload bytes, CRLF — returned as an iolist that
  `tcp-send` flattens. An empty payload returns nil (a 0-length chunk would prematurely end the
  stream, so the caller skips a nil), keeping `last-chunk` the sole terminator."
  (let (bs (bytes-concat data)
        n (count bs))
    (if (= n 0)
      nil
      [(string->utf8-bytes (str (int->hex n) "\r\n")) bs (string->utf8-bytes "\r\n")])))

(defn last-chunk ()
  "The terminating zero-length chunk that ends a chunked-transfer body: `0 CRLF CRLF`."
  (string->utf8-bytes "0\r\n\r\n"))

(defn format-stream-head (resp)
  "Serialize the status line + headers for a chunked streaming response: `Transfer-Encoding:
  chunked` is stamped and any `Content-Length` dropped (the chunk framing delimits the body).
  Returns head `bytes` for `tcp-send`; the body follows as `chunk`s then `last-chunk`. An unset
  content type defaults to text/html, as for a buffered response."
  (let (status (get resp :status 200)
        headers (get resp :headers {})
        headers (assoc (dissoc headers :content-length) :transfer-encoding "chunked")
        headers (if (contains? headers :content-type)
                  headers
                  (assoc headers :content-type "text/html; charset=utf-8")))
    (string->utf8-bytes (str "HTTP/1.1 "
                          status
                          " "
                          (status-text status)
                          "\r\n"
                          (string/join "" (map format-header (map-pairs headers)))
                          "\r\n"))))

(defn header-safe (v)
  "Strip CR/LF from a header value so an attacker-influenced value (a redirect
  `Location`, a reflected header) can't inject extra headers or split the response
  — HTTP response splitting. Values are always strings here; coerce for safety."
  (-> (str v)
    (string/replace "\r" "")
    (string/replace "\n" "")))

(defn format-header (kv)
  "Format a `[keyword value]` pair as one or more HTTP header lines. A scalar value emits
  a single line; a list/vector value emits one line per element — the way multiple
  `Set-Cookie` headers (which can't share a map key) reach the wire."
  (let (k (first kv)
        v (first (rest kv)))
    (if (or (list? v) (vector? v))
      (string/join "" (map (fn (one) (format-header-line k one)) v))
      (format-header-line k v))))

(defn format-header-line (k v)
  "One `Header-Name: value` line (CRLF-terminated), with CR/LF stripped from the value."
  (str (header-name k) ": " (header-safe v) "\r\n"))

(defn header-name (k)
  "Convert a keyword like `:content-type` to the canonical header string `Content-Type`."
  (string/join "-" (map capitalize-first (string/split (name k) "-"))))

(defn capitalize-first (s)
  "Uppercase the first character of `s`, leaving the rest unchanged (unlike the prelude's
  `capitalize`, which lowercases the tail) — a header-name segment like `WWW` must survive."
  (if (string/blank? s)
    s
    (str (string/upper (string/substring s 0 1)) (string/substring s 1 (string/length s)))))

(defn ok (body)
  "200 OK response with HTML body."
  {:status 200 :body body})

(defn ok-text (body)
  "200 OK response with plain-text body."
  {:status 200 :headers {:content-type "text/plain; charset=utf-8"} :body body})

(defn ok-json (body)
  "200 OK response with JSON body (caller supplies the JSON string)."
  {:status 200 :headers {:content-type "application/json"} :body body})

(defn not-found (&optional (body "<h1>404 Not Found</h1>"))
  "404 Not Found response."
  {:status 404 :body body})

(defn redirect (url &optional (status 302))
  "Redirect response to `url`."
  {:status status :headers {:location url} :body ""})

(defn error-resp (msg)
  "500 Internal Server Error response that includes `msg` in the body. A debugging
  helper — do NOT use it for untrusted/production traffic, since it echoes internal
  detail to the client (see `server-error-resp` and http/server's `:error-handler`)."
  {:status 500 :body (str "<h1>Internal Server Error</h1><pre>" msg "</pre>")})

(defn server-error-resp ()
  "A generic 500 that leaks no internals — http/server's default `:error-handler`. The
  exception detail goes to telemetry (the `[:hatch :request :exception]` event), not the
  response body."
  {:status 500 :body "<h1>500 Internal Server Error</h1>"})
