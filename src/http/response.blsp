(defmodule http/response
  "HTTP/1.1 response serialization."
  (:use http/util))

(defn byte-length (s)
  "The UTF-8 byte length of `s`. Content-Length must report bytes, not codepoints:
  the body goes out as UTF-8, so a body with any multibyte char (− … ●, emoji)
  has more bytes than `string-length`, and reporting the codepoint count truncates
  the response in the client."
  (count (seq (string->utf8-bytes s))))

(defn bodyless-status? (status)
  "True for a status that MUST NOT carry a message body or `Content-Length` (RFC 7230
  §3.3.1/§3.3.2): 1xx informational, 204 No Content, and 304 Not Modified. Emitting either
  on these desyncs a keep-alive client, which reads the next response's bytes as this body."
  (or (and (>= status 100) (< status 200))
    (= status 204)
    (= status 304)))

(defn format-response (resp &optional (head? false))
  "Serialize a response map to an HTTP/1.1 response string ready to send over TCP.

  `head?` serializes a response to a HEAD request: the status line and headers (including
  the `Content-Length` the equivalent GET would report) are emitted, but the body is not.
  A 1xx/204/304 response carries no body or `Content-Length` regardless of `head?`; the
  `Connection` header is emitted only when the caller set one (http/server decides
  keep-alive vs close and stamps it), never forced here."
  (let (status (get resp :status 200)
        body (get resp :body "")
        bodyless (bodyless-status? status)
        headers (get resp :headers {})
        headers (if (or bodyless (contains? headers :content-type))
                  headers
                  (assoc headers :content-type "text/html; charset=utf-8"))
        headers (if bodyless headers (assoc headers :content-length (str (byte-length body)))))
    (str "HTTP/1.1 "
      status
      " "
      (status-text status)
      "\r\n"
      (join "" (map format-header (entries headers)))
      "\r\n"
      (if (or bodyless head?) "" body))))

(defn header-safe (v)
  "Strip CR/LF from a header value so an attacker-influenced value (a redirect
  `Location`, a reflected header) can't inject extra headers or split the response
  — HTTP response splitting. Values are always strings here; coerce for safety."
  (-> (str v)
    (replace "\r" "")
    (replace "\n" "")))

(defn format-header (kv)
  "Format a `[keyword value]` pair as one or more HTTP header lines. A scalar value emits
  a single line; a list/vector value emits one line per element — the way multiple
  `Set-Cookie` headers (which can't share a map key) reach the wire."
  (let (k (first kv)
        v (first (rest kv)))
    (if (or (list? v) (vector? v))
      (join "" (map (fn (one) (format-header-line k one)) v))
      (format-header-line k v))))

(defn format-header-line (k v)
  "One `Header-Name: value` line (CRLF-terminated), with CR/LF stripped from the value."
  (str (header-name k) ": " (header-safe v) "\r\n"))

(defn header-name (k)
  "Convert a keyword like `:content-type` to the canonical header string `Content-Type`."
  (join "-" (map capitalize (string-split (name k) "-"))))

(defn capitalize (s)
  "Uppercase the first character of `s`, leaving the rest unchanged."
  (if (blank? s)
    s
    (str (upper (substring s 0 1)) (substring s 1 (string-length s)))))

(defn ok (body)
  "200 OK response with HTML body."
  {:status 200 :body body})

(defn ok-text (body)
  "200 OK response with plain-text body."
  {:status 200 :headers {:content-type "text/plain; charset=utf-8"} :body body})

(defn ok-json (body)
  "200 OK response with JSON body (caller supplies the JSON string)."
  {:status 200 :headers {:content-type "application/json"} :body body})

(defn not-found (&optional (body "<h1>404 Not Found</h1>"))
  "404 Not Found response."
  {:status 404 :body body})

(defn redirect (url &optional (status 302))
  "Redirect response to `url`."
  {:status status :headers {:location url} :body ""})

(defn error-resp (msg)
  "500 Internal Server Error response that includes `msg` in the body. A debugging
  helper — do NOT use it for untrusted/production traffic, since it echoes internal
  detail to the client (see `server-error-resp` and http/server's `:error-handler`)."
  {:status 500 :body (str "<h1>Internal Server Error</h1><pre>" msg "</pre>")})

(defn server-error-resp ()
  "A generic 500 that leaks no internals — http/server's default `:error-handler`. The
  exception detail goes to telemetry (the `[:hatch :request :exception]` event), not the
  response body."
  {:status 500 :body "<h1>500 Internal Server Error</h1>"})
