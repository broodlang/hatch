(defmodule http/websocket
  "WebSocket (RFC 6455) handshake, frame encoder, and frame parser.")

(def *ws-magic* "258EAFA5-E914-47DA-95CA-C5AB0DC85B11")

; ---- handshake ----

(defn accept-key (client-key)
  "Compute the Sec-WebSocket-Accept header value for a given Sec-WebSocket-Key.
  The example is RFC 6455 §1.3's reference vector.

  (hatch/http/websocket/accept-key \"dGhlIHNhbXBsZSBub25jZQ==\") ;=> \"s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\""
  (encoding/base64-encode-bytes (hash/sha1-raw (string/->bytes (str (string/trim client-key)
                                                                 *ws-magic*)))))

(defn upgrade-response (key)
  "Build the 101 Switching Protocols response for a WebSocket upgrade request."
  (str "HTTP/1.1 101 Switching Protocols\r\n"
    "Upgrade: websocket\r\n"
    "Connection: Upgrade\r\n"
    "Sec-WebSocket-Accept: "
    (accept-key key)
    "\r\n"
    "\r\n"))

(defn upgrade-request? (request)
  "True if the HTTP request is a WebSocket upgrade."
  (let (conn (string/lower (map/get-in request [:headers :connection] ""))
        upg (string/lower (map/get-in request [:headers :upgrade] "")))
    (and (includes? conn "upgrade")
      (= upg "websocket"))))

(defn origin-host (origin)
  "The `host[:port]` of an `Origin` header value (scheme stripped), for comparison with the
  request's `Host`. `Origin` is `scheme://host[:port]` with no path.

  (hatch/http/websocket/origin-host \"https://example.com:8080\") ;=> \"example.com:8080\""
  (let (i (index-of origin "://"))
    (if (= i -1) origin (string/substring origin (+ i 3) (string/length origin)))))

(defn origin-allowed? (request policy)
  "Whether a WebSocket upgrade's `Origin` is permitted — the cross-site-WebSocket-hijacking
  (CSWSH) guard. WebSockets aren't bound by the same-origin policy and the browser still
  attaches the user's cookies, so without this a page on another origin could open an
  authenticated live session. `policy`:
    true  — same-origin only (default): the Origin's host must equal the request Host. A
            missing Origin is allowed, since CSWSH is a browser attack and browsers always
            send Origin on a WS handshake (non-browser clients/tools have no ambient cookie).
    false — disable the check (allow any origin).
    list  — an explicit allowlist of permitted `Origin` header values (strict: a missing or
            unlisted Origin is rejected)."
  (cond
    (= policy false) true
    (or (list? policy) (vector? policy))
      (let (o (map/get-in request [:headers :origin]))
        (if (nil? o) false (includes? policy o)))
    else
      (let (o (map/get-in request [:headers :origin]))
        (or (nil? o) (= (origin-host o) (map/get-in request [:headers :host]))))))

; ---- frame building (server → client, unmasked) ----

; A WebSocket frame is a byte sequence (control bytes ≥ 0x80, a length-prefixed
; binary body), so we build each frame as a `bytes` value and send it verbatim.
; `tcp/send` UTF-8-encodes a *string* leaf (ADR-141) — which would re-encode an
; already-encoded payload, doubling every byte ≥ 0x80 (multibyte chars AND the frame's
; own header/length bytes) and mis-sizing the frame. A `bytes` value bypasses that: the
; payload is UTF-8-encoded exactly once (`string/->bytes`), and the header bytes go
; out as-is.

; Each frame is described as an *iolist* (ADR-139) — a nested list of byte ints and
; `bytes` values — and flattened exactly once by `bytes-concat`. The length fields go
; through the prelude's `int->bytes` (big-endian, fixed width) rather than a hand-rolled
; shift-and-mask, which is what `u64-be` used to be.

(defn text-frame (payload)
  "Build a WebSocket text frame (opcode 0x1, FIN=1, no mask) as a `bytes` value: the
  header bytes followed by the UTF-8-encoded `payload`, sent verbatim by `tcp/send`.
  Uses the 7-bit, 16-bit, or 64-bit length form by size — so a large render (>64 KB of
  HTML) produces a valid frame instead of raising and crashing the live session."
  (let (body (string/->bytes payload)
        n (count body))
    (cond
      (<= n 125) (bytes/concat [129 n body])
      (<= n 65535) (bytes/concat [129 126 (bytes/int-> n 2) body])
      else (bytes/concat [129 127 (bytes/int-> n 8) body]))))

(defn close-frame ()
  "Build a WebSocket connection-close frame (opcode 0x8, FIN=1, no payload)."
  (bytes [136 0]))

(defn pong-frame (payload)
  "Build a WebSocket pong frame (opcode 0xA, FIN=1) as `bytes`, echoing `payload`. The
  bytes-native parser hands a client ping's payload here as a `bytes` value — accept that
  directly (a string is UTF-8-encoded, for callers/tests that pass one). Control frames are
  capped at 125 bytes (RFC 6455), so an over-long payload is truncated — guarding against an
  echoed length that would overflow the single length byte into an extended-length marker."
  (let (raw (if (bytes? payload) payload (string/->bytes payload))
        body (if (> (count raw) 125) (bytes/slice raw 0 125) raw))
    (bytes/concat [138 (count body) body])))

(defn ping-frame ()
  "Build an empty WebSocket ping frame (opcode 0x9, FIN=1) — used for server keepalive."
  (bytes [137 0]))

; ---- frame parsing (client → server, masked) ----

; Inbound size limits (RFC 6455 hardening, docs/robustness.md). 64-bit frame lengths are
; rejected outright, so a single frame is already ≤ 64 KB; *ws-max-frame-bytes* can cap it
; lower, and *ws-max-message-bytes* bounds a message reassembled from many fragments.
(def *ws-max-frame-bytes* 65535)
(def *ws-max-message-bytes* 1048576)

; The inbound frame parser is bytes-native (ADR-141): `buf` is a `bytes` value delivered by the
; binary-mode socket, and a frame's payload/remainder are `bytes` — no Latin-1 carrier-string
; hop, and `bytes/at`/`bytes/uint`/`bytes/slice` index it in O(1). The masking key and length fields
; are read with ADR-140 bit-syntax helpers (`bytes-uint`).
(defn parse-frame (buf)
  "Parse one complete WebSocket *message* from the `bytes` `buf`, reassembling a fragmented
  message (a non-FIN data frame followed by continuation frames). Returns
  `[:ok opcode payload remainder]` (payload + remainder are `bytes`), `[:incomplete]`, or
  `[:error msg]`. A control frame (close/ping/pong) is returned standalone. Each frame is capped
  at *ws-max-frame-bytes* and a reassembled message at *ws-max-message-bytes*; an interleaved
  non-continuation frame mid-message is rejected (the live client never sends them)."
  (parse-message buf *ws-max-frame-bytes* *ws-max-message-bytes*))

(defn parse-message (buf maxf maxm)
  "Parse one message: a single frame, or a fragmented data message reassembled across
  continuation frames. `maxf`/`maxm` cap a frame / the whole message."
  (match (parse-one-frame buf maxf)
    ([:incomplete] [:incomplete])
    ([:error m] [:error m])
    ([:ok fin opcode payload remainder]
      (cond
        ; control frames are never fragmented — deliver standalone
        (control-opcode? opcode) [:ok opcode payload remainder]
        ; a complete (FIN) data frame is the whole message
        (= fin 1) [:ok opcode payload remainder]
        ; otherwise it's the head of a fragmented message — gather continuations
        else (reassemble remainder opcode (list payload) (count payload) maxf maxm)))))

(defn reassemble (buf msg-opcode pieces acclen maxf maxm)
  "Accumulate continuation frames (opcode 0) until the FIN frame, capping the total at `maxm`.
  `pieces` holds the `bytes` payloads gathered so far (newest-first) and `acclen` their total
  length; they're `bytes-concat`ed once at FIN rather than per frame (which is O(n²) in the
  fragment count). `msg-opcode` carries the original (text/binary) opcode forward."
  (match (parse-one-frame buf maxf)
    ([:incomplete] [:incomplete])
    ([:error m] [:error m])
    ([:ok fin opcode payload remainder] (cond
                                          (not (= opcode 0))
                                            [:error "websocket: expected continuation frame"]
                                          (> (+ acclen (count payload)) maxm)
                                            [:error "websocket: message too large"]
                                          (= fin 1)
                                            [:ok
                                              msg-opcode
                                              (bytes/concat (reverse (cons payload pieces)))
                                              remainder]
                                          else
                                            (reassemble remainder
                                              msg-opcode
                                              (cons payload pieces)
                                              (+ acclen (count payload))
                                              maxf
                                              maxm)))))

(defn parse-one-frame (buf maxf)
  "Parse exactly one WebSocket frame from `buf`. Returns `[:ok fin opcode payload
  remainder]`, `[:incomplete]`, or `[:error msg]`. `fin` is the FIN bit (1 on the final
  frame of a message). Enforces the RFC 6455 framing rules a server must (masked client
  frames, zero RSV bits, defined opcodes, unfragmented control frames) and rejects a declared
  payload over `maxf` bytes."
  (let (buflen (count buf))
    (if (< buflen 2)
      [:incomplete]
      (let (byte0 (bytes/at buf 0)
            byte1 (bytes/at buf 1)
            fin (bit/shift-right byte0 7)
            rsv (bit/and (bit/shift-right byte0 4) 7)
            opcode (bit/and byte0 15)
            masked (bit/shift-right byte1 7)
            plen7 (bit/and byte1 127))
        (cond
          ; §5.2: RSV1-3 must be 0 unless an extension negotiated them (none here).
          (not (= rsv 0)) [:error "websocket: reserved bits set"]
          ; §5.1: the server MUST fail the connection on an unmasked client frame.
          (not (= masked 1)) [:error "websocket: client frame not masked"]
          ; §5.2: opcodes outside {0,1,2,8,9,10} are reserved.
          (not (valid-opcode? opcode)) [:error "websocket: reserved opcode"]
          ; §5.5: control frames must not be fragmented (FIN must be 1).
          (and (control-opcode? opcode) (= fin 0)) [:error "websocket: fragmented control frame"]
          else (one-frame-sized buf buflen fin opcode masked plen7 maxf))))))

(defn control-opcode? (opcode)
  "True for a WebSocket control opcode (close 0x8, ping 0x9, pong 0xA). Control frames
  must carry ≤125 bytes and may not use extended length (RFC 6455 §5.5)."
  (>= opcode 8))

(defn valid-opcode? (opcode)
  "True for a defined RFC 6455 opcode: continuation 0x0, text 0x1, binary 0x2, and the
  control opcodes close 0x8 / ping 0x9 / pong 0xA. Everything else is reserved."
  (includes? [0 1 2 8 9 10] opcode))

(defn valid-close-code? (code)
  "True for a WebSocket close status code an endpoint may put on the wire (RFC 6455 §7.4):
  1000-1003, 1007-1011, or the application (3000-3999) / private (4000-4999) ranges. Everything
  else is reserved or a no-code sentinel that MUST NOT appear (< 1000, 1004, 1005, 1006, the
  1012-2999 reserved band, 1015)."
  (or (and (>= code 1000) (<= code 1003))
    (and (>= code 1007) (<= code 1011))
    (and (>= code 3000) (<= code 4999))))

(defn valid-close-payload? (payload)
  "RFC 6455 §5.5.1: a Close frame body is EMPTY (no status) or AT LEAST 2 bytes — a big-endian
  u16 status code, optionally followed by a UTF-8 reason. A 1-byte body is malformed, and a
  present code must be a legal one (`valid-close-code?`)."
  (let (n (count payload))
    (cond
      (= n 0) true
      (= n 1) false
      else (valid-close-code? (bytes/uint payload 0 2)))))

(defn- one-frame-sized (buf buflen fin opcode masked plen7 maxf)
  (cond
    ; Control frames (close/ping/pong) must be ≤125 bytes — reject an extended length
    ; rather than let an oversized ping drive a huge unmask / overflow `pong-frame`.
    (and (control-opcode? opcode) (>= plen7 126))
      [:error "websocket: control frame too large (must be <= 125 bytes)"]
    ; 16-bit extended length (ADR-140 bit-syntax: a big-endian u16 at offset 2)
    (= plen7 126)
      (if (< buflen 4)
        [:incomplete]
        (let (plen (bytes/uint buf 2 2)
              hlen (if (= masked 1) 8 4))
          (one-frame-payload buf buflen fin opcode masked plen hlen maxf)))
    ; 64-bit extended length — not supported (caps inbound frames at ~64 KB)
    (= plen7 127) [:error "websocket: 64-bit frame length not supported"]
    ; 7-bit length
    else
      (let (hlen (if (= masked 1) 6 2))
        (one-frame-payload buf buflen fin opcode masked plen7 hlen maxf))))

(defn- one-frame-payload (buf buflen fin opcode masked plen hlen maxf)
  (if (> plen maxf)
    [:error "websocket: frame too large"]
    (let (total (+ hlen plen))
      (if (< buflen total)
        [:incomplete]
        (let (payload (if (= masked 1)
                        (unmask buf (- hlen 4) plen)
                        (bytes/slice buf hlen (+ hlen plen)))
              remainder (bytes/slice buf total buflen))
          ; §5.5.1: a close frame's body must be 0 or ≥2 bytes with a legal status code — a
          ; 1-byte body or a reserved code is a protocol error, so fail the connection.
          (if (and (= opcode 8) (not (valid-close-payload? payload)))
            [:error "websocket: malformed close frame"]
            [:ok fin opcode payload remainder]))))))

(sig one-frame-payload (bytes int any any any int int int -> any))
(defn frame-size (buf)
  "Total byte length (header + payload) of the first WebSocket frame in `buf` once its length
  header is fully present, else nil — the header hasn't fully arrived (`buf` < 2, or < 4 for a
  16-bit length), or it's the unsupported 64-bit form (`parse-one-frame` raises on that anyway).
  Mirrors `one-frame-sized`'s framing so a reader can gather exactly enough bytes for one frame
  in O(n) instead of re-scanning a growing buffer. Client frames are masked (+4 mask bytes)."
  (let (buflen (count buf))
    (if (< buflen 2)
      nil
      (let (byte1 (bytes/at buf 1)
            masked (bit/shift-right byte1 7)
            plen7 (bit/and byte1 127))
        (cond
          (= plen7 126)
            (if (< buflen 4)
              nil
              (+ (if (= masked 1) 8 4) (bytes/uint buf 2 2)))
          (= plen7 127) nil
          else (+ (if (= masked 1) 6 2) plen7))))))

(defn unmask (buf key-offset plen)
  "XOR `plen` bytes of the `bytes` `buf` starting after `key-offset` using the 4-byte masking
  key — returning a `bytes` value. `buf` is a first-class `bytes` and the payload is built in
  one pass (a masked frame is the WS receive hot path; the old carrier-string form indexed with
  O(i) `char-at`, making this O(n²) — a cheap CPU DoS).

  Three things in this loop run once per PAYLOAD BYTE, so each is worth its own thought:

  - `bytes/at`, not `get`. Both index a `bytes` in O(1), but `get` is the generic collection
    accessor and dispatches on the collection kind every call — measured 1.40us against
    `bytes/at`'s 0.31us.
  - the key in four LOCALS, not a vector indexed per byte, which is another generic `get`.
  - `bit/and i 3`, not `math/mod i 4` — the same value for a non-negative `i`, without division.

  Together: 2818us to 509us on a 1 KiB frame, 5.5x, byte-identical output. Every message a
  browser sends is masked (RFC 6455 requires it of clients), so this is on the path of every
  live-view event, and the old cost scaled at ~2.8us per byte against a machine with one
  shared vCPU."
  (let (k0 (bytes/at buf key-offset)
        k1 (bytes/at buf (+ key-offset 1))
        k2 (bytes/at buf (+ key-offset 2))
        k3 (bytes/at buf (+ key-offset 3))
        data-start (+ key-offset 4))
    (bytes (map (range plen)
             (fn (i)
               (bit/xor (bytes/at buf (+ data-start i))
                 (case (bit/and i 3) 0 k0 1 k1 2 k2 k3)))))))

; ---- reading a message off a socket ----
;
; The receive half of the protocol. `parse-frame` above answers from a buffer; this blocks on
; the socket until that buffer holds a whole message, gathering reads as it goes.
;
; It handles exactly two things — bytes arriving and the peer closing — and hands EVERYTHING
; else back to the caller untouched. That split is the point. Both socket actors hatch runs
; (web/live's live session, web/channel's topic socket) are parked in this loop almost all the
; time, and both are woken by messages that have nothing to do with WebSocket framing: a
; ticker beat, a pubsub broadcast, a hot-reload signal, a watchdog ping request. Those differ
; per actor; the framing does not. Interpreting them here would mean this function knowing
; every protocol layered over it, which is how web/live came to carry two copies of its own
; receive arms with a "keep the two in sync" comment between them.

(defn frame-shortfall (buf)
  "How many more bytes would complete the first frame in the `bytes` `buf` — or **nil when
  that number cannot be acted on**, which is two distinct situations deliberately given one
  answer:

  - the length header has not fully arrived, so the frame is not sized yet; and
  - the first frame is already complete. That sounds like 'nothing needed', and for a single
    frame it is — but `parse-frame` asks for a whole MESSAGE, and a complete non-FIN frame is
    the head of a fragmented one whose continuations have not arrived.

  Both mean the same thing to the only caller: go back to the socket, because re-parsing what
  you hold cannot make progress. Collapsing them here rather than at the call site is the
  point — the version that answered a bare `0` for the second case had the reader read it as
  'we have enough', re-parse the identical buffer, get `[:incomplete]` again, and never reach
  a `receive`. A worker pinned at 100% CPU and a wedged connection, from a message shape
  RFC 6455 §5.4 explicitly allows and a browser may produce for a large binary send.

  (hatch/http/websocket/frame-shortfall (bytes [])) ;=> nil
  (hatch/http/websocket/frame-shortfall (bytes [1 131 0 0 0 0 97 98 99])) ;=> nil
  (hatch/http/websocket/frame-shortfall (bytes [1 131 0 0 0 0 97])) ;=> 2"
  (let (sz (frame-size buf))
    (if (nil? sz)
      nil
      (let (short (- sz (count buf)))
        (if (> short 0) short nil)))))

(defn recv-frame (sock buf)
  "Block until a complete WebSocket message has arrived on `sock`, starting from the `bytes`
  already in `buf`. Returns one of:

    `[:ok opcode payload remainder]` — a whole message; `payload`/`remainder` are `bytes`
    `[:closed]`                      — the peer closed the TCP connection
    `[:error msg]`                   — a framing/protocol violation; the caller should close
    `[:other msg buf2]`              — some other message reached the mailbox. `msg` is that
                                       message verbatim and `buf2` the bytes read so far, so
                                       the caller acts on it and re-enters here with `buf2`.

  A caller resuming from `[:other]` re-parses `buf2`, which costs one header read of an
  incomplete frame and keeps the resume path identical to a cold start."
  (match (parse-frame buf)
    ([:ok opcode payload remainder] [:ok opcode payload remainder])
    ([:incomplete] (recv-frame-fill sock buf (list) 0 (frame-shortfall buf)))
    ([:error msg] [:error msg])))

(defn- recv-frame-fill (sock buf pieces got need)
  "Gather socket reads (`bytes` `pieces`, newest-first; `got` bytes so far) until the current
  frame's `need` more bytes are in hand, then `bytes/concat` once and re-enter `recv-frame`.
  `need` nil means re-parsing what we hold cannot make progress — the header is still arriving,
  or the first frame is complete but its message is not (see `frame-shortfall`) — so append one
  read and re-derive rather than looping on it.

  Gathering into a list and joining once is what keeps this O(n): re-`bytes/concat`ing the
  whole buffer on every read was O(n²) up to the message-size cap."
  (if (and (not (nil? need)) (>= got need))
    (recv-frame sock (bytes/concat buf (reverse pieces)))
    (receive
      ; Binary-mode socket (see http/server's pre-101 tcp/set-binary): `chunk` is a
      ; first-class `bytes` value — the parser reads it directly, with no carrier hop.
      ([:tcp ^sock chunk] (if (nil? need)
                            (recv-frame sock (bytes/concat buf chunk))
                            (recv-frame-fill sock
                              buf
                              (cons chunk pieces)
                              (+ got (count chunk))
                              need)))
      ([:tcp-closed ^sock] [:closed])
      (other [:other other (bytes/concat buf (reverse pieces))]))))
