(defmodule http/request
  "HTTP/1.1 request parsing."
  (:use http/util))

(defn try-parse (buf)
  "Attempt to parse a complete HTTP/1.1 request from a string buffer.
  Returns `[:ok request-map remainder]`, `[:incomplete]`, or `[:error msg]`.
  `remainder` contains any bytes in `buf` after the parsed request (pipelined data)."
  (let (sep (index-of buf "\r\n\r\n"))
    (if (= sep -1)
      [:incomplete]
      (let (header-block (string/substring buf 0 sep)
            body-start (+ sep 4)
            lines (string/split header-block "\r\n"))
        (match lines
          (nil [:error "empty request"])
          ((req-line & header-lines)
            (if (> (count header-lines) *max-header-count*)
              [:error "too many headers"]
              (match (parse-request-line req-line)
                ([:error e] [:error e])
                ([:ok method path query version]
                  (let (headers (parse-headers header-lines)
                        buflen (string/length buf))
                    (cond
                      ; A bare CR or LF in the head (only CRLF was split away) lets a proxy that
                      ; splits on it see a different header set — a smuggling primitive (§3.5).
                      (bare-line-break? lines) [:error "bare CR or LF in header block"]
                      ; Whitespace before a field-name colon — we'd trim it and honor the header,
                      ; a strict proxy wouldn't; a CL.TE desync (§3.2.4), same class as obs-fold.
                      (any-ws-before-colon? header-lines) [:error "whitespace before header colon"]
                      ; A header line with no colon is malformed — reject rather than silently drop.
                      (colonless-header? header-lines) [:error "header line without a colon"]
                      ; obs-fold (a header line starting with SP/HTAB) — RFC 7230 §3.2.4 says a
                      ; server must reject it in a request; folding disagreements are a header-
                      ; desync / smuggling primitive. `parse-headers` would otherwise promote a
                      ; continuation line to a standalone header.
                      (obs-fold? header-lines) [:error "obs-fold header line"]
                      ; More than one Transfer-Encoding header line is ambiguous framing: a
                      ; proxy honoring a different occurrence than we do (we keep the last) is a
                      ; smuggling vector. (A list value like "x, chunked" is already rejected
                      ; below, since `chunked?` requires the value to be exactly "chunked".)
                      (duplicate-transfer-encoding? header-lines)
                        [:error "multiple Transfer-Encoding"]
                      ; Transfer-Encoding *and* Content-Length is ambiguous framing
                      ; (request smuggling) — reject outright (RFC 7230 §3.3.3).
                      (and (contains? headers :transfer-encoding)
                        (contains? headers :content-length))
                        [:error "Transfer-Encoding with Content-Length"]
                      ; Chunked Transfer-Encoding: de-chunk the body. Any other TE coding
                      ; (gzip, …) we don't decode, so reject rather than mis-frame it.
                      (contains? headers :transfer-encoding)
                        (if (chunked? (get headers
                                        :transfer-encoding))
                          ; one decoder for both paths: `dechunk-step`
                          ; (its `:more` = "need more bytes" = `:incomplete`
                          ; for a single whole-buffer parse)
                          (match (dechunk-step buf body-start (list) 0)
                            ([:more _tail _decoded _dlen] [:incomplete])
                            ([:error e] [:error e])
                            ([:ok body remainder] [:ok
                                                    (mk-request method
                                                      path query version headers body)
                                                    remainder]))
                          [:error "unsupported transfer-encoding"])
                      ; Conflicting Content-Length values → ambiguous framing.
                      (content-length-conflict? header-lines) [:error "conflicting Content-Length"]
                      ; Content-Length, when present, must be a non-negative
                      ; integer. Without this a negative value made body-end <
                      ; body-start and `substring` threw, crashing the worker.
                      (not (valid-content-length? (get headers :content-length)))
                        [:error "invalid Content-Length"]
                      else
                        (let (clen (content-length-value (get headers :content-length))
                              body-end (+ body-start clen))
                          (if (< buflen body-end)
                            [:incomplete]
                            [:ok
                              (mk-request method
                                path
                                query
                                version
                                headers
                                (string/substring buf body-start body-end))
                              (string/substring buf body-end buflen)])))))))))))))

(defn try-parse-head (buf)
  "Parse a request's line + headers WITHOUT requiring the body to have arrived — for the
  streaming/spool path, which needs the method, headers, Content-Length and body offset before
  it can decide to stream the body to disk. Runs the SAME framing rejections as `try-parse`.
  Returns `[:head {:method :path :query :version :headers} body-start content-length]`,
  `[:incomplete]` (headers not fully received yet), `[:chunked head body-start]` (a chunked
  body — not spoolable; the caller drains it incrementally), or `[:error msg]`. Callers that
  only test the tag (`(first …)`) are unaffected by the extra chunked fields."
  (let (sep (index-of buf "\r\n\r\n"))
    (if (= sep -1)
      [:incomplete]
      (let (header-block (string/substring buf 0 sep)
            body-start (+ sep 4)
            lines (string/split header-block "\r\n"))
        (match lines
          (nil [:error "empty request"])
          ((req-line & header-lines)
            (if (> (count header-lines) *max-header-count*)
              [:error "too many headers"]
              (match (parse-request-line req-line)
                ([:error e] [:error e])
                ([:ok method path query version]
                  (let (headers (parse-headers header-lines))
                    (cond
                      (bare-line-break? lines) [:error "bare CR or LF in header block"]
                      (any-ws-before-colon? header-lines) [:error "whitespace before header colon"]
                      (colonless-header? header-lines) [:error "header line without a colon"]
                      (obs-fold? header-lines) [:error "obs-fold header line"]
                      (duplicate-transfer-encoding? header-lines)
                        [:error "multiple Transfer-Encoding"]
                      (and (contains? headers :transfer-encoding)
                        (contains? headers :content-length))
                        [:error "Transfer-Encoding with Content-Length"]
                      ; A chunked body has no Content-Length to size the spool by — defer to the
                      ; incremental de-chunk drain rather than mis-frame it (carry the head and
                      ; body offset so the drain doesn't re-parse them). Any OTHER coding (gzip,
                      ; `chunked, gzip`, …) we don't decode — reject rather than mis-frame it, the
                      ; same as `try-parse`; treating any TE as chunked is a smuggling surface.
                      (and (contains? headers :transfer-encoding)
                        (not (chunked? (get headers :transfer-encoding))))
                        [:error "unsupported transfer-encoding"]
                      (contains? headers :transfer-encoding)
                        [:chunked
                          {:method method
                           :path path
                           :query query
                           :params (parse-query query)
                           :version version
                           :headers headers}
                          body-start]
                      (content-length-conflict? header-lines) [:error "conflicting Content-Length"]
                      (not (valid-content-length? (get headers :content-length)))
                        [:error "invalid Content-Length"]
                      else
                        [:head
                          {:method method
                           :path path
                           :query query
                           :params (parse-query query)
                           :version version
                           :headers headers}
                          body-start
                          (content-length-value (get headers :content-length))])))))))))))

(defn mk-request (method path query version headers body)
  "Build the request map shared by the Content-Length and chunked paths. `version` is the
  request line's HTTP version ('1.1' or '1.0'), which drives keep-alive defaulting. `body` may
  be a carrier string (legacy path) or a `bytes` value (the bytes-native path); the map is
  otherwise identical."
  {:method method
   :path path
   :query query
   :params (parse-query query)
   :version version
   :headers headers
   :body body})

;; ---- bytes-native parsing (the carrier-bridge-free path) --------------------------------------
;; `try-parse` / `try-parse-head` / `dechunk-step` above take a *carrier* string — one codepoint
;; per wire byte — so the server had to `bytes->carrier` every read and `web/conn` had to
;; `carrier->bytes` the body straight back: a whole-buffer double-walk, quadratic in the body for
;; a large upload (audit §16). These byte-native twins parse a `bytes` buffer directly. Only the
;; small, bounded, ASCII/Latin-1 request HEAD is decoded to a carrier (once, via `head-carrier`)
;; so the proven, security-critical head parsing (`parse-request-line`/`parse-headers` and the
;; obs-fold / duplicate-Transfer-Encoding / Content-Length-conflict rejections) is reused
;; VERBATIM — the byte twins differ from their carrier originals only in how they slice the BODY
;; (`subbytes` not `substring`, `bytes-concat` not `join`). The carrier originals are kept as the
;; oracle for `tests/http_request_bytes_test.blsp`, a differential fuzz that runs a broad corpus
;; through both and asserts identical verdicts — HTTP parsing is exactly where a smuggling bug
;; hides, so the equivalence is guarded live, not by inspection.

(def crlf-crlf-bytes (string/->bytes "\r\n\r\n"))
(def crlf-bytes (string/->bytes "\r\n"))

(defn head-carrier (b)
  "Decode head-block `bytes` to a Latin-1 carrier string (one codepoint 0-255 per byte), so the
  string-based head parser runs byte-faithfully. Applied only to the request HEAD, which is
  bounded (`:max-request-bytes`) and ASCII/Latin-1 — never to the body, which stays `bytes`."
  (string/join "" (map int->char (bytes/->list b))))

(defn try-parse-bytes (buf)
  "Bytes-native `try-parse`: `buf` is a `bytes` value. Returns `[:ok request remainder]`,
  `[:incomplete]`, or `[:error msg]` — the SAME verdicts as `try-parse`, but the request `:body`
  and the `remainder` are raw `bytes`, and no carrier bridge is walked over the body. Head
  CLASSIFICATION (the request line + every smuggling rejection) is delegated to `try-parse-head`
  on the carrier-decoded head, so the two paths can never drift; only the body is sliced natively
  from `buf` (Content-Length) or de-chunked (`dechunk-step-bytes`)."
  (let (sep (bytes/index-of buf crlf-crlf-bytes))
    (if (= sep -1)
      [:incomplete]
      (let (buflen (count buf))
        (match (try-parse-head (head-carrier (bytes/slice buf 0 (+ sep 4))))
          ([:error e] [:error e])
          ([:head head body-start clen] (let (body-end (+ body-start clen))
                                          (if (< buflen body-end)
                                            [:incomplete]
                                            [:ok
                                              (assoc head
                                                :body (bytes/slice buf body-start body-end))
                                              (bytes/slice buf body-end buflen)])))
          ([:chunked head body-start] (match (dechunk-step-bytes buf body-start (list) 0)
                                        ([:more _tail _decoded _dlen] [:incomplete])
                                        ([:error e] [:error e])
                                        ([:ok body remainder] [:ok
                                                                (assoc head :body body)
                                                                remainder]))))))))

(defn try-parse-head-bytes (buf)
  "Bytes-native `try-parse-head`: parse a request's line + headers from a `bytes` buffer WITHOUT
  requiring the body. Same verdicts/shape as `try-parse-head` (`[:head head body-start clen]` /
  `[:chunked head body-start]` / `[:incomplete]` / `[:error msg]`); `body-start` is a byte offset
  into `buf`. The head map's fields are strings/keywords exactly as before (only the body is
  bytes downstream)."
  (let (sep (bytes/index-of buf crlf-crlf-bytes))
    (if (= sep -1)
      [:incomplete]
      ; reuse the proven carrier head classifier on just the head + its terminator; body-start
      ; (sep+4) is the same offset in the byte buffer, so the caller reads the body from `buf`.
      (try-parse-head (head-carrier (bytes/slice buf 0 (+ sep 4)))))))

(defn dechunk-step-bytes (buf pos decoded dlen)
  "Bytes-native `dechunk-step`: `buf` is `bytes`, `decoded` a list of decoded chunk `bytes`
  (newest-first) with running length `dlen`. Same verdicts as `dechunk-step`; `[:ok body …]`'s
  body and every `[:more tail …]`'s tail are `bytes`. The chunk SIZE line is ASCII, so it is
  Latin-1-decoded for the hex parse; the chunk DATA is sliced with `subbytes`, never decoded."
  (let (buflen (count buf)
        eol (bytes/index-of buf crlf-bytes pos))
    (if (= eol -1)
      [:more (bytes/slice buf pos buflen) decoded dlen]
      (let (size-line (head-carrier (bytes/slice buf pos eol))
            semi (index-of size-line ";")
            size-tok (if (= semi -1) size-line (string/substring size-line 0 semi))
            size (parse-hex (string/trim size-tok)))
        (cond
          (nil? size) [:error "invalid chunk size"]
          (= size 0)
            (let (end (dechunk-trailers-bytes buf (+ eol 2) buflen))
              (if (= end -1)
                [:more (bytes/slice buf pos buflen) decoded dlen]
                [:ok (bytes/concat (reverse decoded)) (bytes/slice buf end buflen)]))
          else
            (let (data-start (+ eol 2)
                  data-end (+ data-start size)
                  after (+ data-end 2))
              (if (< buflen after)
                [:more (bytes/slice buf pos buflen) decoded dlen]
                (if (crlf-at? buf data-end)
                  (dechunk-step-bytes buf
                    after
                    (cons (bytes/slice buf data-start data-end) decoded)
                    (+ dlen size))
                  [:error "malformed chunk"]))))))))

(defn crlf-at? (buf i)
  "True if the two bytes at index `i` of `buf` are CR LF. Assumes `i+1` is in bounds."
  (and (= (bytes/at buf i) 13) (= (bytes/at buf (+ i 1)) 10)))

(defn dechunk-trailers-bytes (buf pos buflen)
  "Bytes-native `dechunk-trailers`: skip trailer headers after the 0-size chunk; return the index
  past the terminating empty CRLF, or -1 if the trailer section isn't fully buffered yet."
  (let (eol (bytes/index-of buf crlf-bytes pos))
    (cond
      (= eol -1) -1
      (= eol pos) (+ eol 2)
      else (dechunk-trailers-bytes buf (+ eol 2) buflen))))

;; ---- chunked Transfer-Encoding (RFC 7230 §4.1) ------------------------------
(defn chunked? (te)
  "True if the Transfer-Encoding value is exactly `chunked` (the only coding we decode)."
  (= (string/lower (string/trim te)) "chunked"))

(defn idx-from (s needle from)
  "Index of `needle` in `s` at or after `from`, or -1."
  (let (i (index-of (string/substring s from (string/length s)) needle))
    (if (= i -1) -1 (+ from i))))

(defn hex-digit-val (c)
  "The value 0–15 of hex digit char `c`, or nil if it isn't one."
  (let (n (char->int c))
    (cond
      (and (>= n 48) (<= n 57)) (- n 48)
      ; 0-9
      (and (>= n 97) (<= n 102)) (- n 87)
      ; a-f
      (and (>= n 65) (<= n 70)) (- n 55)
      ; A-F
      else nil)))

(defn parse-hex (s)
  "Parse hex string `s` to a non-negative integer, or nil if empty/invalid."
  (if (string/blank? s)
    nil
    (fold (fn (acc c)
            (if (nil? acc)
              nil
              (let (d (hex-digit-val c)) (if (nil? d) nil (+ (* acc 16) d)))))
      0
      (string/->list s))))

(defn- dechunk-trailers
  (buf pos buflen)
  "Skip any trailer headers after the last (0-size) chunk; return the index past the
  terminating empty CRLF, or -1 if the trailer section isn't fully buffered yet."
  (let (eol (idx-from buf "\r\n" pos))
    (cond
      (= eol -1) -1
      (= eol pos) (+ eol 2)
      ; empty line → end of trailers
      else (dechunk-trailers buf (+ eol 2) buflen))))

(defn dechunk-step (buf pos decoded dlen)
  "Incremental de-chunk: decode every chunk that is *fully present* in `buf` from `pos`,
  accumulating decoded pieces (newest-first) in `decoded` with running length `dlen`. Returns:
    `[:ok body remainder]`  — the terminating 0-size chunk was reached; `body` is the joined
                              decoded bytes, `remainder` anything after the trailers.
    `[:more tail decoded dlen]` — need more bytes; `tail` is only the *undecoded* remainder (a
                              partial chunk/size-line), so a streaming caller (server/chunked-drain)
                              feeds the next read onto `tail` and resumes without re-scanning the
                              bytes already decoded — what makes streaming O(n).
    `[:error msg]`          — malformed framing.
  Pieces are `join`ed once (at `:ok`) rather than `(str acc …)` per chunk. `try-parse` reuses this
  on a whole buffer (`:more` → `:incomplete`), so both paths share one decoder."
  (let (buflen (string/length buf)
        eol (idx-from buf "\r\n" pos))
    (if (= eol -1)
      [:more (string/substring buf pos buflen) decoded dlen]
      (let (size-line (string/substring buf pos eol)
            semi (index-of size-line ";")
            size-tok (if (= semi -1) size-line (string/substring size-line 0 semi))
            size (parse-hex (string/trim size-tok)))
        (cond
          (nil? size) [:error "invalid chunk size"]
          (= size 0)
            (let (end (dechunk-trailers buf (+ eol 2) buflen))
              (if (= end -1)
                [:more (string/substring buf pos buflen) decoded dlen]
                [:ok (string/join "" (reverse decoded)) (string/substring buf end buflen)]))
          else
            (let (data-start (+ eol 2)
                  data-end (+ data-start size)
                  after (+ data-end 2))
              (if (< buflen after)
                [:more (string/substring buf pos buflen) decoded dlen]
                (if (= (string/substring buf data-end after) "\r\n")
                  (dechunk-step buf
                    after
                    (cons (string/substring buf data-start data-end) decoded)
                    (+ dlen size))
                  [:error "malformed chunk"]))))))))

(defn all-digits? (s)
  "True if `s` is non-empty and every character is an ASCII digit 0–9."
  (and (not (string/blank? s))
    (empty? (filter (fn (c) (let (n (char->int c)) (or (< n 48) (> n 57)))) (string/->list s)))))

(defn header-value-for (line lower-key)
  "The trimmed value of raw header `line` if its lowercased name equals `lower-key`,
  else nil. Splits on the first `:` (the space after it is optional)."
  (let (ci (index-of line ":"))
    (if (and (not (= ci -1))
          (= (string/lower (string/trim (string/substring line 0 ci))) lower-key))
      (string/trim (string/substring line (+ ci 1) (string/length line)))
      nil)))

(defn obs-fold? (header-lines)
  "True if any header line begins with a space or tab — an obs-fold continuation line, which
  RFC 7230 §3.2.4 says a server must reject in a request (it's a header-desync primitive)."
  (not (empty? (filter (fn (line)
                         (and (> (string/length line) 0)
                           (let (c (string/substring line 0 1)) (or (= c " ") (= c "\t")))))
                 header-lines))))

(defn ws-before-colon? (line)
  "True when a header `line` has a space or tab immediately before its field-name colon.
  RFC 7230 §3.2.4 forbids whitespace between the field-name and the colon; `parse-headers`
  would `trim` it away and recognise `Transfer-Encoding : chunked` as a real
  Transfer-Encoding, while a strict proxy treats the malformed line as unknown — that
  disagreement is a CL.TE desync primitive, the same class as obs-fold."
  (let (ci (index-of line ":"))
    (and (> ci 0)
      (let (before (string/substring line (- ci 1) ci)) (or (= before " ") (= before "\t"))))))

(defn any-ws-before-colon? (header-lines)
  "True if any header line puts whitespace before its colon (see `ws-before-colon?`)."
  (not (empty? (filter ws-before-colon? header-lines))))

(defn bare-line-break? (lines)
  "True if any already-CRLF-split `lines` (the request-line or a header line) still holds a
  bare CR or bare LF. RFC 7230 §3.5: only CRLF terminates a line, so a bare LF/CR embedded in
  the head means a proxy that DOES split on it parses a different header set — a smuggling
  primitive. Every legitimate CRLF was consumed by the split, so a leftover CR/LF is bare."
  (not (empty? (filter (fn (l) (or (includes? l "\r") (includes? l "\n"))) lines))))

(defn colonless-header? (header-lines)
  "True if any header line has no colon at all — a malformed field with no name/value split.
  `parse-headers` silently DROPS such a line; rejecting it instead keeps a proxy that does parse
  it (as a bare field, or by joining it to a neighbour) from disagreeing with us, the same
  desync posture as the other malformed-header rejections. Obs-fold continuation lines start
  with SP/HTAB and are caught by `obs-fold?` first, so this only fires on a non-folded line."
  (not (empty? (filter (fn (line) (and (> (string/length line) 0) (= (index-of line ":") -1)))
                 header-lines))))

(defn duplicate-transfer-encoding? (header-lines)
  "True if more than one `Transfer-Encoding` header line is present — ambiguous framing
  (a proxy may honor a different occurrence than our last-wins map), a smuggling vector."
  (> (count (filter (fn (line) (not (nil? (header-value-for line "transfer-encoding"))))
              header-lines))
    1))

(defn content-length-conflict? (header-lines)
  "True if `Content-Length` appears more than once with differing values — ambiguous
  framing (RFC 7230), a request-smuggling vector. Duplicate identical values are fine."
  (let (vals (filter (fn (v) (not (nil? v)))
               (map (fn (line) (header-value-for line "content-length")) header-lines)))
    (and (> (count vals) 1)
      (not (empty? (filter (fn (v) (not (= v (first vals)))) (rest vals)))))))

(defn valid-content-length? (cl)
  "True if the Content-Length header value `cl` is absent (nil), or present and a
  non-negative integer. Rejects negatives, floats, hex, and empty — any of which would
  otherwise mis-size or crash the body read."
  (or (nil? cl) (all-digits? (string/trim cl))))

(defn content-length-value (cl)
  "The integer Content-Length, or 0 when absent. Assumes `valid-content-length?`."
  (if (nil? cl) 0 (string/->number (string/trim cl))))

(defn http-version (token)
  "Extract the numeric HTTP version ('1.1', '1.0') from a request-line version token like
  `HTTP/1.1`; defaults to '1.1' when the token is missing the `/version` suffix."
  (let (slash (index-of (str token) "/"))
    (if (= slash -1) "1.1" (string/substring token (+ slash 1) (string/length token)))))

(defn parse-request-line (line)
  "Parse `'GET /path?query HTTP/1.1'` into `[:ok method path query version]` or
  `[:error msg]`. `version` is the numeric HTTP version ('1.1'/'1.0')."
  (let (parts (string/split line " "))
    (match parts
      ((method target version & _) (let (qi (index-of target "?")
                                         v (http-version version))
                                     (if (= qi -1)
                                       [:ok (string/upper method) target "" v]
                                       [:ok
                                         (string/upper method)
                                         (string/substring target 0 qi)
                                         (string/substring target (+ qi 1) (string/length target))
                                         v])))
      (_ [:error (str "invalid request line: " line)]))))

(defn header-join-sep (k)
  "The separator RFC 7230 §3.2.2 uses to combine a repeated header `k` into one value:
  `; ` for `Cookie` (its own list syntax), `, ` for every other field. `Set-Cookie` is a
  response header, so it never reaches request parsing."
  (if (= k :cookie) "; " ", "))

; Cap on the number of header lines in one request — a backstop (beyond the O(n) coalescing
; below and the byte-size cap) against a request made of an absurd number of distinct headers.
; A real request carries a few dozen; 100 is comfortably clear of legitimate traffic.
(def *max-header-count* 100)

(defn join-header-values (k values)
  "Combine a header's gathered values (in wire order) into one string. `Content-Length`
  keeps the first token — identical duplicates collapse (a *differing* duplicate is
  rejected by `content-length-conflict?`); every other field is joined once per RFC 7230
  §3.2.2 (`; ` for `Cookie`, `, ` otherwise)."
  (if (= k :content-length)
    (first values)
    (string/join (header-join-sep k) values)))

(defn parse-headers (lines)
  "Parse a list of raw header lines into a keyword→string map. Splits on the first
  `:` and trims the value, so the space after the colon is optional (`Host:localhost`
  is valid HTTP and must not be dropped). A header repeated across lines is combined
  into a single comma-separated value (RFC 7230 §3.2.2) — `; `-separated for `Cookie` —
  rather than last-wins, so multi-valued `X-Forwarded-For`/`Forwarded`/`Via` survive.

  Values are gathered per key and `join`ed ONCE, so a field repeated N times is O(N),
  not the O(N²) of a per-line `(str acc v)` fold — that quadratic was a repeated-header
  CPU-exhaustion vector (bounded only by the byte cap, i.e. minutes of CPU per request)."
  (let (grouped (fold (fn (m line)
                        (let (ci (index-of line ":"))
                          (if (= ci -1)
                            m
                            (let (k (keyword (string/lower (string/trim (string/substring line 0 ci))))
                                  v (string/trim (string/substring line
                                                   (+ ci 1)
                                                   (string/length line))))
                              (assoc m k (cons v (get m k (list))))))))
                  {}
                  lines))
    (fold (fn (m kv)
            (assoc m (first kv) (join-header-values (first kv) (reverse (first (rest kv))))))
      {}
      (map-pairs grouped))))
