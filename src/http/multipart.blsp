(defmodule http/multipart
  "Parser for `multipart/form-data` request bodies — file uploads (RFC 7578). Given the raw
  body `bytes` and the boundary from the Content-Type, `parse` splits the body on the
  boundary, reads each part's headers, and returns:

    {:fields {name → string}
     :files  {name → {:filename … :content-type … :bytes <raw bytes>}}}

  A part with a `filename` in its Content-Disposition is a file (its content is kept as raw
  `bytes`, so a handler can `spit-bytes` it to disk or hash it); a part without one is a text
  field (decoded to a string, like a form field). Parsing is done entirely on `bytes` so
  binary content is never UTF-8-mangled.")

; The part header/body separator and a reusable CRLF, as bytes.
(def sep-bytes (string->utf8-bytes "\r\n\r\n"))

(defn parse (body boundary)
  "Parse `body` (bytes) as multipart/form-data delimited by `boundary`. Returns
  `{:fields … :files …}` (see the module doc). A nil/blank boundary, or a body with no
  boundary in it, yields empty maps."
  (if (or (nil? boundary) (blank? boundary))
    {:fields {} :files {}}
    (let (delim (string->utf8-bytes (str "--" boundary))
          parts (filter (fn (p) (not (nil? p))) (map parse-part (split-parts body delim))))
      (fold add-part {:fields {} :files {}} parts))))

; ---- splitting on the boundary ----

(defn split-parts (body delim)
  "The raw byte-segments between successive boundary delimiters. A real delimiter is
  `CRLF + \"--\" + boundary` (RFC 7578/2046); the first may sit at the body start (or after a
  preamble). We find the first `--boundary`, then split on the CRLF-anchored `\r\n-boundary`,
  so a bare `--boundary` occurring inside a part's binary content is not mistaken for a
  delimiter. The preamble and the closing `--boundary--` are naturally excluded."
  (let (first-at (bytes-index-of body delim 0))
    (if (< first-at 0)
      (list)
      (let (crlf-delim (bytes-concat (string->utf8-bytes "\r\n") delim))
        (split-parts-loop body crlf-delim (+ first-at (byte-length delim)) (list))))))

(defn- split-parts-loop
  (body crlf-delim pos acc)
  (let (next-at (bytes-index-of body crlf-delim pos))
    (if (< next-at 0)
      (reverse acc)
      (split-parts-loop body
        crlf-delim
        (+ next-at (byte-length crlf-delim))
        (cons (subbytes body pos next-at) acc)))))

; ---- one part ----

(defn crlf-at? (b i)
  "True if bytes `i`,`i+1` of `b` are CR,LF."
  (and (>= i 0)
    (>= (byte-length b) (+ i 2))
    (= (byte-at b i) 13)
    (= (byte-at b (+ i 1)) 10)))

(defn part-trim (seg)
  "Strip the CRLF that follows the opening boundary line, leaving just the part (headers +
  body). The CRLF that precedes the next delimiter is already excluded from `seg` — it belongs
  to the `\r\n-boundary` split delimiter — so only the leading CRLF is removed here."
  (let (n (byte-length seg)
        start (if (crlf-at? seg 0) 2 0))
    (if (>= start n) (subbytes seg 0 0) (subbytes seg start n))))

(defn parse-part (seg)
  "Parse one boundary-delimited segment into `{:name :filename :content-type :bytes}`, or nil
  if it has no header/body separator (a malformed or empty part)."
  (let (part (part-trim seg)
        at (bytes-index-of part sep-bytes 0))
    (if (< at 0)
      nil
      (let (hdrs (parse-part-headers (utf8-bytes->string (subbytes part 0 at)))
            content (subbytes part (+ at 4) (byte-length part))
            disp (get hdrs "content-disposition" ""))
        {:name (cd-param disp "name")
         :filename (cd-param disp "filename")
         :content-type (get hdrs "content-type")
         :bytes content}))))

(defn parse-part-headers (s)
  "A part's header block → `lowercased-name → value` map. Parts don't repeat headers, so
  last-wins is fine."
  (fold (fn (m line)
          (let (ci (index-of line ":"))
            (if (= ci -1)
              m
              (assoc m
                (lower (trim (substring line 0 ci)))
                  (trim (substring line (+ ci 1) (string-length line)))))))
    {}
    (filter (fn (l) (not (blank? l))) (string-split s "\r\n"))))

(defn cd-param (disposition key)
  "The quoted value of a Content-Disposition parameter — `name` / `filename` — i.e. the text
  between the quotes after `key=\"`. nil if the parameter isn't present. The match must start
  a parameter (not be preceded by a name char), so `cd-param disp \"name\"` on a part with only
  `filename=\"…\"` does not match the `name=\"` *inside* `filename=\"` and mis-file it."
  (let (needle (str key "=\"")
        i (cd-param-find disposition needle 0))
    (if (< i 0)
      nil
      (let (start (+ i (string-length needle))
            end (index-of-from disposition "\"" start))
        (if (= end -1) nil (substring disposition start end))))))

(defn param-name-char? (c)
  "True for a Content-Disposition parameter-name character (letter/digit/`-`) — used to tell a
  real parameter start from `name` appearing inside a longer token like `filename`."
  (let (cp (char->int c))
    (or (and (>= cp 65) (<= cp 90))
      (and (>= cp 97) (<= cp 122))
      (and (>= cp 48) (<= cp 57))
      (= cp 45))))

(defn- cd-param-find
  (s needle from)
  "Index of `needle` in `s` at/after `from` where it starts a parameter — i.e. at the string
  start or preceded by a non-name char (so `name=\"` inside `filename=\"` is skipped) — or -1."
  (let (i (index-of-from s needle from))
    (cond
      (< i 0) -1
      (or (= i 0) (not (param-name-char? (char-at s (- i 1))))) i
      else (cd-param-find s needle (+ i 1)))))

(defn index-of-from (s needle from)
  "Index of `needle` in `s` at or after `from`, or -1."
  (let (i (index-of (substring s from (string-length s)) needle))
    (if (= i -1) -1 (+ from i))))

(defn add-part (acc part)
  "Route a parsed part into `:fields` (no filename → a text field, decoded to a string) or
  `:files` (has filename → keep raw bytes). A nameless part is dropped."
  (let (name (get part :name))
    (cond
      (nil? name) acc
      (nil? (get part :filename)) (assoc-in acc [:fields name] (part-text (get part :bytes)))
      else
        (assoc-in acc
          [:files name]
          {:filename (get part :filename)
           :content-type (get part :content-type)
           :bytes (get part :bytes)}))))

(defn part-text (b)
  "Decode a text field's bytes to a string, safely (a field is text; fall back to empty on
  the pathological case of invalid UTF-8 rather than failing the whole parse)."
  (try (utf8-bytes->string b) (catch _e "")))
