(defmodule http/util
  "HTTP utility functions: URL decoding, query-string + body parsing, status codes.")

;; ---- hex helpers ----

(defn hex-char->int (c)
  "Convert a single hex digit character to its integer value (0–15)."
  (let (code (string/char->int c))
    (cond
      (and (>= code 48) (<= code 57)) (- code 48)
      (and (>= code 65) (<= code 70)) (- code 55)
      (and (>= code 97) (<= code 102)) (- code 87)
      else 0)))

(defn hex-str->bytes (hex)
  "Convert a lowercase hex string (e.g. \"deadbeef\") to a list of byte ints."
  (map (partition (string/->list hex) 2)
    (fn (pair) (+ (* (hex-char->int (first pair)) 16) (hex-char->int (first (rest pair)))))))

;; ---- URL decode ----

(defn url-decode (s)
  "Percent-decode a URL-encoded string, correctly handling multi-byte UTF-8 sequences.

  (hatch/http/util/url-decode \"a%20b%2Bc\") ;=> \"a b+c\"

  A `%`-escape can decode to an invalid UTF-8 byte sequence (`%ff`, `%c0`, `%e0%80`, …),
  on which `utf8-bytes->string` throws — and `parse-query` runs this on every request's
  query outside any try, so an unguarded throw crashes the worker with no response (a
  trivially scriptable DoS). Catch it and fall back to the raw input rather than crash."
  (try
    (string/bytes-> (vec (reverse (url-decode-acc (string/->list s) nil))))
    (catch _e s)))

(defn- url-decode-acc (chars acc)
  (match chars
    (nil acc)
    (("%" h l & rest) (url-decode-acc rest
                        (cons (+ (* (hex-char->int h) 16) (hex-char->int l)) acc)))
    (("+" & rest) (url-decode-acc rest (cons 32 acc)))
    ((c & rest) (let (cp (string/char->int c))
                  (if (< cp 128)
                    (url-decode-acc rest (cons cp acc))
                    (url-decode-acc rest
                      (fold (seq (string/->bytes c)) acc (fn (a b) (cons b a)))))))))

;; ---- query-string parser ----

(defn parse-query (s)
  "Parse a URL query string (\"key=val&key2=val2\") into a string→string map.

  (hatch/http/util/parse-query \"a=1&b=two\") ;=> {\"a\" \"1\" \"b\" \"two\"}"
  (if (or (nil? s) (string/blank? s))
    {}
    (fold (string/split s "&")
      {}
      (fn (m pair)
        (let (eq (index-of pair "="))
          (if (= eq -1)
            (assoc m (url-decode pair) "")
            (assoc m
              (url-decode (string/substring pair 0 eq))
                (url-decode (string/substring pair (+ eq 1) (string/length pair))))))))))

;; ---- carrier <-> bytes (byte-faithful request bodies) ----
; The server reads connections in binary mode and accumulates the request as a *carrier*
; string — one codepoint (0-255) per wire byte — so the text-based request parser stays
; byte-correct while the body survives intact (a binary upload isn't UTF-8-lossily mangled).
; These recover the real bytes / decoded text of the parsed body at the conn boundary.

(defn carrier->bytes (carrier)
  "Convert a byte-faithful carrier string (one codepoint 0-255 per byte) to a `bytes` value —
  the inverse of websocket/bytes->carrier. Recovers the raw request-body bytes (e.g. a file
  upload) from the parsed carrier body."
  (bytes (map (string/->list carrier) string/char->int)))

(defn carrier->text (carrier)
  "Decode a carrier string's bytes as UTF-8 text, falling back to the carrier itself if the
  bytes aren't valid UTF-8 (a binary body — which text handlers don't read anyway)."
  (try (string/bytes-> (carrier->bytes carrier)) (catch _e carrier)))

;; ---- request body parser ----

(defn content-type-base (headers)
  "The request's media type, lowercased and without parameters — `application/json`
  from `Application/JSON; charset=utf-8`. Empty string when no Content-Type is set."
  (let (ct (get headers :content-type))
    (if (nil? ct)
      ""
      (string/lower (string/trim (first (string/split ct ";")))))))

(defn content-type-param (headers key)
  "The value of a Content-Type parameter — e.g. `(content-type-param headers \"boundary\")`
  from `multipart/form-data; boundary=abc`. Case-insensitive on the parameter name; a quoted
  value is unquoted. nil when the header or parameter is absent."
  (let (ct (get headers :content-type))
    (if (nil? ct)
      nil
      (ct-param-find (rest (string/split ct ";")) (string/lower key)))))

(defn- ct-param-find (parts key)
  (if (empty? parts)
    nil
    (let (p (string/trim (first parts))
          eq (index-of p "="))
      (if (and (not (= eq -1)) (= (string/lower (string/trim (string/substring p 0 eq))) key))
        (ct-param-unquote (string/trim (string/substring p (+ eq 1) (string/length p))))
        (ct-param-find (rest parts) key)))))

(defn- ct-param-unquote (v)
  (if (and (>= (string/length v) 2) (string/starts-with? v "\"") (string/ends-with? v "\""))
    (string/substring v 1 (- (string/length v) 1))
    v))

(defn parse-body-params (headers body)
  "Parse a request `body` into a string→value params map based on its Content-Type:
  `application/x-www-form-urlencoded` is parsed like a query string, `application/json`
  yields the top-level object's fields (keys stringified to match query/form params).
  Any other type — or an empty/malformed body — yields `{}`; the raw bytes stay on the
  conn as `:body`. multipart/form-data is not parsed yet (file uploads, Tier 2)."
  (if (string/blank? body)
    {}
    (let (ct (content-type-base headers))
      (cond
        (= ct "application/x-www-form-urlencoded") (parse-query body)
        (= ct "application/json") (json-body-params body)
        else {}))))

(defn json-body-params (body)
  "Params from a JSON request `body`. Only a top-level JSON object contributes params; its
  keys are stringified — deeply, including nested objects — so the result reads like query/
  form params throughout (json-parse yields keyword keys). A non-object body or a parse error
  yields `{}` (a malformed body is ignored, not fatal)."
  (try
    (let (parsed (json/decode body))
      (if (map? parsed) (stringify-keys parsed) {}))
    (catch _e {})))

(defn stringify-keys (v)
  "Recursively replace every map key with its string name, descending through map values
  and vectors — so a parsed JSON body is string-keyed all the way down."
  (cond
    (map? v)
      (fold (%map-pairs v)
        {}
        (fn (m kv) (assoc m (->string (first kv)) (stringify-keys (first (rest kv))))))
    (vector? v) (mapv v stringify-keys)
    else v))

;; ---- status codes ----

(defn status-text (code)
  "Return the HTTP reason phrase for a numeric status code.

  (hatch/http/util/status-text 404) ;=> \"Not Found\""
  (match code
    (100 "Continue")
    (101 "Switching Protocols")
    (200 "OK")
    (201 "Created")
    (202 "Accepted")
    (204 "No Content")
    (206 "Partial Content")
    (301 "Moved Permanently")
    (302 "Found")
    (303 "See Other")
    (304 "Not Modified")
    (307 "Temporary Redirect")
    (308 "Permanent Redirect")
    (400 "Bad Request")
    (401 "Unauthorized")
    (403 "Forbidden")
    (404 "Not Found")
    (405 "Method Not Allowed")
    (406 "Not Acceptable")
    (408 "Request Timeout")
    (409 "Conflict")
    (410 "Gone")
    (411 "Length Required")
    (412 "Precondition Failed")
    (413 "Payload Too Large")
    (414 "URI Too Long")
    (415 "Unsupported Media Type")
    (416 "Range Not Satisfiable")
    (422 "Unprocessable Entity")
    (428 "Precondition Required")
    (429 "Too Many Requests")
    (431 "Request Header Fields Too Large")
    (451 "Unavailable For Legal Reasons")
    (500 "Internal Server Error")
    (501 "Not Implemented")
    (502 "Bad Gateway")
    (503 "Service Unavailable")
    (504 "Gateway Timeout")
    (505 "HTTP Version Not Supported")
    (_ "Unknown")))
