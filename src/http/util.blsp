(defmodule http/util
  "HTTP utility functions: URL decoding, query-string parsing, Content-Type and
  Accept-Encoding reading.")

;; ---- hex helpers ----

; The exact set `string/trim` strips — codepoints 9, 10, 13 and 32 — established by probing
; all 256 single-byte codepoints, not assumed. `trim-if-needed` is only correct while this
; matches: a character `string/trim` strips but this set omits would be silently left in place.
(def *trim-chars* " \t\r\n")

(defn trim-if-needed (s)
  "`string/trim`, but only paying for it when there is something to trim.

  `string/trim` costs 3.15us whether or not it finds anything, because the cost is per CALL
  rather than per byte — and it is called twice per HEADER and twice per COOKIE on every
  request, where the overwhelming majority of values have no surrounding whitespace at all.
  Two `string/span` probes answer \"is there any?\" in about 0.7us, and the real `string/trim`
  still runs whenever the answer is yes, so the result is identical either way.

  (hatch/http/util/trim-if-needed \"  a b  \") ;=> \"a b\""
  (let (n (string/length s))
    (if (= n 0)
      s
      (let (start (string/span s 0 *trim-chars*))
        (cond
          ;; all whitespace
          (= start n) ""
          ;; the last char is not whitespace (the first char IN the set at or after the last
          ;; index is past the end), so only the leading run needs removing — and `start`
          ;; already says where it ends. `s` unchanged when there was no leading run either.
          (= (string/span-until s (- n 1) *trim-chars*) n)
            (if (= start 0) s (string/substring s start n))
          ;; trailing whitespace is rare enough not to be worth a backwards scan of its own
          else (string/trim s))))))

(defn hex-char->int (c)
  "Convert a single hex digit character to its integer value (0–15)."
  (let (code (string/char->int c))
    (cond
      (and (>= code 48) (<= code 57)) (- code 48)
      (and (>= code 65) (<= code 70)) (- code 55)
      (and (>= code 97) (<= code 102)) (- code 87)
      else 0)))

;; ---- URL decode ----

(defn url-decode (s)
  "Percent-decode a URL-encoded string, correctly handling multi-byte UTF-8 sequences.

  (hatch/http/util/url-decode \"a%20b%2Bc\") ;=> \"a b+c\"

  A `%`-escape can decode to an invalid UTF-8 byte sequence (`%ff`, `%c0`, `%e0%80`, …),
  on which `utf8-bytes->string` throws — and `parse-query` runs this on every request's
  query outside any try, so an unguarded throw crashes the worker with no response (a
  trivially scriptable DoS). Catch it and fall back to the raw input rather than crash.

  A string with no `%` and no `+` decodes to ITSELF, and almost every one is: a path segment
  like `hatch` or `packages`, an ordinary query value. The decoder walks character by
  character over a list of one-character strings, then reverses, vectorises and re-encodes —
  13.6us for a five-character segment, paid per path param, per query param and per segment of
  a splat route, on every request. One `string/span-until` says whether any of that is needed.

  Provably the same answer: with no `%` and no `+`, every branch of `url-decode-acc` copies the
  character's own bytes through unchanged, so the reassembled string is the input."
  (if (= (string/span-until s 0 "%+") (string/length s))
    s
    (try
      (string/bytes-> (vec (reverse (url-decode-acc (string/->list s) nil))))
      (catch _e s))))

(defn- url-decode-acc (chars acc)
  (match chars
    (nil acc)
    (("%" h l & rest) (url-decode-acc rest
                        (cons (+ (* (hex-char->int h) 16) (hex-char->int l)) acc)))
    (("+" & rest) (url-decode-acc rest (cons 32 acc)))
    ((c & rest) (let (cp (string/char->int c))
                  (if (< cp 128)
                    (url-decode-acc rest (cons cp acc))
                    (url-decode-acc rest
                      (fold (seq (string/->bytes c)) acc (fn (a b) (cons b a)))))))))

;; ---- query-string parser ----

(defn parse-query (s)
  "Parse a URL query string (\"key=val&key2=val2\") into a string→string map.

  (hatch/http/util/parse-query \"a=1&b=two\") ;=> {\"a\" \"1\" \"b\" \"two\"}"
  (if (or (nil? s) (string/blank? s))
    {}
    (fold (string/split s "&")
      {}
      (fn (m pair)
        (let (eq (index-of pair "="))
          (if (= eq -1)
            (assoc m (url-decode pair) "")
            (assoc m
              (url-decode (string/substring pair 0 eq))
                (url-decode (string/substring pair (+ eq 1) (string/length pair))))))))))

(defn crlf-at? (b i)
  "True if the two bytes at index `i` of `b` are CR LF. False — not an error — when `i` or
  `i+1` is out of bounds.

  `http/request` and `http/multipart` each had one of these, under the same name and with
  DIFFERENT contracts: multipart's bounds-checked, request's assumed the caller had already
  proved `i+1` was in range. Two functions with one name and different preconditions is worse
  than either alone — a reader who learns the checked one and calls the other reads off the
  end of the buffer. The checked contract wins because it is the safe one to be wrong about,
  and the two comparisons it costs are per chunk boundary, not per byte."
  (and (>= i 0)
    (>= (bytes/length b) (+ i 2))
    (= (bytes/at b i) 13)
    (= (bytes/at b (+ i 1)) 10)))
(sig crlf-at? (bytes int -> bool))

;; ---- request body parser ----

(defn content-type-base (headers)
  "The request's media type, lowercased and without parameters — `application/json`
  from `Application/JSON; charset=utf-8`. Empty string when no Content-Type is set."
  (let (ct (get headers :content-type))
    (if (nil? ct)
      ""
      (string/lower (string/trim (first (string/split ct ";")))))))

(defn content-type-param (headers key)
  "The value of a Content-Type parameter — e.g. `(content-type-param headers \"boundary\")`
  from `multipart/form-data; boundary=abc`. Case-insensitive on the parameter name; a quoted
  value is unquoted. nil when the header or parameter is absent."
  (let (ct (get headers :content-type))
    (if (nil? ct)
      nil
      (ct-param-find (rest (string/split ct ";")) (string/lower key)))))

(defn- ct-param-find (parts key)
  (if (empty? parts)
    nil
    (let (p (string/trim (first parts))
          eq (index-of p "="))
      (if (and (not (= eq -1)) (= (string/lower (string/trim (string/substring p 0 eq))) key))
        (ct-param-unquote (string/trim (string/substring p (+ eq 1) (string/length p))))
        (ct-param-find (rest parts) key)))))

(defn- ct-param-unquote (v)
  (if (and (>= (string/length v) 2) (string/starts-with? v "\"") (string/ends-with? v "\""))
    (string/substring v 1 (- (string/length v) 1))
    v))

;; ---- content coding ----

; Accept-Encoding negotiation lives here, one layer below every module that asks, because
; three of them do — `web/compress` (compress this response?), `web/static` (serve the
; precompressed `.gz`/`.br` sibling?) and `web/stream` (gzip this event stream?). They had a
; predicate each, and only compress's honoured `q=0`: the same request therefore got
; "not acceptable" from one layer and a `Content-Encoding: gzip` body from the other two.
; A client that spells out `gzip;q=0` is usually one that cannot decode gzip, so the
; disagreement was not a missed optimisation but a body it could not read.

(defn- coding-refused? (accept-encoding coding)
  "True when `accept-encoding` lists `coding` with an explicit `q=0` weight — an RFC 9110
  §12.5.3 refusal (`gzip;q=0`, `br;q=0.0`, with optional whitespace). A *positive* weight,
  however small (`q=0.001`), is not a refusal and is not matched.

  A client that goes to the trouble of saying `q=0` means it, and it is usually saying so
  for a reason — a proxy that mangles a coding, or a debugging session.

  Almost nobody does. `Accept-Encoding: gzip, deflate, br` is what browsers send, and the scan
  below rewrites and lowercases every entry of the header to find something that is not there
  — on every response. Every refusal this looks for (`=0`, `=0.0`, `=0.00`, `=0.000`) contains
  the character `0`, so a header with no `0` anywhere cannot hold one, and `includes?` settles
  that in 0.7us against ~9us for the scan. Deliberately looser than the thing being tested
  for: a header carrying any digit zero (`q=0.9`, say) falls through to the full pass."
  (and (includes? accept-encoding "0")
    (any? (string/split accept-encoding ",")
      (fn (entry)
        (let (bare (string/lower (string/replace entry " " "")))
          (any? ["=0" "=0.0" "=0.00" "=0.000"]
            (fn (zero) (= bare (str coding ";q" zero)))))))))

(defn accepts-encoding? (accept-encoding coding)
  "True if the `Accept-Encoding` header value offers `coding` and does not refuse it with an
  explicit `q=0` weight. A missing header (nil) means no compression.

  The `q=0` check is what separates this from a substring test. A client sending
  `gzip;q=0` is asking NOT to be gzipped, and a substring test reads that as a yes — which
  inverts the client's request rather than merely missing an optimisation.

  (http/util/accepts-encoding? \"gzip, deflate, br\" \"gzip\") ;=> true
  (http/util/accepts-encoding? \"gzip;q=0\" \"gzip\") ;=> false
  (http/util/accepts-encoding? \"gzip;q=0.001\" \"gzip\") ;=> true
  (http/util/accepts-encoding? nil \"gzip\") ;=> false"
  (and (string? accept-encoding)
    (includes? accept-encoding coding)
    (not (coding-refused? accept-encoding coding))))

(defn stringify-keys (v)
  "Recursively replace every map key with its string name, descending through map values
  and vectors — so a parsed JSON body is string-keyed all the way down."
  (cond
    (map? v)
      (fold (%map-pairs v)
        {}
        (fn (m kv) (assoc m (->string (first kv)) (stringify-keys (first (rest kv))))))
    (vector? v) (mapv v stringify-keys)
    else v))

;; The result is as wide as the input, which no signature can say. Left to derive it, the
;; checker spells "a decoded JSON leaf" out as every tag but map and vector — failure among
;; them — so each truthiness test on a field read from a request body or a session reads as
;; testing a possible failure. `any` is the honest claim: it is whatever came in.
(sig stringify-keys (any -> any))
