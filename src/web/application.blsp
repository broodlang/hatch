(defmodule web/application
  "Application startup helper for Hatch web apps.

  Provides two things every Hatch `main` needs:

  - `default-logger-opts` — builds a logger config from the standard
    `$LOG_LEVEL` / `$LOG_FORMAT` / `$NO_COLOR` env vars so apps don't
    have to write that boilerplate themselves.
  - `start config` — the canonical entry point: starts the logger, runs
    each child thunk in order, then parks the main process.

  Typical main:

    (defn main ()
      (web/application/start
        {:logger   (web/application/default-logger-opts)
         :children [(fn () (db/start (pg/opts-from-env \"my_app\")))
                    (fn () (serve))]}))"
  (:use log :only [start-logger fn-backend])
  (:alias web/logger)
  (:alias web/upload)
  (:use json :only [json-encode]))

;; ---- log formatters ---------------------------------------------------------

(def- application-labels {:debug "DEBUG" :info "INFO" :warn "WARN" :error "ERROR"})
(def- application-lower {:debug "debug" :info "info" :warn "warn" :error "error"})
(def- application-colors {:debug "\x1b[90m" :info "\x1b[36m" :warn "\x1b[33m" :error "\x1b[31m"})
(def- application-reset "\x1b[0m")

(defn- application-line-body
  (rec)
  (str "[" (or (get application-labels (get rec :level)) "?") "] " (get rec :msg)))

(defn- application-text-line
  (rec)
  (str (application-line-body rec) "\n"))

(defn- application-color-line
  (rec)
  (str (or (get application-colors (get rec :level)) "")
    (application-line-body rec)
    application-reset
    "\n"))

(defn- application-json-line
  (rec)
  "One NDJSON object per record — compatible with Grafana Loki, Datadog, AppSignal."
  (str (json-encode (merge (get rec :meta)
                      {:timestamp (get rec :ts)
                       :level (or (get application-lower (get rec :level)) "info")
                       :message (get rec :msg)}))
    "\n"))

;; ---- public API -------------------------------------------------------------

(defn valid-level (raw)
  "The log level keyword for `$LOG_LEVEL` value `raw`, validated against the known set
  (`:debug`/`:info`/`:warn`/`:error`). An unrecognized value (e.g. a typo like `infoo`) falls
  back to `:debug` rather than becoming an unknown keyword the logger backend would choke on
  (silently dropping every line). `nil`/unset → `:debug`."
  (let (lvl (keyword (or raw "debug")))
    (if (contains? application-labels lvl) lvl :debug)))

(defn default-logger-opts ()
  "Logger opts derived from env vars:
  - `$LOG_LEVEL`  — `:debug` / `:info` / `:warn` / `:error` (default `:debug`; an
                    unrecognized value falls back to `:debug`, see `valid-level`)
  - `$LOG_FORMAT` — `\"json\"` for NDJSON (log shippers), else colored text
  - `$NO_COLOR`   — set to disable ANSI colors (the no-color.org convention)"
  (let (fmt (cond
              (= (getenv "LOG_FORMAT") "json") application-json-line
              (nil? (getenv "NO_COLOR")) application-color-line
              else application-text-line))
    {:level (valid-level (getenv "LOG_LEVEL"))
     :backends [(fn-backend (fn (line) (print line)) {:format fmt})]}))

(defn start (config)
  "Boot a Hatch application from `config` and park the main process.

  `:logger`     — opts map passed directly to `start-logger`; use
                  `default-logger-opts` for env-driven defaults. Omit to
                  skip logger startup (e.g. when using a custom logger).
  `:access-log` — `true` to log one line per request (via `web/logger`), or an
                  opts map passed to `attach-access-log` (`:level`, `:id`, …).
                  Omit/`false` to skip. Starts telemetry if needed.
  `:upload-progress` — `true` to push upload progress to live views (via
                  `web/upload`), or an opts map passed to `attach-progress`.
                  Omit/`false` to skip. Starts telemetry if needed.
  `:children`   — list of zero-arg fns called in order at startup (open DB,
                  boot endpoint, start background workers, …).

  Parks with `(receive (:shutdown nil))` after all children have started."
  (let (logger-opts (get config :logger nil)
        access-log (get config :access-log nil)
        upload-progress (get config :upload-progress nil)
        children (get config :children []))
    (when logger-opts
      (start-logger logger-opts))
    (when access-log
      (web/logger/attach-access-log (if (map? access-log) access-log {})))
    (when upload-progress
      (web/upload/attach-progress (if (map? upload-progress) upload-progress {})))
    (start-children children 0)
    (receive (:shutdown nil))))

(defn start-children (children i)
  "Call each zero-arg child thunk in order. If one raises, abort the boot with an error that
  names which child failed (and why) instead of an opaque stack — a half-started application
  should fail loudly at boot, not park and serve in a broken state."
  (when (not (empty? children))
    (try
      ((first children))
      (catch e
        (error "web/application: child #" i " failed to start: " (error-message e))))
    (start-children (rest children) (+ i 1))))
