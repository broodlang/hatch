; log/info, log/warn, log/error
(defmodule web/assets
  "Build-step-agnostic asset integration. Hatch only ever *serves* `static/`; this
  module is the optional glue that *produces* what goes there by shelling out to an
  external bundler — Tailwind, esbuild, sass, UnoCSS, anything with a CLI.

  Everything is driven by one plain-data config map, so swapping tools is a data edit,
  not a code change. Shape:

    (def *assets*
      {:watchers [{:cmd [\"bin/tailwindcss\" \"-i\" \"assets/app.css\"
                         \"-o\" \"static/app.css\" \"--watch\"]
                   :reload-on \"Done in\"}]   ; a stdout/stderr substring → hot-swap CSS
       :build    [[\"bin/tailwindcss\" \"-i\" \"assets/app.css\"
                  \"-o\" \"static/app.css\" \"--minify\"]]
       :install  [[\"sh\" \"-c\" \"...download the standalone binary...\"]]})

  Three verbs:
    (watch config)   — dev: long-running watchers, output piped to the log; a rebuild
                       nudges open live sessions to hot-swap their stylesheet (no reload)
    (build config)   — release: one-shot builds, fails loudly on a non-zero exit
    (install config) — first-time setup: one-shot install/download commands

  Each watcher map carries a `:cmd` argv and optional `:cwd` (string), `:env` (a
  string->string map), and `:reload-on` (a substring that marks a finished rebuild;
  defaults to \"Done in\", set to nil to never trigger a CSS reload). `:build` and
  `:install` entries are plain argv vectors run one-shot, in order."
  ; notify-reload-css — the hot CSS swap over open sockets
  (:use web/live)
  ; render-manifest — the fingerprint manifest codec lives in web/static
  (:alias web/static)
  (:alias log))

(def *default-reload-marker* "Done in")

; ---- dev watchers ----------------------------------------------------------

(defn watch (config)
  "Start every watcher in `config` (`:watchers`), each as its own green process that
  pipes the bundler's output to the log and, on a finished rebuild, hot-swaps CSS in
  open live sessions. Returns the manager pids; pass them to `stop-watchers` to shut the
  bundler subprocesses down. Call from the endpoint when running in dev — see the module doc."
  (map (fn (w) (spawn (fn () (watcher-loop w)))) (or (get config :watchers) (list))))

(defn stop-watchers (managers)
  "Stop watcher managers started by `watch`: each closes its bundler subprocess and exits, so
  the external `--watch` process doesn't linger. Wire it into the endpoint's shutdown."
  (dolist (m managers) (send m [:stop]))
  nil)

(defn watcher-loop (w)
  "Spawn one watcher child and forward its output until it exits. The child is spawned
  inside this process so its [:proc …] messages land in this mailbox."
  (let (cmd (get w :cmd)
        handle (try
                 (proc/spawn (first cmd) (rest cmd) (proc-opts w))
                 (catch e
                   (do
                     (log/error (str "[assets] cannot start watcher `"
                                  (string/join " " cmd)
                                  "`: "
                                  (error-message e)))
                     nil))))
    (when handle
      (log/info (str "[assets] watching: " (string/join " " cmd)))
      (watcher-recv handle (get w :reload-on *default-reload-marker*) (string/join " " cmd) ""))))

(defn watcher-recv (handle marker label buf)
  "Drain a watcher child's piped stdout/stderr, accumulating a `buf` of the trailing partial
  line across reads: log each COMPLETE line and hot-swap CSS when one contains `marker` (so a
  marker split across two reads isn't missed, and a filename that merely contains it on a
  different line doesn't false-trigger). A `[:stop]` closes the child; on the child's own exit,
  flush the last line, log, and stop (a dead watcher is usually a config error — restart to
  retry)."
  (receive
    ([:proc ^handle data] (watcher-recv handle marker label (on-output (str buf data) marker)))
    ([:proc-err ^handle data] (watcher-recv handle marker label (on-output (str buf data) marker)))
    ([:stop] (do
               (try (proc/close handle) (catch _ nil))
               (log/info (str "[assets] stopped watching: " label))))
    ([:proc-closed ^handle code] (do
                                   (emit-line buf marker)
                                   (log/warn (str "[assets] watcher exited (code "
                                               code "): " label))))))

(defn on-output (buf marker)
  "Log every COMPLETE line in `buf` (up to the last newline), hot-swapping CSS on a line that
  contains `marker`; return the trailing incomplete line (no newline yet) to carry forward."
  (let (lines (string/split buf "\n")
        complete (reverse (rest (reverse lines))))
    (dolist (line complete) (emit-line line marker))
    (first (reverse lines))))

(defn emit-line (line marker)
  "Log one non-blank watcher line under an `[assets]` prefix; if it contains `marker`, hot-swap
  CSS in open live sessions."
  (when (not (string/blank? line))
    (log/info (str "[assets] " line))
    (when (and marker (includes? line marker)) (web/live/notify-reload-css))))

(defn proc-opts (w)
  "The proc/spawn opts map for watcher `w`: `:cwd`/`:env` if present, else empty."
  (let (base (if (get w :cwd) {:cwd (get w :cwd)} {}))
    (if (get w :env) (assoc base :env (get w :env)) base)))

; ---- one-shot build / install ----------------------------------------------

(defn build (config)
  "Run `config`'s `:build` commands one-shot, in order (a release step). Each inherits
  stdio so its output goes straight to the console; a non-zero exit raises, so a broken
  build fails the boot/release loudly rather than shipping stale assets. Then, if
  `:fingerprint` is set, content-fingerprint the built files (see `fingerprint`) so prod
  serves them under immutable, cache-forever URLs."
  (run-each (or (get config :build) (list)) "build")
  (when (get config :fingerprint)
    (log/info "[assets] fingerprinting built assets")
    (fingerprint (get config :fingerprint)))
  nil)

; ---- content fingerprinting (prod cache-busting) ---------------------------
; A release rewrites built assets to content-addressed names (`app.<sha>.css`) and records a
; `logical → fingerprinted` manifest under the static dir. `web/static/asset-path` reads that
; manifest to emit the fingerprinted URL in prod (which `web/static/serve` then marks
; `immutable`), so a content change ships a new URL and the old one stays cached. Dev skips
; all of this — no manifest, plain names, revalidate-each-load.

(defn fingerprint (spec)
  "Content-fingerprint built assets. `spec` is `{:dir <static-dir> :files [<logical-name> …]}`:
  for each file, read it, hash it, write a copy named `base.<sha8>.ext`, and record
  `logical → fingerprinted`. Writes the manifest to `<dir>/cache-manifest` (read by
  `web/static/asset-path`) and returns the manifest map. Handles any asset — binary files
  (fonts, images, wasm) are copied and hashed byte-faithfully (see `fingerprint-file`)."
  (let (dir (get spec :dir "static")
        files (or (get spec :files) (list))
        manifest (fold (fn (m file) (assoc m file (fingerprint-file dir file))) {} files))
    (write-manifest (str dir "/cache-manifest") (static/render-manifest manifest))
    manifest))

(defn write-manifest (path text)
  "Write the fingerprint manifest atomically: `spit` to a temp file, then `rename-file` over
  the target. A rename is atomic on the same filesystem, so a concurrent reader (e.g. a
  live-serving process during a redeploy) sees either the old manifest or the new one — never
  a half-written, truncated file that would mint broken asset URLs."
  (let (tmp (str path ".tmp"))
    (file/spit tmp text)
    (file/rename tmp path)))

(defn fingerprint-file (dir file)
  "Write a content-addressed copy of `dir/file` (`base.<sha8>.ext`) and return its name. Reads
  and writes the raw bytes (`slurp-bytes`/`spit-bytes`) and hashes the bytes, so a binary asset
  (.woff2/.png/.ico/.wasm) is copied byte-faithfully — a UTF-8 `slurp`/`spit` round-trip would
  corrupt it AND change its hash, shipping a broken file under an immutable/cache-forever URL."
  (let (body (file/slurp-bytes (str dir "/" file))
        fp (fingerprint-name file (string/substring (hash/sha256-bytes body) 0 8)))
    (file/spit-bytes (str dir "/" fp) body)
    (log/info (str "[assets] fingerprint: " file " -> " fp))
    (when (compressible? file)
      (precompress (str dir "/" fp)))
    fp))

(defn compressible? (file)
  "True for text assets worth precompressing (CSS/JS/SVG/JSON/…), by MIME. Already-compressed
  binaries (png/woff2/wasm/gz) barely shrink and are skipped."
  (static/text-mime? (static/mime-type file)))

(defn precompress (path)
  "Best-effort: write brotli (`path.br`) and gzip (`path.gz`) copies of `path` so
  `web/static/serve-encoded` can serve a precompressed variant to `Accept-Encoding` clients
  (brotli preferred, ~5-6x smaller CSS/JS). Compresses in-process at the maximum level —
  `zlib/brotli` quality 11 (the `brotli` builtin, RFC 7932 `Content-Encoding: br`) and
  `zlib/gzip` level 9 (the `flate2` builtin) — a one-time build cost paid to shrink a file served
  many times, so the best ratio is the right trade. No external binary is required, so a
  build/boot host without one no longer degrades to uncompressed serving. Overwrites stale
  siblings from a previous build. A read/compress/write failure is logged and skipped, so serving
  still works uncompressed."
  (let (raw (try (file/slurp-bytes path) (catch e :error)))
    (if (= raw :error)
      (log/warn (str "[assets] precompress could not read " path "; serving uncompressed"))
      (do
        (precompress-variant (str path ".br") (fn () (zlib/brotli raw 11)) path)
        (precompress-variant (str path ".gz") (fn () (zlib/gzip raw 9)) path)))))

(defn precompress-variant (out encode path)
  "Write one precompressed sibling `out` from `(encode)`, logging + skipping on failure so one
  coding's problem never blocks the other or breaks serving."
  (try
    (do
      (file/spit-bytes out (encode))
      (log/info (str "[assets] precompress: " out)))
    (catch e
      (log/warn (str "[assets] precompress failed for "
                  path
                  " -> "
                  out
                  " ("
                  (error-message e)
                  "); serving that coding uncompressed")))))

(defn fingerprint-name (file digest)
  "Insert `digest` before the extension: `app.css` → `app.<digest>.css` (no extension →
  append `.<digest>`)."
  (let (parts (string/split file "."))
    (if (< (count parts) 2)
      (str file "." digest)
      (let (ext (first (reverse parts))
            base (string/join "." (reverse (rest (reverse parts)))))
        (str base "." digest "." ext)))))

(defn install (config)
  "Run `config`'s `:install` commands one-shot, in order — first-time setup, e.g.
  downloading a standalone bundler binary. Same fail-loud semantics as `build`."
  (run-each (or (get config :install) (list)) "install"))

; ---- dev one-call: make assets ready, then watch ---------------------------

(defn ensure (config)
  "Dev convenience — the single call an endpoint makes in dev so styles just work on
  `nest run`, no manual setup step. In order:

    1. If `:install-probe` (a path, e.g. the bundler binary) is given and missing, run
       `:install` — the first-time toolchain download (`bin/setup`). Skipped once the
       probe exists, so it's a one-time cost, not every boot.
    2. Run `:build` once, so `static/` is populated *before* the server takes its first
       request — no 404 window while the watcher's first rebuild is still in flight.
    3. Start the `:watchers` for live rebuilds.

  Steps 1–2 are best-effort: if they fail (offline, no toolchain), log a clear warning
  and still start watching + serving, so a missing download degrades to 'no styles yet'
  rather than a server that won't boot. Release builds should call `build` directly
  (fail-loud), not this."
  (try
    (do
      (when (and (get config :install-probe)
              (not (file/exists? (get config :install-probe))))
        (log/info (str "[assets] toolchain missing ("
                    (get config :install-probe)
                    ") — running one-time install"))
        (install config))
      (build config))
    (catch e
      (log/warn (str "[assets] could not prepare assets ("
                  (error-message e)
                  "); serving without a fresh build — styles may be missing until the watcher rebuilds"))))
  (watch config))

(defn run-each (cmds label)
  "Run each argv in `cmds` with `os/run-process` (inherited stdio), in order; raise on the
  first non-zero exit."
  (dolist (cmd cmds)
    (log/info (str "[assets] " label ": " (string/join " " cmd)))
    (let (code (os/run-process (first cmd) (rest cmd)))
      (when (not (= code 0))
        (error "[assets] " label " failed (exit " code "): " (string/join " " cmd)))))
  nil)
