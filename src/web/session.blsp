(defmodule web/session
  "Signed cookie sessions and flash messages — Hatch's stateless session store, à la
  Phoenix's default `Plug.Session` cookie store. The whole session map is serialized to
  JSON, base64url-encoded, and HMAC-SHA256 signed into a single cookie: no server-side
  store, so it survives restarts and scales across nodes. The signature is *authentication*,
  not secrecy — the payload is readable by the client, so don't put secrets in it; it can't
  be forged or tampered with without the secret. (An encrypted variant is a small follow-up:
  the crypto stdlib already has ChaCha20-Poly1305.)

  Wire two plugs into a `through` group, session first:

    (def secret (session/secret-from-env))   ; strong prod secret, or a loud boot failure
    (through [(session/fetch-session (cookie-store secret {})) session/fetch-flash]
      (get  \"/login\"  login/form)
      (post \"/login\"  login/create))

  Then handlers use get/put-session and get/put-flash on the conn; the (possibly mutated)
  session is re-signed into a Set-Cookie before the response is sent — but only if it
  changed, so plain GETs don't churn the cookie.

  ## Where a session lives — the `SessionStore` seam

  The signed cookie is the default because it is the right first reach: no server-side state
  to run, sweep, replicate or lose, so it survives a restart and costs nothing across
  machines. It buys that with two real limits — the payload is readable by the client unless
  you turn `:encrypt` on, and a cookie already issued cannot be revoked before its `__exp__`.

  When those limits bite, the store is replaceable rather than the module. `fetch-session`
  takes a value implementing `SessionStore` — the built-in one, or someone else's:

      (through [(session/fetch-session (session/cookie-store secret {:encrypt true}))] …)
      (through [(session/fetch-session (my-redis-store pool))] …)

  A store is a value you pass, not a name resolved through configuration, so it carries its
  own pool or connection as fields. See the `SessionStore` ability for the two ops."
  ; get-cookie, put-cookie, register-before-send — the conn plumbing this builds on
  (:use web/conn)
  ; dev? / prod? — the one place $HATCH_ENV is read
  (:alias web/env)
  ; base64-url-encode / base64-url-decode — cookie-safe payload encoding
  (:use encoding)
  ; hmac-sha256 — the cookie signature
  (:use hash)
  ; constant-time-equal? — constant-time signature comparison (no timing oracle);
  ; encrypt/decrypt/random-nonce/pbkdf2 — the sealed cookie format
  (:use crypto)
  ; stringify-keys — one deep keyword→string normalization for every JSON hatch decodes
  (:alias http/util)
  ; table/new — memoising the derived AEAD key, which costs a 600k pbkdf2 to make
  (:alias table))

(def *default-cookie* "_hatch_session")
(def *flash-key* "__flash__")
; The clearly-labeled dev-only signing secret. Used only when $HATCH_ENV is dev (or unset) so
; `nest run` works with zero config; `check-secret` refuses to fall back to it outside dev.
(def *dev-secret* "dev-only-change-me-0000000000000000")
; Minimum acceptable secret length (bytes) outside dev. A short secret is brute-forceable, and
; a forgeable signature means forgeable sessions (auth bypass), so we won't boot on one.
(def *min-secret-len* 32)
; Reserved key carrying the session's absolute expiry (epoch-ms). Stamped into the signed
; payload when `:max-age` is configured, verified on decode, and stripped before the session
; reaches handlers — so a stolen cookie stops verifying as live past its deadline.
(def *exp-key* "__exp__")

; ---- signing secret (fail-loud on a weak prod secret) ----

(defn check-secret (v dev?)
  "The validated session signing secret. A strong secret (≥ `*min-secret-len*` chars) is used
  as-is. In dev a missing or weak `v` falls back to the labeled dev default so local `nest run`
  just works. Outside dev a missing or weak secret raises — signing every session cookie with a
  known/short key makes them forgeable (full auth bypass), so we fail the boot loudly rather
  than ship it. Pure; `secret-from-env` supplies `v`/`dev?` from the environment."
  (cond
    (and v (>= (string/length v) *min-secret-len*)) v
    dev? (or v *dev-secret*)
    (nil? v)
      (error "web/session: HATCH_SECRET_KEY_BASE is not set. Refusing to sign sessions "
        "with a default key outside dev — every cookie would be forgeable. Set a strong " "(>= "
        *min-secret-len* "-char) secret.")
    else
      (error "web/session: HATCH_SECRET_KEY_BASE is too weak (< "
        *min-secret-len* " chars). Refusing to boot outside dev with a brute-forceable signing key.")))

(defn secret-from-env (&optional (var "HATCH_SECRET_KEY_BASE"))
  "The session signing secret, read from `$var` and validated by `check-secret`: a strong
  secret in any environment, the labeled dev default when it's missing/weak in dev, or a loud
  boot failure when it's missing/weak outside dev. Prefer this over a hand-rolled
  `(or (os/env …) \"dev-secret\")` so a forgotten prod secret can't silently ship."
  (check-secret (os/env var) (web/env/dev?)))

; ---- signing / verification ----

(defn encode-session (secret data &optional (opts {}))
  "Serialize session `data` (a map) into a cookie string.

  Signed by default: `payload.signature`, where payload is base64url(JSON) and signature is
  HMAC-SHA256(secret, payload). A signature is AUTHENTICATION — it proves the value came
  from this app and was not altered — but the payload is plain base64 that anyone holding
  the cookie can read.

  With `:encrypt true` the whole session is sealed instead (`ENCRYPTED-PREFIX`), so its
  contents are confidential as well. Use it when a session carries anything the holder of
  the cookie should not be able to READ — a one-shot token in a flash, an email address, a
  role. It costs one AEAD seal per write, and reads are unchanged for cookies that were
  never encrypted, so it can be turned on for a running app."
  (if (get opts :encrypt false)
    (encrypt-session secret data)
    (let (payload (base64-url-encode (json/encode data))
          sig (hmac-sha256 secret payload))
      (str payload "." sig))))

;; Marks a sealed cookie, and the format that produced it. A prefix rather than a flag
;; passed to the reader: a cookie has to say what it is, because both formats are in flight
;; the moment encryption is switched on for an app whose users hold signed cookies already.
(def *encrypted-prefix* "E1.")

(defn encrypt-session (secret data)
  "Seal `data` into `E1.<nonce>.<ciphertext>`, both base64url.

  ChaCha20-Poly1305, which authenticates as well as encrypts — so a sealed cookie needs no
  separate HMAC; a tampered one fails to open. The nonce is fresh per write, which is what
  the construction requires: reusing one under the same key would leak the relationship
  between two sessions."
  (let (nonce (random-nonce)
        sealed (encrypt (session-key secret) nonce (string/->bytes (json/encode data))))
    (str *encrypted-prefix*
      (base64-url-encode-bytes nonce)
      "."
      (base64-url-encode-bytes sealed))))

(defn decrypt-session (secret cookie)
  "Open a sealed cookie, or `{}` if it does not open — a bad cookie reads as an empty
  session, exactly as a bad signature does."
  (let (rest-of (string/substring cookie
                  (string/length *encrypted-prefix*)
                  (string/length cookie))
        dot (index-of rest-of "."))
    (if (< dot 0)
      {}
      ;; `bytes?` at each step, not truthiness. Neither of these reports failure by
      ;; raising or by answering nil: `base64-url-decode-bytes` answers a FAILURE value,
      ;; which is truthy, and `decrypt` answers the keyword `:error` when the tag does not
      ;; verify — which is exactly what a tampered cookie produces. Checking the type is
      ;; what makes a bad cookie read as an empty session instead of raising out of a plug.
      (let (nonce (base64-url-decode-bytes (string/substring rest-of 0 dot))
            sealed (base64-url-decode-bytes (string/substring rest-of
                                              (+ dot 1)
                                              (string/length rest-of)))
            opened (when (and (bytes? nonce) (bytes? sealed))
                     (decrypt (session-key secret) nonce sealed)))
        (if (not (bytes? opened))
          {}
          (check-expiry (decode-json (string/bytes-> opened))))))))

;; The 32-byte key a session is sealed with, derived from the signing secret so an app needs
;; no second secret to turn encryption on. MEMOISED: the derivation is a 600k-iteration
;; pbkdf2, which is the right cost to pay once at first use and absurd to pay per request.
;; Keyed by the secret, so a test using several secrets gets a key for each.
(def- *session-keys* (table/new))

(defn session-key (secret)
  "The AEAD key for `secret`, derived once and remembered."
  (if (table/has? *session-keys* secret)
    (table/get *session-keys* secret)
    (let (key (pbkdf2 secret "hatch/web/session/encrypt" 600000 32))
      (table/put *session-keys* secret key)
      key)))

(defn decode-session (secret cookie)
  "Verify and decode a session `cookie` back into a string-keyed map. Returns `{}` for an
  absent, malformed, or tampered cookie — a bad cookie reads as an empty session, never an
  error. base64url has no `.`, so the final `.` cleanly splits payload from signature.

  Both formats are read, whichever the app currently WRITES. Turning encryption on therefore
  does not sign everyone out: the signed cookies already in browsers keep opening, and each
  is replaced with a sealed one the next time its session changes."
  (cond
    (or (nil? cookie) (string/blank? cookie)) {}
    (string/starts-with? cookie *encrypted-prefix*) (decrypt-session secret cookie)
    else (decode-signed secret cookie)))

(defn- decode-signed (secret cookie)
  (if (or (nil? cookie) (string/blank? cookie))
    {}
    (let (dot (index-of cookie "."))
      (if (= dot -1)
        {}
        (let (payload (string/substring cookie 0 dot)
              sig (string/substring cookie (+ dot 1) (string/length cookie))
              expected (hmac-sha256 secret payload))
          (if (constant-time-equal? (string/->bytes sig) (string/->bytes expected))
            (check-expiry (decode-payload payload))
            {}))))))

(defn check-expiry (data)
  "Enforce the `__exp__` (epoch-ms) reserved key if present: an expired session reads as `{}`,
  otherwise the key is stripped and the user data returned. A session written without
  `:max-age` carries no `__exp__` and passes through unchanged."
  (let (exp (get data *exp-key*))
    (cond
      (nil? exp) data
      (> (os/now) exp) {}
      else (dissoc data *exp-key*))))

; A signed session's default absolute lifetime (seconds) when `:max-age` isn't configured.
; The browser cookie still defaults to a session cookie (no Max-Age) — this bounds only the
; SIGNED value's validity, so a captured cookie can't be replayed forever. 7 days.
(def *default-max-age* 604800)

(defn with-expiry (data opts)
  "Stamp an absolute `__exp__` (now + max-age seconds, in epoch-ms) into `data`, so the
  signature itself carries a deadline. Uses `:max-age` when configured, else *default-max-age*
  — a signed session ALWAYS expires, so a captured cookie is replayable only until `__exp__`,
  not forever (`check-expiry` enforces it on decode)."
  (let (max-age (get opts :max-age *default-max-age*))
    (assoc data *exp-key* (+ (os/now) (* max-age 1000)))))

(defn decode-payload (payload)
  "Decode a verified base64url JSON `payload` into a string-keyed map; `{}` on any decode or
  parse failure, or if the payload isn't a JSON object."
  (try (decode-json (base64-url-decode payload)) (catch _e {})))

(defn decode-json (json)
  "A JSON object as a string-keyed map; `{}` for anything else. Shared by the signed and the
  sealed formats, so both agree on what a session that does not parse reads as.

  `stringify-keys` is `http/util`'s: `json/decode` yields keyword keys, and a session is
  string-keyed end to end to match query/form params — the same normalization a JSON request
  body needs, which is why it lives one layer down rather than in a copy here. There were two
  copies, identical down to the `mapv`."
  (try
    (let (parsed (if json (json/decode json) nil))
      (if (map? parsed) (http/util/stringify-keys parsed) {}))
    (catch _e {})))

; ---- the SessionStore ability ----

(defability SessionStore
  "Where a session's data lives between requests.

  Two ops, both handed the conn, because a store owns both halves of the round trip: how the
  browser is told which session this is, and where the data behind it sits. For the cookie
  store those are the same thing — the cookie IS the data. For a server-side store the cookie
  carries an id and the data is a row somewhere.

      (session-read  [store conn]      -> the session data, a string-keyed map)
      (session-write [store conn data] -> the conn, carrying whatever the client needs)

  `session-write` runs as a before-send callback and only when a handler actually changed the
  session, so a plain GET writes nothing. An empty `data` means *end this session* — expire
  the cookie, drop the row — not \"store an empty map\"; that distinction is what makes logout
  work, and a store that re-writes `{}` instead leaves a live session behind.

  A store is a VALUE, not a configured name, so a second one is passed rather than looked up:

      (defrecord redis-store (pool secret))
      (impl SessionStore my-app/redis-store
        (session-read  [store conn] …)
        (session-write [store conn data] …))

      (through [(session/fetch-session (redis-store my-pool secret))]
        (get \"/account\" account/show))

  Hatch ships one implementation, `cookie-store`, and it is the default — see the module
  docstring for why a stateless session is the right thing to reach for first."
  ;; `session-read` answers a string-keyed map — declared `any` because every implementation
  ;; builds it out of a `cond` the checker widens to `countable` (the cookie store's
  ;; `decode-session` is the built-in example), and a return type that cannot be satisfied is
  ;; a warning every implementor would have to work around rather than a contract.
  (session-read [self conn] :-> any)
  (session-write [self conn data] :-> map))

(defn session-cookie-name (opts)
  "The cookie a session is carried in — `:cookie` in `opts`, else `_hatch_session`."
  (get opts :cookie *default-cookie*))

;; `(cookie-store secret opts)` — hatch's `SessionStore`, and what `fetch-session` is given.
;;
;; `opts` is required rather than optional because a record constructor is exact-arity, and
;; that turns out to be the better API anyway: `{}` at the call site is where a reader looks
;; to find that there ARE options, and what they are —
;;
;;   :cookie     the cookie name (default `_hatch_session`)
;;   :max-age    seconds; also bounds the signed value itself (see `with-expiry`)
;;   :encrypt    seal the payload rather than only signing it (see `encode-session`)
;;   :path       default "/"
;;   :same-site  default "Lax"
;;   :http-only  default true
;;   :secure     default: on outside dev (see `secure-cookie-default?`)
(defrecord cookie-store (secret opts))

;; The default store, and everything above this line: the session IS the cookie, signed (or
;; sealed) with `secret`. No server-side state, so it survives a restart, needs no sweeping,
;; and costs nothing to run across machines — which is why it is the default rather than
;; merely one option.
(impl SessionStore
  web/session/cookie-store
  (session-read [store conn]
    (decode-session (cookie-store-secret store)
      (get-cookie conn (session-cookie-name (cookie-store-opts store)))))
  (session-write [store conn data]
    (let (opts (cookie-store-opts store)
          name (session-cookie-name opts))
      ;; An empty session is EXPIRED (Max-Age=0), not re-signed as `{}` — otherwise a logout
      ;; leaves the browser holding a valid cookie for an empty session, and the next request
      ;; arrives with a session that exists.
      (if (= (count data) 0)
        (delete-cookie conn name (session-cookie-opts opts))
        (put-cookie conn
          name
          (encode-session (cookie-store-secret store) (with-expiry data opts) opts)
          (session-cookie-opts opts))))))

(impl Display
  web/session/cookie-store
  (->string [store]
    (str "#<session cookie-store " (session-cookie-name (cookie-store-opts store)) ">")))

; ---- the fetch-session plug ----

(defn fetch-session (store)
  "A plug that loads the session into `conn :session` and registers a before-send callback to
  write it back — but only if a handler changed it.

  `store` is a `SessionStore` value. For the built-in signed cookie that is
  `(cookie-store secret opts)`:

      (through [(session/fetch-session (session/cookie-store secret {}))] …)
      (through [(session/fetch-session (session/cookie-store secret {:encrypt true}))] …)
      (through [(session/fetch-session (my-redis-store pool))] …)

  It took a bare secret too, meaning \"the cookie store with this secret\". One argument that
  is sometimes a secret and sometimes a store is two shapes to recognise and two branches to
  keep working, for two saved characters — and it hid the store from the call site, which is
  the thing worth seeing. `(cookie-store secret {})` says which store is in use and where its
  options go; see `cookie-store` for what they are."
  (fn (conn)
    (register-before-send (assoc conn
                            :session (session-read store conn)
                            :session-store store
                            :session-changed? false)
      write-session)))

(defn write-session (conn)
  "Before-send callback: if the session changed this request, hand it to the store. Unchanged
  sessions leave the response untouched (no cookie churn on plain GETs), and an empty one is
  handed over as empty — the store's cue to end the session rather than persist a blank."
  (if (conn-session-changed? conn)
    (session-write (conn-session-store conn) conn (or (conn-session conn) {}))
    conn))

(defn secure-cookie-default? ()
  "Default for the session cookie's `Secure` flag: on outside dev ($HATCH_ENV ≠ \"dev\"), so
  in prod the auth cookie is sent only over HTTPS (a network attacker can't read it off a
  plaintext request and replay it) while local HTTP dev still works. An explicit `:secure`
  opt overrides."
  (web/env/prod?))

(defn session-cookie-opts (opts)
  "The put-cookie options for the session cookie, defaulting to a secure-by-default shape
  (HttpOnly, SameSite=Lax, and Secure outside dev) while letting `fetch-session` opts
  override."
  {:path (get opts :path "/")
   :http-only (get opts :http-only true)
   :same-site (get opts :same-site "Lax")
   :secure (get opts :secure (secure-cookie-default?))
   :max-age (get opts :max-age)})

; ---- session accessors ----

(defn get-session (conn key &optional (default nil))
  "Read a session value by string `key`, or `default` if absent."
  (get (or (conn-session conn) {}) key default))

(defn put-session (conn key value)
  "Set session `key` to `value` and mark the session dirty (so it's re-signed on send)."
  (assoc conn
    :session (assoc (or (conn-session conn) {}) key value)
    :session-changed? true))

(defn delete-session (conn key)
  "Remove `key` from the session and mark it dirty."
  (assoc conn
    :session (dissoc (or (conn-session conn) {}) key)
    :session-changed? true))

(defn clear-session (conn)
  "Drop the entire session (e.g. on logout) and mark it dirty — the next Set-Cookie writes
  an empty session."
  (assoc conn :session {} :session-changed? true))

(defn rotate-session (conn)
  "Start a fresh session, discarding every current key — including the CSRF token, which
  `csrf/protect-from-forgery` then re-mints on the next request — and mark it dirty. Call on
  any privilege change (login, logout, role switch), then set the new state:

    (-> conn (session/rotate-session) (session/put-session \"user_id\" id))

  so a token or value that may have leaked to an attacker *before* authentication is not
  carried over and honored *after* it (session/CSRF-fixation defense). In the stateless
  cookie model this can't retroactively invalidate a cookie the attacker already holds, but
  it does stop a pre-auth token from remaining valid post-auth.

  Identical to `clear-session` in the stateless cookie model — both blank the signed data;
  there is no server-side session id to rotate — so it delegates to it; the distinct name
  documents intent. NOTE: this also clears any CSRF token minted earlier in the request, so do
  NOT render a form in the SAME response that rotates the session — its token would be nil and
  the next POST would 403. The normal POST→redirect→GET flow re-mints the token on the GET."
  (clear-session conn))

; ---- flash ----

(defn fetch-flash (conn)
  "A plug — run *after* fetch-session — giving flash its one-shot lifetime: it moves any
  flash stashed in the session into `conn :flash` for this request, then clears it from the
  session (marking it dirty). So a message put before a redirect shows on exactly the next
  request, then is gone."
  (let (sess (or (conn-session conn) {})
        flash (get sess *flash-key* {}))
    (if (empty? flash)
      (assoc conn :flash {})
      (assoc conn
        :flash flash
        :session (dissoc sess *flash-key*)
        :session-changed? true))))

(defn put-flash (conn key message)
  "Stash a flash `message` under string `key` (e.g. \"info\", \"error\") to show on the
  *next* request — set it just before a redirect (the POST→redirect→GET pattern)."
  (let (sess (or (conn-session conn) {})
        flash (get sess *flash-key* {}))
    (assoc conn
      :session (assoc sess *flash-key* (assoc flash key message))
      :session-changed? true)))

(defn get-flash (conn key &optional (default nil))
  "Read a flash message by `key` for this request (placed there by fetch-flash)."
  (get (or (conn-flash conn) {}) key default))
