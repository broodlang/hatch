(defmodule web/component
  "LiveComponents: scoped, independently-testable UI pieces embedded in a live view's
  template via `(component module assigns)`. A component has its own `mount`/`render`/`on`
  lifecycle — the same vocabulary as `deflive` — plus its own `tick`. handle-info, unmount and
  on-mount-guard stay parent concerns.

  State lives in the session's per-connection component table (a `table` — Brood's ETS —
  one per mounted view: created when the session connects and replaced on every live-navigate,
  its components' beats cancelled with it), keyed by the string `\"id\"` the parent's `assigns` map supplies.
  `mount` runs once, the first time an id is seen; a parent re-render that keeps the same
  id does *not* re-run it — `web/component/send-update` pushes new state into a running
  component from anywhere (a sibling event, a PubSub handler, a parent tick) and triggers
  a re-render.

  A component gets its **own wire-level diff**: `deflive-component` compiles its render into
  the same statics/dynamics split `deflive` does, and `render-slot` hands the parent a
  component slot value (`web/parts/component-slot`) rather than an opaque string. So a state
  change ships only that component's changed inner slots, and a parent re-render that leaves
  the component alone ships nothing for it at all.

  A component also gets **its own `tick`**: `(tick ms (state) …)` beats on its own interval,
  started at mount, without the parent having to own a timer and `send-update` into it. See
  `start-component-ticks` for the one thing to know — a beat outlives the component leaving
  the screen, and is bounded by the session.

  Granularity, precisely. A component diffs per inner slot when it is a *direct* hole, the
  branch of an `(if …)`/`(when …)`, or the whole body of a `(for …)`. Wrapped inside a
  comprehension body — `[:li {} (component …)]` — the row diffs per ITEM instead: the
  comprehension ships only the row whose HTML changed, with the component's markup inside it.

  That last case is a real boundary, not an oversight. Giving every comprehension item its own
  statics/dynamics split would be the general answer and it founders on IDENTITY: a component
  patch is gated on a matching cid, a comp item has only its index, and indices shift on insert
  and delete — so patching item 3 after a row was removed would splice two unrelated rows
  together. Per-item string diffing has no such hazard, which is why the wrapped case keeps it."
  ; clause / dispatch-match / tick-match / render-expr / compile-render — the expansion
  ; deflive-component shares with deflive and defchannel. (It used to borrow web/live's own
  ; internals for this, which made the two modules a load cycle.)
  (:alias web/macro-helpers :as macro)
  ; render — lowers a component's Hiccup to HTML (the wrapper open tag, and the fallback
  ; whole-component render for a spec with no static/dynamic split)
  (:use web/template)
  ; compile-parts / component-slot / slot->html — the component's own static/dynamic split
  ; and the tagged slot value the parent diffs it as
  (:alias web/parts)
  ; send-safely — send-update's delivery, shared with send-info
  (:alias web/socket)
  ; send-interval — a component's own tick, started at mount (see start-component-ticks)
  (:alias timer))

; ---- the component spec ----
;
;; What a `deflive-component` module exposes, as a value — the component's half of what
;; `web/live/view-spec` is for a view, and named for the same reason: `(get spec
;; :render-static)` mistyped is a silent nil, and a nil there means "this component predates
;; the static/dynamic split", which is a real branch. So a typo does not fail — it quietly
;; drops the component back to shipping its whole HTML on every change.
;;
;; The accessors read a plain map as happily as a record, so a hand-built spec still works.
(defrecord component-spec
  (mount render render-static render-dynamic handle-event handle-tick ticks))

(impl Display web/component/component-spec (->string (_spec) "#<live component-spec>"))

; ---- the LiveComponentModule behaviour ----

(defbehaviour LiveComponentModule
  "A live component: build state from an id + assigns, render it, and handle its own
  client events, scoped independently of the parent view."
  (mount (id assigns))
  (render (state))
  (handle-event (name params state))
  (handle-tick (ms state)))

; ---- deflive-component macro ----

(defmacro deflive-component (& clauses)
  "Define a live component in the current module.

  Expands to `mount`, `render`, `handle-event`, `handle-tick`, `live-component-ticks` and the
  `live-component-spec` thunk.
  Embed it in a parent live view's template with `(component this-module assigns)` —
  `assigns` must carry a string `\"id\"`, the component's identity within the session.

  Syntax:
    (deflive-component
      (mount (id assigns) initial-state)
      (render (state) hiccup-template)      ; — or —  (template \"component.bml\")
      (on \"event-name\" (params state) updated-state)
      (tick 1000 (state) updated-state))    ; optional: its own beat (repeatable)

  `mount` runs once, the first time this id is seen in the session — a parent re-render
  that keeps the same id does *not* re-mount; push new data in with `web/component/send-update`
  instead. `render` and `on` read exactly like `deflive`'s, with `state` standing in for a
  view's `model`."
  (let (clause (fn (tag) (macro/clause "deflive-component" tag clauses))
        mount-clause (clause 'mount)
        render-clause (clause 'render)
        tick-clauses (macro/clauses 'tick clauses)
        render-expr (macro/render-expr render-clause (clause 'template))
        ; a (template …) clause's compiled body always references a variable literally
        ; named `model` (web/bml hardcodes `@field` -> `(get model :field)`, matching
        ; deflive's own template default) — *not* `state`, even though inline (render
        ; (state) …) is the idiomatic name elsewhere in this module.
        render-dyn-args (if render-clause (first (rest render-clause)) (list 'model))
        ; The component's own static/dynamic split, so it can be diffed independently of its
        ; parent (see render-slot). Same fallback as deflive's: a form the compiler can't
        ; split becomes one opaque dynamic — correct, just not granular.
        parts (macro/compile-render render-expr))
    (list 'do
      (list 'defn 'mount (first (rest mount-clause)) (cons 'do (rest (rest mount-clause))))
      (list 'defn 'render render-dyn-args render-expr)
      (list 'def 'render-static (get parts :statics))
      (list 'defn 'render-dynamic render-dyn-args (cons 'vector (get parts :dynamics)))
      (list 'defn
        'handle-event
        (list 'event-name 'event-params 'event-model)
        (macro/dispatch-match 'event-name
          (macro/clauses 'on clauses)
          'event-params
          'event-model
          'event-model))
      ;; One match arm per `(tick ms (state) …)`, keyed by its (literal) interval — the same
      ;; shape deflive builds for a view, so a component's beat reads identically to a view's.
      (list 'defn
        'handle-tick
        (list 'tick-ms 'tick-state)
        (macro/tick-match 'tick-ms tick-clauses 'tick-state))
      ;; The intervals this component beats on. Read at mount, when the session starts one
      ;; timer per interval for this id; empty for a component with no `tick` clause, which
      ;; is the overwhelming majority and costs nothing.
      (list 'def 'live-component-ticks (macro/tick-intervals tick-clauses))
      ; A 0-arg thunk, mirroring deflive's live-spec — re-resolves the component's
      ; functions by name each call, so hot-reloaded code is picked up.
      ;; Positional, in `component-spec`'s declared field order.
      (list 'defn
        'live-component-spec
        (list)
        (list 'web/component/component-spec
          'mount 'render 'render-static 'render-dynamic 'handle-event 'handle-tick
          'live-component-ticks)))))

; ---- the components table: {id -> {:module 'mod :spec-thunk spec-thunk :state state}} ----
; Storing the spec-thunk alongside state (not just state) is what lets an event or an
; out-of-band update find the right component's functions by id alone — `table/put`/`table/get`
; round-trip function values fine (a spec-thunk is a plain closure) *as callables*, but a
; value read back out is never `=` to the original (`table/put`/`table/get` deep-clone in and out) —
; so `:module` (a plain symbol, stable across the round-trip) is what render-slot actually
; compares to tell "the same component" from "a different module reusing this id".

(defn component-entry (module spec-thunk state &optional (tick-handles []))
  "One components-table entry: the module tag (compared to detect an id collision — see
  render-slot), the spec-thunk (to call mount/render/handle-event by name each time,
  hot-reload-friendly), the component's current state, and the timer handles of its own
  `tick` beats (so `cancel-ticks` can stop them when the table is torn down)."
  {:module module :spec-thunk spec-thunk :state state :tick-handles tick-handles})

(defn- with-state (entry state)
  "`entry` with its state replaced — and everything else, the tick handles included, kept.
  Rebuilding an entry through `component-entry` at every update dropped the handles, which is
  how a beat became impossible to cancel."
  (assoc entry :state state))

(defn- cancel-entry-ticks (entry)
  ;; a fold, not `dolist`: `dolist` is list-only and runs its body once, with nil, over an
  ;; EMPTY vector — which is what a component with no `tick` clause holds
  (fold (or (and entry (get entry :tick-handles)) []) nil (fn (_ handle) (timer/cancel handle) nil))
  nil)

(defn cancel-ticks (components-table)
  "Cancel every component beat started for `components-table` — the session calls this when
  it tears a view down (a live-navigate away, or the socket closing).

  Without it a component's timers outlived the table they were started for: after a navigate
  the beats kept arriving for ids no table held, each one costing a re-render and a diff frame
  for the rest of the connection, and navigating back mounted the component again and doubled
  them. A timer is bounded by the session process, not by the view, so the view has to stop it."
  (fold (table/snapshot components-table) nil (fn (_ pair) (cancel-entry-ticks (nth pair 1))))
  nil)

; ---- render-slot: called from a parent's render-dynamic for a (component …) hole ----

(defn- slot-state (module spec-thunk assigns components-table)
  "The component's current state for this id, mounting it on first sight. Shared by both
  render entry points below.

  Ids aren't namespaced per parent — the components table belongs to the whole mounted view. If
  a stored entry's `:module` doesn't match this call's (two different component modules reused
  the same id string), that's not the same component: cancel its beats, treat it as unmounted and
  mount fresh rather than rendering a foreign module's state through this one's `render`."
  (let (id (get assigns "id")
        entry (table/get components-table id)
        same-component? (and entry (= (get entry :module) module)))
    (if same-component?
      (get entry :state)
      (let (initial ((component-spec-mount (spec-thunk)) id assigns))
        ;; a foreign entry under this id is being replaced, and its beats with it
        (cancel-entry-ticks entry)
        (table/put components-table
          id
          (component-entry module spec-thunk initial (start-component-ticks id (spec-thunk))))
        initial))))

(defn- start-component-ticks (id spec)
  "Start one interval timer per `(tick ms …)` this component declares, posting
  `[:tick-component id ms]` to the session on each beat. Returns the timer handles, which the
  entry keeps so `cancel-ticks` can stop them.

  At MOUNT, because that is the one moment a component is known to be new: `render-slot` runs
  inside the session process on every re-render, and starting a timer there would add one per
  render.

  A beat CAN outlive the component being on screen. A component whose `(if …)` turns false
  keeps its state and its beat, and each beat then produces a diff for a slot nobody is
  rendering — wasted work, not wrong output. That is the same shape as `send-update` to a
  component that is no longer rendered, which has always been a no-op rather than an error. It
  does not outlive the VIEW: the session cancels every beat in the table when it navigates
  away or closes (`cancel-ticks`)."
  (seq/mapv (or (component-spec-ticks spec) [])
    (fn (ms) (timer/send-interval ms (self) [:tick-component id ms]))))

(defn wrapper-statics (id statics)
  "`statics` with the component's `[:div {:data-cid id} …]` wrapper folded into its first and
  last entries, so weaving the pair alone reproduces the wrapped HTML.

  Baking the wrapper in — rather than applying it around a woven string — is what lets the
  parent (and brood_live.js) treat a component slot as an ordinary statics/dynamics pair, with
  one interleave implementation on each side instead of a wrapper rule that could drift. The
  open tag is built by rendering an empty `[:div {:data-cid id}]` and splitting it, so the
  attribute escaping is `web/template`'s own and can't diverge from it.

  (hatch/web/component/wrapper-statics \"a\" [\"<p>\" \"</p>\"]) ;=> [\"<div data-cid=\\\"a\\\"><p>\" \"</p></div>\"]"
  (let (empty-div (web/template/render [:div {:data-cid id}])
        open (string/substring empty-div 0 (- (string/length empty-div) 6))
        v (into [] statics)
        n (count v))
    (if (= n 0)
      [(str open "</div>")]
      (assoc (assoc v 0 (str open (nth v 0))) (- n 1) (str (nth v (- n 1)) "</div>")))))

(defn render-slot (module spec-thunk assigns components-table)
  "Render one `(component module assigns)` hole to a **component slot value** (web/parts'
  `component-slot`) for the parent's dynamic slot: the component's own statics and dynamics,
  wrapper baked in, rather than one opaque HTML string.

  That split is what gives a component an independent wire diff. When only the component's
  state changed, `web/parts/slot-diff` compares this slot against its previous self and emits
  `{:__kdiff__ {inner-idx value}}` — just the component's changed inner slots — instead of
  re-sending its whole subtree. A parent re-render that leaves the component untouched
  produces an equal slot value and so ships nothing at all for it.

  `components-table` is the session's live per-id state table (a `table`): first time
  `(get assigns \"id\")` is seen, calls the component's `mount` and stores the result;
  thereafter reuses the stored state as-is (the parent's `assigns` are only consulted on first
  mount — see the module docstring).

  The `[:div {:data-cid id} …]` wrapper guarantees exactly one tagged root regardless of what
  the component's `render` returns (one element, a list, …) — the same reason Phoenix's
  LiveComponent requires a single HTML root. brood_live.js reads the nearest ancestor
  `data-cid` off a client event's target and sends it along, which is how
  `web/live/session-dispatch` knows to route that event to this component's own `handle-event`
  instead of the parent's.

  A component whose spec predates the split (no `:render-static`) falls back to one opaque
  string, exactly as before — correct, just not granular."
  (let (id (get assigns "id")
        state (slot-state module spec-thunk assigns components-table)
        spec (spec-thunk)
        statics (component-spec-render-static spec))
    (if (nil? statics)
      (web/template/render [:div {:data-cid id} ((component-spec-render spec) state)])
      (web/parts/component-slot id
        (wrapper-statics id statics)
        ((component-spec-render-dynamic spec) state)))))

(defn render-slot-html (module spec-thunk assigns components-table)
  "`render-slot` as a plain HTML string — the whole component, wrapper included.

  Used on the paths that need HTML rather than a diffable value: a view's plain `render` (whose
  contract is to return Hiccup, so the string is wrapped in `web/template/raw`), and any
  component nested inside an `(if …)`/`(for …)`, which the parent already compiles as one
  opaque dynamic. A nested component therefore keeps the coarser v1 behaviour — it re-sends its
  whole HTML when its enclosing slot changes — the same carve-out that has always applied to
  anything inside a conditional or comprehension."
  (web/parts/slot->html (render-slot module spec-thunk assigns components-table)))

; ---- event routing: a client event whose target DOM carries data-cid ----

(defn dispatch-event (components-table cid name params)
  "Run component `cid`'s own `handle-event` for a client event that targeted it (routed
  by `web/live/session-dispatch` on a wire event carrying a `cid`), storing the resulting
  state back. A no-op (swallowed) if `cid` names no mounted component — a stale id from a
  slow client is harmless, the same defensive stance `send-info`/a late tick already take."
  (let (entry (table/get components-table cid))
    (when entry
      (let (spec-thunk (get entry :spec-thunk)
            new-state (try
                        ((component-spec-handle-event (spec-thunk)) name params (get entry :state))
                        (catch _ (get entry :state))))
        (table/put components-table cid (with-state entry new-state)))))
  nil)

; ---- send-update: push new state into a running component from anywhere ----

(defn apply-update (components-table cid changes)
  "Merge `changes` into component `cid`'s stored state — the session-side handler for a
  `[:update-component cid changes]` mailbox message (see `send-update`). A no-op if `cid`
  names no mounted component."
  (let (entry (table/get components-table cid))
    (when entry
      (table/put components-table
        cid
        (with-state entry (merge (get entry :state) changes)))))
  nil)

(defn send-update (session cid changes)
  "Merge `changes` into component `cid`'s stored state within `session` (a live session
  pid) and trigger a re-render — the mechanism that lets code *outside* a component's own
  event handlers (a sibling event, a PubSub broadcast, a parent tick) push fresh data into
  it. Sending to an already-dead session is swallowed — see `web/socket/send-safely`, which
  `send-info` also builds on."
  (web/socket/send-safely session [:update-component cid changes]))

(defn apply-tick (components-table cid ms)
  "Run component `cid`'s own `handle-tick` for interval `ms` over its stored state and store
  the result — the session-side handler for a `[:tick-component cid ms]` beat.

  A no-op if `cid` names no mounted component (its beat outlived the thing that started it,
  which `start-component-ticks` explains), or if the component's spec declares no `handle-tick`
  — a component written before ticks existed has none, and a missing hook must not be a
  crashing session. Mirrors `apply-update`: the parent's own model is untouched, and the
  session re-renders afterwards so the component's fresh state reaches the wire as its own
  inner-slot diff.

  Returns true when a tick ran, false for the no-op cases — a beat for no mounted component has
  nothing for the session to render, and one can still land just after `cancel-ticks`, which
  races an in-flight fire."
  (let (entry (table/get components-table cid))
    (if entry
      (let (spec ((get entry :spec-thunk))
            tick (component-spec-handle-tick spec))
        (if tick
          (do (table/put components-table cid (with-state entry (tick ms (get entry :state)))) true)
          false))
      false)))
