; not-found-resp, send-resp, put-resp-header, param
(defmodule web/static
  "Static file serving: a MIME table and a path-traversal-safe handler factory.

  `(handler root)` returns a conn handler for a splat route — wire it as
  `(get \"/static/*path\" (static/handler \"static\"))`: the `*path` capture is
  sanitized (no `..`/`.`/backslash segments) and resolved under `root` (relative to
  the working directory). A miss or a traversal attempt yields a 404.

  Every file is read byte-faithfully with `slurp-bytes` and served as raw `bytes` — text and
  binary alike — so it reaches the wire exactly as it sits on disk; the MIME table only names
  the `Content-Type`.

  Every response goes through `serve-body`: a strong content ETag (so an unchanged asset
  revalidates to a bodyless 304), `X-Content-Type-Options: nosniff`, `Accept-Ranges` with
  best-effort byte ranges (206/416), and an env-aware `Cache-Control` — `no-cache` in dev
  and for un-fingerprinted URLs, `immutable`/one-year for content-fingerprinted ones. Pair
  with `web/assets/fingerprint` (build) + `asset-path` (link) for cache-busting in prod."
  (:use web/conn)
  ; url-decode — percent-decode each path segment (so a `%20` filename resolves), on the
  ; DECODED value of which the traversal checks run
  (:alias http/util)
  ; dev? / prod? — the one place $HATCH_ENV is read
  (:alias web/env)
  ; not-modified? / strong-etag — the one If-None-Match rule (RFC 9110 §13.1.2) and the one tag
  (:alias web/http-cache)
  ; accepts? — the Accept-Encoding predicate the endpoint negotiates with
  (:alias web/compress))

; ---- MIME types ----

(def *mime-types*
  {"html" "text/html; charset=utf-8"
   "htm" "text/html; charset=utf-8"
   "css" "text/css; charset=utf-8"
   "js" "text/javascript; charset=utf-8"
   "mjs" "text/javascript; charset=utf-8"
   "json" "application/json"
   "map" "application/json"
   "txt" "text/plain; charset=utf-8"
   "xml" "application/xml"
   "svg" "image/svg+xml"
   "webmanifest" "application/manifest+json"
   ; binary types
   "png" "image/png"
   "jpg" "image/jpeg"
   "jpeg" "image/jpeg"
   "gif" "image/gif"
   "webp" "image/webp"
   "avif" "image/avif"
   "ico" "image/x-icon"
   "bmp" "image/bmp"
   "woff" "font/woff"
   "woff2" "font/woff2"
   "ttf" "font/ttf"
   "otf" "font/otf"
   "eot" "application/vnd.ms-fontobject"
   "pdf" "application/pdf"
   "wasm" "application/wasm"
   "mp3" "audio/mpeg"
   "mp4" "video/mp4"
   "webm" "video/webm"
   "ogg" "audio/ogg"
   "zip" "application/zip"
   "gz" "application/gzip"})

(defn extension (path)
  "The lowercase file extension of `path` (after the last dot of the last segment),
  or \"\" when there's no extension."
  (let (seg (last (string/split path "/"))
        parts (string/split seg "."))
    (if (> (count parts) 1) (string/lower (last parts)) "")))

(defn text-mime? (mime)
  "True if `mime` is a text media type — what `web/assets` precompresses. (Serving no longer
  asks: every file is read as `bytes`.)"
  (or (string/starts-with? mime "text/")
    (= mime "application/json")
    (= mime "application/xml")
    (= mime "application/manifest+json")
    (= mime "image/svg+xml")))

(defn mime-type (path)
  "Content-Type for `path`, chosen by extension; `application/octet-stream` if unknown."
  (get *mime-types* (extension path) "application/octet-stream"))

; ---- path safety ----

(defn has-control-byte? (s)
  "True if `s` contains any control byte (< 0x20) or DEL (0x7f) — e.g. a NUL, which can
  truncate a path at the OS layer and on which `file-stat` may raise."
  (any? (string/->codepoints s) (fn (cp) (or (< cp 32) (= cp 127)))))

(defn unsafe-segment? (s)
  "True if a (percent-decoded) path segment would escape the root or is otherwise unsafe:
  `.`/`..`, or a segment carrying a path separator (`/` from a decoded `%2f`, or `\\`) or any
  control/NUL byte. Checking the DECODED value is what makes `%2e%2e`/`%2f` fail closed."
  (or (= s "..") (= s ".") (includes? s "/") (includes? s "\\") (has-control-byte? s)))

(defn safe-segments (rel)
  "Percent-decoded path segments of `rel` (empties dropped), or `nil` if any decoded segment
  is unsafe — a path-traversal attempt like `../../etc/passwd`, `..%2f..`, or `%2e%2e`. Decode
  is per-segment so a `%2f` becomes a literal `/` *inside* a segment (rejected by
  `unsafe-segment?`) rather than a new separator."
  (let (segs (map (seq/filter (string/split rel "/") (fn (s) (not (string/blank? s))))
               http/util/url-decode))
    (if (empty? (seq/filter segs unsafe-segment?)) segs nil)))

; ---- caching ----

; A process-shared cache (Brood's ETS) of `path → {:mtime :size :etag}`, so a hot asset is
; hashed once, not on every request. Lives for the runtime; lock-free concurrent reads (a
; registry process would funnel every read through one mailbox).
(def *etag-cache* (table/new))

(defn cached-etag (path body)
  "The cached strong ETag for the file `body` (a string or `bytes`) at `path`: the hash is
  reused while the file's mtime+size are unchanged and recomputed after an edit. One
  `file/stat` (a cheap syscall) replaces hashing the whole body on every hit."
  (let (st (file/stat path))
    (if (nil? st)
      (web/http-cache/strong-etag body)
      (let (hit (table/get *etag-cache* path))
        (if (and hit (= (get hit :mtime) (get st :mtime)) (= (get hit :size) (get st :size)))
          (get hit :etag)
          (let (tag (web/http-cache/strong-etag body))
            (table/put *etag-cache* path {:mtime (get st :mtime) :size (get st :size) :etag tag})
            tag))))))

(defn fingerprint-shaped? (path)
  "True if `path`'s basename *looks* content-fingerprinted — `name.<8+ hex>.ext`, the shape
  `asset-path`/`web/assets/fingerprint` emit. A cheap, no-IO pre-check: it gates the manifest
  lookup in `fingerprinted?` so a normal request never touches disk."
  (let (seg (string/lower (last (string/split path "/")))
        parts (string/split seg "."))
    (and (>= (count parts) 3)
      ;; `h` is nil-checked as well as counted: `(>= (count parts) 3)` guarantees it, but
      ;; nothing carries that to the `first`/`rest` chain that produces it.
      (let (h (first (rest (reverse parts))))
        (and h
          (>= (string/length h) 8)
          (= (string/span h 0 "0123456789abcdef") (string/length h)))))))

(defn relative-to (path dir)
  "`path` with a leading `dir/` removed — the form the fingerprint manifest keys and values
  use. `serve` builds a path as `dir/rel`, so this recovers `rel`."
  (let (prefix (str dir "/"))
    (if (string/starts-with? path prefix)
      (string/substring path (count prefix) (count path))
      path)))

(defn fingerprinted? (path dir)
  "True if `path` is an asset hatch actually content-fingerprinted — its path RELATIVE to
  `dir` appears as a value in `dir`'s manifest. Authoritative, not a guess: a
  fingerprint-*shaped* look-alike that hatch didn't produce (a vendored `chunk.a1b2c3d4.js`
  you hashed yourself) is NOT treated as immutable, so it can't get stuck in caches for a
  year if its bytes later change. The structural pre-check means only a fingerprint-shaped
  URL ever reads the manifest.

  Relative path, not basename. `fingerprint-name` keeps an asset where it was —
  `fonts/body.woff2` fingerprints to `fonts/body.<sha>.woff2`, and that whole string is what
  the manifest stores. Comparing only the basename therefore never matched anything in a
  SUBDIRECTORY, so a nested asset was fingerprinted, linked by its immutable URL, and then
  served `no-cache` — revalidated on every page load for the life of the deploy, with
  nothing to indicate it was happening. Flat assets matched by accident, because for them
  the basename and the relative path are the same string."
  (and (fingerprint-shaped? path)
    (includes? (vals (load-manifest dir)) (relative-to path dir))))

(defn cache-control (path dir)
  "The Cache-Control for a static asset at `path` (served from `dir`). In prod a
  hatch-fingerprinted URL (in `dir`'s manifest) is `immutable` and cached for a year — a
  content change means a new URL; everything else is `no-cache`, i.e. revalidate every load,
  cheap because the ETag turns an unchanged asset into a bodyless 304. In dev, always
  `no-cache`, so an edited asset is never masked by a stale copy (and the manifest is never
  read — `prod?` short-circuits)."
  (if (and (web/env/prod?) (fingerprinted? path dir))
    "public, max-age=31536000, immutable"
    "no-cache"))

; ---- serving ----

(defn with-resp-headers (conn hmap)
  "Add every `keyword → value` in `hmap` as a response header."
  (fold (%map-pairs hmap) conn (fn (c kv) (put-resp-header c (first kv) (first (rest kv))))))

(defn- asset-headers (content-type tag cc)
  "The headers every static response carries, whatever its status: what the representation
  is, how to validate it, how long to keep it, that it varies by encoding, and not to sniff it.

  These were written out at six call sites — two 200s, two 206s, two 416s — and they had
  already drifted. `Vary: Accept-Encoding` was on the 200s and missing from every range
  response and from the 304, so a shared cache storing one of those held a body with nothing
  saying it varies by content coding, and could hand a gzip entity to a client that never
  asked for one. That is the failure mode of writing a header set out six times."
  {:content-type content-type
   :etag tag
   :cache-control cc
   :vary "Accept-Encoding"
   :x-content-type-options "nosniff"})

(defn- rangeable-headers (content-type tag cc)
  "`asset-headers` plus the advertisement that byte ranges are served. Separate because the
  precompressed path does NOT honour `Range` — advertising it there would be a promise this
  module does not keep."
  (assoc (asset-headers content-type tag cc) :accept-ranges "bytes"))

(defn not-modified (conn tag cc)
  "A 304 Not Modified — no body, but it still carries what a cache needs to keep trusting
  (and re-using) its stored copy: the ETag, the Cache-Control, and `Vary`.

  `Vary` because the stored response it is refreshing varies by `Accept-Encoding`; a 304 that
  omits it can leave a cache revalidating an entry it has no key for (RFC 9110 §15.4.5 lists
  `Vary` among the headers a 304 SHOULD carry). Deliberately not the full `asset-headers`
  set: a 304 has no body, so the representation headers describing one have nothing to say."
  (send-resp (with-resp-headers conn {:etag tag :cache-control cc :vary "Accept-Encoding"})
    304 ""))

(defn if-none-match? (conn tag)
  "True if the request's `If-None-Match` lists `tag` (or is the `*` wildcard) — i.e. the
  client already holds this exact version, so we can answer 304 instead of resending it.

  `web/http-cache/not-modified?` is the one implementation of the rule, for files and for dynamic
  responses alike. This module had its own, and the two had already drifted: on `\"a\", *` and
  on a malformed `W/ \"abc\"` they disagreed about whether to send a 304. Two readings of one
  RFC paragraph is exactly the shape that drifts, and a wrongly-issued 304 leaves a client on
  a stale copy."
  (web/http-cache/not-modified? conn tag))

(defn range-int (s)
  "The non-negative integer `s` denotes, or nil if `s` isn't a plain run of digits. We
  validate the digits ourselves rather than trust `string/->number`, which also parses floats
  (`\"1.5\"` → 1.5) — and a float offset would later blow up `substring` (int-only), turning a
  crafted `Range` header into a 500. So anything non-integer (floats, signs, hex, spaces) is
  rejected here and the range is ignored."
  (if (and (not (string/blank? s)) (= (string/span s 0 "0123456789") (string/length s)))
    ;; The span check above means this parse cannot fail — but `string/->number` answers
    ;; `number | failure`, a failure is TRUTHY, and every caller here guards with
    ;; `(nil? a)`. Say nil, as the docstring does, so the guards mean what they say.
    (let (n (string/->number s))
      (when (int? n) n))
    nil))

(defn parse-range (spec len)
  "Parse a single-range `Range: bytes=…` spec against a body of `len` bytes, returning
  `[start end]` (inclusive, satisfiable), `:unsatisfiable` (a syntactically valid range
  wholly past the end), or nil (absent/garbled/multi-range — ignore it and serve the whole
  body). Forms: `bytes=a-b`, `bytes=a-` (a..end), `bytes=-n` (final n bytes)."
  (if (or (nil? spec) (not (string/starts-with? (string/trim spec) "bytes=")))
    nil
    (let (r (string/substring (string/trim spec) 6 (string/length (string/trim spec))))
      (if (includes? r ",")
        ; multi-range: not worth it for text assets — fall back to a full 200
        nil
        (let (dash (index-of r "-"))
          (if (= dash -1)
            nil
            (let (lo (string/trim (string/substring r 0 dash))
                  hi (string/trim (string/substring r (+ dash 1) (string/length r))))
              (cond
                ; suffix: bytes=-n → final n bytes
                (string/blank? lo)
                  (let (n (range-int hi))
                    (if (and n (> n 0))
                      [(math/max 0 (- len n)) (- len 1)]
                      nil))
                ; bytes=a- → a..end
                (string/blank? hi)
                  (let (a (range-int lo))
                    (if a
                      (if (>= a len) :unsatisfiable [a (- len 1)])
                      nil))
                ; bytes=a-b
                else
                  (let (a (range-int lo)
                        b (range-int hi))
                    (if (and a b)
                      (cond
                        (> a b) nil
                        (>= a len) :unsatisfiable
                        else [a (math/min b (- len 1))])
                      nil))))))))))

(defn serve-range (conn content-type body tag cc)
  "Honour a `Range` request against `body` (a string or `bytes`): a 206 with the requested
  bytes, a 416 for an unsatisfiable range, or nil (no or garbled `Range`, or a multi-range) to
  mean 'send the whole body', which the spec allows.

  Ranges are byte offsets, so a string body is ranged over its UTF-8 bytes — any range,
  including one that splits a multibyte character, which is the client's to reassemble. The
  206 body is always `bytes`."
  (let (raw (if (bytes? body) body (string/->bytes body))
        len (count raw)
        r (parse-range (get (conn-headers conn) :range) len))
    (cond
      (nil? r) nil
      (= r :unsatisfiable)
        (send-resp (with-resp-headers conn
                     (assoc (rangeable-headers content-type tag cc)
                       :content-range (str "bytes */" len)))
          416 "")
      else
      ;; floored: byte offsets are integral by construction, but they arrive by
      ;; destructuring a vector, which widens them to `number`
        (let ([start-raw end-raw] r
              start (math/floor start-raw)
              end (math/floor end-raw))
          (send-resp (with-resp-headers conn
                       (assoc (rangeable-headers content-type tag cc)
                         :content-range (str "bytes " start "-" end "/" len)))
            206
            (bytes/slice raw start (+ end 1)))))))

(defn serve-body (conn content-type body path &optional (dir "static") (tag nil))
  "Send `body` — a string or `bytes` — as a cacheable static asset: a content ETag (with
  `If-None-Match` → 304), an env- and fingerprint-aware Cache-Control, `nosniff`,
  `Accept-Ranges`, and byte ranges (`Range` → 206/416, else a full 200 carrying `body` as
  given). `path`/`dir` only steer the cache policy (fingerprinted? consults `dir`'s
  manifest); `path` may be a bare filename. `tag` lets a caller pass a precomputed (e.g.
  cached) ETag; nil computes one from `body`."
  (let (tag (or tag (web/http-cache/strong-etag body))
        cc (cache-control path dir))
    (cond
      (if-none-match? conn tag) (not-modified conn tag cc)
      else
      ;; A string body is encoded to bytes ONLY for a request that actually sent `Range`:
      ;; `string/->bytes` copies the whole asset, and almost no request ranges.
        (or (and (get (conn-headers conn) :range) (serve-range conn content-type body tag cc))
          (send-resp (with-resp-headers conn (rangeable-headers content-type tag cc))
            200 body)))))

(defn fresh-cached-etag (path)
  "The cached ETag for `path` if the file still matches the cached mtime+size — determined
  from a `file-stat` alone, without reading the body. Lets a revalidation answer 304 without
  slurping the file. nil if the file is uncached, changed, or unstattable (the caller then
  reads + hashes it). `file-stat` is guarded: a path the OS rejects (an interior NUL that
  slipped a check, an odd encoding) fails closed to 404 rather than crashing the worker."
  (let (st (check-allow :discarded-catch (try (file/stat path) (catch _ nil))))
    (if (nil? st)
      nil
      (let (hit (table/get *etag-cache* path))
        (if (and hit (= (get hit :mtime) (get st :mtime)) (= (get hit :size) (get st :size)))
          (get hit :etag)
          nil)))))

(defn accepts? (conn coding)
  "True if the request's `Accept-Encoding` offers `coding` and does not refuse it with an
  explicit `q=0` weight.

  A refusal matters more here than anywhere else in hatch: this gates serving a
  *precompressed* `.gz`/`.br` sibling, so reading `gzip;q=0` as a yes hands a client that
  said it cannot decode gzip a body it cannot read. It is `web/compress/accepts?` — one
  predicate for every layer that negotiates a coding."
  (web/compress/accepts? conn coding))

(defn accepts-gzip? (conn)
  "True if the request's `Accept-Encoding` offers gzip."
  (accepts? conn "gzip"))

(defn negotiated-variant (conn path)
  "The best precompressed sibling of `path` to serve as `[coding sibling-path]` — brotli
  (`path.br`) preferred over gzip (`path.gz`), each offered only when the client accepts that
  coding AND the sibling exists on disk (both written by `web/assets/fingerprint`). nil when
  neither applies (fall through to the identity representation)."
  (cond
    (and (accepts? conn "br") (file/exists? (str path ".br"))) ["br" (str path ".br")]
    (and (accepts? conn "gzip") (file/exists? (str path ".gz"))) ["gzip" (str path ".gz")]
    else nil))

(defn serve-encoded (conn path root)
  "Content-negotiated compression: when the client accepts a coding and a matching precompressed
  sibling exists (`path.br` for brotli, preferred; else `path.gz` for gzip), serve those bytes
  with the matching `Content-Encoding` — a ~5-6x smaller transfer for CSS/JS. Returns the
  response conn, or nil to fall through to the identity representation (no accepted coding, or no
  sibling on disk). The compressed body is sent whole — a `Range` over compressed bytes isn't
  offered — with a representation-specific ETag (hashed from the sibling) and `Vary:
  Accept-Encoding` so a shared cache keys the encodings apart. Cache-Control follows the *logical*
  path, so a fingerprinted asset's compressed variant stays `immutable`."
  (let (variant (negotiated-variant conn path))
    (when variant
      (let (coding (first variant)
            sibling (nth variant 1)
            body (check-allow :discarded-catch (try (file/slurp-bytes sibling) (catch _ nil))))
        (when body
          (let (tag (cached-etag sibling body)
                cc (cache-control path root))
            (if (if-none-match? conn tag)
              (not-modified conn tag cc)
              ;; `asset-headers`, not `rangeable-headers`: this path serves the whole
              ;; precompressed sibling and never honours a `Range`, so it must not claim to.
              (send-resp (with-resp-headers conn
                           (assoc (asset-headers (mime-type path) tag cc)
                             :content-encoding coding))
                200 body))))))))

(defn serve (conn root rel)
  "Serve `rel` under `root` into `conn`: 200 with the file's MIME type on success, a bodyless
  304 when the client's `If-None-Match` already matches, 404 on a traversal attempt or a
  missing/unreadable file. See `serve-body` for the cache/conditional/range headers.

  A revalidation whose ETag is already cached (mtime+size unchanged) short-circuits to 304
  from the stat alone — the file body is never read, so re-checking a large asset costs a
  syscall, not a full slurp into memory. A gzip-capable client with a precompressed `.gz`
  sibling on disk is served that instead (`serve-encoded`), transparently."
  (let (segs (safe-segments rel))
    (if (or (nil? segs) (empty? segs))
      (not-found-resp conn)
      (let (path (str root "/" (string/join segs "/")))
        (or (serve-encoded conn path root)
          ;; The stat is for ONE purpose: answering a revalidation without reading the file.
          ;; A request with no `If-None-Match` is not revalidating, so it was a syscall spent
          ;; to learn something nobody asked — and the read path stats again anyway, through
          ;; `cached-etag`.
          (let (fresh (and (get (conn-headers conn) :if-none-match) (fresh-cached-etag path)))
            (if (and fresh (if-none-match? conn fresh))
              (not-modified conn fresh (cache-control path root))
              (serve-file conn path root))))))))

(defn serve-file (conn path root)
  "Serve the file at `path`, read byte-faithfully as `bytes` whatever its type, through
  `serve-body`; 404 when it cannot be read.

  Bytes for text too. The bytes ARE the file — a stylesheet's identity is what is on disk,
  not a decode of it — so the ETag is the same one a UTF-8 read would hash, a `Range`
  slices exactly what was asked, and a text file that is not valid UTF-8 is served rather
  than refused."
  (let (body (check-allow :discarded-catch (try (file/slurp-bytes path) (catch _ nil))))
    (if (nil? body)
      (not-found-resp conn)
      (serve-body conn (mime-type path) body path root (cached-etag path body)))))

(defn handler (root &optional (capture "path"))
  "A conn handler that serves files under `root` from a splat route. `capture` is the
  splat param name (the `*name` in the route pattern; defaults to `path`)."
  (fn (conn)
    (serve conn root (or (param conn capture) ""))))

; ---- content-fingerprinted asset URLs ----
; A build step (`web/assets/fingerprint`) rewrites built files to content-addressed names
; (`app.<sha>.css`) and records a manifest mapping each logical name to its fingerprinted
; one. `asset-path` turns a logical name into the URL to emit — the cache-forever
; fingerprinted name in prod, the plain name (revalidated each load) in dev — so templates
; link by logical name and pick up long-lived prod caching for free.

(def *manifest-name* "cache-manifest")

(defn manifest-path (dir)
  "Path to the fingerprint manifest under `dir`."
  (str dir "/" *manifest-name*))

(defn render-manifest (manifest)
  "Serialize a `logical → fingerprinted` map to the manifest line format — one
  `logical<TAB>fingerprinted` line per asset. The inverse of `parse-manifest`; written by
  `web/assets/fingerprint`."
  (string/join (map (%map-pairs manifest) (fn (kv) (str (first kv) "\t" (first (rest kv)) "\n")))
    ""))

(defn parse-manifest (text)
  "Parse a manifest (one `logical<TAB>fingerprinted` line per asset) into a map."
  (fold (seq/filter (string/split text "\n") (fn (l) (not (string/blank? l))))
    {}
    (fn (m line)
      (let (tab (index-of line "\t"))
        (if (= tab -1)
          m
          (assoc m
            (string/substring line 0 tab) (string/substring line (+ tab 1) (string/length line))))))))

; Process-shared cache (ETS) of `dir → parsed manifest`. The manifest is immutable for a
; deployment's lifetime (a new build means a new process), so this is read once per dir and
; never invalidated — removing per-render disk IO in prod. `clear-manifest-cache` exists for
; tests / a dev rebuild.
(def *manifest-cache* (table/new))

(defn load-manifest (&optional (dir "static"))
  "The fingerprint manifest under `dir` as a `logical → fingerprinted` map, or `{}` when
  there's none (dev, or a build that didn't fingerprint).

  A manifest that was READ is memoized per `dir`, so a hot path touches the disk once. A
  MISS is deliberately not memoized: the absent manifest is a transient state — `serve`
  writes it during boot, and anything that asked before then (a module-level `def` in a
  view, loaded when the router builds its route table) would otherwise pin `{}` for the
  life of the process and ship plain, `no-cache` URLs with a correct manifest sitting on
  disk beside them. A miss costs one failed `file/slurp`; only dev pays it repeatedly."
  (if (table/has? *manifest-cache* dir)
    (table/get *manifest-cache* dir)
    (let (text (check-allow :discarded-catch (try (file/slurp (manifest-path dir)) (catch _ nil))))
      (if (nil? text)
        {}
        (let (m (parse-manifest text))
          (table/put *manifest-cache* dir m)
          m)))))

(defn clear-manifest-cache ()
  "Drop every memoized manifest, so the next `load-manifest` re-reads from disk. For tests
  and a dev rebuild that rewrote the manifest within a running process."
  (doseq (dir (keys (table/snapshot *manifest-cache*)))
    (table/delete *manifest-cache* dir))
  nil)

(defn asset-path (logical &optional (dir "static"))
  "The URL for a logical asset name (e.g. \"app.css\"). In prod, the content-fingerprinted
  name from the build manifest — immutable, so the client caches it forever; in dev (or on a
  manifest miss), the plain name, which `serve` revalidates each load. Link assets by logical
  name and get the right caching in both environments."
  (let (name (if (web/env/prod?) (get (load-manifest dir) logical logical) logical))
    (str "/" dir "/" name)))

(defn file-text (logical &optional (dir "static"))
  "The text of a static file, read from disk NOW — for inlining into a page.

  Now, and not at load: a `(def *css* (file/slurp …))` is restored from the startup image
  (ADR-218) on every later boot, and the image is keyed on `src/` — an edit to the file never
  reaches the page until something in `src/` changes. That cost an app a whole restart of
  confusion once. A read per render is a few microseconds for a few kilobytes, and the
  endpoint's ETag makes the page itself cheap to revalidate."
  (file/slurp (str dir "/" logical)))

(defn inline-css (logical &optional (dir "static"))
  "A `<style>` node holding the stylesheet `logical`, read per render (`file-text`). For a
  small stylesheet this beats a `<link>`: no second round trip before the first paint, which
  is the one Lighthouse audit a terminal-sized app otherwise fails."
  [:style {} (web/template/raw (file-text logical dir))])

; ---- head hints: telling the browser about an asset before it would discover it ----
;
; The browser finds most assets late. A font is fetched only once style resolution applies a
; rule that uses it, which is after the stylesheet has arrived; a module's static imports
; are fetched only once the module itself has been downloaded and parsed. Each of those is a
; full round trip that starts strictly after the one before it — a chain, and the chain's
; length is what the reader waits for. These links flatten it: they name the asset in the
; document head, so the fetch starts with the document and lands in parallel with the rest.
;
; They take LOGICAL names for the same reason `asset-path` does: a hint that names the
; un-fingerprinted URL preloads a file the page never uses, and the browser then downloads
; the real one a second time — the hint made the page slower, and warned in a console nobody
; was watching. A helper that resolves the name cannot get that wrong.

(defn modulepreload (logical &optional (dir "static"))
  "A `<link rel=\"modulepreload\">` for the ES module `logical` names, as Hiccup.

  For a module the page's entry script `import`s: without the hint the browser discovers it
  only after downloading and parsing the entry, so the two load in series rather than
  together. Unlike a plain preload it also parses and compiles the module, so the import
  resolves from the module map without a second wait."
  [:link {:rel "modulepreload" :href (asset-path logical dir)}])

(defn preload-font (logical &optional (dir "static"))
  "A `<link rel=\"preload\" as=\"font\">` for the font file `logical` names, as Hiccup.

  Fonts are the asset the browser finds latest of all: the fetch starts only when a style
  rule that names the face is applied to some text, which is after the stylesheet has
  landed and been resolved. Preloading starts it with the document instead.

  The link carries `crossorigin=\"anonymous\"` even for a same-origin font, because the
  specification fetches fonts in CORS mode and a preload is matched to its use by fetch mode
  as well as by URL. A font preload WITHOUT the attribute is never matched: the browser
  downloads the file, discards it, and downloads it again when the rule fires — worse than
  no hint. `type` lets a browser that cannot use the format skip the download."
  [:link
    {:rel "preload"
     :as "font"
     :type (mime-type logical)
     :crossorigin "anonymous"
     :href (asset-path logical dir)}])

; ---- font faces: the @font-face rules, fingerprinted and split by unicode-range ----
;
; A font's URL is fingerprinted, and the fingerprint is known only once the files are hashed,
; after any stylesheet is built; so the rules are made here, at render time, for an inline
; `<style>` in the head. A face may also be split: a small subset for the characters nearly
; every page uses, and the whole font for the rest. With disjoint `unicode-range`s the browser
; downloads the whole font only on a page whose text needs one of those other characters.

;; The highest code point, the end of the last range `unicode-range-outside` gives.
(def- *last-code-point* 0x10FFFF)

(defn- code-point-hex (code-point) (string/upper (string/number-> code-point 16)))

(defn unicode-range (ranges)
  "The CSS `unicode-range` value for `ranges`, a list of `[first last]` code points, inclusive:
  `[[0x20 0x7E] [0x2212 0x2212]]` gives `\"U+20-7E,U+2212\"`."
  (string/join (map ranges
                 (fn (range)
                   (let ([first-point last-point] range)
                     (if (= first-point last-point)
                       (str "U+" (code-point-hex first-point))
                       (str "U+" (code-point-hex first-point) "-" (code-point-hex last-point))))))
    ","))

(defn unicode-range-outside (ranges)
  "The code points `ranges` leaves out, as ranges of the same shape, up to U+10FFFF: what the
  whole font answers for when a subset answers for `ranges`. `ranges` must be in order and
  must not overlap."
  (let (end (reduce ranges
              {:next 0 :gaps []}
              (fn (state range)
                (let ([first-point last-point] range
                      next-point (get state :next))
                  {:next (+ last-point 1)
                   :gaps (if (< next-point first-point)
                           (conj (get state :gaps) [next-point (- first-point 1)])
                           (get state :gaps))}))))
    (if (<= (get end :next) *last-code-point*)
      (conj (get end :gaps) [(get end :next) *last-code-point*])
      (get end :gaps))))

(defn font-face-css (faces &optional (dir "static"))
  "The `@font-face` rules for `faces`, one string, each `src` resolved through `asset-path` so
  it names the fingerprinted file (and a `preload-font` of the same name matches it). A face is
  a map: `:family`, `:src` (a logical name), `:weight`, and optionally `:style` (\"normal\"),
  `:display` (\"swap\": text shows in the fallback at once) and `:unicode-range` (ranges as
  `unicode-range` takes them).

  For a subset and the whole font, give the same family and weight twice, the subset with
  its ranges and the whole font with `(unicode-range-outside ranges)`."
  (apply str
    (map faces
      (fn (face)
        (str "@font-face{font-family:\""
          (get face :family)
          "\";src:url(\""
          (asset-path (get face :src) dir)
          "\") format(\"woff2\");font-weight:"
          (get face :weight)
          ";font-style:"
          (get face :style "normal")
          ";font-display:"
          (get face :display "swap")
          (let (ranges (get face :unicode-range))
            (if (nil? ranges) "" (str ";unicode-range:" (unicode-range ranges))))
          "}")))))

; ---- hatch's own bundled assets ----

; Hatch ships three browser clients in its package `static/` dir — brood_live.js,
; brood_webmcp.js and brood_channel.js — and serves them from there so an app never vendors
; a copy that can drift from the server half it talks to. `web/live` and `web/mcp` each had their own
; root-finding constant and their own three-function wrapper around it, identical but for
; the filename. The root is found by stripping this file's own known suffix off its path,
; and `string/replace` answers the subject unchanged when the pattern is absent — so if the
; file is ever moved, the root silently becomes the whole path and the asset 404s with
; nothing raised. That is a trap worth having once rather than twice.
(def *hatch-root*
  (string/replace (or (reflect/current-file) "") "/src/web/static.blsp" ""))

(defn bundled-path (file)
  "Absolute path to `file` in hatch's own bundled `static/` directory."
  (str *hatch-root* "/static/" file))

(defn bundled-source (file)
  "The bundled asset's source text read from disk, or nil if it can't be located.

  Correct only where hatch's own source tree exists — which is dev, and the build. At
  RUNTIME in a released app it is neither: prefer `embed-bundled`, which is the macro that
  makes that distinction go away."
  (check-allow :discarded-catch (try (file/slurp (bundled-path file)) (catch _ nil))))

;; WHY A PACKAGE ASSET CAN BE ABSENT, which is not obvious and cost a production bug.
;;
;; `nest release` bundles the manifest and every `src/**/*.blsp` — sources, and only sources.
;; hatch's `static/` is data, so it does not travel. Inside that bundle
;; `reflect/current-file` answers a virtual `<bundle>/hatch/web/static.blsp`, which has no
;; `/src/` in it, so the suffix-strip above misses and `string/replace` hands back the whole
;; path unchanged — `*hatch-root*` becomes the file's own name and every bundled path below
;; it is nonsense. Neither a load-time `def` nor a macro escapes this: a bundle macroexpands
;; at BOOT, inside itself, where the files have never existed.
;;
;; So in a released app these reads answer nil, and that is a fact to design around rather
;; than defeat. `web/endpoint`'s `:static` stage falls through to the app's own static
;; directory when the package copy is missing, so a release that puts the clients there —
;; one `cp` in the image build — serves them; and `bundled-js-handler` answers 404 rather
;; than an empty 200, so an app that has not done so finds out.

(defn bundled-js-handler (file source)
  "A conn handler serving hatch's bundled JavaScript `source` as `file`, through the static
  cache pipeline: a content ETag (so the browser gets a bodyless 304 once it holds the file),
  `nosniff`, and `no-cache`. These sit at fixed, non-fingerprinted paths, so they always
  revalidate — cheap, and never stale (a stale copy fetched under the old codepoint
  Content-Length bug is what broke live parsing until the cache was cleared).

  `source` is passed in rather than read here, so it is the caller's load-time `def` — see
  `bundled-source`. A nil `source` answers **404**, not an empty 200. The empty 200 is what
  hid this in production for as long as it did: it has a status that says yes, a content-type
  that says JavaScript, and an ETag over the emptiness, so every log line and every probe
  reports a served file. A 404 is a thing someone notices."
  (fn (conn)
    (if (nil? source)
      (not-found-resp conn)
      (serve-body conn "text/javascript; charset=utf-8" source file))))
