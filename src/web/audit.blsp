; log/warn
(defmodule web/audit
  "Dev-only structural audits of a rendered page.

  These catch a class of bug the server cannot otherwise see: a response that is complete,
  correct, 200-OK HTML, and still does not work when a person uses it. Nothing about the
  request/response cycle is wrong, so no test that asserts on status, headers or markup
  presence will fail — the page simply does nothing.

  Two audits live here. [[inert-controls]] catches a control nothing can reach;
  [[first-flight]] catches a page that cannot paint in one network round trip.

  The audit that motivated the module is [[inert-controls]]. A reusable renderer emitted a
  fragment containing a `Filter…` search box plus a separate companion script, the host
  page inlined the stylesheet and forgot the script, and the box shipped inert for months:
  present in the markup, focusable, accepts typing, wired to nothing.

  Audits run in dev only and never alter the response — they log a warning naming the
  element. Every one of them is written to have no false positives rather than to catch
  everything: a lint that cries wolf is a lint people stop reading, so each rule declines
  to judge whatever it cannot prove."
  (:use web/conn))

(def- *controls* ["<input" "<select" "<textarea" "<button"])

;; TCP opens a connection with a congestion window of 10 segments (RFC 6928) and cannot
;; send more until the client acknowledges. At the usual 1460-byte MSS that is 14 600 bytes
;; on the wire; 14 336 (14 KiB) is the conventional budget, leaving room for response
;; headers. A document that fits arrives in ONE round trip after the handshake; a document
;; that does not waits for an acknowledgement it could have avoided.
;;
;; `initcwnd` itself is a kernel route setting (`ip route change … initcwnd N`) — no server
;; process can raise it, and hatch does not pretend to. What a framework CAN do is tell an
;; app when it has stopped fitting, which is otherwise invisible: nothing about a 60 KB page
;; fails, it is just a slower first paint than it needs to be.
(def *first-flight-budget* 14336)

(defn dev? ()
  "Whether this process is running in the dev environment (`HATCH_ENV` unset or `dev`)."
  (= (or (os/env "HATCH_ENV") "dev") "dev"))

(defn- tag-text (document start)
  "The source text of the tag opening at `start`, `<input …>` inclusive. Stops at the first
  `>`, which is wrong only for an attribute value containing a literal `>` — that truncates
  a snippet, it does not mis-detect a tag."
  (let (end (index-of document ">" start))
    (if (< end 0)
      (string/substring document start (count document))
      (string/substring document start (inc end)))))

(defn- attr-value (tag name)
  "The value of double-quoted attribute `name` in `tag`, or nil."
  ;; match ` name="` so `id="x"` is found but `data-id="x"` is not
  (let (at (index-of tag (str " " name "=\"")))
    (if (< at 0)
      nil
      (let (from (+ at (count name) 3)
            end (index-of tag "\"" from))
        (if (< end 0) nil (string/substring tag from end))))))

(defn- has-inline-handler? (tag)
  "Whether `tag` carries an inline `on…=` event handler."
  (let (scan (fn (from)
               (let (at (index-of tag " on" from))
                 (cond
                   (< at 0) false
                   ;; ` on` must be followed by letters then `=` to be a handler
                   ;; attribute rather than a value like ` only="…"`.
                   (>= (index-of tag "=" at) 0) true
                   else (scan (+ at 3))))))
    (scan 0)))

(defn- ranges (document open close width from acc)
  "Index ranges of every `open`…`close` region in `document`, as `[start end]` pairs."
  (let (start (index-of document open from))
    (if (< start 0)
      (reverse acc)
      (let (end (index-of document close start))
        (if (< end 0)
          (reverse (cons [start (count document)] acc))
          (ranges document open close width (+ end width) (cons [start end] acc)))))))

(defn- within? (position rs)
  "Whether `position` falls inside any `[start end]` range in `rs`."
  (> (count (filter rs (fn (r) (and (> position (first r)) (< position (second r)))))) 0))

(defn- inline-script-text (document)
  "Every inline `<script>` body in `document`, concatenated. External scripts contribute
  nothing here — see [[inert-controls]], which declines to judge a page that has any."
  (fold (ranges document "<script" "</script>" 9 0 nil)
    ""
    (fn (acc r)
      (let (body-start (index-of document ">" (first r)))
        (if (< body-start 0)
          acc
          (str acc " " (string/substring document (inc body-start) (second r))))))))

(defn inert-controls (document)
  "Every interactive control in `document` that provably cannot do anything, as a list of
  maps carrying `:tag`, `:id` and `:snippet`.

  A control does something if it submits a form, if an inline `on…=` handler fires, or if
  page script reaches it. A control that has none of those three is not a style question or
  a matter of taste — it is inert, and shipping it is always a bug.

  The rule declines to judge rather than guess, so it returns nothing at all for:

  - a fragment (no `<html`), whose script is the embedding page's business;
  - a page carrying any external `<script src=…>`, whose contents are not readable here;
  - a control with no `id` on a page that does have inline script, which could be reached
    by a tag or class selector this cannot see.

  What is left is exact: an `id`'d control outside any form, with no inline handler, whose
  id appears in no script on the page.

      (hatch/web/audit/inert-controls \"<html><body><input id=\\\"q\\\"></body></html>\")   → ({:tag \"input\" :id \"q\" :snippet \"<input id=\\\"q\\\">\"})"
  (if (< (index-of document "<html") 0)
    nil
    (let (external? (>= (index-of document "<script src=\"") 0)
          script-text (inline-script-text document)
          form-ranges (ranges document "<form" "</form>" 7 0 nil))
      (if external?
        nil
        (fold *controls*
          nil
          (fn (acc control)
            (let (collect (fn (from found)
                            (let (at (index-of document control from))
                              (if (< at 0)
                                found
                                (let (tag (tag-text document at)
                                      id (attr-value tag "id")
                                      unreachable? (and (not (within? at form-ranges))
                                                     (not (has-inline-handler? tag))
                                                     (if (= script-text "")
                                                       true
                                                       (and id (< (index-of script-text id) 0)))))
                                  (collect (+ at (count control))
                                    (if unreachable?
                                      (cons {:tag (string/substring control 1 (count control))
                                             :id id
                                             :snippet tag}
                                        found)
                                      found)))))))
              (append acc (reverse (collect 0 nil))))))))))

(defn warn-inert! (document)
  "Log a dev warning for every control [[inert-controls]] proves dead in `document`.
  A no-op outside dev and a no-op when the page is clean. Returns `document` unchanged, so
  it drops into a render pipeline without altering the response."
  (when (dev?)
    (doseq (finding (inert-controls document))
      (log/warn (str "[audit] inert control: <"
                  (get finding :tag)
                  (if (get finding :id) (str " id=\"" (get finding :id) "\"") "")
                  "> is outside any form, has no inline handler, and no script on the page "
                  "references it — it accepts input and does nothing. "
                  "If its behaviour comes from a companion script, the page is missing it."))))
  document)

;; ---- first flight -----------------------------------------------------------

(defn- render-blocking-refs (head)
  "Every ABSOLUTE-URL resource in `head` that blocks the first paint, as
  `{:kind :url}` maps.

  Only two shapes block: a `rel=\"stylesheet\"` link, and a classic `<script src>` with
  neither `async` nor `defer` (a `type=\"module\"` script is deferred by definition). A
  `preconnect`/`dns-prefetch`/`preload` hint blocks nothing and is deliberately not
  reported — it is the mitigation, not the problem."
  (append (blocking-links head) (blocking-scripts head)))

(defn- absolute? (url)
  (or (string/starts-with? url "https://") (string/starts-with? url "http://")))

(defn- scan-tags (document open collect from acc)
  "Fold `collect` over every tag opening with `open` in `document`."
  (let (at (index-of document open from))
    (if (< at 0)
      (reverse acc)
      (let (tag (tag-text document at))
        (scan-tags document open collect (+ at (count open)) (collect acc tag))))))

(defn- blocking-links (head)
  (scan-tags head
    "<link"
    (fn (acc tag)
      (let (href (attr-value tag "href")
            rel (attr-value tag "rel"))
        (if (and href (= rel "stylesheet") (absolute? href))
          (cons {:kind "stylesheet" :url href} acc)
          acc)))
    0
    nil))

(defn- blocking-scripts (head)
  (scan-tags head
    "<script"
    (fn (acc tag)
      (let (src (attr-value tag "src"))
        (if (and src
              (absolute? src)
              (< (index-of tag " async") 0)
              (< (index-of tag " defer") 0)
              (not (= (attr-value tag "type") "module")))
          (cons {:kind "script" :url src} acc)
          acc)))
    0
    nil))

(defn head-of (document)
  "The `<head>` section of `document`, or the whole thing when there is no `</head>` — a
  fragment has no head, and scanning all of it is the conservative reading."
  (let (end (index-of document "</head>"))
    (if (< end 0) document (string/substring document 0 end))))

(defn first-flight (document)
  "How `document` fares against the initial congestion window, as
  `{:bytes :compressed :budget :over? :blocking}`.

  `:compressed` is the real gzipped length, not an estimate — the wire carries the
  compressed bytes, so an estimate would be the wrong number to budget against. `:over?`
  compares it with [[*first-flight-budget*]]. `:blocking` lists the absolute-URL
  render-blocking resources in the `<head>`; each one on another origin costs a DNS lookup,
  a TCP handshake and a TLS handshake BEFORE the first paint, which routinely costs more
  than the document itself.

  A pure measurement — call it from a test or a script, not only from the dev warning."
  (let (raw-size (count document)
        ;; Compression can only shrink, so a document already inside the budget is inside it
        ;; whatever it compresses to — and gzipping to learn that is pure waste. It is not
        ;; small waste either: this runs on every response in dev, and gzipping a 437 KB page
        ;; measured 14 ms against 0.8 ms to render it, so the audit cost seventeen times what
        ;; it was watching.
        compressed (if (<= raw-size *first-flight-budget*) raw-size (count (zlib/gzip document))))
    {:bytes raw-size
     :compressed compressed
     :budget *first-flight-budget*
     :over? (> compressed *first-flight-budget*)
     :blocking (render-blocking-refs (head-of document))}))

(defn warn-first-flight! (document)
  "Log a dev warning when `document` cannot paint in one round trip. A no-op outside dev
  and a no-op when the page is within budget and has no third-party render-blocking
  resource. Returns `document` unchanged.

  Deliberately advisory. A reference manual or a changelog is legitimately large, and being
  over budget is a trade an app is allowed to make knowingly — what it should not be is a
  thing nobody measured."
  (when (dev?)
    (let (report (first-flight document))
      (when (get report :over?)
        (log/warn (str "[audit] first flight: "
                    (get report :compressed)
                    " gzipped bytes over a "
                    (get report :budget)
                    "-byte initial congestion window — this document needs more than one "
                    "network round trip before it can start painting.")))
      (doseq (ref (get report :blocking))
        (log/warn (str "[audit] render-blocking "
                    (get ref :kind)
                    " in <head>: "
                    (get ref :url)
                    " — an absolute URL blocks the first paint on a DNS lookup plus a TCP "
                    "and TLS handshake to that origin. Self-host it, or preconnect.")))))
  document)

(defn warn-page! (document)
  "Run every page audit and return `document` unchanged — the single hook a renderer calls.
  Currently [[warn-inert!]] and [[warn-first-flight!]]."
  (warn-first-flight! (warn-inert! document)))
