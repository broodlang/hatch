(defmodule web/registry
  "Supervised, crash-durable named registries — the shared scaffolding behind web/pubsub
  and web/presence (web/live's route table uses the same shape inline).

  A registry is a process holding live state; a sibling *vault* process holds a snapshot of
  it. Both run under one supervisor (`:strategy :one-for-one`, `:restart :permanent`), which
  restarts either on crash and bounds a crash loop. When the registry restarts it recovers
  its state by pulling the vault's snapshot; it then re-establishes anything derived from
  that state (e.g. re-`monitor`ing restored pids). Recovery is one-directional — the registry
  pulls from the vault, the vault never pulls — so the two can't deadlock at boot. The vault
  starts before the registry, so the first pull sees an empty (or last-known) snapshot.

  This covers the single-fault case (registry crash → recover from vault). The vault is also
  supervised; if it crashes it restarts empty and is repopulated by the registry's next
  `mirror` (registries mirror their full snapshot on every state change)."
  (:alias supervisor))

(defn await (nm tries)
  "Block until `nm` is registered (supervisor children start asynchronously). Gives up after
  `tries` × 5ms — callers treat a miss as 'not up yet' rather than erroring."
  (cond
    (proc/whereis nm) :ok
    (<= tries 0) :ok
    else (do (sleep 5) (await nm (- tries 1)))))

(defn ensure-supervised (sup-name children wait-name)
  "The pid registered as `wait-name`. On first use (or after a teardown) start the supervisor
  for `children` — idempotent via its `:name`, so concurrent callers and hot reloads converge
  on one — and wait through the brief async-start window."
  (or (proc/whereis wait-name)
    (do
      (supervisor/start children {:name sup-name :strategy :one-for-one})
      (await wait-name 60)
      ;; Raise rather than answer nil. The docstring promises "the pid", and every caller
      ;; takes it at its word — `(send (pubsub) …)`, `(send (presence) …)` and the rest
      ;; passed the nil straight to `send`, which fails far from the cause with a message
      ;; about the wrong thing. If the child never registered inside the window, that is
      ;; what went wrong and this is where it is known.
      (or (proc/whereis wait-name)
        (error "ensure-supervised: "
          wait-name " did not register within the start window")))))
(sig ensure-supervised (any any any -> pid))

(defn vault-loop (snapshot)
  "A durable mirror: holds the latest snapshot pushed via `[:set s]` and serves it on
  `[:get-snapshot from]`. It never pulls, so registry and vault can't deadlock at boot."
  (receive
    ([:set s] (vault-loop s))
    ([:get-snapshot from] (do (send from [:snapshot snapshot]) (vault-loop snapshot)))))

(defn pull-snapshot (vault-name default)
  "Pull the vault's snapshot — the registry calls this on boot to recover. `default` if the
  vault isn't up yet (first boot) or doesn't answer in time."
  (let (v (proc/whereis vault-name))
    (if (nil? v)
      default
      (do
        (send v [:get-snapshot (self)])
        (receive
          ([:snapshot s] s)
          (after 1000 default))))))

(defn mirror (vault-name snapshot)
  "Push the current snapshot to the vault (best-effort; the vault may be mid-restart, in
  which case the next mirror repopulates it). Returns nil."
  (let (v (proc/whereis vault-name))
    (when v (send v [:set snapshot])))
  nil)

;; ---- monitor bookkeeping ------------------------------------------------------------
;;
;; Every registry built on this scaffolding holds the same second map alongside its state: a
;; `monitors` map of `pid → ref`. It exists so a registry can *demonitor* — a long-lived live
;; session subscribes and unsubscribes across every live-navigation, and monitoring on each
;; one without releasing the last piles refs onto the session pid without bound. That is a
;; leak with no symptom until a session has navigated a few hundred times.
;;
;; web/pubsub and web/presence each carried their own copy of these three, identical down to
;; the `(when ref (demonitor ref))`. One copy, one place to fix, and a registry the two of
;; them do not yet share (web/live's route table) can adopt it without re-deriving the rule.

(defn monitor-each (pids)
  "A fresh `pid → ref` map monitoring every pid in `pids` — what a registry rebuilds on boot
  for the pids it just recovered from the vault. One that died during the crash window
  re-fires `[:down]` immediately and is cleaned up by the loop's ordinary dead-pid arm."
  (fold pids {} (fn (monitors pid) (assoc monitors pid (monitor pid)))))

(defn hold-monitor (monitors pid)
  "`monitors` with `pid` monitored, if it isn't already. Idempotent: a pid subscribing to a
  second topic must not take a second ref on the same process."
  (if (contains? monitors pid) monitors (assoc monitors pid (monitor pid))))

(defn release-monitor (monitors pid)
  "Demonitor `pid` — its last entry in this registry is gone — and drop it from `monitors`.
  Safe on a pid that was never monitored."
  (let (ref (get monitors pid))
    (when ref (demonitor ref)))
  (dissoc monitors pid))

;; ---- watching the vault -------------------------------------------------------------

(defn watch-vault (vault-name)
  "Monitor the vault registered as `vault-name`, so its death arrives as a `[:down]` in the
  registry's own mailbox and the registry can re-mirror to the restarted one. The ref, or nil
  if the vault isn't up yet (the registry then simply never hears about it — the next
  `mirror` repopulates whatever came back)."
  (let (vault (proc/whereis vault-name))
    (if vault (monitor vault) nil)))

(defn rewatch-vault (vault-name snapshot)
  "Recover from the vault's death: wait for the supervisor to bring it back, push `snapshot`
  so the backup is whole again, and monitor the fresh process. Returns the new ref, which the
  registry loop carries in place of the dead one.

  Without the re-mirror a vault restart (empty) followed by a registry restart before the next
  state change would recover an empty registry — a silent, total loss of subscriptions or
  rosters that no crash report names."
  (await vault-name 60)
  (mirror vault-name snapshot)
  (watch-vault vault-name))
