(defmodule web/mcp
  "WebMCP — declare this page's capabilities as tools an in-browser agent can call.

  A page that only renders HTML leaves an agent to scrape it: read the markup, guess which
  input is the search box, submit it, parse the result page. WebMCP lets the page say what
  it can do instead — a name, a description, a JSON Schema for the arguments, and the
  endpoint that answers. The agent calls the same API a client would.

  Tools are declared as DATA and rendered into a JSON block; hatch's bundled
  `brood_webmcp.js` reads that block and registers each one. Nothing here emits JavaScript
  built from application strings, which is both an injection surface and, in this tree, a
  thing the CI gate refuses.

  The API is young and has moved — the getter has been specified on both `navigator` and
  `document`, and the earlier `provideContext`/`clearContext` pair was replaced by
  `registerTool`. The client probes both and does nothing where neither exists, so a page
  carrying tools is unchanged in a browser that has never heard of them, and for a crawler.

      (mcp/tools-script
        [{:name \"searchPackages\"
          :description \"Search the registry by name or description.\"
          :input-schema {:type \"object\"
                         :properties {:q {:type \"string\" :description \"search text\"}}
                         :required [\"q\"]}
          :endpoint {:method \"GET\" :url \"/api/v1/packages\" :query [\"q\"]}}])"
  (:alias web/template)
  ; serve-body — the static cache pipeline (content ETag, 304, nosniff)
  (:alias web/static :as static))

(def *block-id* "hatch-mcp-tools")

(defn- present? (s) (and (string? s) (not (= s ""))))

(defn tools-script (tools)
  "The Hiccup for `tools`: a JSON block of definitions plus the client that registers them.

  Put it in the body of any page whose tools apply. Answers \"\" for no tools, so a page
  with nothing to offer carries no markup and no request."
  (if (empty? tools)
    ""
    [:div
      {}
      [:script
        {:type "application/json" :id *block-id*}
        (web/template/raw (web/template/script-safe (json/encode (map tools validated-tool))))]
      [:script {:type "module" :src (client-path)}]]))

(def *form-tool-attr* "toolname")

(defn form-tool (spec)
  "The declarative WebMCP attributes for a `<form>`, as a map to merge into its own.

  The JSON block above is the *imperative* API: a tool the page registers through
  JavaScript, backed by whatever endpoint you name. This is the other half of the
  specification, and it needs no JavaScript at all — the browser reads the annotations off
  the form, generates the input schema from the fields, and the tool IS the form.

      [:form
        (merge {:action \"/packages\" :method \"get\"}
          (mcp/form-tool {:name \"searchPackages\"
                          :description \"Search the package registry by name.\"
                          :autosubmit true}))
        [:label {:for \"q\"} \"Search\"]
        [:input {:id \"q\" :name \"q\" :toolparamdescription \"Search text.\"}]]

  Which to use is not a style question. A form that already does the thing wants the
  declarative form: there is no endpoint to duplicate, no second code path to keep in step,
  and — the part that matters in practice — an annotated form is STATIC HTML, so a crawler,
  a scanner or an agent that never runs the page can still see the capability. The
  imperative API is for a capability that is not a form: a lookup with no UI, an action the
  page performs itself.

  `:autosubmit` lets an agent submit the form once it has filled it, rather than filling it
  and waiting for a person. Right for a search; wrong for anything that spends money or
  cannot be undone, which is why it is off unless asked for.

  Per-field descriptions are a `:toolparamdescription` on the control itself — an ordinary
  attribute, so no helper is needed. Without one the browser uses the field's `<label>`,
  which is usually what you would have written anyway."
  (let (nm (get spec :name)
        description (get spec :description))
    (when (not (present? nm))
      (error "web/mcp/form-tool: a form tool needs a :name — an agent selects on it: " spec))
    (when (not (valid-name? nm))
      (error "web/mcp/form-tool: :name must be letters, digits, _ or - (got): " nm))
    (when (not (present? description))
      (error "web/mcp/form-tool: tool " nm " needs a :description — it is what an agent chooses on"))
    (let (base {:toolname nm :tooldescription description})
      (if (get spec :autosubmit) (assoc base :toolautosubmit true) base))))

(defn client-path ()
  "The URL the bundled client is served from. Override by serving it elsewhere and passing
  your own `<script src>`; this is the path `client-js-handler` is meant to sit on."
  "/static/brood_webmcp.js")

(defn validated-tool (tool)
  "`tool` as the wire shape the client expects, or a raised error naming what is wrong.

  Validated at RENDER time and not left to the browser, because a malformed tool is silent
  where it lands: the page looks right, the agent surface simply never offers it. The
  requirements are the specification's — a name, a description an agent can choose on, and
  an object schema for the arguments."
  (let (name (get tool :name)
        description (get tool :description)
        schema (get tool :input-schema))
    (when (not (present? name))
      (error "web/mcp: a tool needs a :name — an agent selects on it: " tool))
    (when (not (valid-name? name))
      (error "web/mcp: tool :name must be letters, digits, _ or - (got): " name))
    (when (not (present? description))
      (error "web/mcp: tool " name " needs a :description — it is what an agent chooses on"))
    (when (not (object-schema? schema))
      (error "web/mcp: tool " name " needs an :input-schema of {:type \"object\" :properties {…}}"))
    (when (not (present? (get (get tool :endpoint {}) :url)))
      (error "web/mcp: tool " name " needs an :endpoint with a :url"))
    {:name name
     :description description
     :inputSchema schema
     :endpoint (get tool :endpoint)}))

;; The characters a tool name may contain, as a SET — the same shape `web/bml` and
;; `http/request` use, so the check is one native scan rather than a per-character loop
;; comparing codepoint ranges by hand.
(def- *name-chars*
  "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-")

(defn valid-name? (name)
  "A tool name an agent can address: letters, digits, `_` or `-`, nothing else."
  (and (string? name)
    (> (string/length name) 0)
    (= (string/span name 0 *name-chars*) (string/length name))))

(defn object-schema? (schema)
  "Whether `schema` is the object JSON Schema the tool contract requires. A tool takes named
  arguments, so anything else — a bare string, an array, a missing `:properties` — would be
  registered and then never callable."
  (and (map? schema)
    (= (get schema :type) "object")
    (map? (get schema :properties))))

;; ---- serving the bundled client ---------------------------------------------
;; The package's own static/ dir is located and served by web/static (bundled-path /
;; bundled-source / bundled-js-handler) — the same three it serves brood_live.js through.

(def *client-file* "brood_webmcp.js")

(defn asset-path ()
  "Absolute path to hatch's bundled `static/brood_webmcp.js`."
  (static/bundled-path *client-file*))

(defn client-js ()
  "The bundled client's source, or nil if it can't be located."
  (static/bundled-source *client-file*))

(defn client-js-handler ()
  "A conn handler serving the bundled client, so an app can wire it straight from the
  package:

      (get \"/static/brood_webmcp.js\" (mcp/client-js-handler))"
  (static/bundled-js-handler *client-file*))
