; base64-decode — Authorization carries base64(user:pass)
(defmodule web/auth
  "Authentication plugs for the router's `through` groups. A plug is a conn→conn
  function: it either passes the conn along (optionally enriched, e.g. with an assigned
  `:current-user`) or halts it with a rejection response. `basic-auth` is the one built
  in — HTTP Basic credentials, enough to gate a dev/admin endpoint:
    (through [(auth/basic-auth \"admin\" \"admin\")]
      (get \"/dev\" dev-info))"
  ; header, put-resp-header, send-resp, halt, assign
  (:use web/conn)
  (:use encoding)
  ; constant-time-equal? — constant-time credential comparison (no timing oracle)
  (:use crypto)
  ; items — the comma-separated allow-list read from the environment
  (:alias web/env))
(defn basic-auth (username password &optional (realm "Restricted"))
  "A plug that requires HTTP Basic auth matching `username`:`password`. On a match it
  assigns `:current-user` (the username) and passes the conn through; otherwise it halts
  the conn with a 401 + `WWW-Authenticate: Basic` challenge, which makes a browser show
  its native login prompt. `realm` labels that prompt."
  (fn (conn)
    (if (basic-auth-ok? conn username password)
      (assign conn :current-user username)
      (halt (basic-auth-challenge conn realm)))))

(defn basic-auth-ok? (conn username password)
  "True if the conn's Authorization header carries Basic creds equal to
  `username`:`password`. Uses a constant-time compare (`constant-time-equal?`), not `=`, so the response
  time can't be used as an oracle to recover the password byte-by-byte."
  (let (creds (basic-auth-creds conn))
    (and creds
      (constant-time-equal? (string/->bytes creds)
        (string/->bytes (str username ":" password))))))

(defn basic-auth-creds (conn)
  "The decoded `user:pass` string from a `Basic <base64>` Authorization header, or nil
  if the header is absent or not well-formed Basic auth. Malformed base64 (or bytes that
  aren't valid UTF-8) yields nil — never a thrown error — so a hostile Authorization header
  fails closed to a 401 instead of crashing the worker (a pre-auth DoS)."
  (let (raw (header conn :authorization)
        prefix "Basic ")
    (if (and raw (string/starts-with? raw prefix))
      ;; `base64-decode` answers a falsy `failure` on bad input rather than throwing
      ;; (brood ADR-310), so there is nothing to catch — normalise it to the `nil` this
      ;; function's contract promises.
      (let (decoded (base64-decode (string/trim (string/substring raw
                                                  (string/length prefix)
                                                  (string/length raw)))))
        (if (failure? decoded) nil decoded))
      nil)))

(defn realm-safe (realm)
  "Strip characters that would break the `WWW-Authenticate` auth-param syntax or inject a
  header — double quotes and CR/LF."
  (-> (str realm)
    (string/replace "\"" "")
    (string/replace "\r" "")
    (string/replace "\n" "")))

(defn basic-auth-challenge (conn realm)
  "A 401 conn carrying the `WWW-Authenticate: Basic` challenge for `realm`."
  (-> conn
    (put-resp-header :www-authenticate
      (str "Basic realm=\"" (realm-safe realm) "\", charset=\"UTF-8\""))
    (send-resp 401 "<h1>401 Unauthorized</h1>")))

;; ---- bearer tokens ----------------------------------------------------------

(defn bearer-token (conn)
  "The raw token from an `Authorization: Bearer <token>` header, or nil when the header is
  absent, uses another scheme, or carries an empty token.

  The scheme is matched **case-insensitively**, because RFC 9110 §11.1 says it is one. A
  `(string/starts-with? raw \"Bearer \")` test — the obvious way to write this, and the way
  everyone writes it — rejects `bearer <token>`, which is what several HTTP clients and
  every hand-written `curl` eventually sends. The token itself is returned verbatim and
  never lowercased.

  The value is opaque here: it may be an API token to hash and look up, or a JWT to verify.
  This only pulls it out of the envelope."
  (let (raw (header conn :authorization)
        prefix "bearer ")
    (if (and raw
          (>= (string/length raw) (string/length prefix))
          (= (string/lower (string/substring raw 0 (string/length prefix))) prefix))
      (let (token (string/trim (string/substring raw (string/length prefix) (string/length raw))))
        (if (= token "") nil token))
      nil)))

(defn bearer-auth (lookup &optional (opts {}))
  "A plug that requires a bearer token `lookup` recognises.

  `lookup` is `(fn (token) -> user-or-nil)` — your own token store, since what a token
  identifies and how it is stored is not the framework's business. On a hit the result is
  assigned as `:current-user` and the conn passes through; otherwise the conn is halted with
  a 401 and a `WWW-Authenticate: Bearer` challenge.

      (through [(auth/bearer-auth accounts/user-for-token)]
        (post \"/api/v1/publish\" api/publish))

  `:realm` labels the challenge. `:body` replaces the rejection body — pass a JSON one for
  an API, so a client's decoder gets an object rather than a document:

      (auth/bearer-auth lookup {:body \"{\\\"error\\\":\\\"authentication required\\\"}\"
                                :content-type \"application/json\"})

  Unlike `basic-auth` there is no constant-time compare here: the comparison happens inside
  `lookup`, against a stored hash of the token rather than the token itself, which is where
  it belongs."
  (let (realm (get opts :realm "API")
        body (get opts :body "<h1>401 Unauthorized</h1>")
        content-type (get opts :content-type nil))
    (fn (conn)
      (let (token (bearer-token conn)
            user (and token (lookup token)))
        (if user
          (assign conn :current-user user)
          (halt (bearer-challenge conn realm body content-type)))))))

(defn bearer-challenge (conn realm body content-type)
  "A 401 conn carrying the `WWW-Authenticate: Bearer` challenge for `realm`."
  (let (challenged (put-resp-header conn
                     :www-authenticate (str "Bearer realm=\"" (realm-safe realm) "\"")))
    (send-resp (if content-type (put-resp-header challenged :content-type content-type) challenged)
      401 body)))

;; ---- address allow-lists ----------------------------------------------------

(def *client-ip-headers* [:fly-client-ip :x-real-ip :cf-connecting-ip])

(defn client-ip (conn)
  "The originating client's address, or nil.

  Behind a proxy the socket peer is the PROXY, so an allow-list compared against it would
  admit everyone or no one. The address has to come from a header the proxy sets:
  `Fly-Client-IP`, `X-Real-IP`, `CF-Connecting-IP`, then the first entry of
  `X-Forwarded-For`.

  Only trustworthy because the proxy OVERWRITES these on the way in. Read them from a
  request that did not come through one — a direct connection, a misconfigured route — and
  they are whatever the client typed, so an allow-list built on this must be the outer of
  two defences and never the only one."
  (let (headers (or (conn-headers conn) {})
        direct (first (seq/filter (map *client-ip-headers* (fn (h) (get headers h)))
                        (fn (v) (and (string? v) (not (= v ""))))))
        forwarded (get headers :x-forwarded-for))
    (cond
      direct (string/trim direct)
      (and (string? forwarded) (not (= forwarded "")))
        (string/trim (first (string/split forwarded ",")))
      else nil)))

(defn- normalise-ip (address)
  "Lowercased and stripped of a `[…]` wrapper or a `:port` suffix on a v4 address, so a
  configured address and a header value compare equal."
  (let (lower (string/lower (string/trim address))
        unbracketed (if (string/starts-with? lower "[")
                      (let (close (index-of lower "]"))
                        (if (< close 0) lower (string/substring lower 1 close)))
                      lower)
        ;; a single colon is a v4 host:port; several mean it is v6, where colons are the
        ;; address itself
        colons (count (seq/filter (string/->list unbracketed) (fn (c) (= c ":")))))
    (if (= colons 1) (first (string/split unbracketed ":")) unbracketed)))

(defn- ipv6-groups (address)
  "An IPv6 address as its eight 16-bit groups, lowercased and zero-padded, expanding a `::`
  run. nil for anything that is not IPv6."
  (if (< (count (seq/filter (string/->list address) (fn (c) (= c ":")))) 2)
    nil
    (let (halves (string/split address "::")
          head (seq/filter (string/split (first halves) ":") (fn (g) (not (= g ""))))
          ;; bound and nil-checked, not counted then indexed — the count never reaches
          ;; `(second halves)`
          after (second halves)
          tail (if (nil? after)
                 []
                 (seq/filter (string/split after ":") (fn (g) (not (= g "")))))
          gap (- 8 (+ (count head) (count tail)))
          filled (append (into [] head)
                   (map (range (%max 0 gap)) (fn (_) "0"))
                   (into [] tail)))
      (if (= (count filled) 8)
        (apply vector (map filled (fn (g) (string/pad-left (string/lower g) 4 "0"))))
        nil))))

(defn- prefix-match? (address entry)
  "Whether `address` falls inside `entry` when `entry` is written as `prefix/bits`.

  Only IPv6, and only prefix lengths that are a multiple of 16 — which covers the ones
  anyone writes by hand (/32, /48, /64) and needs no bit arithmetic. Anything else is not a
  match rather than a guess.

  This exists because an IPv6 privacy address ROTATES its host half: the same machine on the
  same network appears as `2c0f:ef18:1b2e:0:231b:…` one day and `2c0f:ef18:1b2e:0:5d71:…`
  the next. An allow-list of exact addresses locks its owner out on the next rotation, which
  is not a hypothetical — it happened within an hour of the first one being set."
  (match (string/split entry "/")
    ((prefix bits-text)
      (let (bits (string/->number bits-text)
            groups (ipv6-groups prefix)
            theirs (ipv6-groups address))
        ;; `int?`, not `(not (failure? …))`: `math/rem` below wants an int, and a
        ;; non-failure could still be a float — "2c0f::/64.5" parses.
        (and (int? bits)
          groups
          theirs
          (= 0 (math/rem bits 16))
          (> bits 0)
          (<= bits 128)
          (let (n (/ bits 16))
            (= (apply vector (take groups n)) (apply vector (take theirs n)))))))
    (_ false)))

(defn allowed-ip? (conn allowed)
  "Whether this request's client address is admitted by `allowed` — a list of exact
  addresses and/or IPv6 `prefix/bits` ranges (`2c0f:ef18:1b2e:0::/64`).

  An empty list allows nothing, and an unknown address is not allowed — a gate that cannot
  identify the caller must not admit them."
  (let (address (client-ip conn))
    (and address
      (let (normalised (normalise-ip address))
        (any? allowed
          (fn (entry)
            (if (includes? entry "/")
              (prefix-match? normalised (string/trim entry))
              (= (normalise-ip entry) normalised))))))))

(defn allow-ips (allowed &optional (opts {}))
  "A plug admitting only requests from `allowed` addresses.

  Everything else gets a 404, not a 403: a 403 confirms the endpoint exists and is worth
  attacking, which for an admin surface is the one thing not to volunteer. Pass
  `:status`/`:body` to say otherwise.

      (through [(auth/allow-ips (string/split (os/env \"DASHBOARD_IPS\") \",\"))]
        (get \"/dashboard\" dashboard/index))

  Give it the addresses at runtime — from an environment variable or a secret — rather than
  baking them in: a residential address changes, and an allow-list in the image needs a
  deploy to fix while locking you out in the meantime.

  For IPv6, prefer a `/64` prefix over an exact address. A privacy address rotates its host
  half, so the same machine on the same network stops matching within a day.

  An address gate is a coarse outer defence. It stops the internet; it does not stop anyone
  who shares your network, and it rests on a proxy header (see `client-ip`). Put real
  authentication behind it for anything that matters."
  (let (status (get opts :status 404)
        body (get opts :body "<h1>404 Not Found</h1>"))
    (fn (conn)
      (if (allowed-ip? conn allowed)
        conn
        (halt (send-resp conn status body))))))

(defn allow-ips-from-env (var &optional (opts {}))
  "`allow-ips` with the list read from environment variable `var` — comma-separated, at
  boot.

      (through [(auth/allow-ips-from-env \"DASHBOARD_IPS\")]
        (get \"/dashboard\" (web/dashboard/handler {})))

  This is the form `allow-ips`' own docstring tells you to use, so it may as well be one
  call. An unset variable yields an empty list, which admits NOBODY (`web/env/items`
  answers `[]`, and `allowed-ip?` refuses an empty list): a gate whose list was never
  configured must close, not open."
  (allow-ips (web/env/items var) opts))
