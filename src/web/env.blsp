(defmodule web/env
  "Typed reads of the process environment.

  `os/env` answers a string or nil, and every app then writes the same three guards around
  it: is it set, is it blank, is it the shape I asked for. Written out per call site those
  guards drift, and one of them has a trap in it — so they belong in one place.

  **The trap is `string/->number`.** It answers a `failure` for junk rather than raising,
  and a `failure` is TRUTHY. So `(if (string/->number raw) …)` admits `\"abc\"`, and the
  comparison that was supposed to validate it (`(> parsed 0)`) then raises deep inside the
  numeric builtin, naming neither the variable nor the environment it came from.
  `as-integer` guards with `int?`, which is the only check that answers the question
  actually being asked.

  Each type comes as a **pure parser** (`as-text`, `as-integer`, …) and a one-line reader
  that applies it to a variable (`text`, `integer`, …) — the split `web/application`'s
  `valid-level` already uses, and the reason the parsing is testable at all: brood's
  environment is read-only, so a test that could only go through `os/env` could not set up
  its own input.

  Nothing is cached: a variable is read on each call, so a value that changes between two
  reads is seen. The cost is a table lookup, not a syscall.")

;; ---- parsers ----------------------------------------------------------------

(defn as-text (raw &optional (fallback nil))
  "`raw` trimmed, or `fallback` when it is nil or blank.

  Blank counts as unset, deliberately. A variable set to `\"\"` is what a deploy tool
  writes for a secret it could not find, and treating that as a configured empty value is
  how an empty allow-list becomes an open one.

      (hatch/web/env/as-text \"  hello  \") ;=> \"hello\"
      (hatch/web/env/as-text \"   \" \"default\") ;=> \"default\"
      (hatch/web/env/as-text nil) ;=> nil"
  (if (or (nil? raw) (string/blank? raw)) fallback (string/trim raw)))

(defn as-integer (raw &optional (fallback nil))
  "`raw` as an integer, or `fallback` when it is unset, blank, or not an integer. A float
  is not an integer — see the module docstring for why the check is `int?` and not
  truthiness.

      (hatch/web/env/as-integer \"8080\" 5000) ;=> 8080
      (hatch/web/env/as-integer \"abc\" 5000) ;=> 5000
      (hatch/web/env/as-integer \"1.5\" 5000) ;=> 5000"
  (let (trimmed (as-text raw))
    (if (nil? trimmed)
      fallback
      (let (parsed (string/->number trimmed)) (if (int? parsed) parsed fallback)))))

(defn as-positive-integer (raw &optional (fallback nil))
  "`raw` as an integer greater than zero, else `fallback`.

  The shape a duration, a size limit or a pool size wants: zero and negative values are
  rejected at the read rather than arriving as a timeout that fires immediately or a cap
  that rejects everything.

      (hatch/web/env/as-positive-integer \"30\" 60) ;=> 30
      (hatch/web/env/as-positive-integer \"0\" 60) ;=> 60
      (hatch/web/env/as-positive-integer \"-1\" 60) ;=> 60"
  (let (parsed (as-integer raw nil))
    (if (and (int? parsed) (> parsed 0)) parsed fallback)))

(def- *falsey* #{"0" "false" "no" "off"})

(defn as-flag? (raw)
  "Whether `raw` means yes — anything except nil, blank, `0`, `false`, `no`, or `off`
  (case-insensitive).

  Presence alone is not enough: `FEATURE_X=0` is how someone turns a flag off without
  deleting the line, and reading that as on is the opposite of what they wrote.

      (hatch/web/env/as-flag? \"1\") ;=> true
      (hatch/web/env/as-flag? \"0\") ;=> false
      (hatch/web/env/as-flag? \"FALSE\") ;=> false
      (hatch/web/env/as-flag? nil) ;=> false"
  (let (trimmed (as-text raw))
    ;; `if`, not `and`: an `and` that short-circuits on nil answers NIL, and a predicate
    ;; whose contract is a boolean must answer one — `(= (as-flag? nil) false)` is a
    ;; perfectly ordinary thing for a caller to write.
    (if (nil? trimmed) false (not (contains? *falsey* (string/lower trimmed))))))

(defn as-items (raw &optional (separator ","))
  "`raw` split on `separator`, each entry trimmed, empty entries dropped — `[]` when `raw`
  is nil or blank.

  `[]` and not nil, because the thing this is usually read for is an allow-list, and an
  allow-list that cannot be read must admit nobody rather than everybody
  (`web/auth/allowed-ip?` refuses an empty list). A trailing separator or a stray space is
  how these are actually typed, so neither produces a phantom entry.

      (hatch/web/env/as-items \"a, b ,c\") ;=> [\"a\" \"b\" \"c\"]
      (hatch/web/env/as-items \"a,b,\") ;=> [\"a\" \"b\"]
      (hatch/web/env/as-items nil) ;=> []"
  (let (trimmed (as-text raw))
    (if (nil? trimmed)
      []
      (seq/filterv (mapv (string/split trimmed separator) string/trim)
        (fn (entry) (not (= entry "")))))))

;; ---- readers ----------------------------------------------------------------

(defn text (var &optional (fallback nil))
  "`$var` trimmed, or `fallback` when it is unset or blank."
  (as-text (os/env var) fallback))

(defn integer (var &optional (fallback nil))
  "`$var` as an integer, or `fallback`."
  (as-integer (os/env var) fallback))

(defn positive-integer (var &optional (fallback nil))
  "`$var` as an integer greater than zero, or `fallback`."
  (as-positive-integer (os/env var) fallback))

(defn flag? (var)
  "Whether `$var` is set to something that means yes."
  (as-flag? (os/env var)))

(defn items (var &optional (separator ","))
  "`$var` split on `separator` — trimmed, empties dropped, `[]` when unset."
  (as-items (os/env var) separator))

;; ---- the environment itself -------------------------------------------------

(def *env-var* "HATCH_ENV")
(def *dev-name* "dev")

(defn name-of ()
  "The environment this process is running in: `$HATCH_ENV`, or `\"dev\"` when unset."
  (text *env-var* *dev-name*))

(defn dev? ()
  "True when `$HATCH_ENV` is unset or names the dev environment.

  Dev is the zero-config default, so a plain `nest run` needs nothing set — and a deploy
  that forgets to set this gets dev behaviour, which is the safe direction for the asset
  watchers and the page audits and the *unsafe* one for secrets.
  `web/session/check-secret` is therefore the one place that must fail loudly rather than
  trust this."
  (= (name-of) *dev-name*))

(defn prod? ()
  "True unless `$HATCH_ENV` names the dev environment — the inverse of `dev?`, spelled out
  because the reading side usually wants the positive form ('serve immutable asset URLs',
  'set the cookie Secure flag')."
  (not (dev?)))
