(defmodule web/endpoint
  "The standard endpoint: everything between a raw request and the bytes that answer it.

  `conn/router->handler` is the three-line version — build, route, serialize — and it is
  enough for a demo. A real endpoint wants six more things, and every app that writes them
  itself writes the same six, in an order that matters:

  1. **Process isolation with a deadline.** Each request runs as a `task`, so a handler that
     raises cannot take the worker down and one that wedges cannot hold the connection open
     forever.
  2. **A log line for the crash.** A request inside a task comes back as `[:task-error h msg]`
     rather than propagating, which means `http/server`'s own exception telemetry never fires
     for it. An adapter that binds that message to `_msg` and drops it — the obvious way to
     write this — leaves a 500 with no recorded cause anywhere, and the only way left to
     learn anything is to reproduce it by hand.
  3. **A validator on the response.** Marking a page `no-cache` is correct and says
     *revalidate before reuse*; with no ETag on it every one of those revalidations is a
     full 200 carrying the whole body, forever, and nothing about it looks wrong.
  4. **Compression, after the validator.** The ETag is computed against the body a cache
     would store, so asking first means a 304 skips the compression work entirely instead of
     compressing a body that is never sent.
  5. **Baseline security headers**, applied without clobbering what a handler set.
  6. **Themed errors** (`web/errors`), which must skin the framework's bare 404 while leaving
     a JSON body and a handler's own rendered page alone.

  So:

      (web/endpoint/serve
        {:router     routes/app-router
         :assets     *assets*
         :freshness  {:max-age 60 :stale-for 600}
         :errors     {:render my-error-page}})

  Every key has a default and only `:router` is required. The pipeline order is fixed
  because it is the part that is easy to get wrong and impossible to notice."
  (:alias http/server)
  (:alias web/conn)
  (:alias web/live)
  ; channel-dispatcher / channel-table — the topic-socket half of the WebSocket layer,
  ; routed beside live views by `ws-handler`
  (:alias web/channel)
  ;; serve — the path-safe static handler behind the :static stage; client-js-handler on
  ;; web/live and web/mcp serve hatch's own two browser clients out of the package
  (:alias web/static)
  (:alias web/mcp)
  (:alias web/errors)
  ;; chosen-encoding / encode-body — the coding choice and the encoder, one implementation
  ;; for every app rather than an `accepts-gzip?` per app that matches the literal "gzip"
  ;; and serves a br-only client uncompressed.
  (:alias web/compress :as compress)
  ;; conditional / etag-for — the validator that makes a mandated revalidation cheap
  (:alias web/cache :as cache)
  ;; ensure (dev: install + build + watch) / prepare (prod boot: fingerprint + precompress)
  (:alias web/assets)
  (:alias web/env)
  (:alias task)
  (:alias log))

;; ---- defaults ---------------------------------------------------------------

;; Hard deadline per request — kills a wedged handler and answers 504. Generous, because it
;; is a backstop against a bug and not a latency budget: a handler that legitimately needs
;; longer than this should be streaming or a background job.
(def *default-timeout-ms* 30000)

;; Below this, the ~20-byte framing overhead is not worth the CPU.
(def *default-compress-min-bytes* 256)

(def *default-security-headers*
  ;; Applied to every response — HTML, JSON, a tarball, a static file.
  ;;
  ;; A Content-Security-Policy is deliberately absent. A meaningful one needs per-page
  ;; nonces, which is an app-level decision about the app's own inline scripts; a default
  ;; CSP here would either be so loose it means nothing or would break the first page with
  ;; an inline `<style>`. Pass your own through `:security-headers`.
  {:x-content-type-options "nosniff" ; never MIME-sniff a response into an executable type
   :x-frame-options "DENY" ; clickjacking: most apps are not meant to be framed
   :referrer-policy "strict-origin-when-cross-origin"}) ; don't leak full paths cross-origin
;; Whether this runtime can compress at all. Probed once at load: the encoders are native, and
;; a runtime built without them should serve plain bodies rather than raise per request.
(def- *zlib?* (check-allow :discarded-catch (try (do zlib/gzip zlib/brotli true) (catch _e false))))

;; ---- environment ------------------------------------------------------------

(defn port (&optional (fallback 5000))
  "The port to serve on: `$HATCH_PORT` when it is a positive integer, else `fallback`.

  Non-numeric or non-positive falls back rather than raising — a platform that exports
  `PORT` and not `HATCH_PORT` should still boot on the default, and a typo should not be a
  crash loop."
  (web/env/positive-integer "HATCH_PORT" fallback))

;; ---- the response pipeline --------------------------------------------------

(def *default-hsts* "max-age=31536000")

(defn hsts-header (conn resp value)
  "Add `Strict-Transport-Security` to `resp`, but only when the request arrived over HTTPS.

  Sending it over plaintext is not merely useless — the specification says a client MUST
  ignore it there, and a header that is ignored is one nobody notices is misconfigured. So
  the guard is the behaviour, not a nicety.

  The default is `max-age=31536000` and deliberately nothing else. `includeSubDomains` is
  the usual recommendation and it is a promise hatch cannot make on an app's behalf: it
  commits every subdomain of the host to HTTPS, including ones this app has never heard of,
  and a staging or internal subdomain still serving plaintext simply stops working — with a
  year-long memory in every browser that saw the header. `preload` is the same commitment
  made irreversible, since removal means waiting to be dropped from a list compiled into
  browser builds.

  Both are right for many sites and are one string away:

      {:hsts \"max-age=31536000; includeSubDomains\"}

  `:hsts false` sends none. A handler that set its own is left alone, as with every other
  header here."
  (let (headers (get resp :headers {}))
    (if (and value (web/conn/secure? conn) (nil? (get headers :strict-transport-security)))
      (assoc resp :headers (assoc headers :strict-transport-security value))
      resp)))

;; `resp` declared `map` on the three below. Each reads it with `get`/`empty?` before
;; `assoc`ing onto it, and those narrow the parameter to `countable` — which `assoc` will not
;; take. It is a response map at every call site; saying so is what the sig is for.
(sig hsts-header (any map any -> map))

(defn- secured (conn resp config headers)
  "The baseline headers, plus HSTS — which depends on the transport and so cannot live in
  the flat default map — plus `no-transform` on anything carrying a validator.

  `no-transform` rides here because this is the last step every response passes through, so
  the directive describes the bytes actually going out. See `web/cache/forbid-transform`:
  hatch has already negotiated and tagged the representation, so an intermediary re-encoding
  it can only invalidate the tag. `:no-transform false` opts out."
  (let (secured-resp (hsts-header conn
                       (security-headers resp headers)
                       (get config :hsts *default-hsts*)))
    (if (= (get config :no-transform) false)
      secured-resp
      (cache/forbid-transform secured-resp))))

(sig secured (any map any any -> map))

(defn- as-response (v)
  "`v` as a response map.

  `cache/conditional` answers one in both arms of its result, but that result is a pair the
  checker cannot see into — so the response arrives at `secured` widened, and `secured` has to
  `assoc` onto it. Narrowing once here is cheaper than declaring every function downstream,
  and the `{}` fallback is unreachable: both arms carry a map."
  (if (map? v) v {}))

(defn security-headers (resp headers)
  "Merge baseline security `headers` into `resp`, without clobbering any a handler already
  set. The handler wins, deliberately: a page that needs to be framed, or an endpoint that
  sets its own `Referrer-Policy`, is making a decision this must not silently undo."
  (if (empty? headers)
    resp
    (assoc resp :headers (merge headers (get resp :headers {})))))

(sig security-headers (map any -> map))

(defn compress-response (conn resp opts)
  "Compress a text response body with the best coding the client accepts — brotli where it
  is offered, else gzip — as a native `Content-Encoding`.

  Runs last, so it merges `Accept-Encoding` into any `Vary` an earlier stage set (a
  freshness policy that varies by `Cookie`, say). Fires only on a *string* body (HTML, JSON,
  SVG — a binary response carries `bytes`) with no existing `Content-Encoding`, above the
  size floor, and only when the runtime has the encoders. A static asset that already served
  a precompressed sibling carries `Content-Encoding` and is skipped.

  A response with an ETag is compressed THROUGH the compressed-body cache. For a page whose
  bytes cannot change between requests, compressing is the largest remaining cost and
  produces the same output every time; the ETag identifies those exact bytes and the coding
  names the representation, so together they are the key. Without a tag (nothing worth
  validating) it compresses per request."
  (let (body (get resp :body)
        headers (get resp :headers {})
        min-bytes (get opts :min-bytes *default-compress-min-bytes*)
        coding (compress/chosen-encoding conn))
    (if (and *zlib?*
          coding
          (string? body)
          (>= (string/length body) min-bytes)
          (nil? (get headers :content-encoding)))
      (assoc resp
        :body
          (let (tag (get headers :etag))
            (if (or (nil? tag) (= tag ""))
              (compress/encode-body coding body)
              (cache/compressed [tag coding] (fn () (compress/encode-body coding body)))))
        :headers
          (assoc headers
            :content-encoding coding
            ;; `cache/merge-vary`, not a substring test — an existing `accept-encoding` in
            ;; any casing but the one being added fails a naive match and the token goes out
            ;; twice.
            :vary (cache/merge-vary (get headers :vary) "Accept-Encoding")))
      resp)))

(defn finish (conn resp config)
  "Validate, compress and secure a finished response, in that order.

  The order is the point. The ETag is computed first, against the body a cache would store,
  so a matching `If-None-Match` returns a bodyless 304 — which also skips the compression
  work for a body that is never sent. The coding is passed to the validator because a br
  entity and a gzip entity are different representations of the same page (RFC 9110 §8.8.3)
  and must not share a tag.

  A response that arrives ALREADY carrying an ETag is left uncompressed, which is the other
  half of that same rule. `web/static` tags its responses itself, over the exact bytes it
  chose to send after its own `Accept-Encoding` negotiation. Compressing here would change
  the representation and leave that tag describing bytes no longer going out — so a client
  holding the gzip copy, revalidating with `Accept-Encoding: br`, would be answered 304 and
  render gzip as br. `cache/conditional` already declines to re-tag such a response; until
  now the compressor did not decline to re-encode it, and half a rule is not one."
  (let (compress-opts (get config :compress {})
        headers (get config :security-headers *default-security-headers*)
        coding (compress/chosen-encoding conn)
        pre-tagged? (not (nil? (get (get resp :headers {}) :etag))))
    (match (cache/conditional conn resp coding)
      ([:not-modified not-modified] (secured conn (as-response not-modified) config headers))
      ([:send validated] (secured conn
                           (let (response (as-response validated))
                             (if (and compress-opts (not pre-tagged?))
                               (compress-response conn response compress-opts)
                               response))
                           config
                           headers)))))

(defn freshen (conn resp config)
  "Apply the app's dynamic-HTML freshness policy, if it has one.

  `:freshness` is passed straight to `web/cache/html-freshness`, which holds the conditions
  (GET/HEAD, 200, no `Set-Cookie`, HTML only) and fails closed on anything it cannot read.
  Omit it and a response keeps whatever `Cache-Control` its handler set."
  (let (freshness (get config :freshness))
    (if freshness (cache/html-freshness conn resp freshness) resp)))

;; ---- failures ---------------------------------------------------------------

(defn- error-opts (config)
  (let (errors (get config :errors {}))
    (if errors errors {})))

(defn- failure-response (code config)
  (or (web/errors/error-response code (error-opts config))
    {:status code :headers {:content-type "text/plain; charset=utf-8"} :body "error"}))

(defn- log-crash (conn message config)
  "Log a crashed handler's message at `:error`, then answer the generic 500 page.

  The message goes to the log and never to the response — the page still leaks nothing to
  the caller — but it goes SOMEWHERE, which is the whole difference between a diagnosable
  500 and a mystery one."
  (log/error (str "handler raised: " message)
    {:method (web/conn/conn-method conn)
     :path (web/conn/conn-path conn)
     :status 500
     :error (str message)})
  (failure-response 500 config))

(defn- log-timeout (conn timeout-ms config)
  "Log a handler that outran its deadline at `:error`, then answer 504.

  Logged distinctly from a crash on purpose: a slow handler and a broken one look identical
  in a log that records only the status, and they want opposite responses."
  (log/error (str "handler timed out after " timeout-ms "ms")
    {:method (web/conn/conn-method conn)
     :path (web/conn/conn-path conn)
     :status 504
     :timeout_ms timeout-ms})
  (failure-response 504 config))

;; ---- static assets ----------------------------------------------------------
;;
;; The seventh thing every app wrote. The six stages above are what sits AROUND a router;
;; this is the one thing that has to sit in FRONT of it, and both apps built on hatch wrote
;; it themselves and disagreed. hive put `/static/*path` inside its router; the demo wrote a
;; `cond` on the conn's path with `(string/substring path 8 …)` — a literal 8 standing in for
;; the length of "/static/", which nothing named and nothing checked.
;;
;; Neither is only a style question. Inside the router a static response meets the compressor
;; (see `finish`), and `web/static` has already negotiated and tagged its own bytes. In front
;; of it, the prefix arithmetic is the app's to get right.

(def *default-static* {:at "/static" :dir "static" :clients true})

(defn static-subpath (path at)
  "The part of `path` sitting under the mount point `at`, or nil when it does not.

  Derived from `at` rather than a hardcoded width, which is the whole reason this is a
  function: the two must agree, and a literal in one place cannot.

  (hatch/web/endpoint/static-subpath \"/static/app.css\" \"/static\") ;=> \"app.css\"
  (hatch/web/endpoint/static-subpath \"/static/fonts/a.woff2\" \"/static\") ;=> \"fonts/a.woff2\"
  (hatch/web/endpoint/static-subpath \"/staticky/app.css\" \"/static\") ;=> nil
  (hatch/web/endpoint/static-subpath \"/static\" \"/static\") ;=> nil
  (hatch/web/endpoint/static-subpath \"/\" \"/static\") ;=> nil"
  (let (prefix (str at "/"))
    (if (string/starts-with? path prefix)
      (string/substring path (string/length prefix) (string/length path))
      nil)))

(defn- bundled-client (subpath)
  "The handler for one of hatch's own browser clients, or nil when `subpath` names neither —
  **or when the package copy is not readable**, in which case the caller falls through to the
  app's own static directory.

  Both ship inside the package, so an app serves them without vendoring a copy that can drift
  from the server half it talks to, and without writing the route itself — which is what
  every live app was doing.

  The fall-through is the part that had to be learnt. `nest release` bundles sources and only
  sources, so a released app has no package `static/` to read and these answer nil; the
  practical fix at that point is one `cp` into the app's own static dir during the image
  build, and falling through is what makes that work with nothing else changed. Before it,
  the missing copy was served as a 200 with an empty body — hive shipped its WebMCP client
  that way, every page pointing an agent at a script that was nothing."
  (cond
    (and (= subpath "brood_live.js") (web/live/client-js)) (web/live/client-js-handler)
    (and (= subpath "brood_webmcp.js") (web/mcp/client-js)) (web/mcp/client-js-handler)
    (and (= subpath "brood_channel.js") (web/channel/client-js)) (web/channel/client-js-handler)
    else nil))

(defn- static-options (config)
  "The `:static` options as a full map, or nil when the app does not want this stage.
  `true` means the defaults; a map overrides any of them."
  (let (spec (get config :static))
    (cond
      (nil? spec) nil
      (= spec false) nil
      (= spec true) *default-static*
      else (merge *default-static* spec))))

(defn- static-answer (conn config options)
  "A finished response for a static request, or nil so the caller falls through to the router.

  Only the security headers are applied on top. A static response is already finished in
  every other sense — `web/static` picked the coding, wrote the validator and answered the
  conditional request — which is exactly why it must not be run through the compressor
  again; see `finish`."
  (let (subpath (static-subpath (web/conn/conn-path conn) (get options :at)))
    (if (nil? subpath)
      nil
      (let (client (if (get options :clients) (bundled-client subpath) nil)
            answered (if client
                       (client conn)
                       (web/static/serve conn (get options :dir) subpath)))
        (secured conn
          (web/conn/conn->response answered)
          config
          (get config :security-headers *default-security-headers*))))))

;; ---- the adapter ------------------------------------------------------------

(defn- dispatch (conn config)
  (let (timeout-ms (get config :timeout-ms *default-timeout-ms*)
        router (get config :router)
        errors (get config :errors {})
        h (task/task (fn () (web/conn/conn->response (router conn))) {:timeout timeout-ms}))
    (receive
      ([:task-done ^h resp] (if errors (web/errors/themed resp errors) resp))
      ([:task-error ^h message] (log-crash conn message config))
      ([:task-timeout ^h] (log-timeout conn timeout-ms config)))))

(defn adapter (config)
  "The `http/server` request handler for `config` — build a conn, run the router inside a
  task with a deadline, then theme, freshen, validate, compress and secure the result.

  `:router` (a `defrouter` function, taking a conn and answering one) is required. See `serve` for the rest of
  the config; pass the same map to both.

  With `:static`, a request under the mount point is answered before the router runs and
  never reaches it — so a static asset costs one prefix test rather than a walk through
  every route, and the router file stays the app's own routes."
  (when (nil? (get config :router))
    (error "web/endpoint/adapter: :router is required (a defrouter function)"))
  (let (static (static-options config))
    (fn (request)
      (let (conn (web/conn/build request))
        (or (if static (static-answer conn config static) nil)
          (finish conn (freshen conn (dispatch conn config) config) config))))))

;; ---- assets + boot ----------------------------------------------------------

(defn prepare-assets (assets)
  "Get the asset pipeline ready for this environment, if the app has one.

  In dev: first-run install, a one-shot build, then the watcher, whose rebuilds hot-swap the
  page CSS over the live socket. In prod: `prepare` only — fingerprint the already-built
  files (and write any missing precompressed siblings), so the slim runtime image boots
  without the bundler installed.

  A prod failure is a warning, not a boot failure: a missing build degrades to plain asset
  URLs, and refusing to serve at all would turn a cosmetic problem into an outage.

  `prepare` and not `fingerprint`: the inner one skips the `:precompress` step, which is how
  a 7 MB wasm module goes out uncompressed with its spec sitting right there in the config."
  (when assets
    (if (web/env/dev?)
      (web/assets/ensure assets)
      (try
        (web/assets/prepare assets)
        (catch e
          (log/warn (str "[assets] preparation skipped ("
                      (error-message e)
                      "); serving plain asset URLs")))))))

(defn serve (config)
  "Prepare the assets and start the HTTP listener. The canonical body of an app's endpoint,
  and one of `web/application`'s children.

    `:router`            — a `defrouter` function (conn in, conn out). **Required.**
    `:port`              — the listen port (default `(port)`, i.e. `$HATCH_PORT` or 5000).
    `:timeout-ms`        — per-request deadline (default 30s) after which a handler is
                           killed and the request answered 504.
    `:errors`            — `web/errors` opts (`:render`, `:meta`) for themed error pages, or
                           `false` to pass framework error bodies through untouched.
    `:freshness`         — `web/cache/html-freshness` opts for dynamic HTML
                           (`{:max-age 60 :stale-for 600}`). Omitted: no policy applied.
    `:security-headers`  — merged under whatever a handler set (default
                           `*default-security-headers*`); `{}` for none.
    `:hsts`              — `Strict-Transport-Security`, sent only on an HTTPS request
                           (default `max-age=31536000`, `false` for none). See
                           `hsts-header` for why `includeSubDomains` is not defaulted.
    `:compress`          — `{:min-bytes 256}`, or `false` to send bodies uncompressed.
    `:no-transform`      — add the `no-transform` cache directive to any response carrying a
                           validator, so an intermediary cannot re-encode bytes an ETag
                           already names (default on; `false` to omit).
    `:static`            — serve files ahead of the router. `true` mounts `./static` at
                           `/static` and adds hatch's own bundled clients
                           (`brood_live.js`, `brood_webmcp.js`, `brood_channel.js`) from the
                           package; a map
                           overrides any of `{:at \"/static\" :dir \"static\" :clients true}`.
                           Omitted: no static stage (the app routes it itself, or has none).
    `:assets`            — a `web/assets` config; dev watches it, prod fingerprints it.
    `:live`              — the WebSocket handler for live views (default
                           `(web/live/live-dispatcher)`); `false` for an app with no live
                           views.
    `:channels`          — `true` to serve `web/channel` topic sockets at `/channel/ws`
                           (default: on when the app's router registered any `(channel …)`
                           clause, off otherwise), a `(fn (conn) …)` socket-wide connect
                           guard, or `false` to refuse them outright.
    `:server`            — extra `http/server/start` config (`:spool-threshold`,
                           `:max-request-bytes`, `:tls`, …).

  Returns the listener supervisor pid."
  (prepare-assets (get config :assets))
  (http/server/start (get config :port (port))
    (adapter config)
    (ws-handler config)
    (get config :server {})))

(defn ws-handler (config)
  "The one ws-handler `http/server` takes, routing an upgrade by path to the live-view
  dispatcher or the channel dispatcher.

  `http/server` takes a single handler because at the point it runs there is no router yet —
  the 101 is answered before any route table is consulted. Two socket protocols therefore
  have to agree on one entry point, and the path is what tells them apart: `/live/ws<path>`
  names a view, `/channel/ws` names the multiplexed topic socket. An upgrade matching neither
  gets no handler at all, which closes the socket."
  (let (live (get config :live :default)
        live-fn (if (= live :default) (web/live/live-dispatcher) (if live live nil))
        channels (get config :channels :default)
        ;; Default on only if the app actually registered a channel. An app with no
        ;; `(channel …)` clause should not be answering upgrades on a URL it has nothing
        ;; behind — and one that has them should not have to remember a config line.
        channels-fn (cond
                      ;; `proc/whereis` first, and not merely as an optimisation: reading the
                      ;; table through `channel-table` STARTS the registry supervisor, so the
                      ;; default would stand up a pair of processes on every app that has
                      ;; never heard of channels, purely to be told it has none. A registry
                      ;; that was never started is proof that no `(channel …)` clause ran.
                      (= channels :default)
                        (if (or (nil? (proc/whereis :hatch-channels))
                              (empty? (web/channel/channel-table)))
                          nil
                          (web/channel/channel-dispatcher))
                      ;; nil disables, exactly as `false` does and exactly as `{:live nil}`
                      ;; does two lines up. Without this arm nil is not `:default`, is not
                      ;; `false` (in Brood `(= nil false)` is false) and is not `true` — so it
                      ;; fell to the guard branch and served /channel/ws with `connect` = nil:
                      ;; an UNGUARDED channel endpoint from a config that plainly asked for
                      ;; none. `{:channels (and (prod?) guard-fn)}` is nil in dev.
                      (nil? channels) nil
                      (= channels false) nil
                      (= channels true) (web/channel/channel-dispatcher)
                      ;; anything else is the connect guard itself
                      else (web/channel/channel-dispatcher channels)))
    (if (and (nil? live-fn) (nil? channels-fn))
      nil
      (fn (sock request)
        (let (path (get request :path ""))
          (cond
            (and channels-fn (string/starts-with? path web/channel/*channel-ws-prefix*))
              (channels-fn sock request)
            live-fn (live-fn sock request)
            else (tcp/close sock)))))))
