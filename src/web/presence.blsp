(defmodule web/presence
  "Who-is-here tracking for live views (à la Phoenix.Presence). A session `track`s itself on
  a topic with a key (e.g. a user/visitor id) and a metadata map; everyone present on that
  topic is then pushed the updated roster via `send-info` (→ `handle-info`), so a join or
  leave updates every open client live. A registry process monitors each tracked session, so
  closing a tab (the socket dies) removes that presence automatically and notifies the rest.

  A live view tracks in its mount and seeds its roster from the synchronous `roster` call:

    (deflive
      (mount (params)
        (do (presence/track \"room:lobby\" (get params \"id\" \"anon\") {})
            {:members (presence/roster \"room:lobby\")}))
      (handle-info (msg model)
        (if (contains? msg :presence) (assoc model :members (get msg :presence)) model))
      (render (model) …))

  Roster updates go to the present members themselves (they are the audience). A non-present
  observer that also wants live updates can pair this with web/pubsub on the same topic.

  Cluster-aware: when the runtime is a distributed node (`node-start` + `connect`/`ensure-link`
  to peers, wired once in the app's entry point), a topic's roster is the *merge* of every
  node's presences. Each node owns its local presences and replicates each topic's roster to
  peers on every change (a state-based CRDT); a member is notified by its own node, and a
  departed peer's presences are dropped on node-down. With no node started it's a single-node
  registry, unchanged."
  ; send-info — push the roster to a tracked session
  (:use web/live)
  ; ensure-supervised / vault-loop / pull-snapshot / mirror — supervised durable registry
  (:use web/registry)
  ; set/set — distinct tracked pids as a first-class #{} set (ADR-060), no O(n²) dedupe
  (:alias set))

(def vault-name :hatch-presence-vault)

; ---- registry process: topic -> list of {:pid :key :meta} ----
; Supervised + vault-backed (web/registry): every change is mirrored to the vault; on
; restart the registry recovers its state from the vault and re-monitors the restored pids,
; so a crash doesn't silently empty every roster.

; The loop carries `state` (topic → entries, durable, mirrored to the vault) and `refs`
; (pid → monitor ref, local — to demonitor a pid once its last presence drops, so monitors
; don't pile up across a session's live-navigations).

; The loop carries a third value, `remotes` (`{peer-node → {topic → roster}}`): the last
; roster every peer reported for each topic. It's replicated peer-owned state, re-derivable
; from re-syncs, so it is NOT vaulted — only local `state` is. The roster a member sees is the
; *merge*: this node's local presences plus every peer's reported roster (see below).

(defn presence--watch-vault ()
  "Monitor the vault so its death delivers a `[:down]` here, letting the registry re-mirror to
  the restarted vault. Returns the monitor ref, or nil if the vault isn't up yet."
  (let (v (whereis vault-name)) (if v (monitor v) nil)))

(defn presence--boot ()
  "Start (or restart) the registry: recover local state from the vault, re-monitor each restored
  pid (a dead one re-fires [:down] at once and is removed), monitor the vault, then enter the
  loop with empty peer state (it re-populates as peers sync)."
  (await vault-name 60)
  (let (state (pull-snapshot vault-name {})
        refs (fold (fn (m pid) (assoc m pid (monitor pid))) {} (presence--all-pids state)))
    (presence--loop state refs {} (presence--watch-vault))))

(defn presence--save (state refs remotes vault-ref)
  "Mirror the new *local* state to the vault (peer state isn't durable), then continue."
  (mirror vault-name state)
  (presence--loop state refs remotes vault-ref))

(defn presence--loop (state refs remotes vault-ref)
  (receive
    ; A local track: update local state, tell peers our new roster for the topic, and notify
    ; local members with the merged (local + peers) roster.
    ([:track topic pid key meta] (let (refs2 (if (contains? refs pid)
                                               refs
                                               (assoc refs pid (monitor pid)))
                                       state2 (presence--put state topic pid key meta))
                                   (presence--broadcast-sync state2 topic)
                                   (presence--notify-merged state2 remotes topic)
                                   (presence--save state2 refs2 remotes vault-ref)))
    ([:untrack topic pid]
      (let (state2 (presence--remove state topic pid)
            ; demonitor on the last untrack so monitors don't leak
            refs2 (if (presence--tracked? state2 pid) refs (presence--drop-ref refs pid)))
        (presence--broadcast-sync state2 topic)
        (presence--notify-merged state2 remotes topic)
        (presence--save state2 refs2 remotes vault-ref)))
    ; The vault we monitor died: wait for the supervisor to restart it, re-mirror our whole
    ; local state so the backup is whole again, and re-watch the fresh vault — the durability
    ; web/live's route registry has (a vault restart then a registry restart would otherwise
    ; recover empty rosters). Matched by the vault's ref, ahead of the session-down clause.
    ([:down ^vault-ref _ _] (do
                              (await vault-name 60)
                              (mirror vault-name state)
                              (presence--loop state refs remotes (presence--watch-vault))))
    ; a tracked session died — drop it everywhere, resync + refresh each affected topic; its
    ; monitor already fired, so just drop the ref ([:down ref pid reason])
    ([:down _ pid _] (let (affected (presence--topics-of state pid)
                           state2 (presence--remove-pid state pid))
                       (dolist (t affected)
                         (presence--broadcast-sync state2 t)
                         (presence--notify-merged state2 remotes t))
                       (presence--save state2 (dissoc refs pid) remotes vault-ref)))
    ; A peer reported its roster for `topic`. Record it, and if this is the first we've heard
    ; from that node, monitor it (for node-down) and reply with our full state so it learns our
    ; existing presences (a one-time bootstrap — converges without looping). Then notify local
    ; members with the refreshed merge. Peer state isn't vaulted, so recurse without a save.
    ([:presence-sync from topic roster]
      (let (fresh (not (contains? remotes from))
            remotes2 (presence--record-remote remotes from topic roster))
        (when fresh (monitor-node from) (presence--sync-all-to state from))
        (presence--notify-merged state remotes2 topic)
        (presence--loop state refs remotes2 vault-ref)))
    ; A peer node went down — forget its presences and refresh every topic it was on.
    ([:nodedown node] (let (topics (presence--remote-topics-of remotes node)
                            remotes2 (dissoc remotes node))
                        (dolist (t topics) (presence--notify-merged state remotes2 t))
                        (presence--loop state refs remotes2 vault-ref)))
    ; reply with the merged roster, keyed by the caller's ref `r` so a late reply can't be
    ; mismatched to another call
    ([:list topic from r] (do
                            (send from [:list r (presence--merged state remotes topic)])
                            (presence--loop state refs remotes vault-ref)))
    ; A synchronous barrier — see web/pubsub's `[:sync …]`. Lets a live-navigate confirm its
    ; untrack is applied and any roster push queued before it has landed, before draining.
    ([:sync from r] (do (send from [:sync r]) (presence--loop state refs remotes vault-ref)))))

(defn presence--tracked? (state pid)
  "True if `pid` is still tracked on any topic."
  (presence--known? state pid))

(defn presence--drop-ref (refs pid)
  "Demonitor `pid` (its last presence is gone) and drop its ref."
  (let (ref (get refs pid))
    (when ref (demonitor ref)))
  (dissoc refs pid))

(defn presence--entries (state topic)
  "The raw {:pid :key :meta} entries tracked on `topic`."
  (get state topic (list)))

(defn presence--without (entries pid)
  "`entries` with any entry for `pid` removed."
  (filter (fn (e) (not (= (get e :pid) pid))) entries))

(defn presence--put (state topic pid key meta)
  "Track `pid` on `topic` under `key`/`meta`, replacing any prior entry for that pid."
  (assoc state
    topic (cons {:pid pid :key key :meta meta}
            (presence--without (presence--entries state topic) pid))))

(defn presence--remove (state topic pid)
  "Untrack `pid` from `topic`, dropping the topic key entirely once it has no members left
  so ephemeral topics don't accumulate in the registry (and its vault)."
  (let (remaining (presence--without (presence--entries state topic) pid))
    (if (empty? remaining) (dissoc state topic) (assoc state topic remaining))))

(defn presence--remove-pid (state pid)
  "Untrack `pid` from every topic. Topics it emptied are dropped (not left as dead keys)."
  (fold (fn (m kv)
          (let (remaining (presence--without (first (rest kv)) pid))
            (if (empty? remaining) m (assoc m (first kv) remaining))))
    {}
    (entries state)))

(defn presence--has-pid? (entries pid)
  (not (empty? (filter (fn (e) (= (get e :pid) pid)) entries))))

(defn presence--known? (state pid)
  "True if `pid` is tracked on any topic — used to monitor each session just once."
  (not (empty? (filter (fn (kv) (presence--has-pid? (first (rest kv)) pid)) (entries state)))))

(defn presence--topics-of (state pid)
  "The topics `pid` is tracked on (so a death only refreshes those)."
  (map (fn (kv) (first kv))
    (filter (fn (kv) (presence--has-pid? (first (rest kv)) pid)) (entries state))))

(defn presence--roster (state topic)
  "The public roster for `topic`: a list of {:key :meta} (pids dropped)."
  (map (fn (e) {:key (get e :key) :meta (get e :meta)}) (presence--entries state topic)))

; ---- cross-node roster replication ----
; Presence is cluster-aware when the runtime is a distributed node (node-start + connect/
; ensure-link, wired in the app's entry point). Each node owns its LOCAL presences and
; replicates each topic's roster to peers on every change; the roster a member sees is the
; merge of the local presences and every peer's last-reported roster. A member is only ever
; notified by its OWN node (its pid is local there). node-down purges a departed peer. With no
; node started, `(nodes)` is empty and every peer step is a no-op — single-node behaviour is
; unchanged.

(defn remote-nodes ()
  "Connected peer node names, or empty when this runtime isn't a distributed node."
  (or (try (nodes) (catch _e nil)) (list)))

(defn presence--remote-roster (remotes topic)
  "The concatenation of every peer's last-reported roster for `topic`."
  (apply append (map (fn (kv) (get (first (rest kv)) topic (list))) (entries remotes))))

(defn presence--merged (state remotes topic)
  "The full roster for `topic`: this node's local presences plus every peer's reported roster."
  (append (presence--roster state topic) (presence--remote-roster remotes topic)))

(defn presence--notify-merged (state remotes topic)
  "Push the merged `topic` roster to every LOCAL member present on it. Remote members are
  notified by their own node (their pid lives there), so we never send to a remote pid."
  (let (roster (presence--merged state remotes topic))
    (dolist (e (presence--entries state topic)) (send-info (get e :pid) {:presence roster}))))

(defn presence--sync-to (target-node from-node topic roster)
  "Best-effort: report `from-node`'s `roster` for `topic` to `target-node`'s registry."
  (try (send {:name :hatch-presence :node target-node} [:presence-sync from-node topic roster])
    (catch _e nil)))

(defn presence--broadcast-sync (state topic)
  "Tell every peer node this node's current local roster for `topic` (state-based
  replication). A no-op with no peers."
  (let (me (node-name)
        roster (presence--roster state topic))
    (dolist (n (remote-nodes)) (presence--sync-to n me topic roster))))

(defn presence--sync-all-to (state target-node)
  "Send this node's full local rosters (every topic) to `target-node` — the one-time bootstrap
  when a peer is first seen, so it learns our already-tracked presences."
  (let (me (node-name))
    (dolist (kv (entries state))
      (presence--sync-to target-node me (first kv) (presence--roster state (first kv))))))

(defn presence--record-remote (remotes from topic roster)
  "Record peer `from`'s `roster` for `topic`. An EMPTY roster (that peer's topic emptied) drops
  the `[from topic]` entry — and the `from` node entry if that was its last topic — rather than
  accumulating dead empty-roster keys, an unbounded per-topic memory leak on a long-lived link
  (local `state` already prunes emptied topics the same way)."
  (if (empty? roster)
    (let (node-map (dissoc (get remotes from {}) topic))
      (if (empty? node-map) (dissoc remotes from) (assoc remotes from node-map)))
    (assoc-in remotes [from topic] roster)))

(defn presence--remote-topics-of (remotes node)
  "The topics a departed `node` had presences on (so a node-down only refreshes those)."
  (let (rr (get remotes node {}))
    (map (fn (kv) (first kv)) (entries rr))))

(defn presence--all-pids (state)
  "Every distinct tracked pid across all topics, as a set — for re-monitoring on recovery
  (already distinct, no O(n²) `member?` dedupe pass); `presence--boot` folds over it."
  (set/set (apply append
             (map (fn (kv) (map (fn (e) (get e :pid)) (first (rest kv)))) (entries state)))))

(defn presence ()
  "The presence registry pid — a supervised, vault-backed singleton. Started on first use
  and recovered from the vault on any crash (see web/registry)."
  (let (vault {:id :hatch-presence-vault
               :name :hatch-presence-vault
               :restart :permanent
               :start (fn () (spawn (vault-loop {})))}
        registry {:id :hatch-presence
                  :name :hatch-presence
                  :restart :permanent
                  :start (fn () (spawn (presence--boot)))})
    (ensure-supervised :hatch-presence-sup [vault registry] :hatch-presence)))

; ---- public API ----

(defn track (topic key meta)
  "Mark the current process present on `topic` under `key` with `meta` (a map). Call from a
  live view's mount, where `(self)` is the session pid. Notifies all present members with the
  refreshed roster and auto-removes this presence when the process dies. Returns nil."
  (send (presence) [:track topic (self) key meta])
  nil)

(defn untrack (topic)
  "Remove the current process's presence from `topic` (also happens automatically on death).
  Returns nil."
  (send (presence) [:untrack topic (self)])
  nil)

(defn roster (topic)
  "A snapshot of the current presences on `topic` as a list of {:key :meta}. The request
  carries a fresh `ref` and the reply is pinned to it, so a late reply from a prior
  (timed-out) call can't be mismatched here."
  (let (rf (ref))
    (send (presence) [:list topic (self) rf])
    (receive
      ([:list ^rf roster] roster)
      (after 1000 (list)))))
