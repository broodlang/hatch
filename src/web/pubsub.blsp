(defmodule web/pubsub
  "Topic-based publish/subscribe for live views — the real-time backbone (à la
  Phoenix.PubSub). A process subscribes to a string topic; anyone can broadcast a payload
  to that topic, and every subscriber receives it via `send-info` — i.e. at the view's
  `handle-info`. A live view subscribes in its `mount` (where `(self)` is the session pid):

    (deflive
      (mount (params) (do (pubsub/subscribe \"room:lobby\") {:messages []}))
      (on \"send\" (params model) (do (pubsub/broadcast \"room:lobby\" {:text (get params \"value\")}) model))
      (handle-info (msg model) (assoc model :messages (cons msg (get model :messages))))
      (render (model) …))

  The registry runs under a supervisor with a sibling vault (web/registry): every change is
  mirrored to the vault, and on restart the registry recovers its subscriptions from the
  vault and re-monitors the restored pids — so a crash doesn't silently drop every
  subscription. It monitors each subscriber, so a dropped session is removed automatically.
  Delivery is fire-and-forget (no ordering or delivery guarantee across topics), which is
  what a live UI wants.

  Cluster-aware: if the runtime is started as a distributed node (`node-start` plus
  `connect`/`ensure-link` to peers, wired once in the app's entry point), a broadcast fans
  out to subscribers on every connected node — each node keeps only its local subscribers and
  a locally-published broadcast is replicated once per peer (see `pubsub--fanout-remote`).
  With no node started, `(nodes)` is empty and the replication is a no-op, so a single-node
  app behaves exactly as before."
  ; send-info — deliver a payload to a subscribed session
  (:use web/live)
  ; ensure-supervised / vault-loop / pull-snapshot / mirror — supervised durable registry
  (:use web/registry)
  ; set/union — subscriber sets are first-class #{} sets (ADR-060), O(log n)
  ; add/remove/membership vs the old O(n) list scans on the subscribe/DOWN churn.
  ; (`conj`/`disj` need no alias: they are polymorphic prelude fns — ADR-155.)
  (:alias set))

(def vault-name :hatch-pubsub-vault)

; ---- registry process: topic -> set of subscriber pids ----

; The loop carries two maps: `subs` (topic → pid set, the durable state mirrored to the vault)
; and `refs` (pid → monitor ref, local — used to demonitor a pid once its *last* subscription
; drops, so monitors don't pile up as a long-lived session subscribes/unsubscribes across
; live-navigations).

(defn pubsub--watch-vault ()
  "Monitor the vault so its death delivers a `[:down]` here, letting the registry re-mirror to
  the restarted vault. Returns the monitor ref, or nil if the vault isn't up yet."
  (let (v (whereis vault-name)) (if v (monitor v) nil)))

(defn pubsub--boot ()
  "Start (or restart) the registry: recover subscriptions from the vault, re-establish a monitor
  on each restored pid (one that died during the crash window re-fires [:down] at once and is
  cleaned up), monitor the vault, then enter the loop."
  (await vault-name 60)
  (let (subs (pull-snapshot vault-name {})
        refs (fold (fn (m pid) (assoc m pid (monitor pid))) {} (pubsub--all-pids subs)))
    (pubsub--loop subs refs (pubsub--watch-vault))))

(defn pubsub--save (subs refs vault-ref)
  "Mirror the new subscriptions to the vault, then continue the loop."
  (mirror vault-name subs)
  (pubsub--loop subs refs vault-ref))

(defn pubsub--loop (subs refs vault-ref)
  (receive
    ([:subscribe topic pid] (let (refs2 (if (contains? refs pid)
                                          refs
                                          (assoc refs pid (monitor pid))))
                              (pubsub--save (pubsub--add subs topic pid) refs2 vault-ref)))
    ([:unsubscribe topic pid] (let (subs2 (pubsub--remove subs topic pid)
                                    refs2 (if (pubsub--subscribed? subs2 pid)
                                            refs
                                            (pubsub--drop-ref refs pid)))
                                (pubsub--save subs2 refs2 vault-ref)))
    ; A broadcast. `origin` is `:local` (published on this node via the API) or `:remote`
    ; (replicated here from a peer node). Either way we fan out to this node's subscribers;
    ; only a *local*-origin broadcast is forwarded on to peer nodes, so a replicated message
    ; is never re-forwarded — that bounds cross-node traffic to one hop and can't loop.
    ([:broadcast topic except payload origin]
      (do
        (dolist (p (get subs topic #{}))
          (when (not (= p except)) (send-info p payload)))
        (when (= origin :local) (pubsub--fanout-remote topic payload))
        ; broadcast doesn't change state — no mirror
        (pubsub--loop subs refs vault-ref)))
    ; The vault we monitor died: wait for the supervisor to restart it, re-mirror the whole
    ; subscription table so the backup is whole again, and re-watch the fresh vault — the same
    ; durability web/live's route registry has. Without it, a vault restart (empty) followed by
    ; a registry restart before the next mirror would recover an empty table. Matched by the
    ; vault's ref, ahead of the subscriber-down clause below (receive is first-match).
    ([:down ^vault-ref _ _] (do
                              (await vault-name 60)
                              (mirror vault-name subs)
                              (pubsub--loop subs refs (pubsub--watch-vault))))
    ; a subscriber died — drop it from every topic; its monitor already fired, so just drop
    ; the ref ([:down ref pid reason])
    ([:down _ pid _] (pubsub--save (pubsub--remove-pid subs pid) (dissoc refs pid) vault-ref))
    ; introspection, mostly for tests: reply with a topic's current subscriber list, keyed
    ; by the caller's ref `r` so a late reply can't be mismatched to another call
    ([:subscribers topic from r] (do
                                   ; convert the pid set → a list at the API boundary (the
                                   ; public `subscribers` snapshot has always returned a list)
                                   (send from [:subscribers r (into (list) (get subs topic #{}))])
                                   (pubsub--loop subs refs vault-ref)))
    ; A synchronous barrier: reply once we've processed everything queued ahead of it. A caller
    ; that just unsubscribed uses this to know its unsubscribe is applied AND that any broadcast
    ; queued before it has already been delivered to the caller's mailbox — so a live-navigate
    ; can drain those stale deliveries before mounting the next view (see web/live's sync-registry).
    ([:sync from r] (do (send from [:sync r]) (pubsub--loop subs refs vault-ref)))))

; ---- cross-node fan-out ----
; PubSub is cluster-aware when the runtime is started as a distributed node (`node-start` +
; `connect`/`ensure-link`, wired in the app's entry point). Each node keeps only its *local*
; subscribers; a locally-published broadcast is replicated once to every connected peer's
; registry (addressed by its distributed name `:hatch-pubsub`), which fans it out to that
; node's subscribers. Delivery to a subscriber — local or remote — already rides brood's
; location-transparent `send` (via `send-info`). When the runtime isn't a distributed node,
; `(nodes)` is empty and this is a no-op, so single-node apps are entirely unaffected.

(defn remote-nodes ()
  "The connected peer node names, or an empty list when this runtime isn't a distributed
  node (so cross-node fan-out is a safe no-op)."
  (or (try (nodes) (catch _e nil)) (list)))

(defn pubsub--fanout-remote (topic payload)
  "Replicate a locally-originated broadcast to every peer node's registry — once each, marked
  `:remote` so the peer delivers to its own subscribers without re-forwarding (no loops,
  O(nodes) messages per publish). Best-effort: a peer that isn't running PubSub, or a link
  that just dropped, is skipped rather than failing the publish."
  (dolist (n (remote-nodes))
    (try
      (send {:name :hatch-pubsub :node n} [:broadcast topic nil payload :remote])
      (catch _e nil))))

(defn pubsub--subscribed? (subs pid)
  "True if `pid` is still subscribed to any topic (O(log n) per topic set)."
  (not (empty? (filter (fn (kv) (contains? (first (rest kv)) pid)) (map-pairs subs)))))

(defn pubsub--drop-ref (refs pid)
  "Demonitor `pid` (its last subscription is gone) and drop its ref."
  (let (ref (get refs pid))
    (when ref (demonitor ref)))
  (dissoc refs pid))

(defn pubsub--add (subs topic pid)
  "Add `pid` to `topic`'s subscriber set (idempotent — set membership dedupes)."
  (assoc subs topic (conj (get subs topic #{}) pid)))

(defn pubsub--remove (subs topic pid)
  "Remove `pid` from `topic`'s subscriber set, dropping the topic key entirely once it has
  no subscribers left so ephemeral topics don't accumulate in the registry (and its vault)."
  (let (remaining (disj (get subs topic #{}) pid))
    (if (empty? remaining) (dissoc subs topic) (assoc subs topic remaining))))

(defn pubsub--remove-pid (subs pid)
  "Remove `pid` from every topic — the dead-subscriber cleanup. Topics it emptied are
  dropped (not left as dead keys)."
  (fold (fn (m kv)
          (let (remaining (disj (first (rest kv)) pid))
            (if (empty? remaining) m (assoc m (first kv) remaining))))
    {}
    (map-pairs subs)))

(defn pubsub--all-pids (subs)
  "Every distinct subscriber pid across all topics, as a set — for re-monitoring on recovery
  (the union of every topic's subscriber set; already distinct, no dedupe pass)."
  (fold (fn (acc kv) (set/union acc (first (rest kv)))) #{} (map-pairs subs)))

(defn pubsub ()
  "The PubSub registry pid — a supervised, vault-backed singleton. Started on first use and
  recovered from the vault on any crash (see web/registry)."
  (let (vault {:id :hatch-pubsub-vault
               :name :hatch-pubsub-vault
               :restart :permanent
               :start (fn () (spawn (vault-loop {})))}
        registry {:id :hatch-pubsub
                  :name :hatch-pubsub
                  :restart :permanent
                  :start (fn () (spawn (pubsub--boot)))})
    (ensure-supervised :hatch-pubsub-sup [vault registry] :hatch-pubsub)))

; ---- public API ----

(defn subscribe (topic)
  "Subscribe the current process to `topic`. It then receives every broadcast to `topic`
  via `send-info` (the view's `handle-info`). Call it from a live view's `mount`, where
  `(self)` is the session pid. Returns nil."
  (send (pubsub) [:subscribe topic (self)])
  nil)

(defn unsubscribe (topic)
  "Unsubscribe the current process from `topic`. (Subscriptions are also dropped
  automatically when the process dies.) Returns nil."
  (send (pubsub) [:unsubscribe topic (self)])
  nil)

(defn broadcast (topic payload)
  "Broadcast `payload` to every subscriber of `topic`, including the sender. Each receives
  it at `handle-info`. In a cluster (this runtime started as a distributed node) the message
  also reaches subscribers on every connected peer node; single-node apps are unaffected.
  Returns nil."
  (send (pubsub) [:broadcast topic nil payload :local])
  nil)

(defn broadcast-from (topic payload)
  "Like `broadcast`, but does not deliver to the calling process — use it when the sender
  has already updated its own view and only the *other* subscribers need the message. (The
  sender is only ever skipped on its own node; peer-node subscribers all receive it.)"
  (send (pubsub) [:broadcast topic (self) payload :local])
  nil)

(defn subscribers (topic)
  "The current subscriber pids for `topic` (a snapshot — mostly for tests/debugging). The
  request carries a fresh `ref` and the reply is pinned to it, so a late reply from a prior
  (timed-out) call can't be mismatched here."
  (let (r (ref))
    (send (pubsub) [:subscribers topic (self) r])
    (receive
      ([:subscribers ^r pids] pids)
      (after 1000 (list)))))
