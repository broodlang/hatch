(defmodule web/template "Hiccup-style s-expression HTML renderer.")

; Void elements have no closing tag and no children.
(def *void-tags*
  {:area true
   :base true
   :br true
   :col true
   :embed true
   :hr true
   :img true
   :input true
   :link true
   :meta true
   :param true
   :source true
   :track true
   :wbr true})

;; A raw node is a RECORD, not a `{:__raw__ …}` map. `raw?` gates HTML escaping, so a
;; shape test is a hole: any map that happens to carry a `:__raw__` key — an app's own
;; model, a decoded JSON body — reached `render` as trusted, pre-escaped HTML. An identity
;; cannot be forged. It also stops the representation leaking: `web/bml` used to hand-build
;; the same literal map, so changing it here would silently break raw-text elements there.
(defrecord raw-node (html))

;; The record's id under whatever namespace this module actually loads as — bare
;; `web/template` when hatch runs standalone, or `hatch/web/template` when hatch is a
;; dependency (ADR-070 intra-package rooting). Captured from a sentinel instance at load
;; so `raw?` compares against the real id in every context; a hardcoded `:web/template/…`
;; keyword only matched the standalone case and silently made `raw?` false for every raw
;; node once hatch was consumed as a package.
(def raw-node-id (record-id (raw-node nil)))

(defn raw (html)
  "Wrap a pre-built HTML string to bypass escaping in `render`."
  (raw-node html))

(defn raw? (v)
  "True if `v` was produced by `raw` — by identity, not by shape."
  (and (record? v) (= (record-id v) raw-node-id)))

;; So a raw node in a log line or a REPL result reads as what it is, rather than printing
;; the wrapper map around it.
(impl Display
  web/template/raw-node
  (->string [r] (str "#<raw " (pr-str (raw-node-html r)) ">")))

(impl Inspect
  web/template/raw-node
  (inspect [r] (str "#<raw " (pr-str (raw-node-html r)) ">")))

(defn escape-html (s)
  "Escape HTML special characters: & < > \" '.

  Most strings contain none of them — a class list, a URL path, ordinary prose — and the
  five `string/replace` passes cost the same whether or not they find anything, because the
  cost is per CALL and not per byte: escaping a ONE-character value measured 5µs, which was
  a fifth of the total cost of rendering an element. So the clean case is answered by five
  searches that allocate nothing, and the replaces run only when there is something to
  replace.

  (hatch/web/template/escape-html \"a<b&c\") ;=> \"a&lt;b&amp;c\""
  (let (text (str s))
    (if (or (includes? text "&")
          (includes? text "<")
          (includes? text ">")
          (includes? text "\"")
          (includes? text "'"))
      (string/replace (string/replace (string/replace (string/replace (string/replace text
                                                                        "&" "&amp;")
                                                        "<" "&lt;")
                                        ">" "&gt;")
                        "\"" "&quot;")
        "'" "&#39;")
      text)))

; Attributes whose value is a URL — a `javascript:`/`vbscript:` value (or a `data:` document)
; here executes script on click/load, which escaping does NOT stop (the scheme survives
; escaping). `render` neutralizes those on these attributes; `http(s)`/`mailto`/relative and a
; raster-image `data:` URL pass through (so a legitimate inline image still works).
(def *url-attrs* {:href true :src true :action true :formaction true :poster true :ping true})

(defn- url-scheme-noise? (c)
  "True for a leading char a browser strips before parsing a URL scheme (whitespace/controls)."
  (<= (string/char->int c) 32))

(defn- safe-data-image? (s)
  "True when normalized `s` is a `data:` URL declaring a raster image type we allow inline
  (png/apng/jpeg/gif/webp/bmp/x-icon). Deliberately EXCLUDES `image/svg+xml` (SVG can carry
  script) and every text/*, application/*, or type-less `data:` URL (those default to a
  text document and are trivially abused as `data:text/html`)."
  (or (string/starts-with? s "data:image/png")
    (string/starts-with? s "data:image/apng")
    (string/starts-with? s "data:image/jpeg")
    (string/starts-with? s "data:image/jpg")
    (string/starts-with? s "data:image/gif")
    (string/starts-with? s "data:image/webp")
    (string/starts-with? s "data:image/bmp")
    (string/starts-with? s "data:image/x-icon")))

(defn dangerous-url? (v)
  "True if `v` is a URL that executes script in a URL attribute: a `javascript:`/`vbscript:`
  scheme, or a `data:` URL that isn't a whitelisted raster image (so `data:text/html,…` and
  `data:image/svg+xml,…` are caught). Whitespace and control characters are removed first and
  case ignored, since browsers strip them before resolving the scheme (`  java\\tscript:…` is
  `javascript:`)."
  (let (s (string/lower (string/join (filter (string/->list (str v))
                                       (fn (c) (not (url-scheme-noise? c))))
                          "")))
    (or (string/starts-with? s "javascript:")
      (string/starts-with? s "vbscript:")
      (and (string/starts-with? s "data:") (not (safe-data-image? s))))))

(defn safe-url (v)
  "A URL safe to place in a URL attribute: a script-executing scheme (`javascript:`/`vbscript:`)
  is neutralized to `\"#\"`, everything else is returned unchanged. Applied automatically to
  `href`/`src`/`action`/… in `render`; use it explicitly for a URL in another context."
  (if (dangerous-url? v) "#" v))

(defn- unsafe-attr-name-cp? (cp)
  "True for a codepoint that must never appear in an HTML attribute name — whitespace/control
  (≤ 32) or a delimiter that could break out of the attribute list (`\"` `'` `/` `&` `<` `=`
  `>` backtick)."
  (or (<= cp 32) (= cp 34) (= cp 38) (= cp 39) (= cp 47) (= cp 60) (= cp 61) (= cp 62) (= cp 96)))

;; Attribute names are keywords written in source — `:class`, `:href`, the same handful on
;; every element of every page — so the character scan below answers the same question about
;; the same strings for the life of the process. It measured 4.2µs per attribute, a sixth of
;; the cost of rendering an element. Memoised, it is a table lookup.
(def- *safe-names* (table/new))

;; Bounded, because a name is not guaranteed to come from source: a template can build one
;; from data, and an unbounded memo keyed by that is a leak an app's INPUT controls. Past the
;; cap the scan simply runs — slower, still correct. The cap is far above the number of
;; distinct attribute names any real template uses.
(def- *max-safe-names* 512)

(defn- safe-attr-name? (n)
  (cond
    (table/has? *safe-names* n) (table/get *safe-names* n)
    (>= (table/count *safe-names*) *max-safe-names*) (safe-attr-name-scan? n)
    else
      (let (safe (safe-attr-name-scan? n))
        (table/put *safe-names* n safe)
        safe)))

(defn- safe-attr-name-scan? (n)
  "True when `n` is a non-empty attribute name with no character that could escape the
  attribute list. Hiccup keys are normally compile-time literals; this guards the case where
  an app derives a key from untrusted input (e.g. `(keyword (str \"data-\" user))`), which the
  value path already defends but the name path otherwise emits verbatim."
  (and (> (string/length n) 0)
    (not (any? (string/->list n) (fn (c) (unsafe-attr-name-cp? (string/char->int c)))))))

(defn render-attr (kv)
  "Serialize one `[keyword value]` attribute pair.
  Boolean `true` emits the bare attribute name; `false`/`nil` omits it. A URL attribute's
  value is passed through `safe-url` first, so a `javascript:` value can't smuggle script. An
  attribute whose NAME contains an unsafe character is dropped entirely (an unsafe name can't
  be escaped the way a value can)."
  (let ([k v] kv
        n (->string k))
    (cond
      (not (safe-attr-name? n)) ""
      (= v true) (str " " n)
      (= v false) ""
      (nil? v) ""
      (vector? v) (str " " n "=\"" (escape-html (string/join (map v str) " ")) "\"")
      (contains? *url-attrs* k) (str " " n "=\"" (escape-html (str (safe-url v))) "\"")
      else (str " " n "=\"" (escape-html (str v)) "\""))))

(defn render-attrs (attrs)
  "Serialize an attribute map to an HTML attribute string."
  (string/join (map (%map-pairs attrs) render-attr) ""))

;; The seam for an app's OWN type in a template. `render`'s `else` used to escape
;; `(str node)`, which for a record is its internal map — `{:__id__ :app/money, :cents 250}`
;; escaped into the page. That is never what the caller wanted, and the only ways out were
;; to pre-stringify at every call site or to edit this file. An `impl` is the third way.
;;
;; The provided body IS the old `else`, so every type without an impl renders exactly as it
;; did before. Dispatch also stays off the hot path: the concrete node kinds below keep
;; their direct `cond` branches, and only the fallback goes through the ability.
;;
;; An impl returns FINAL HTML and owns its own escaping — the same power `raw` has. Pass any
;; interpolated user data through `escape-html`.
(defability Renderable
  (render-html [self] :-> string (escape-html (str self))))

(impl Renderable web/template/raw-node (render-html [r] (raw-node-html r)))

(defn render (node)
  "Render a Hiccup node to an HTML string.

  Accepted forms:
  - `nil`                     → empty string
  - string / number           → HTML-escaped text
  - `(raw s)`                 → `s` verbatim (no escaping)
  - `[:tag attrs & children]` → HTML element
  - list of any of the above  → concatenated
  - anything else             → its `Renderable` impl, else HTML-escaped `str`

  (hatch/web/template/render [:p {:class \"x\"} \"hi\"]) ;=> \"<p class=\\\"x\\\">hi</p>\""
  (cond
    (nil? node) ""
    (string? node) (escape-html node)
    (int? node) (str node)
    (float? node) (str node)
    (bool? node) ""
    (vector? node) (render-element node)
    (pair? node) (string/join (map node render) "")
    else (render-html node)))

(defn- render-element (node)
  (let (tag (first node)
        tail (rest node)
        has-map (and (not (nil? tail)) (map? (first tail)))
        attrs (if has-map (first tail) {})
        children (if has-map (rest tail) tail)
        tag-name (->string tag)
        attr-str (render-attrs attrs))
    (if (contains? *void-tags* tag)
      (str "<" tag-name attr-str ">")
      (str "<"
        tag-name
        attr-str
        ">"
        (render-children children)
        "</"
        tag-name
        ">"))))

(defn- render-children (children)
  (string/join (map (seq/flatten children) render) ""))

(defn html (node)
  "Render a Hiccup node and prepend the HTML5 doctype declaration.

  (hatch/web/template/html [:p {} \"hi\"]) ;=> \"<!DOCTYPE html><p>hi</p>\""
  (str "<!DOCTYPE html>" (render node)))

(defn stylesheet (href)
  "A `<link rel=stylesheet>` Hiccup node for `href` — the conventional way to pull in a
  bundled stylesheet (e.g. `(stylesheet \"/static/app.css\")` for a Tailwind build). The
  live-view client hot-swaps these in place when the asset watcher reports a rebuild."
  [:link {:rel "stylesheet" :href href}])
