(defmodule web/compress
  "Response compression's two decisions: which content-coding a client gets — brotli
  (`Content-Encoding: br`) over gzip, whichever its `Accept-Encoding` offers and does not refuse
  (RFC 9110 §12.5.3) — and the encoding itself, in-process via `zlib/brotli` / `zlib/gzip`, so no
  reverse proxy or external binary is needed.

  Applying them is `web/endpoint`'s job: its pipeline compresses a finished string body last,
  after the ETag (so a 304 skips the work) and through the compressed-body cache (so an
  unchanged page is compressed once). Every hatch app gets that by serving through
  `web/endpoint/serve`, with `:compress` options in its config.

  The `compress` plug that used to live here — a router-pipeline before-send callback —
  duplicated that stage: the endpoint already compresses every response it serves."
  ; conn-headers — the request's Accept-Encoding
  (:use web/conn)
  ; accepts-encoding? — the one Accept-Encoding predicate, shared with web/static and web/stream
  (:use http/util))

(defn accepts? (conn coding)
  "True if the request's `Accept-Encoding` offers `coding` and does not refuse it with an
  explicit `q=0` weight. A missing header means no compression.

  The predicate itself is `http/util/accepts-encoding?`, shared with `web/static` and
  `web/stream` so that all three layers answer one question the same way."
  (accepts-encoding? (get (conn-headers conn) :accept-encoding) coding))

(defn chosen-encoding (conn)
  "The content-coding to compress with, preferring brotli (`\"br\"`) over gzip (`\"gzip\"`) when
  the client accepts it — brotli beats gzip on text and every modern browser advertises `br`.
  Returns nil when the client accepts neither."
  (cond
    (accepts? conn "br") "br"
    (accepts? conn "gzip") "gzip"
    else nil))

(defn encode-body (coding raw)
  "Compress `raw` bytes with `coding` (`\"br\"` or `\"gzip\"`) — the default level for each,
  tuned for per-request work (brotli 5, gzip 6)."
  (if (= coding "br") (zlib/brotli raw) (zlib/gzip raw)))
