(defmodule web/form
  "Forms over store changesets: what an input shows, which error sits under it, and the
  validators a web form wants that a storage library has no business shipping.

  A handler casts the submitted params, validates, and on failure re-renders the form
  with the changeset — every field keeps what the person typed, and each carries its
  first error:

    (let (cs (-> (changeset/cast {} params [:email :password] {:email :text :password :text})
                 (web/form/validate-email :email)
                 (changeset/validate-length :password {:min 12})))
      (match (changeset/apply-action cs :register)
        ([:ok fields] …)
        ([:error cs] (render-form cs))))

  and the template reads it:

    (input {:name \"email\" :value (web/form/value cs :email)
            :class (web/form/field-class cs :email \"input\" \"input-error\")})
    (when-let (message (web/form/error-for cs :email)) (p {:class \"error\"} message))

  A fresh form is `(changeset/change {})` — no params, so no errors.

  Validation itself is the changeset's (`changeset/validate-*`), and so is a uniqueness
  check: `changeset/unique-constraint` maps the database's rejection, which is the only
  check two concurrent requests cannot both pass.

  A form only a person should submit carries a `honeypot`, and its handler asks
  `honeypot-filled?` before doing anything."
  (:alias changeset)
  (:alias web/conn))

; ---- reading a changeset in a template ----

(defn- sent (cs field)
  "What the client sent for `field` — under its keyword or its string name — or
  `[:absent]`."
  (let (params (or (changeset/params cs) {}))
    (cond
      (contains? params field) [:present (get params field)]
      (contains? params (->string field)) [:present (get params (->string field))]
      :else [:absent])))

(defn value (cs field)
  "The text an input for `field` should show: what was submitted (so a value that failed
  to cast is shown as typed, not lost), else the changeset's value, else \"\"."
  (match (sent cs field)
    ([:present raw] (if (nil? raw) "" (str raw)))
    ([:absent] (let (v (changeset/get-field cs field)) (if (nil? v) "" (str v))))))

(defn error-for (cs field)
  "`field`'s first error message, or nil."
  (changeset/error-for cs field))

(defn errors? (cs)
  "True when the changeset carries any error."
  (not (changeset/valid? cs)))

(defn field-class (cs field base error-class)
  "`base`, or `\"base error-class\"` when `field` has an error — the conditional styling
  every input with an error state needs."
  (if (error-for cs field) (str base " " error-class) base))

; ---- web-form validators ----

(defn- no-space-or-control? (v)
  "True when `v` holds no space, tab, CR, LF, or other control character (any codepoint
  ≤ 32). Rejecting the whole control range — not just the space — keeps a validated address
  from smuggling a CR/LF into a downstream mail header (header injection)."
  (not (any? (string/->list v) (fn (c) (<= (string/char->int c) 32)))))

(defn email? (v)
  "A deliberately simple email check: one `@` with text before it and a dotted domain
  after (the dot not last), and no spaces, tabs, or control characters (so a validated
  address can't carry a CR/LF into a mail header). Enough for sign-up, not RFC 5322."
  (let (at (index-of v "@"))
    (and (> at 0)
      (no-space-or-control? v)
      (let (domain (string/substring v (+ at 1) (string/length v)))
        (and (= (index-of domain "@") -1)
          (> (index-of domain ".") 0)
          (< (index-of domain ".") (- (string/length domain) 1)))))))

(defn validate-email (cs field &optional (message "must be a valid email address"))
  "`field`'s change must pass `email?`."
  (changeset/validate cs field email? message))

; ---- a honeypot: a field a person never fills in, and a script does ----

(def *honeypot-field* "website")

(defn honeypot ()
  "A text field no person sees or fills in — off the page, out of the tab order and hidden from
  a screen reader — which a script filling every field it finds does fill. Put it inside a
  form a script should not submit (registering, say) and check `honeypot-filled?` first."
  [:div
    {:aria-hidden "true"
     :style "position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden"}
    [:label
      {}
      "Website"
      [:input {:type "text" :name *honeypot-field* :tabindex "-1" :autocomplete "off"}]]])

(defn honeypot-filled? (conn)
  "True when the form `conn` submits fills in the `honeypot`: it came from a script. Answer it
  as the form would be answered, so the script learns nothing, and do nothing."
  (not (= (string/trim (or (web/conn/param conn *honeypot-field*) "")) "")))
