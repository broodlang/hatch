(defmodule web/stream
  "Server-Sent Events (SSE) over hatch's chunked streaming responses. An SSE endpoint holds the
  connection open and pushes `text/event-stream` events to the browser's `EventSource`, which
  reconnects automatically if the stream drops.

  A handler returns `(sse-resp conn producer)`, where `producer` is `(fn (emit) …)`. It calls
  `emit` to push events and blocks as long as it wants — the worker process is dedicated to this
  connection, so a `receive` loop that forwards pubsub messages is the idiomatic shape:

    (defn events (conn)
      (stream/sse-resp conn
        (fn (emit)
          (pubsub/subscribe \"prices\")
          (loop []
            (receive
              ([:price p] (do (emit (str \"price=\" p)) (recur))
              (:done nil)))))))

  `emit` accepts either a string (sent as a `data:` event) or a map
  `{:data … :event … :id … :retry …}` for a named event, a last-event-id (resumption), or a
  reconnect-delay hint. When `producer` returns, the stream's terminating chunk is sent and the
  connection closes; the client's `EventSource` then reconnects unless the app closed it.

  Sending a periodic comment/keepalive (`(emit-comment emit)`) keeps proxies from idling the
  connection out.

  Beyond SSE, `stream-bytes`/`stream-file` chunk a large body (a report, an export, a download)
  onto the socket in fixed-size blocks so the framework never builds one giant response value,
  with optional `Content-Encoding: gzip`."
  ; stream-resp / put-resp-header — build the chunked streaming conn
  (:use web/conn))

(defn sse-field (name value)
  "One SSE header line `name: value\\n`, or \"\" when `value` is nil (the field is omitted)."
  (if (nil? value) "" (str name ": " value "\n")))

(defn sse-data (data)
  "The `data:` lines for a payload. Each embedded newline starts a new `data:` line, per the
  SSE spec — so a multi-line payload arrives as one event with newlines preserved."
  (string/join "" (map (fn (line) (str "data: " line "\n")) (string/split (str data) "\n"))))

(defn sse-event (data &optional (opts {}))
  "Format one SSE event frame from `data` and `opts` (`:event`, `:id`, `:retry`), terminated by
  the blank line that dispatches the event. Field order is event/id/retry then the data lines,
  matching common SSE producers."
  (str (sse-field "event" (get opts :event))
    (sse-field "id" (get opts :id))
    (sse-field "retry" (get opts :retry))
    (sse-data data)
    "\n"))

(defn emit-comment (emit &optional (text ""))
  "Send an SSE comment line (`: text`) through `emit` — ignored by the client, but a cheap
  keepalive that stops an idle proxy from closing the connection."
  (emit {:raw (str ": " text "\n\n")}))

(defn- format-message
  (msg)
  "Format one value passed to `emit`: a string is a plain `data:` event; a map may carry
  `:data`/`:event`/`:id`/`:retry`, or `:raw` for a pre-formatted frame (comments/keepalives)."
  (cond
    (string? msg) (sse-event msg {})
    (contains? msg :raw) (get msg :raw)
    else (sse-event (get msg :data "") msg)))

(defn sse-resp (conn producer)
  "An SSE (`text/event-stream`) streaming response. `producer` is `(fn (emit) …)`: `emit` takes
  a string (a `data:` event) or a `{:data … :event … :id … :retry …}` map. Sets the SSE
  content-type and `Cache-Control: no-cache`; streams until `producer` returns. Built on
  `web/conn/stream-resp`."
  (let (conn (put-resp-header (put-resp-header conn :content-type "text/event-stream")
               :cache-control "no-cache"))
    (stream-resp conn
      (fn (write) (producer (fn (msg) (write (format-message msg))))))))

;; ---- byte / file streaming (chunked, optionally gzip) ------------------------

(defn accepts-gzip? (conn)
  "True if the request's `Accept-Encoding` offers gzip (a crude substring test — we only ever
  advertise gzip)."
  (let (ae (get (get conn :headers) :accept-encoding))
    (and (string? ae) (includes? ae "gzip"))))

(defn- write-blocks
  (write data block-size offset)
  "Write `data` (bytes) to the socket in `block-size`-byte chunks, from `offset` to the end."
  (let (n (count data))
    (when (< offset n)
      (let (end (min n (+ offset block-size)))
        (write (bytes/slice data offset end))
        (write-blocks write data block-size end)))))

(defn stream-bytes (conn data &optional (opts {}))
  "Stream `data` (a string or `bytes`) as a chunked response, written to the socket in
  `:block-size`-byte blocks (default 65536) so a large body reaches the client progressively.
  `opts`: `:content-type` (default `application/octet-stream`), `:block-size`, and `:gzip` — when
  set and the request accepts gzip, the bytes are gzip-compressed once and streamed with
  `Content-Encoding: gzip` + `Vary: Accept-Encoding`. Returns a streaming conn."
  (let (raw (bytes/concat data)
        gzip? (and (get opts :gzip false) (accepts-gzip? conn))
        body (if gzip? (zlib/gzip raw) raw)
        block-size (get opts :block-size 65536)
        conn (put-resp-header conn
               :content-type
               (get opts :content-type "application/octet-stream"))
        conn (if gzip?
               (put-resp-header (put-resp-header conn :content-encoding "gzip")
                 :vary "Accept-Encoding")
               conn))
    (stream-resp conn (fn (write) (write-blocks write body block-size 0)))))

(defn stream-file (conn path &optional (opts {}))
  "Stream the file at `path` as a chunked response (see `stream-bytes` for `opts`). The file is
  read once with `slurp-bytes` and then chunked onto the socket — this bounds the *response*
  build, not the read (brood has no incremental file read yet), so it suits moderate downloads
  and progressive delivery rather than arbitrarily large files. Guard the path (existence /
  traversal) before calling; an unreadable path raises."
  (stream-bytes conn (file/slurp-bytes path) opts))
