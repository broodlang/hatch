(defmodule web/conn
  "Request/response context value — the Conn."
  ; parse-query / content-type-base / content-type-param / stringify-keys — body parsing
  (:use http/util)
  ; parse — multipart/form-data (file upload) body parsing
  (:use http/multipart))

;; The Conn is a RECORD, not a bare map, for the reason Phoenix's `%Plug.Conn{}` is a struct:
;; every field it carries is now a name the toolchain knows. `(get conn :halted)` — one
;; character off `:halted?` — is a silent nil that reads as "not halted", and a plug that
;; wrote it would let a halted request through with nothing to see. `(conn-halted? conn)` is
;; an undefined function: a `nest check` warning at edit time.
;;
;; The generated accessors work on ANY map, not only on a record (verified: `(conn-method
;; {:method "POST"})` answers "POST"), so a synthetic conn built by hand in a test — or the
;; `{:headers {…}}` literal in a doctest — keeps working exactly as before. What changes is
;; that the *framework's* reads go through a name instead of a keyword.
;;
;; Two consequences worth knowing. A record is NOT `=` to a map with the same fields, so a
;; test may not compare a whole conn against a map literal. And `contains?` answers true for
;; a declared field even when it is nil, so "was this ever set?" is `(nil? (conn-route c))`,
;; never `contains?` — see `conn->response`, which is where that distinction is load-bearing.
;;
;; The fields below are every key the framework itself reads. The response-side and
;; plug-owned ones (`:session`, `:flash`, `:route`, `:stream`) are declared here rather than
;; accreted by `assoc` in whichever module happens to add them, so the shape of a conn is
;; readable in one place. An app is still free to `assoc` its own keys on; that keeps working
;; and the value stays a record.
(defrecord conn
  (method path
    query scheme params body-params files body-file headers body body-bytes cookies assigns status
    resp-body resp-headers resp-cookies before-send halted? route stream session session-store
    session-changed? flash path-params body-parsed?))

(impl Display
  web/conn/conn
  (->string [connection]
    (str "#<conn " (conn-method connection) " " (conn-path connection) ">")))

;; The most a JSON body may be for `parse-body` to decode it into params. json/decode costs
;; about 5us a byte in Brood, so the 8 MB a body may be cost tens of seconds of one core —
;; and the body is the attacker's. A larger JSON body still arrives whole as `:body` /
;; `:body-bytes` for a handler that decodes it itself, as a spooled body does.
(def *json-params-max-bytes* 16384)

(defn build (request)
  "Construct a Conn from a raw parsed request map, its body parsed (see `parse-body`) — the
  conn a test or a direct caller wants. The endpoint builds with `build-unparsed`, so a
  request no route takes never pays for parsing its body. `:params` merges the request's query
  params (already parsed by http/request) with any form/JSON body params, body winning on
  a key clash; the router later merges path params on top. Request cookies are parsed from
  the `Cookie` header into `:cookies`.

  The request `:body` arrives as raw `bytes` (from the bytes-native request parser). The conn
  exposes it two ways: `:body` (decoded to UTF-8 text, for form/JSON/text handlers) and
  `:body-bytes` (the raw bytes, for binary payloads). A `multipart/form-data` upload is parsed
  here: its text fields merge into `:params`, and its file parts land in `:files` as
  `{name → {:filename :content-type :bytes}}`.

  A large body the server streamed to disk (http/server `:spool-threshold`) arrives with an
  empty `:body` and a `:body-file` path instead; the conn carries `:body-file` through, and the
  handler persists it zero-copy with `save-body` or parses it on demand with
  `parse-upload-file` (never loading it into memory otherwise)."
  (parse-body (build-unparsed request)))

(defn build-unparsed (request)
  "Construct a Conn from a raw parsed request map with its body NOT yet parsed: `:params`
  holds the query params, and `parse-body` adds the form / JSON / multipart ones. What the
  endpoint builds, so a body is parsed only for a request a route takes — after that route's
  `through` plugs (a rate limit) and inside its deadline — never for a 404 or an asset."
  (let (headers (get request :headers {})
        query-params (get request :params {})
        raw (get request :body "")
        ; `:body` is `bytes` from the parser (empty `bytes` for no body); a spooled request carries
        ; the empty string "" — coerce either to bytes, then decode text for form/JSON handlers.
        body-bytes (if (bytes? raw) raw (string/->bytes raw))
        body-text (check-allow :discarded-catch (try (string/bytes-> body-bytes) (catch _e "")))
        body-params {})
    ;; Positional, in the record's declared order — the one construction site in the
    ;; framework, so the ordering is checked here once rather than trusted everywhere.
    ;;
    ;; `:session` and `:flash` start as `{}` rather than nil. A DECLARED field is always
    ;; present, so a `(get conn :session {})` style read would answer nil (a default fires
    ;; only on an ABSENT key) and every accessor that coerced a missing session to `{}` would
    ;; start handing nil to `get` instead. Empty is also the truer value: no session plug has
    ;; run, so there is nothing in the session.
    (conn (get request :method)
      (get request :path)
      (get request :query)
      ;; stamped by http/server from its own `:tls` config — see `request-scheme`
      (get request :scheme)
      query-params
      body-params
      {} ; files — filled by parse-body
      (get request :body-file)
      headers
      body-text
      body-bytes
      (parse-cookies headers)
      {} ; assigns
      nil ; status
      "" ; resp-body
      {} ; resp-headers
      (list) ; resp-cookies
      (list) ; before-send
      false ; halted?
      nil ; route — set by the router when a pattern matched
      nil ; stream — set by stream-resp
      {} ; session — replaced by fetch-session
      nil ; session-store
      false ; session-changed?
      {} ; flash — replaced by fetch-flash
      {} ; path-params — set by the router
      false))) ; body-parsed? — set by parse-body
(defn parse-body (conn)
  "`conn` with its request body parsed into params — form, JSON (up to
  `*json-params-max-bytes*`) and multipart fields, with file parts in `:files` — the body's
  values winning over the query's and the route's path params over both. Parses once: a
  parsed conn comes back as it is, so a plug that needs a body value (CSRF) and the route
  share one parse."
  ;; a conn written out as a map in a test, with no `:body-parsed?`, already says its params
  (if (or (conn-body-parsed? conn) (not (contains? conn :body-parsed?)))
    conn
    (let (parsed (parse-conn-body (conn-headers conn) (conn-body conn) (conn-body-bytes conn))
          body-params (get parsed :params))
      (assoc conn
        :params (into (into (or (conn-params conn) {}) body-params) (or (conn-path-params conn) {}))
        :body-params body-params
        :files (get parsed :files)
        :body-parsed? true))))
(sig parse-body (map -> map))

(defn parse-conn-body (headers body-text body-bytes)
  "Parse the request body into `{:params <string→value> :files <name→file-map>}`.
  `multipart/form-data` splits file parts out into `:files` (raw bytes) and merges its text
  fields into `:params`; `x-www-form-urlencoded`/JSON parse into `:params` (from the decoded
  text) as before; any other type contributes nothing."
  (cond
    (and (= (content-type-base headers) "application/json")
      (> (count body-bytes) *json-params-max-bytes*))
      {:params {} :files {}}
    (= (content-type-base headers) "multipart/form-data")
      (let (mp (http/multipart/parse body-bytes (content-type-param headers "boundary")))
        {:params (get mp :fields) :files (get mp :files)})
    :else {:params (parse-body-params headers body-text) :files {}}))

(defn parse-body-params (headers body)
  "Parse a request `body` into a string→value params map based on its Content-Type:
  `application/x-www-form-urlencoded` is parsed like a query string, `application/json`
  yields the top-level object's fields (keys stringified to match query/form params).
  Any other type — or an empty/malformed body — yields `{}`; the raw bytes stay on the
  conn as `:body`. A `multipart/form-data` body never reaches this: `parse-conn-body` hands it
  to `http/multipart/parse`, which splits its file parts into `:files`."
  (if (string/blank? body)
    {}
    (let (ct (content-type-base headers))
      (cond
        (= ct "application/x-www-form-urlencoded") (parse-query body)
        (= ct "application/json") (json-body-params body)
        else {}))))

(defn- json-body-params (body)
  "Params from a JSON request `body`. Only a top-level JSON object contributes params; its
  keys are stringified — deeply, including nested objects — so the result reads like query/
  form params throughout (json-parse yields keyword keys). A non-object body or a parse error
  yields `{}` (a malformed body is ignored, not fatal)."
  (try
    (let (parsed (json/decode body))
      (if (map? parsed) (stringify-keys parsed) {}))
    (catch _e {})))

(defn parse-cookies (headers)
  "Parse the request `Cookie` header into a string→string map. Values are taken verbatim
  (not URL-decoded): session/flash cookies are base64url, which is already cookie-safe, and
  decoding opaque third-party cookies would only corrupt them."
  (let (raw (get headers :cookie))
    (if (or (nil? raw) (string/blank? raw))
      {}
      (fold (string/split raw ";")
        {}
        (fn (m pair)
          (let (eq (index-of pair "="))
            (if (= eq -1)
              m
              (assoc m
                (trim-if-needed (string/substring pair 0 eq))
                  (trim-if-needed (string/substring pair (+ eq 1) (string/length pair)))))))))))

(defn assign (conn key val)
  "Put a value into the conn's assigns map."
  (map/assoc-in conn [:assigns key] val))

(defn get-assign (conn key)
  "Get a value from the conn's assigns map."
  (get (conn-assigns conn) key))

(defn put-status (conn status)
  "Set the response status."
  (assoc conn :status status))

(defn put-resp-header (conn key val)
  "Add a response header."
  (map/assoc-in conn [:resp-headers key] val))

(defn put-resp-body (conn body)
  "Set the response body."
  (assoc conn :resp-body body))

(defn halt (conn)
  "Mark the conn as halted — no further plugs will run."
  (assoc conn :halted? true))

(defn halted? (conn)
  "True if the conn has been halted."
  (or (conn-halted? conn) false))

(defn param (conn key)
  "Get a request param by string key — query, body or path. On a conn whose body is not yet
  parsed (a plug that runs before its route's handler) the body is parsed for the lookup."
  (get (conn-params (parse-body conn)) key))

(defn body-param (conn key)
  "Get a request param that came from the request *body* (form/JSON) by string key — not the
  query string. Use this where a query-string value must not be honored, e.g. a CSRF token
  (which leaks via Referer/logs/history if accepted from the URL)."
  (get (or (conn-body-params (parse-body conn)) {}) key))

;; ---- typed params ---------------------------------------------------------------
;; A JSON body's values keep their JSON types — `{"page": 5}`, `{"q": ["a"]}` — while a handler
;; written against forms expects a string, and the gap was a 500: `(string/->number 5)` raises.
;; These answer the type asked for, or nil, whatever the client sent.

;; The largest whole number a parameter may name: 2^53, past which a float can no longer tell
;; neighbours apart, and well inside what a `bigint` column holds.
(def *largest-whole-number* 9007199254740992)

(defn string-param (conn key &optional (fallback nil))
  "The `key` param when it is a string — from the query, the body or the path — else
  `fallback`: a JSON number, array or object where a string was meant is not one."
  (let (value (param conn key))
    (if (string? value) value fallback)))

(defn whole-number (raw)
  "`raw` as a whole number from 0 to 2^53, or nil for anything else — a fraction, a
  negative, junk, a number too large for the database, nil, or a value that is not a string
  or an integer at all. A string is parsed; a JSON integer is taken as it is.

  `int?`, not truthiness: `string/->number` answers a FAILURE for text that is not a
  number, and a failure is truthy — unguarded, `/settings/tokens/abc/delete` reached a query
  with it and came back a 500."
  (let (parsed (cond
                 (int? raw) raw
                 (string? raw) (string/->number raw)
                 :else nil))
    (if (and (int? parsed) (>= parsed 0) (<= parsed *largest-whole-number*)) parsed nil)))

(defn whole-number-param (conn key &optional (fallback nil))
  "The `key` param as a whole number (see `whole-number`), or `fallback` when it is absent
  or is not one."
  (let (value (whole-number (param conn key)))
    (if (nil? value) fallback value)))

(defn files (conn)
  "The uploaded files from a multipart/form-data request: `{name → {:filename :content-type
  :bytes}}`. Empty when the request wasn't a multipart upload."
  (or (conn-files conn) {}))

(defn file (conn name)
  "One uploaded file by its form field `name` — a `{:filename :content-type :bytes}` map, or
  nil if no file was uploaded under that name. `spit-bytes` the `:bytes` to store it."
  (get (or (conn-files conn) {}) name))

(defn body-file (conn)
  "The path of the on-disk spool for a large request body the server streamed to disk (see
  http/server `:spool-threshold`), or nil for an ordinary in-memory request. When set, `:body`/
  `:body-bytes`/`:files` are empty — read the body via `save-body` or `parse-upload-file`."
  (conn-body-file conn))

(defn spooled? (conn)
  "True if this request's body was streamed to disk rather than buffered in memory."
  (not (nil? (conn-body-file conn))))

(defn body-bytes (conn)
  "The request body as `bytes`, wherever the server put it: read back from the spool when
  it was streamed to disk (`spooled?`), else the in-memory `:body-bytes`. Empty bytes for a
  request with no body, so a caller asks `(= (bytes/length …) 0)` rather than guessing
  which of nil and empty it gets. Reads a spooled body into memory — to only store one,
  `save-body` moves the file instead."
  (let (spool (conn-body-file conn)
        in-memory (conn-body-bytes conn))
    (cond
      (string? spool) (file/slurp-bytes spool)
      (nil? in-memory) (string/->bytes "")
      :else in-memory)))

(defn save-body (conn dest)
  "Persist a spooled request body to `dest` by moving the temp spool file — zero-copy (a
  rename, no read-back into memory), which is the point of streaming a large upload to disk.
  Returns `dest`. Errors if the request wasn't spooled (no `:body-file`)."
  (let (src (conn-body-file conn))
    (if (nil? src)
      (error "save-body: request body was not spooled to disk (no :body-file)")
      (do (file/rename src dest) dest))))

(defn parse-upload-file (conn)
  "Parse a spooled `multipart/form-data` body from disk into `{:fields :files}` (the same shape
  http/multipart returns). Reads the spool file once — use only when the app needs the parsed
  fields; to merely store the upload, prefer the zero-copy `save-body`. Returns nil if the
  request wasn't spooled."
  (let (src (conn-body-file conn))
    (if (nil? src)
      nil
      (http/multipart/parse (file/slurp-bytes src)
        (content-type-param (or (conn-headers conn) {}) "boundary")))))

(defn header (conn key)
  "Get a request header by keyword key."
  (get (conn-headers conn) key))

(defn get-cookie (conn name &optional (default nil))
  "Get a request cookie value by string name, or `default` if absent."
  (get (or (conn-cookies conn) {}) name default))

(defn put-cookie (conn name value &optional (opts {}))
  "Add a `Set-Cookie` to the response. `opts`: `:path` (default \"/\"), `:max-age` (in
  seconds), `:domain`, `:same-site` (default \"Lax\"), `:http-only` (default true), and
  `:secure` (default false). Multiple cookies accumulate — each becomes its own header
  line (see http/response). The caller is responsible for any value encoding."
  (assoc conn
    :resp-cookies
      (append (or (conn-resp-cookies conn) (list))
        (list (format-set-cookie name value opts)))))

(defn delete-cookie (conn name &optional (opts {}))
  "Expire a cookie by name — a `Set-Cookie` with an empty value and `Max-Age=0`. Pass the
  same `:path`/`:domain` the cookie was written with so the browser drops the right one."
  (put-cookie conn name "" (assoc opts :max-age 0)))

(defn cookie-safe (s)
  "Strip characters that could break out of a cookie name or value — CR/LF (header
  injection / response splitting) and `;` (forging extra attributes or a second pair).
  Defense in depth for the public `put-cookie` API: a caller passing an unencoded,
  user-controlled value can't smuggle attributes. (Signed session/flash cookies are
  base64url+hex, so this is a no-op for them.)"
  (-> (str s)
    (string/replace "\r" "")
    (string/replace "\n" "")
    (string/replace ";" "")))

(defn format-set-cookie (name value opts)
  "Format one `Set-Cookie` header value from `name`, `value`, and `opts` (see put-cookie)."
  (let (path (get opts :path "/")
        max-age (get opts :max-age)
        domain (get opts :domain)
        same-site (get opts :same-site "Lax"))
    (str (cookie-safe name)
      "="
      (cookie-safe value)
      "; Path="
      (cookie-safe path)
      (if (nil? domain) "" (str "; Domain=" (cookie-safe domain)))
      (if (nil? max-age) "" (str "; Max-Age=" max-age))
      "; SameSite="
      (cookie-safe same-site)
      (if (get opts :http-only true) "; HttpOnly" "")
      (if (get opts :secure false) "; Secure" ""))))

(defn register-before-send (conn f)
  "Register `f` (a conn→conn function) to run just before the conn is serialized by
  `conn->response`. Callbacks run in registration order. This is how a plug writes a value
  computed from the *finished* conn — e.g. the session/flash cookie, set after the handler
  has mutated the session (mirrors Plug's `register_before_send`)."
  (assoc conn :before-send (append (or (conn-before-send conn) (list)) (list f))))

(defn run-before-send (conn)
  "Run the conn's registered before-send callbacks left-to-right, threading the conn."
  (fold (or (conn-before-send conn) (list)) conn (fn (c f) (f c))))

(defn send-resp (conn status body)
  "Set the response status and body on the conn, returning the conn. The web layer
  works in conns end to end; `conn->response` serializes the final conn for http/server."
  (assoc conn :status status :resp-body body))

(defn conn->response (conn)
  "Serialize a finished conn into the `{:status :headers :body}` map http/server sends.
  Runs any registered before-send callbacks first, then folds accumulated `:resp-cookies`
  into a list-valued `:set-cookie` header (http/response emits one line per cookie). Status
  defaults to 200; headers and body come from the conn's resp fields. A conn carrying a
  `:stream` function (see `stream-resp`) passes it through so http/server sends the response
  chunked."
  (let (conn (run-before-send conn)
        cookies (or (conn-resp-cookies conn) (list))
        headers (or (conn-resp-headers conn) {})
        headers (if (empty? cookies) headers (assoc headers :set-cookie cookies))
        base {:status (or (conn-status conn) 200)
              :headers headers
              :body (or (conn-resp-body conn) "")}
        ;; Carried through so the server's telemetry can name the ROUTE rather than the
        ;; path — the difference between one row per route and one per URL anyone visits.
        ;;
        ;; `nil?`, not `contains?`: `:route` and `:stream` are declared fields of the conn
        ;; record and so are always PRESENT, nil or not. `contains?` answered true for every
        ;; conn ever built and stamped `:route nil` onto every response.
        route (conn-route conn)
        base (if (nil? route) base (assoc base :route route))
        stream (conn-stream conn))
    (if (nil? stream) base (assoc base :stream stream))))

(defn stream-resp (conn stream-fn &optional (status 200))
  "Produce a chunked streaming response from `conn`. `stream-fn` is a one-argument function
  `(fn (write) …)`; it calls `write` — passing a string, `bytes`, or an iolist — as many times
  as it likes, and each call sends one Transfer-Encoding chunk. The connection is chunked-encoded
  and closed once `stream-fn` returns. Set any response headers (e.g. `:content-type`) with
  `put-resp-header` before calling. For Server-Sent Events, use `web/stream/sse-resp`, which wraps
  this with the SSE content-type and an event-formatting `emit`."
  (assoc conn :status status :stream stream-fn))

(defn html-resp (conn body)
  "200 OK HTML response (conn)."
  (send-resp conn 200 body))

(defn text-resp (conn body)
  "200 OK plain-text response (conn)."
  (send-resp (put-resp-header conn :content-type "text/plain; charset=utf-8") 200 body))

(defn json-resp (conn body &optional (status 200) (opts {}))
  "JSON response (conn), `status` defaulting to 200.

  `body` is encoded when it is not already a string, so a handler hands over the data it
  has rather than remembering to encode at every call site:

      (json-resp conn {:packages results})              ; encoded, 200
      (json-resp conn {:error \"no such package\"} 404)   ; encoded, 404
      (json-resp conn already-encoded-text)             ; sent as-is

  The status matters more than it looks. Without it every JSON error had to be built by hand
  (`put-resp-header` + `send-resp`), and an app that did that once per error path is an app
  where one of them forgot the content-type — which turns a parseable `{\"error\": …}` into a
  body the client's decoder rejects, reporting a syntax error instead of the message.

  `:cache` in `opts` sets `Cache-Control`. There is no default, deliberately: a JSON response
  is public and cacheable (`http-cache/public-for`) or it is per-user and must not be
  (`http-cache/no-store`), and only the handler knows which. A read whose freshness nobody
  declared is one every client and proxy has to guess about."
  (let (typed (put-resp-header conn :content-type "application/json")
        cache (get opts :cache)
        headed (if cache (put-resp-header typed :cache-control cache) typed))
    (send-resp headed status (if (string? body) body (json/encode body)))))

(defn redirect-resp (conn url &optional (status 302))
  "Redirect response (conn)."
  (send-resp (put-resp-header conn :location url) status ""))

(defn not-found-resp (conn &optional (body "<h1>404 Not Found</h1>"))
  "404 Not Found response (conn)."
  (send-resp conn 404 body))

(defn run-pipeline (conn plugs)
  "Run a list of plug functions left-to-right, stopping on halt."
  (if (or (nil? plugs) (halted? conn))
    conn
    (run-pipeline ((first plugs) conn) (rest plugs))))

(defn router->handler (router)
  "Adapt a conn-based `router` (a `defrouter` function) into an `http/server` request
  handler: build a conn from the raw request, run it through the router, and serialize the
  resulting conn into the `{:status :headers :body}` map the server sends. This is the
  minimal `build → route → conn->response` seam every app otherwise hand-rolls — wire it
  straight into the endpoint:
    (server/start port (web/conn/router->handler app-router) (live/live-dispatcher))
  An app that wants per-request logging, process isolation, a handler timeout, themed error
  pages, response validators or compression uses `web/endpoint/serve` instead, which is that
  pipeline in the order that makes it correct. This stays for the smallest case: a router and
  nothing around it."
  (fn (request) (conn->response (router (build request)))))
