(defmodule web/migrate
  "The migration commands an app exposes — `mix ecto.migrate` and friends, as one function
  the app's `main` hands its arguments to:

    (defn main (& arguments)
      (if (= (first arguments) \"migrate\")
        (os/exit (web/migrate/run (pg/adaptor) (config/db-opts) migrations/all db/schemas
                   (rest arguments)))
        (serve …)))

  so the release binary carries them (`hive migrate status`) and a deploy can run
  `<app> migrate` once before its machines start. The commands:

    (none) | up [--to V]     apply what is pending
    down [--step N | --to V] roll back the newest (or N, or everything after V)
    status                   every migration, up or down
    pending                  the pending ones; exit 1 when there are any
    sql                      the SQL `up` would run, without running it
    check                    exit 1 when the migrations do not build the schemas
    gen NAME                 print the migration that would make them agree

  `check` and `gen` need no database: the migrations are data, and folding them gives the
  schema they build (store's `migration/model`)."
  (:alias repo)
  (:alias migration))

(def- usage
  (str "usage: migrate [up [--to V] | down [--step N | --to V] | status | pending | sql | check | gen NAME]"))

(defn- flag (arguments name)
  "The value after `--name` in `arguments`, as a number, or nil."
  (let (tail (drop-while (into [] arguments) (fn (a) (not (= a (str "--" name))))))
    (when (> (count tail) 1) (string/->number (second tail)))))

(defn- with-repo (adaptor opts f)
  (let (r (repo/open adaptor (assoc opts :size 1)))
    (try
      (let (result (f r)) (repo/close r) result)
      (catch e (do (repo/close r) (throw e))))))

(defn- say (line) (io/puts line))

(defn- describe-migration (m) (str (get m :version) " " (get m :name)))

(defn run (adaptor opts migrations schemas arguments)
  "Run the migration command in `arguments` (see the module doc) and return the exit
  code: 0 on success, 1 when `pending`/`check` find work or the command is unknown."
  (let (command (or (first arguments) "up")
        rest-arguments (rest arguments))
    (case command
      "up"
        (with-repo adaptor
          opts
          (fn (r)
            (let (applied (migration/migrate r
                            migrations
                            (if (flag rest-arguments "to")
                              {:log say :to (flag rest-arguments "to")}
                              {:log say})))
              (say (if (empty? applied)
                     "migrate: nothing pending"
                     (str "migrate: applied " (count applied))))
              0)))
      "down"
        (with-repo adaptor
          opts
          (fn (r)
            (let (options (cond
                            (flag rest-arguments "to") {:log say :to (flag rest-arguments "to")}
                            (flag rest-arguments "step")
                              {:log say :step (flag rest-arguments "step")}
                            :else {:log say})
                  undone (migration/rollback r migrations options))
              (say (if (empty? undone)
                     "migrate: nothing to roll back"
                     (str "migrate: rolled back " (count undone))))
              0)))
      "status"
        (with-repo adaptor
          opts
          (fn (r)
            (doseq (entry (migration/status r migrations))
              (say (str (case (get entry :state) :up "  up      " :down "  down    " "  MISSING ")
                     (get entry :version)
                     " "
                     (get entry :name))))
            0))
      "pending"
        (with-repo adaptor
          opts
          (fn (r)
            (let (todo (migration/pending r migrations))
              (doseq (m todo) (say (describe-migration m)))
              (if (empty? todo) 0 1))))
      "sql"
        (with-repo adaptor
          opts
          (fn (r)
            (doseq (line (migration/plan migrations
                           (map (migration/applied r) (fn (row) (get row :version)))))
              (say line))
            0))
      "check"
        (let (gap (migration/check migrations schemas))
          (if (empty? gap)
            (do (say "migrate: the migrations build the schemas") 0)
            (do
              (say "migrate: the schemas differ from what the migrations build — `migrate gen NAME` writes:")
              (doseq (step gap) (say (str "  " (pr-str step))))
              1)))
      "gen"
        (if (empty? rest-arguments)
          (do (say usage) 1)
          (let (m (migration/generate migrations schemas (first rest-arguments)))
            (if (nil? m)
              (do (say "migrate: nothing to generate — the migrations already build the schemas") 0)
              (do (say (migration/render m)) 0))))
      (do (say usage) 1))))
