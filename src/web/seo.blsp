(defmodule web/seo
  "Search-engine and social metadata: the `<head>` block, `robots.txt`, and a
  `sitemap.xml` **derived from the router's own route table**.

  A server-rendered Hatch app is already most of the way to being indexable — the HTML is
  the content, not a shell a crawler has to execute JavaScript to fill. What it usually
  lacks is the part no framework can guess: which of several URLs for the same content is
  the canonical one, what each page is ABOUT (as opposed to what the site is about), and
  where the list of pages lives. That is what this module is for.

  Three pieces, usable independently:

  - `head-tags` — one call rendering description, canonical, robots, the Open Graph and
    Twitter card, and any JSON-LD. It takes a SITE map (constant per app) and a PAGE map
    (per request), so the per-page half is the only thing a view has to think about.
  - `robots-handler` — `robots.txt`, pointing at the sitemap.
  - `sitemap-handler` — `sitemap.xml`, listing every parameterless `GET` route the router
    declares, plus whatever dynamic URLs the app supplies.

  The sitemap reading the ROUTE TABLE is the point. A hand-maintained URL list is a second
  copy of the routes, and the copy is always the one that goes stale — silently, because a
  missing sitemap entry looks exactly like a page nobody linked to. `defrouter` already
  builds its table as a `def` (`<router-name>--routes`), and a pattern segment is a literal
  string, a `:param` keyword, or a `[:splat name]`; a route whose every segment is a string
  is a fixed URL, and those are exactly the ones a sitemap can name without help.

  ## Canonical vs noindex

  Both answer \"do not rank this URL\", and they must not be used together. `rel=canonical`
  is a HINT that consolidates duplicates onto one URL; `noindex` is a DIRECTIVE that keeps
  a page out of the index. Together they contradict each other — one says credit that other
  page, the other says drop this one — and the documented failure is the `noindex` being
  carried across to the canonical target. So: a page that IS the canonical one carries
  `:canonical`; a variant that should never be a landing page carries `:robots \"noindex,
  follow\"` and no canonical. `head-tags` enforces this rather than trusting the caller —
  passing both drops the canonical.

  ## Example

      (def *site*
        {:url \"https://example.com\"
         :name \"Example\"
         :description \"What the site is, in one sentence.\"
         :image \"/og.png\"
         :twitter-card \"summary_large_image\"})

      (head-tags *site* {:title \"Widgets\" :description \"Every widget we sell.\"
                         :canonical \"/widgets\"})

      (defrouter app-router
        (get \"/robots.txt\"  (seo/robots-handler *site* {}))
        (get \"/sitemap.xml\" (seo/sitemap-handler *site* app-router--routes {}))
        (get \"/widgets\"     widgets/index))"
  (:use web/conn)
  (:alias web/cache)
  (:alias web/template))

;; ---- the head block ---------------------------------------------------------

(defn- present? (s) (and (string? s) (not (= s ""))))

(defn absolute-url (site path)
  "`path` as an absolute URL under the site's own origin. A path that is already absolute
  is returned unchanged, so a caller may pass either — an OG image on a CDN, say, beside a
  canonical on this host. Canonical and `og:url` MUST be absolute; this is what guarantees
  it rather than hoping every call site remembered."
  (cond
    (not (present? path)) nil
    (or (string/starts-with? path "http://") (string/starts-with? path "https://")) path
    else (str (or (get site :url) "") path)))

(defn page-description (site page)
  "The page's own description, falling back to the site's.

  The fallback is a floor, not a plan: a site whose every URL shares one description has,
  to a search engine, one page's worth of distinguishing text. Give a page its own whenever
  the page knows something — a product its summary, an article its lede, a package its
  blurb."
  (let (own (get page :description))
    (if (present? own) own (get site :description))))

(defn json-ld (data)
  "One `application/ld+json` script element for `data` (a map, rendered as JSON).

  Structured data is how a page says what KIND of thing it is — a `SoftwareApplication`, an
  `Article`, a `BreadcrumbList` — rather than leaving a search engine to infer it from
  prose. Returns \"\" for nil, so a page with nothing to declare costs nothing.

  The JSON is escaped for a `<script>` context: `</` is broken up, because a `</script>`
  appearing inside a JSON string value would otherwise end the element early and spill the
  rest of the data into the document as markup."
  (if (nil? data)
    ""
    [:script
      {:type "application/ld+json"}
      (web/template/raw (web/template/script-safe (json/encode data)))]))

(defn- tag-when (present node) (if present node ""))

(defn head-tags (site page)
  "The whole SEO/social `<head>` block as a list of Hiccup nodes.

  `site` (constant for the app): `:url` (origin, no trailing slash), `:name`,
  `:description`, `:image` (default share image), `:twitter-card`, `:twitter-site`.

  `page` (per request, every key optional): `:title`, `:description`, `:canonical` (a path
  or absolute URL), `:robots` (e.g. `\"noindex, follow\"`), `:url` (the page's own address,
  for `og:url`; defaults to `:canonical`), `:image`, `:image-alt`, `:type` (OG type,
  default `\"website\"`), and `:json-ld` (a map, or a list of maps).

  A page passing `:robots` gets no canonical — see the module docstring."
  (let (description (page-description site page)
        robots (get page :robots)
        canonical (if (present? robots) nil (absolute-url site (get page :canonical)))
        url (or canonical (absolute-url site (or (get page :url) (get page :canonical))))
        image (absolute-url site (or (get page :image) (get site :image)))
        title (or (get page :title) (get site :name))
        card (get site :twitter-card "summary_large_image"))
    (append (list (tag-when (present? description)
                    [:meta {:name "description" :content description}])
              (tag-when (present? robots) [:meta {:name "robots" :content robots}])
              (tag-when canonical [:link {:rel "canonical" :href canonical}])
              [:meta {:property "og:type" :content (get page :type "website")}]
              (tag-when (present? (get site :name))
                [:meta {:property "og:site_name" :content (get site :name)}])
              [:meta {:property "og:title" :content title}]
              (tag-when (present? description)
                [:meta {:property "og:description" :content description}])
              (tag-when url [:meta {:property "og:url" :content url}])
              (tag-when image [:meta {:property "og:image" :content image}])
              (tag-when (and image (present? (get page :image-alt)))
                [:meta {:property "og:image:alt" :content (get page :image-alt)}])
              [:meta {:name "twitter:card" :content card}]
              (tag-when (present? (get site :twitter-site))
                [:meta {:name "twitter:site" :content (get site :twitter-site)}])
              [:meta {:name "twitter:title" :content title}]
              (tag-when (present? description)
                [:meta {:name "twitter:description" :content description}])
              (tag-when image [:meta {:name "twitter:image" :content image}]))
      (json-ld-nodes (get page :json-ld)))))

(defn- json-ld-nodes (data)
  "`:json-ld` accepts one map or several; both render as separate script elements, which is
  what search engines expect (rather than one array)."
  (cond
    (nil? data) (list)
    (map? data) (list (json-ld data))
    else (map data json-ld)))

;; ---- route-table introspection ---------------------------------------------

(defn- fixed-segment? (segment) (string? segment))

(defn fixed-path? (pattern)
  "True when a parsed route pattern names ONE fixed URL — every segment a literal string.
  A `:param` capture or a `[:splat …]` stands for unboundedly many URLs, which a sitemap
  cannot enumerate without knowing the data behind them; those are the app's to supply."
  (every? pattern fixed-segment?))

(defn route-table (routes)
  "`routes` as a list. Accepts the table itself or a zero-argument function returning it.

  The thunk is not a convenience: the sitemap route is declared INSIDE the same `defrouter`
  form that defines `<router-name>--routes`, so at the moment the handler is built the
  table is not bound yet. `(fn () app-router--routes)` closes over the name and reads it
  when the request arrives, by which point it exists."
  (let (table (if (fn? routes) (routes) routes))
    ;; Since the router indexes its table by first segment, the `def` holds an index map
    ;; rather than a bare list. `:all` is the untouched table; a hand-built list still works.
    (if (and (map? table) (contains? table :all)) (get table :all) table)))

(defn fixed-get-paths (routes)
  "Every fixed URL path the route table serves on `GET`, in declaration order.

  `routes` is the table `defrouter` defines — the `<router-name>--routes` global — or a
  thunk returning it (see `route-table`). It is a plain list of `{:method :pattern
  :handler}` maps."
  (map (seq/filter (route-table routes)
         (fn (route)
           (and (= (get route :method) "GET") (fixed-path? (get route :pattern)))))
    (fn (route) (str "/" (string/join (get route :pattern) "/")))))

;; ---- robots.txt -------------------------------------------------------------

(defn robots-text (site opts)
  "The `robots.txt` body. `opts`: `:disallow` (a list of path prefixes, default none),
  `:sitemap` (the sitemap path, default `/sitemap.xml`; nil to omit the line).

  Naming the sitemap here is the one line that matters — it is how a crawler finds the URL
  list without being told out of band."
  (let (disallow (get opts :disallow [])
        sitemap (if (contains? opts :sitemap) (get opts :sitemap) "/sitemap.xml"))
    (str "User-agent: *\n"
      (if (empty? disallow)
        "Disallow:\n"
        (apply str (map disallow (fn (path) (str "Disallow: " path "\n")))))
      (if (present? sitemap) (str "\nSitemap: " (absolute-url site sitemap) "\n") ""))))

(defn robots-handler (site opts)
  "A conn handler serving `robots-text`. Wire it as `(get \"/robots.txt\" (robots-handler
  site {}))`.

  Cached for an hour by default (`:max-age`) — it is the same bytes for every requester and
  a crawler fetches it before every crawl, so leaving its freshness undefined means every
  one of those is a full round trip for a file that changes when the app is redeployed."
  (fn (conn)
    (text-resp (put-resp-header conn :cache-control (web/cache/public-for (get opts :max-age 3600)))
      (robots-text site opts))))

;; ---- llms.txt ---------------------------------------------------------------

(defn llms-text (site content)
  "The `llms.txt` body for `content`, in the order the specification fixes.

  `llms.txt` (llmstxt.org) is a curated map of a site for a language model: not a crawl
  frontier like `sitemap.xml`, which lists every URL there is, but the handful a reader
  should start from, each with a line saying what it is. A model given a whole site spends
  its context finding the documentation; given this, it starts at it.

  `content`:

    :title    (required) the H1 — the project or site name
    :summary  a one-line blockquote under it
    :details  free-form markdown between the summary and the sections. Headings are NOT
              allowed here by the spec, since an H2 would open a section.
    :sections a list of `{:name :links}`, each rendered as an H2 and a markdown list.
              A link is `{:title :url :notes}`; `:notes` is appended after a colon.
              A section named \"Optional\" has a defined meaning — a reader short on
              context may skip everything in it — so put secondary material there rather
              than inventing a name for it.

  Relative link URLs are made absolute against `site`, because the file is read away from
  the page it came from and a bare `/docs` has nothing to resolve against.

      (llms-text *site*
        {:title \"Acme\"
         :summary \"A widget registry.\"
         :sections [{:name \"Docs\"
                     :links [{:title \"Guide\" :url \"/guide\" :notes \"start here\"}]}]})"
  (let (sections (get content :sections [])
        details (get content :details))
    (check-details details)
    (str "# "
      (get content :title "")
      "\n"
      (let (summary (get content :summary)) (if (present? summary) (str "\n> " summary "\n") ""))
      (if (present? details) (str "\n" details "\n") "")
      (apply str (map sections (fn (section) (llms-section site section)))))))

(defn check-details (details)
  "Raise when `details` contains a markdown heading, which the specification forbids there.

  The rule reads like pedantry and is not. `details` sits between the summary and the
  sections, and an `##` line in it does not render as emphasis — it OPENS A SECTION, at a
  position where the reader is still being told what the site is. Everything after it, up
  to the first real section, silently becomes that phantom section's content, and the
  document still looks fine: the headings are all there, in an order nobody intended.

  Raised rather than warned, because `llms-text` is called to build a file and the caller
  is a `def` or a handler in the app's own source — a value it can fix, at a moment it can
  see. A `#` at the start of a line is the whole test; a `#` mid-sentence (`C#`) is not a
  heading and is left alone."
  (when (and (string? details) (heading-line? details))
    (error "web/seo/llms-text: :details must not contain a markdown heading — an ATX "
      "heading there opens a section ahead of :sections, and everything after it is read "
      "as that section's content. Move it into :sections, or write it as plain prose.")))

(defn- run-length (line character from limit)
  "How many consecutive `character`s `line` has from index `from`, capped at `limit`."
  (let (n (count line)
        step (fn (i seen)
               ;; `char-at`, not a one-character `substring`: it says what is being asked,
               ;; allocates no slice, and needs no computed end index. `or` short-circuits,
               ;; so the read only happens once `i` is known to be in bounds.
               (if (or (>= i n) (>= seen limit) (not (= (string/char-at line i) character)))
                 seen
                 (step (inc i) (inc seen)))))
    (step from 0)))
;; Declared `int` so the index arithmetic at its call site stays an index: the body folds
;; through `inc`, which the checker widens to `number`, and `string/char-at` wants an int.
(sig run-length (string string int int -> int))

(defn heading-line? (text)
  "Whether any line of `text` begins an ATX markdown heading (`#` through `######`).

  Deliberately exact about the three edge cases, because a heading check that guesses is
  worse than none: `#tag` is not a heading (no space after the hashes), `C#` mid-sentence
  is not one (not at the start of a line), and FOUR leading spaces is not one either — at
  that indent markdown reads the line as a code block, so capping the indent scan at three
  makes the fourth space fail the `#` test on its own.

      (hatch/web/seo/heading-line? \"plain prose\") ;=> false
      (hatch/web/seo/heading-line? \"written in C# mostly\") ;=> false
      (hatch/web/seo/heading-line? \"#tag\") ;=> false
      (hatch/web/seo/heading-line? \"## Heading\") ;=> true
      (hatch/web/seo/heading-line? \"   ### deep\") ;=> true"
  (any? (string/split text "\n")
    (fn (line)
      (let (n (count line)
            indent (run-length line " " 0 3)
            hashes (run-length line "#" indent 6))
        (and (> hashes 0)
          (< (+ indent hashes) n)
          ;; the character after the hashes must be a space — an ATX heading, not `#tag`
          (= (string/char-at line (+ indent hashes)) " "))))))

(defn- llms-section (site section)
  "One H2 section and its link list."
  (str "\n## "
    (get section :name "")
    "\n\n"
    (apply str
      (map (get section :links [])
        (fn (link)
          (str "- ["
            (get link :title "")
            "]("
            (absolute-url site (get link :url ""))
            ")"
            (let (notes (get link :notes)) (if (present? notes) (str ": " notes) ""))
            "\n"))))))

(defn llms-handler (site content opts)
  "A conn handler serving `llms-text` at `/llms.txt`.

  `content` is the map `llms-text` takes, OR a zero-argument function returning one — pass
  the function when any of it is read from the database, so the file reflects the site as it
  is now rather than as it was at boot.

  Served as `text/plain`: it is markdown, but it is meant to be read raw, and a browser
  shows plain text rather than offering to download it."
  (fn (conn)
    (let (data (if (fn? content) (content) content))
      (text-resp (put-resp-header conn
                   :cache-control (web/cache/public-for (get opts :max-age 3600)))
        (llms-text site data)))))

;; ---- sitemap.xml ------------------------------------------------------------

(defn- url-entry (site entry)
  "One `<url>` element. `entry` is a path string, or a map `{:path :lastmod :changefreq
  :priority}` — the extra keys are optional and omitted when absent."
  (let (path (if (map? entry) (get entry :path) entry)
        lastmod (when (map? entry) (get entry :lastmod))
        changefreq (when (map? entry) (get entry :changefreq))
        priority (when (map? entry) (get entry :priority)))
    (str "  <url><loc>"
      (web/template/escape-html (absolute-url site path))
      "</loc>"
      (if (present? lastmod) (str "<lastmod>" (web/template/escape-html lastmod) "</lastmod>") "")
      (if (present? changefreq)
        (str "<changefreq>" (web/template/escape-html changefreq) "</changefreq>")
        "")
      (if (nil? priority) "" (str "<priority>" priority "</priority>"))
      "</url>\n")))

(defn canonical-host (site &optional (opts {}))
  "A plug that redirects any request for another host to `site`'s own, with a permanent 301.

  One page reachable at several addresses is one page's worth of ranking split across them,
  and the addresses accumulate without anyone adding them: an apex and a `www`, a platform
  hostname alongside a custom domain, an old domain still pointed at the app. A search engine
  has to guess which is canonical; a redirect tells it.

      (through [(seo/canonical-host *site*)]
        (get \"/\" home/index))

  A `<link rel=canonical>` (which `head-tags` emits from `:canonical`) states a preference.
  This *enforces* one — the wrong address stops answering 200 at all, which is the only
  version of this that also fixes the duplicate a crawler already has in its index.

  301 and not 302: a permanent redirect is what transfers the ranking signal, and a
  temporary one asks the crawler to keep the old address. `:status` overrides it for a
  migration you are not yet sure of.

  The request's own scheme is preserved unless `site`'s URL names one, so an app behind a
  TLS-terminating proxy does not accidentally send visitors to plaintext. `:except` is a
  list of hostnames to leave alone — a health check that dials the machine by its internal
  name, say, which must not be redirected into a loop it cannot follow."
  (let (canonical (host-of (get site :url ""))
        status (get opts :status 301)
        except (get opts :except []))
    (fn (conn)
      (let (requested (request-host conn))
        (if (or (nil? requested)
              (= requested canonical)
              (= canonical "")
              (includes? except requested))
          conn
          (halt (send-resp (put-resp-header conn
                             :location (str (get site :url) (request-target conn)))
                  status "")))))))

(defn host-of (url)
  "The hostname in `url`, lowercased and without a port — `\"\"` when there is none.

      (hatch/web/seo/host-of \"https://example.com/a\") ;=> \"example.com\"
      (hatch/web/seo/host-of \"https://example.com:8443\") ;=> \"example.com\"
      (hatch/web/seo/host-of \"\") ;=> \"\""
  (let (after (let (at (index-of url "://"))
                (if (< at 0) url (string/substring url (+ at 3) (count url))))
        host (first (string/split (first (string/split after "/")) ":")))
    (string/lower (string/trim host))))

(defn request-host (conn)
  "The hostname this request asked for, lowercased and without a port, or nil.

  `X-Forwarded-Host` first: behind a proxy the `Host` the app sees may be the proxy's own,
  and the one the visitor typed is the one that matters for canonicalisation."
  (let (headers (or (conn-headers conn) {})
        raw (or (get headers :x-forwarded-host) (get headers :host)))
    (if (or (nil? raw) (= raw "")) nil (host-of (first (string/split raw ","))))))

(defn- request-target (conn)
  "The path and query of `conn`, so a redirect preserves what was asked for. A canonical
  redirect that drops the path sends every deep link to the home page, which loses exactly
  the ranking the redirect was meant to consolidate."
  (let (path (or (conn-path conn) "/")
        query (conn-query conn))
    (if (and (string? query) (not (= query ""))) (str path "?" query) path)))

(defn sitemap-date (ms)
  "Epoch-milliseconds as the date a sitemap `<lastmod>` takes, or nil when `ms` is not a
  number — a malformed date is worse than an absent one, which is simply omitted.

  `<lastmod>` accepts a full W3C datetime or a bare date, and a bare date is usually the
  honest precision: the timestamp behind it moves when a row is written, and no crawler
  schedules on the hour.

  It is worth carrying. A site that publishes continuously has most of itself unchanged on
  any given day, and without a date a crawler has no way to tell the one page that moved
  from the hundred that did not — so it re-fetches on its own schedule instead of yours.

      (hatch/web/seo/sitemap-date 1757548800000) ;=> \"2025-09-11\"
      (hatch/web/seo/sitemap-date nil) ;=> nil"
  ;; `math/floor` rather than handing `ms` over as it arrives: the guard admits any number,
  ;; `epoch-ms->` takes an int, and a caller that computed its timestamp (`(* 1000 seconds)`
  ;; on a float) would otherwise reach it with a fraction of a millisecond attached. Flooring
  ;; loses nothing — the result is truncated to a bare date two lines later.
  (if (number? ms)
    (string/substring (datetime/->iso (datetime/epoch-ms-> (math/floor ms))) 0 10)
    nil))

(defn sitemap-xml (site entries)
  "A `sitemap.xml` document for `entries` — each a path string or a
  `{:path :lastmod :changefreq :priority}` map."
  (str "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
    "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n"
    (apply str (map entries (fn (entry) (url-entry site entry))))
    "</urlset>\n"))

(defn sitemap-entries (routes opts)
  "The sitemap's entries: every fixed `GET` path in `routes`, minus `:exclude`, plus
  `:extra`.

  Took a `site` it never read — the rest of the family (`sitemap-xml`, `robots-text`) needs
  one to build absolute URLs, and this one was given it for symmetry. Entries are paths; the
  origin is applied by `url-entry` when each is rendered, so there was nothing here to use it
  for and a reader had to go looking to find that out.

  `routes` is the table or a thunk returning it (see `route-table`).

  `opts`: `:exclude` (paths to drop — the machine-facing ones: `/robots.txt`,
  `/sitemap.xml`, `/health`, an API prefix), `:extra` (a list, or a zero-argument function
  returning one, of the dynamic URLs only the app can enumerate — a row per package, per
  article, per user). `:extra` is a THUNK rather than a value so a listing is read when the
  sitemap is requested rather than frozen at boot."
  (let (exclude (get opts :exclude [])
        extra (let (e (get opts :extra))
                (cond (nil? e) (list) (fn? e) (e) else e))
        excluded? (fn (path)
                    (any? exclude
                      (fn (prefix) (or (= path prefix) (string/starts-with? path prefix))))))
    (append (seq/filter (fixed-get-paths routes) (fn (path) (not (excluded? path)))) extra)))

(defn sitemap-handler (site routes opts)
  "A conn handler serving `sitemap.xml`, built from the router's own table.

  Declared inside the router itself, pass the table as a thunk — the `def` it names has not
  run yet at that point:

      (get \"/sitemap.xml\"
        (sitemap-handler *site* (fn () app-router--routes) {:exclude [\"/api\"]}))"
  (fn (conn)
    (send-resp (-> conn
                 (put-resp-header :content-type "application/xml; charset=utf-8")
                 (put-resp-header :cache-control
                   (web/cache/public-for (get opts :max-age 3600))))
      200
      (sitemap-xml site (sitemap-entries routes opts)))))
