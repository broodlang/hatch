(defmodule web/csrf
  "CSRF protection for unsafe (state-changing) requests — a synchronizer-token scheme on top
  of the signed session. A per-session token is minted on first request and kept in the
  session (which is signed, so a client can read but not forge it). Forms embed the token in
  a hidden `_csrf_token` field (or send it as an `X-CSRF-Token` header); the
  `protect-from-forgery` plug rejects any POST/PUT/PATCH/DELETE whose submitted token doesn't
  match the session's, with a 403. A cross-site attacker can't read the victim's token
  (same-origin) nor forge the signed session, so their forged request fails the check.

  Wire it after the session plug, and embed the token in every form:

    (through [(session/fetch-session secret) session/fetch-flash csrf/protect-from-forgery]
      (get  \"/account\" account/index)
      (post \"/account\" account/save))

    ; inside the form's Hiccup:
    (csrf/csrf-input conn)        ; → a hidden <input name=\"_csrf_token\" value=…>

  Safe methods (GET/HEAD/OPTIONS) are never blocked — the plug just ensures a token exists so
  forms rendered on the way out can embed it. Requires a session: `fetch-session` must run
  first."
  ; get-session / put-session — the token lives in the signed session
  (:alias web/session)
  ; param / header / halt / send-resp — read the submitted token, reject on mismatch
  (:use web/conn)
  ; live-conn — the WebSocket connection's read-only Conn, for the live-view accessors
  (:alias web/live)
  ; constant-time-equal? — constant-time token comparison
  (:use crypto))

; Module-scoped (not earmuffed → not global): the session key the token is stored under, the
; form field, and the header clients may use instead.
(def session-key "_csrf")
(def field-name "_csrf_token")
(def header-key :x-csrf-token)

(defn token (conn)
  "The session's CSRF token — `protect-from-forgery` guarantees one exists. nil if neither
  the session plug nor this plug has run."
  (session/get-session conn session-key))

(defn ensure-token (conn)
  "Make sure the session carries a CSRF token, minting a cryptographically strong one on
  first request (only then is the session marked dirty, so there's no cookie churn). Returns
  the possibly-updated conn."
  (if (token conn)
    conn
    (session/put-session conn session-key (rand/token 32))))

(defn safe-method? (conn)
  "True for methods that don't change state — never CSRF-checked."
  (let (m (get conn :method))
    (or (= m "GET") (= m "HEAD") (= m "OPTIONS"))))

(defn submitted-token (conn)
  "The token the client sent: the `_csrf_token` *body* param (form/JSON), or the
  `X-CSRF-Token` header (for fetch/JSON clients). Deliberately not read from the query
  string — a token in a URL leaks through Referer headers, proxy/access logs, and browser
  history, and would otherwise be honored on an unsafe method."
  (or (body-param conn field-name) (header conn header-key)))

(defn token-ok? (conn)
  "True if the submitted token is present and matches the session token (constant-time)."
  (let (want (token conn)
        got (submitted-token conn))
    (and want got (constant-time-equal? (string/->bytes want) (string/->bytes got)))))

(defn reject (conn)
  "A halted 403 for a missing/invalid CSRF token."
  (halt (send-resp conn 403 "<h1>403 Forbidden</h1><p>Invalid or missing CSRF token.</p>")))

(defn protect-from-forgery (conn)
  "Plug: ensure the session carries a CSRF token, and on an unsafe method reject the request
  (403, halted) unless the submitted token matches. Safe methods pass through. Run it after
  `fetch-session`."
  (if (safe-method? conn)
    ; mint a token (if absent) so forms rendered downstream can embed it
    (ensure-token conn)
    ; unsafe method: validate only — a passing request already carries the token, and a
    ; failing one is rejected without minting, so a 403 never sets a fresh session cookie
    (if (token-ok? conn) conn (reject conn))))

(defn csrf-input (conn)
  "A hidden form field carrying the session's CSRF token — drop it inside every POST form:
  `(csrf-input conn)`."
  [:input {:type "hidden" :name field-name :value (token conn)}])

;; ---- the live-view case --------------------------------------------------------------
;; A live view's `render` has no Conn, so `token`/`csrf-input` above are unreachable from it
;; — yet a live view that posts a form (or `fetch`es) to a protected route needs the token
;; just as much as a plain page does. `web/live/live-conn` now exposes the connection's
;; read-only Conn, which carries the browser's cookies from the WebSocket upgrade request,
;; so the token can be read from the signed session the same way `on-mount-guard` already
;; reads the session: by running the session decode explicitly, since no plug pipeline runs
;; on a WebSocket.
;;
;; READ-ONLY, and that is a real limit rather than an oversight: `ensure-token` mints into
;; the session and marks it dirty, which only reaches the browser as a `Set-Cookie` on an
;; HTTP response. A WebSocket has no response to carry one, so a token minted here could
;; never be stored, and the POST it was embedded in would fail the check. `live-token`
;; therefore returns what is already there, or nil.

(defn live-token (secret &optional (opts {}))
  "The CSRF token for the current live session's connection, or nil if there isn't one.

  Call it from a live view's `render` (or any hook) and embed the result the way a plain
  page embeds `csrf-input`. `secret` and `opts` are the same values passed to
  `session/fetch-session` in the router — the WebSocket ran no plug pipeline, so the signed
  session cookie is decoded here explicitly.

  Returns nil when there is no token to read, which is the case worth understanding: a token
  is minted by `protect-from-forgery` on an HTTP request and stored via `Set-Cookie`, and a
  WebSocket can't set cookies. So the live page's own mount request must have gone through
  the CSRF pipeline for a token to exist by the time the socket opens — put the live route
  inside the same `through` group as your other protected routes and it will have. A view
  that might render before that should treat nil as \"no token yet\" rather than emitting an
  empty field that will be rejected."
  (let (conn (web/live/live-conn))
    (if (nil? conn) nil (token ((session/fetch-session secret opts) conn)))))

(defn live-csrf-input (secret &optional (opts {}))
  "`csrf-input` for a live view: a hidden `_csrf_token` field carrying `live-token`. Returns
  nil (rendering nothing) when no token is available, rather than a field with an empty value
  that would be rejected on submit — see `live-token` on when that happens."
  (let (t (live-token secret opts))
    (if (nil? t) nil [:input {:type "hidden" :name field-name :value t}])))
