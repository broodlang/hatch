(defmodule web/http-cache
  "HTTP caching for DYNAMIC responses — validators (`ETag` + `If-None-Match`) and freshness
  (`Cache-Control`, `Vary`), the conditional-GET half of caching that `web/static` already does
  for files on disk. What a SERVER keeps in memory is `web/cache`'s; this module is what the
  response says to the caches between it and the reader.

  Two separate questions, and a response wants an answer to both:

  - **Freshness** (`Cache-Control`) — may a cache reuse this without asking?
  - **Validation** (`ETag` + `If-None-Match`) — when it must ask, can the answer be cheap?

  Getting only the first right is the common failure, and it is silent. A page marked
  `no-cache` is *correct*: it says store this, but revalidate before reuse. With no
  validator on it, every one of those revalidations is a full 200 with the whole body —
  so the header that was supposed to make repeat visits cheap makes them cost exactly what
  a first visit costs, forever. Nothing errors; the bytes just go out again.

  `conditional` closes that: it hangs a strong ETag on the finished response and turns a
  matching `If-None-Match` into a bodyless 304.

  **The ETag identifies a REPRESENTATION, not a resource** (RFC 9110 §8.8.3). A gzipped
  body and a brotli body of the same page are different representations, so `etag-for`
  takes the content-coding and suffixes the tag with it. Getting this wrong is how a client
  ends up holding a br-encoded entity, revalidating over a gzip connection, being told 304,
  and decoding the wrong bytes.

  Ordering matters: compute against the body a cache would store. Ask `conditional` BEFORE
  compressing — it takes the coding you are about to use, so a 304 skips the compression
  work entirely rather than compressing a body that is never sent.

      (let (resp (html-no-store rendered)
            coding (compress/chosen-encoding conn))
        (match (conditional conn resp coding)
          ([:not-modified r] r)
          ([:send r] (compress-response conn r))))"
  ; header / conn-method / conn-headers / get-cookie — what the request asked and carries
  (:use web/conn)
  ; trim-if-needed — `string/trim` costs 3.14us per call whether or not it finds anything
  (:use http/util)
  ; *default-cookie* — the session cookie whose presence makes a page personal
  (:alias web/session))

;; ---- validators -------------------------------------------------------------

(defn strong-etag (body)
  "A strong ETag for `body` (a string or `bytes`): a quoted SHA-256 prefix.

  Content-addressed, so it changes exactly when the bytes change — identical across
  restarts and across replicas, unlike anything derived from an inode or a timestamp. That
  is what lets a client's cached copy validate against whichever machine answers next."
  (str "\""
    (string/substring (if (bytes? body) (hash/sha256-bytes body) (hash/sha256 body)) 0 16)
    "\""))

(defn etag-for (body coding)
  "`strong-etag` for `body`, distinguished by content-`coding` (`\"br\"`, `\"gzip\"`, or nil
  for identity) — because the coded body is a different representation of the same
  resource, and a validator that ignored the coding would match across them."
  (let (base (strong-etag body))
    (if (or (nil? coding) (= coding ""))
      base
      (str (string/substring base 0 (- (count base) 1)) "-" coding "\""))))

(defn- etag-candidates (header)
  "The entity-tags in an `If-None-Match` value, weak prefixes stripped.

  `W/` is dropped without re-trimming what follows, because RFC 9110 §8.8.3 has the prefix
  IMMEDIATELY followed by the opaque-tag: `W/ \"abc\"` with a space is malformed, and reading
  it as `\"abc\"` would answer 304 to a request that did not properly ask."
  (map (string/split header ",")
    (fn (entry)
      (let (trimmed (trim-if-needed entry))
        (if (string/starts-with? trimmed "W/")
          (string/substring trimmed 2 (count trimmed))
          trimmed)))))

(defn not-modified? (conn tag)
  "True when the request's `If-None-Match` matches `tag` — an exact entity-tag among the
  listed ones, or the wildcard `*`. Weak comparison, which is what RFC 9110 §13.1.2
  prescribes for `If-None-Match`, so a `W/`-prefixed tag matches its strong twin.

  `*` counts only as the WHOLE header value. The grammar is `If-None-Match = \"*\" / #entity-tag`
  — the wildcard is an alternative to the list, not a member of it — so `\"a\", *` is malformed
  and does not match. Reading it as a wildcard would answer 304 to a request that did not ask
  for one, and a wrongly-issued 304 leaves the client on a stale copy; a wrongly-issued 200 only
  costs bytes. Strictness is the safe direction here.

  This is the one implementation of the rule. `web/static/if-none-match?` calls it, so the
  file path and the dynamic path cannot drift apart on what counts as a match."
  (let (header (header conn :if-none-match))
    (and (string? header)
      (let (want (trim-if-needed header))
        (if (= want "*")
          true
          (includes? (etag-candidates want) tag))))))

;; ---- freshness --------------------------------------------------------------

(defn immutable (&optional (seconds 31536000))
  "A `Cache-Control` for content that can never change at this URL — an archived version, a
  content-addressed asset. `immutable` tells a browser not even to revalidate on a reload,
  which is the difference between a fast back-button and a network round trip."
  (str "public, max-age=" seconds ", immutable"))

(defn public-for (seconds)
  "A `Cache-Control` for content that is the same for everyone and may go stale for
  `seconds`."
  (str "public, max-age=" seconds))

(defn no-store ()
  "A `Cache-Control` for a response nothing may keep — a health probe, anything
  per-request by nature. Distinct from `no-cache`, which means store it but revalidate."
  "no-store")

(defn public-swr (max-age stale-for)
  "A `Cache-Control` for content that is the same for everyone: reusable without asking for
  `max-age` seconds, and for a further `stale-for` seconds reusable INSTANTLY while the
  browser revalidates in the background (`stale-while-revalidate`, RFC 5861).

  The second half is what makes this usable on a page that is only mostly static. Under plain
  `max-age` the choice is between a stale page and a round trip; with `stale-while-revalidate`
  the visitor gets the cached page immediately and the next navigation has the fresh one. A
  page that changes when someone signs in is wrong for at most one navigation instead of for
  the whole `max-age`."
  (str "public, max-age=" max-age ", stale-while-revalidate=" stale-for))

;; ---- anonymous HTML ---------------------------------------------------------

(defn html-freshness (conn resp &optional (opts {}))
  "Choose `Cache-Control` for a dynamic HTML response, by whether this particular request
  could possibly be personalised.

  An app whose nav shows the signed-in user's email has to send `private, no-cache` — one
  visitor's page must never be reused for another. But that header is charged to EVERYONE,
  and most visitors to most sites are signed out, looking at a page that is byte-identical
  for all of them. `no-cache` means *revalidate before reuse*, so each of them pays a network
  round trip per navigation to be told nothing changed. On an origin one continent away that
  is the entire perceived load time — the server's own work is a rounding error next to it.

  So: a request carrying no session cookie is served `public, max-age=… ,
  stale-while-revalidate=…` and its browser reuses the page with no request at all. A request
  that carries one keeps `private, no-cache`.

  Deliberately conservative — every one of these must hold, or it falls back to
  `private, no-cache`:

  - the method is GET or HEAD (a POST response is not a cache entry)
  - the status is 200 (a redirect or an error is not the page)
  - the response sets no cookie (a login response must never be shared, and it is a 200 with
    a `Set-Cookie` that would otherwise slip through)
  - the request carries no session cookie (`:cookie`, default `_hatch_session`)
  - no `Cache-Control` was set already, and the body is HTML

  A signed-out visitor whose expired cookie is still on disk simply gets the old behaviour,
  which is the direction to be wrong in.

  `opts`: `:max-age` (default 60), `:stale-for` (default 600), `:cookie` (session cookie name),
  `:vary` (an extra Vary token, default `Cookie`)."
  (let (headers (get resp :headers {})
        content-type (get headers :content-type)
        method (string/upper (or (conn-method conn) ""))
        cookie-name (get opts :cookie web/session/*default-cookie*))
    (if (get headers :cache-control)
      resp
      (if (not (or (nil? content-type) (includes? content-type "text/html")))
        resp
        (let (public? (and (or (= method "GET") (= method "HEAD"))
                        (= (get resp :status 200) 200)
                        (nil? (get headers :set-cookie))
                        (not (session-cookie? conn cookie-name))))
          (assoc resp
            :headers
              (assoc headers
                :cache-control
                  (if public?
                    (public-swr (get opts :max-age 60) (get opts :stale-for 600))
                    "private, no-cache")
                ;; MERGED, not assigned: a bare assignment discards whatever another layer
                ;; already put in Vary.
                :vary (merge-vary (get headers :vary) (get opts :vary "Cookie")))))))))

(defn session-cookie? (conn name)
  "Whether this request carries a session cookie called `name`.

  Checks the parsed `:cookies` and, failing that, the raw `Cookie` header. The second look is
  the point: `web/conn/build` parses cookies, but a conn assembled some other way may not
  have, and `get-cookie` cannot tell \"no cookie\" from \"never parsed\". For a cache-control
  decision those two must not be the same answer — reading a signed-in request as anonymous
  publishes that page to a shared cache. So an unparsed conn that mentions the name in its
  raw header counts as carrying it: this fails closed."
  (or (not (nil? (get-cookie conn name)))
    (let (raw (get (or (conn-headers conn) {}) :cookie))
      (and (string? raw) (includes? raw name)))))

(defn- merge-token (existing token)
  "`existing` comma-separated list with `token` added once, case-insensitively."
  (if (or (nil? existing) (= existing ""))
    token
    (if (any? (map (string/split existing ",") (fn (t) (string/lower (trim-if-needed t))))
          (fn (t) (= t (string/lower token))))
      existing
      (str existing ", " token))))

(defn merge-vary (existing token)
  "`existing` with `token` added, case-insensitively, or just `token` when there is none."
  (merge-token existing token))

(defn forbid-transform (resp)
  "Add the `no-transform` cache directive to `resp` when it carries a validator.

  An `ETag` names one exact sequence of bytes (RFC 9110 §8.8.3). An intermediary that
  re-encodes the body — a CDN or edge proxy gzipping an identity response is the ordinary
  case — changes those bytes while forwarding the tag that described the old ones. The client
  then holds a gzip body under an identity tag, and its next `If-None-Match` can be answered
  304 for a representation it does not actually have.

  `no-transform` is the directive that exists to forbid precisely this (RFC 9111 §5.2.2.6):
  it tells every intermediary not to alter the payload. hatch does its own content
  negotiation and compression, with tags that name the coding, so there is nothing an
  intermediary can add by re-encoding — only a validator it can invalidate.

  Observed rather than theorised: `brood.fly.dev` served an identity stylesheet that Fly's
  edge then gzipped, keeping hive's identity ETag. Merged rather than set, so a handler's own
  `Cache-Control` (`no-cache`, `immutable`, a max-age) survives alongside it."
  (let (headers (get resp :headers {}))
    (if (nil? (get headers :etag))
      resp
      (assoc resp
        :headers
          (assoc headers
            :cache-control (merge-token (get headers :cache-control) "no-transform"))))))

(defn put-cache-control (resp value)
  "Set `Cache-Control` on a response map, without clobbering one a handler already chose."
  (let (headers (get resp :headers {}))
    (if (get headers :cache-control)
      resp
      (assoc resp :headers (assoc headers :cache-control value)))))

;; ---- the conditional-GET step -----------------------------------------------

(defn not-modified-response (resp tag)
  "`resp` reduced to a 304: no body, and only the headers RFC 9110 §15.4.5 says to carry —
  the validator and the caching metadata the client needs to refresh what it already holds.
  Content headers are dropped, because there is no content."
  (let (headers (get resp :headers {}))
    {:status 304
     :body ""
     :headers (fold [:cache-control :vary :date :expires]
                {:etag tag}
                (fn (kept key)
                  (let (value (get headers key)) (if value (assoc kept key value) kept))))}))

(defn conditional (conn resp coding)
  "Attach a validator to `resp` and answer a conditional request.

  Returns `[:not-modified resp]` when the client already holds this exact representation —
  send it as-is, and do no more work — or `[:send resp]` with the `ETag` and
  `Vary: If-None-Match`-free headers set, to carry on with (compression, security headers).

  Only bodies worth validating are tagged: a string body, on a status that carries one, with
  no `ETag` already set. Everything else passes through untouched."
  (let (body (get resp :body)
        status (or (get resp :status) 200)
        headers (get resp :headers {}))
    (if (and (string? body)
          (not (= body ""))
          (or (= status 200) (= status 203))
          (nil? (get headers :etag)))
      (let (tag (etag-for body coding)
            tagged (assoc resp :headers (assoc headers :etag tag)))
        (if (not-modified? conn tag)
          [:not-modified (not-modified-response tagged tag)]
          [:send tagged]))
      [:send resp])))
