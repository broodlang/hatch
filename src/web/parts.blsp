(defmodule web/parts
  "Static/dynamic split for live views — the minimal-diff renderer (Phoenix HEEx-style).

  `compile-parts` runs at macro-expansion time (called by `deflive`). It walks a Hiccup
  *form* and splits it into:
  - `:statics` — a vector of literal HTML string segments, baked at compile time.
  - `:dynamics` — a list of forms, each of which renders one hole to an HTML string at
    runtime (with `model` in scope).

  Invariant: the live view's HTML equals `s0 + d0 + s1 + d1 + … + sn`, where the statics
  weave with the rendered dynamics and `(count statics) = (count dynamics) + 1`. The
  statics never change, so on join the server sends statics + dynamics, and on every update
  only the *changed* dynamic slots — the client re-interleaves and morphs.

  Literal structure (tags, literal attrs, literal text) is folded into statics. A non-literal
  hole — a value expression, a dynamic attribute value, an `(if …)`/component call, or
  anything else — becomes a dynamic. A `(for …)` comprehension becomes a *comprehension slot*
  (`comp`) that renders per item, so a single changed row diffs on its own (see below). For
  correctness over granularity, an element whose
  attrs-position is an ambiguous non-literal form (could be a dynamic attrs map or a child)
  is emitted whole as one opaque dynamic. Idiomatic views (and all `.bml`-compiled ones) put
  an attrs map on every element, so this fallback rarely fires.

  A `(component module assigns)` form (web/component's LiveComponents) gets its own dynamic
  hole via `web/component/render-slot`, which returns a *component slot* carrying the
  component's own statics and dynamics — so a component diffs per inner slot, independently of
  its parent, the same way a comprehension diffs per item (see both slot types below). The
  compiled form also threads the session's live component table through. Its change-tracking dependency is
  always `:all` (see `deps-of`'s `live-components` case) — a component's own state can change
  (via `web/component/send-update` or its own event) without any `model` key changing at all,
  so the slot must always be considered dirty; there's no way to pin it to specific keys.

  `weave` and `diff-dynamics` are the runtime helpers the session actor uses."
  ; render / render-attr / escape-html / *void-tags* — reused at compile time and in the
  ; emitted dynamic forms
  (:use web/template)
  ; sha256 — the statics fingerprint a reconnecting client replays
  (:alias hash))

; ---- compile-time predicates ----

(defn elem? (node)
  "True if `node` is a Hiccup element form: a vector with a keyword head."
  (and (vector? node) (> (count node) 0) (keyword? (first node))))

(defn literal-attr? (v)
  "True if an attribute value is a compile-time literal (rendered into a static segment)."
  (or (string? v) (int? v) (float? v) (bool? v) (nil? v)))

(defn child-or-literal? (v)
  "True if `v` in the attrs position is really a child (a literal or an element), not a
  possible attrs map — so the element has no attrs and `v` is its first child."
  (or (string? v) (int? v) (float? v) (bool? v) (nil? v) (elem? v)))

(defn list-form? (node)
  "True for a literal `(list …)` form, whose items we can split individually."
  (and (pair? node) (= (first node) 'list)))

(defn for-form? (node)
  "True for a `(for (binder coll …) body)` comprehension (what `:for` lowers to). It
  compiles to a per-item comprehension slot, so a single changed row diffs on its own
  instead of re-shipping the whole list."
  (and (pair? node) (= (first node) 'for)))

(defn comp-form (node)
  "Transform `(for spec body…)` into the dynamic form for its comprehension slot:
  `(web/parts/comp-slot (for spec (web/template/render <body>)))`. The `for` yields one HTML
  string per item; `comp` tags that list so weave/diff treat it per item. The per-item
  HTML concatenated equals a whole-list render, so the weave invariant still holds."
  (let (spec (first (rest node))
        body-forms (rest (rest node))
        body (if (= (count body-forms) 1) (first body-forms) (cons 'do body-forms)))
    ; Run the loop body through rewrite-components so a `(component …)` inside the `for` is
    ; compiled to its render-slot call — without this it stays literal `(component …)` and
    ; raises "unbound component" at render (a list of stateful components is a mainstream
    ; pattern), and its change-tracking deps would be empty (never re-rendering).
    (list 'web/parts/comp-slot
      (list 'for spec (list 'web/template/render (rewrite-components body))))))

(defn component-form? (node)
  "True for a literal `(component module assigns)` form — a LiveComponent slot
  (web/component), compiled to its own dynamic hole instead of falling through to the
  generic opaque-dynamic case (walk's else branch)."
  (and (pair? node) (= (first node) 'component)))

(defn component-slot-form-html (node)
  "`component-slot-form`'s HTML-returning twin, for `rewrite-components` — the paths that need
  a string rather than a diffable slot value (a view's plain `render`, and any component nested
  inside an `(if …)`/`(for …)`, which is part of one opaque dynamic anyway)."
  (let (f (component-slot-form node))
    (cons 'web/component/render-slot-html (rest f))))

(defn component-slot-form (node)
  "The generated call for a `(component module assigns)` hole: resolves `module` to its
  `live-component-spec` thunk symbol at compile time — mirroring how web/router's
  compile-live resolves `module/live-spec` — and threads the session's live component
  table (`live-components`, a free variable deflive's generated render-dynamic binds as
  an extra param) through to web/component/render-slot. Passes the quoted bare `module`
  symbol too, alongside the resolved spec-thunk: render-slot stores it next to a mounted
  component's state so a same-id-different-module collision can be detected by comparing
  symbols (stable across a table round-trip) rather than the spec-thunk function value
  (`table/put`/`table/get` deep-clone a stored function, so two 'equal' thunks are never `=` after
  a round-trip — comparing those would report every render as a different component)."
  (list 'web/component/render-slot
    (list 'quote (nth node 1))
    (symbol (str (name (nth node 1)) "/live-component-spec"))
    (nth node 2)
    'live-components))

; ---- change tracking: which model keys each dynamic slot reads ----
; So the session can re-render only the slots a state change actually affects (Phoenix
; HEEx-style), `form-deps` statically finds the `model` keys a dynamic form reads via
; `(get model <literal>)`. It over-approximates on purpose: any *opaque* use of the model —
; the bare `model` symbol, a dynamic `(get model k)` key, `model` passed to a function —
; yields `:all`, meaning "always re-render this slot". Under-approximating would ship a stale
; render, so when unsure we re-render.

(defn model-get-form? (form model-sym)
  "True if `form` is `(get <model-sym> <literal-key> …)` — a statically pinned model read."
  (and (pair? form)
    (>= (count form) 3)
    (= (first form) 'get)
    (= (first (rest form)) model-sym)
    (let (k (first (rest (rest form)))) (or (keyword? k) (string? k)))))

(defn deps-merge (a b)
  "Combine two dependency results — `:all` (opaque) dominates; otherwise concatenate keys."
  (if (or (= a :all) (= b :all)) :all (append a b)))

(defn deps-seq (forms model-sym)
  "Merge the dependencies of every form in `forms`."
  (fold (fn (acc x) (deps-merge acc (deps-of x model-sym))) (list) forms))

(defn deps-of (form model-sym)
  "The model keys `form` reads, or `:all` for any opaque model use. See the section comment.
  `live-components` (a component slot's free-variable reference to the session's live
  component table — see `component-slot-form`) is always `:all`: a LiveComponent's own state
  can change via `web/component/send-update` or its own event handler without any `model` key
  changing, so a slot containing one can never be pinned to specific model keys — it must
  always be considered dirty, or its own state updates would never reach a diff."
  (cond
    (model-get-form? form model-sym)
    ; the pinned key, plus deps in any args past the key (e.g. a default expression)
    (deps-merge (list (first (rest (rest form))))
      (deps-seq (rest (rest (rest form))) model-sym))
      (= form model-sym)
    :all (= form 'live-components)
    :all (pair? form)
    (deps-seq form model-sym) (vector? form)
    (deps-seq form model-sym)
    ; a map literal in the form (e.g. an attrs map inside a comprehension body) — its keys
    ; and values can themselves read the model
    (map? form) (deps-merge (deps-seq (keys form) model-sym) (deps-seq (vals form) model-sym))
    else (list)))

(defn form-deps (form model-sym)
  "The dependency descriptor for a dynamic slot `form` whose model parameter is `model-sym`:
  a vector of the model keys it reads, or `:all` if it uses the model in a way that can't be
  pinned to specific keys (so it must always re-render). Called at `deflive` expansion time."
  (let (d (deps-of form model-sym))
    (if (= d :all) :all (into [] d))))

; ---- builder state: {:s reversed-completed-statics :d reversed-dynamic-forms :cur current} ----

(defn emit-static (st s)
  "Append literal HTML `s` to the segment under construction."
  (assoc st :cur (str (get st :cur) s)))

(defn emit-dynamic (st form)
  "Close the current static segment and record `form` (which renders a hole to HTML)."
  (assoc st
    :s (cons (get st :cur) (get st :s))
    :d (cons form (get st :d))
    :cur ""))

(defn elem-children (node start)
  "The child forms of element `node`, from index `start` to the end."
  (map (fn (i) (nth node i)) (range start (count node))))

(defn emit-attr (st kv)
  "Emit one attribute: a literal value folds into the static segment; a dynamic value
  becomes a `render-attr` hole (so booleans/vectors/strings are all handled at runtime)."
  (let (k (nth kv 0)
        v (nth kv 1))
    (if (literal-attr? v)
      (emit-static st (render-attr kv))
      (emit-dynamic st (list 'web/template/render-attr (list 'vector k v))))))

(defn rewrite-components (form)
  "Recursively replace every `(component module assigns)` sub-form of `form` with its
  compiled `web/component/render-slot-html` call, wrapped in `web/template/raw` so the
  already-rendered HTML isn't re-escaped as text. `component-form?`'s top-level case in
  `walk` only catches a component that's a *direct* child of an element or `(list …)`; a
  component nested inside anything else — `(if …)`, `(for …)`, a component call — falls
  into the generic opaque-dynamic `else` branch below, which preserves the original code
  verbatim. This walk fixes that form up before it's embedded, so a nested component
  still compiles to a real call instead of literal code trying to invoke the bare symbol
  `component` (which is never a real function — it only exists as this compile-time
  marker). Also used to fix up deflive's plain, non-split `render`, which composes
  render-static + render-dynamic rather than re-walking render-expr itself (see deflive)."
  (cond
    (component-form? form) (list 'web/template/raw (component-slot-form-html form))
    (pair? form) (map rewrite-components form)
    (vector? form) (mapv rewrite-components form)
    else form))

(defn walk (st node)
  "Walk one Hiccup `node`, threading the builder state."
  (cond
    (nil? node) st
    (string? node) (emit-static st (escape-html node))
    (int? node) (emit-static st (str node))
    (float? node) (emit-static st (str node))
    (bool? node) st
    (elem? node) (walk-element st node)
    (for-form? node) (emit-dynamic st (comp-form node))
    (component-form? node) (emit-dynamic st (component-slot-form node))
    (list-form? node) (fold walk st (rest node))
    else (emit-dynamic st (list 'web/template/render (rewrite-components node)))))

(defn walk-element (st node)
  (let (tag (name (first node))
        n (count node)
        second (if (> n 1) (nth node 1) nil)
        has-attrs (map? second)
        ambiguous (and (> n 1) (not has-attrs) (not (child-or-literal? second))))
    (if ambiguous
      ; can't tell a dynamic attrs map from a child — render the whole element at runtime
      (emit-dynamic st (list 'web/template/render node))
      (let (attrs (if has-attrs second {})
            cstart (if has-attrs 2 1)
            st (emit-static st (str "<" tag))
            st (fold emit-attr st (map-pairs attrs))
            st (emit-static st ">"))
        (if (contains? *void-tags* (keyword tag))
          st
          (let (st (fold walk st (elem-children node cstart)))
            (emit-static st (str "</" tag ">"))))))))

(defn compile-parts (form)
  "Split a Hiccup `form` into `{:statics <vector of strings> :dynamics <list of forms>}`.
  Call at macro-expansion time with the form as data."
  (let (st (walk {:s (list) :d (list) :cur ""} form)
        statics (reverse (cons (get st :cur) (get st :s)))
        dynamics (reverse (get st :d)))
    {:statics (apply vector statics)
     :dynamics dynamics}))

; ---- comprehension slots (per-item diffing) ----
; A `:for`/`(for …)` renders to a *list* of per-item HTML strings tagged by `comp`, rather
; than one opaque string. weave joins them (so the full HTML is unchanged), and the
; diff compares item-by-item — so editing one row of a 1000-row list ships that one row, not
; the whole list. On the wire a comp slot is `{"__comp__":[…items…]}` on join and
; `{"__cdiff__":{idx:html},"n":count}` on update; brood_live.js patches the item array.

(defn comp-slot (items)
  "Tag a comprehension's per-item HTML strings as one slot value so the runtime diffs the
  list per item instead of treating the whole thing as one opaque string."
  {:__comp__ (into [] items)})

(defn comp? (v)
  "True if `v` is a comprehension slot value (from `comp`)."
  (and (map? v) (contains? v :__comp__)))

(defn comp-items (v)
  "The per-item HTML string vector of a comprehension slot value."
  (get v :__comp__))

; ---- component slots (per-component diffing) ----
; A `(component …)` hole renders to the component's OWN static/dynamic split rather than one
; opaque HTML string, so a component whose state changed ships only its changed inner slots
; — not its whole subtree, and not the parent's. Structurally it is the comprehension slot's
; twin: a tagged value the runtime knows how to render whole and how to diff against its
; previous self.
;
; The `[:div {:data-cid id} …]` wrapper is baked into the component's own statics (first and
; last), NOT re-applied at render time. That is what lets both sides treat a component slot as
; "just another statics/dynamics pair": `weave` alone reproduces the wrapper, and
; brood_live.js reuses the exact interleave it already runs for the top-level render instead
; of needing wrapper logic that could drift from the server's.
;
; On the wire: `{"__kslot__":true,"cid":id,"s":[…],"d":[…]}` on join (or whenever a slot
; becomes a component), and `{"__kdiff__":{inner-idx:value},"cid":id}` on update.

(defn component-slot (cid statics dynamics)
  "Tag a rendered component as one slot value carrying its own static/dynamic split, so the
  runtime diffs it per inner slot instead of as one opaque string. `statics` must already
  carry the `data-cid` wrapper (see the note above)."
  {:__kslot__ true :cid cid :s (into [] statics) :d (into [] dynamics)})

(defn kslot? (v)
  "True if `v` is a component slot value (from `component-slot`)."
  (and (map? v) (contains? v :__kslot__)))

(defn slot->html (v)
  "The HTML for a rendered slot value: a comprehension slot joins its items, a component slot
  weaves its own statics and dynamics (recursively — a component's inner slots may themselves
  be comprehensions or nested components), and a scalar slot is already its HTML string."
  (cond
    (comp? v) (string/join "" (comp-items v))
    (kslot? v) (weave (get v :s) (get v :d))
    else v))

; ---- runtime: assemble HTML and diff dynamic slots ----

(defn weave (statics dynamics)
  "Assemble the full HTML from `statics` and the rendered `dynamics`: s0 d0 s1 … sn.
  Collects the pieces in a list and `join`s once — a per-slot `(str acc …)` fold re-copies the
  whole growing HTML each step, O(n²) in the slot count (and this runs on every re-render)."
  (string/join "" (reverse (weave-at statics dynamics 0 (count statics) (list)))))

(defn- weave-at
  (statics dynamics i n acc)
  (if (>= i n)
    acc
    (let (acc (cons (nth statics i) acc)
          acc (if (< i (count dynamics)) (cons (slot->html (nth dynamics i)) acc) acc))
      (weave-at statics dynamics (+ i 1) n acc))))

(defn statics-fingerprint (statics)
  "A short, stable fingerprint of a view's static segments — the identity of its *template*,
  independent of any model.

  A live client caches the statics it was sent and replays this fingerprint on a reconnect
  join; when it matches, the server omits them from the join frame and the client reuses what
  it already holds (see `web/live/push-full`). The statics are the bulk of a join — a page's
  whole literal skeleton — so a flaky connection stops re-downloading its own markup on every
  drop.

  The count is folded in ahead of the segments so that two different splits which happen to
  concatenate alike can't collide, and the NUL separator can't occur in rendered HTML.

  (hatch/web/parts/statics-fingerprint [\"<p>\" \"</p>\"]) ;=> \"f461e62bd2db8219\""
  (string/substring (hash/sha256 (str (count statics) "\x00" (string/join "\x00" statics))) 0 16))

(defn diff-dynamics (old new)
  "A map `{index → value}` of the dynamic slots that changed from `old` to `new`. The hole
  count is fixed by the template, so the two are normally equal length; if they ever differ
  (defensive), every new slot is reported. A changed comprehension slot carries a per-item
  diff (`slot-diff`) rather than its whole re-rendered list."
  (if (= (count old) (count new))
    (diff-at old new 0 (count new) {})
    (diff-at (list) new 0 (count new) {})))

(defn- diff-at
  (old new i n acc)
  (if (>= i n)
    acc
    (let (nv (nth new i)
          same (and (< i (count old)) (= (nth old i) nv)))
      (diff-at old
        new
        (+ i 1)
        n
        (if same
          acc
          (assoc acc i (slot-diff (if (< i (count old)) (nth old i) nil) nv)))))))

(defn slot-diff (o nv)
  "The wire value for a changed slot: a per-item diff when both old and new are
  comprehensions, a per-inner-slot diff when both are the *same* component, else the whole
  new value (a string, or a full comprehension/component marker when a slot just became — or
  was replaced by — one).

  The component case is gated on the cid matching: a slot holding a *different* component
  than last render shares nothing with it, so patching one's inner slots onto the other's
  would splice two unrelated renders together. Same reasoning as `render-slot`'s
  module-mismatch remount."
  (cond
    (and (comp? o) (comp? nv)) (comp-slot-diff (comp-items o) (comp-items nv))
    (and (kslot? o) (kslot? nv) (= (get o :cid) (get nv :cid)))
      {:__kdiff__ (diff-dynamics (get o :d) (get nv :d)) :cid (get nv :cid)}
    else nv))

(defn comp-slot-diff (old-items new-items)
  "A per-item diff of a comprehension slot: `{:__cdiff__ {item-idx html} :n new-count}` —
  only the items whose HTML changed, plus the new item count so the client grows/shrinks the
  list. Items past the old length are all reported (they're new)."
  {:__cdiff__ (comp-diff-at old-items new-items 0 (count new-items) {})
   :n (count new-items)})

(defn- comp-diff-at
  (old new i n acc)
  (if (>= i n)
    acc
    (comp-diff-at old
      new
      (+ i 1)
      n
      (if (and (< i (count old)) (= (nth old i) (nth new i)))
        acc
        (assoc acc i (nth new i))))))
