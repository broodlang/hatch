; defability / impl (value dispatch, ability)
(defmodule web/live
  "LiveBrood: per-session WebSocket actor + deflive macro."
  (:use http/websocket)
  (:use web/template)
  ; parse-file — the (template …) clause's BML→Hiccup compiler
  (:use web/bml)
  ; compile-parts — split a render form into statics + dynamic holes (minimal diffs)
  (:use web/parts)
  ; build — a read-only Conn from the WS upgrade request, for on-mount-guard
  (:use web/conn)
  ; defability Encode / impl — value dispatch for JSON wire encoding (ability, ADR)
  ; apply-update / dispatch-event — this module's own session runtime calls these
  ; fully-qualified (web/component/…); declaring the dependency here — rather than
  ; relying entirely on deflive-expanded consumers to have loaded it — means it
  ; resolves even for a hand-built LiveModule spec that never goes through the deflive
  ; macro. web/component itself :alias web/live — Brood tolerates the mutual reference
  ; fine (verified empirically), so this isn't a load-order hazard.
  (:alias web/component)
  ; serve-body — serve brood_live.js through the static cache pipeline (ETag/304/nosniff)
  (:alias web/static)
  ; start — the live registries run under a supervisor (docs/robustness.md)
  (:alias supervisor)
  ; ->json — the stdlib `JsonEncode` ability, which `Encode`'s fallback delegates to, so an
  ; app writes ONE impl for both the HTTP JSON body and the live wire (see below); decode —
  ; the inbound half, which used to be a hand-rolled parser here
  (:alias json)
  ; stringify-keys — a decoded frame is string-keyed, like every other param map in hatch
  (:alias http/util)
  ; emit — surface a raising view handler as a [:hatch :live :exception] event
  (:alias telemetry))
; ---- JSON encode via the Encode protocol -----------------------------------
; What used to be one closed `(cond …)` on `type-of` is now an open protocol: each
; type has its own impl, and an app can add `(impl Encode :instant …)` for its
; own types without touching the framework. `encode` dispatches on the value's type.

(def *json-hex* "0123456789abcdef")

(defn- json-esc-control (cp)
  "The JSON escape for a C0 control codepoint `cp` (0x00–0x1F): the named short form where one
  exists, else `\\u00XX`."
  (cond
    (= cp 8) "\\b"
    (= cp 9) "\\t"
    (= cp 10) "\\n"
    (= cp 12) "\\f"
    (= cp 13) "\\r"
    else
      (str "\\u00"
        (string/char-at *json-hex* (math/quot cp 16))
        (string/char-at *json-hex* (math/mod cp 16)))))

; Every character JSON must escape: backslash (92), quote (34), and every C0 control
; (U+0000–U+001F). Built once, as character SETs for `string/span-until`. The controls are
; separated out because they are far rarer than a quote — HTML in a live diff is full of
; `class="…"` and holds a control character essentially never.
(def *json-control-chars* (string/codepoints-> (into [] (range 0 32))))
(def *json-escape-chars* (string/codepoints-> (append [92 34] (into [] (range 0 32)))))

(defn- json-clean? (s chars)
  "True when `s` contains no character from the set `chars` — one native scan."
  (= (string/span-until s 0 chars) (string/length s)))

(defn json-str (s)
  "Encode a Brood string as a JSON string. Escapes `\\` and `\"`, then EVERY C0 control
  (U+0000–U+001F) — the named short forms (\\b \\t \\n \\f \\r) or `\\u00XX`. RFC 8259 requires
  all chars < U+0020 to be escaped; emitting a raw control (a backspace/ESC/NUL pasted into
  user text) makes the frame's JSON invalid, and the client's `JSON.parse` then silently drops
  the whole frame — a per-field server↔client desync with no error surfaced.

  Almost no string contains any of them, and the escaping path costs the same either way: two
  `string/replace` passes, then a fold over all 32 control codepoints, each allocating a
  `bytes`, decoding it to a string, and running ANOTHER full `string/replace` over the
  accumulator. Thirty-four passes over the string to change nothing — 87.8us for a ten-
  character string, and this runs on every string field of every live-view frame.

  `string/span-until` asks whether any escapable character is present in one native scan, and
  a second scan asks specifically about the controls. Three tiers, because the middle one is
  what real traffic looks like: a rendered HTML diff is full of `class=\"…\"` and so needs the
  two `string/replace` passes, but holds a C0 control essentially never — and it is the fold
  over all 32 of those, not the replaces, that costs 87us. The full path is unchanged and
  still runs whenever a control really is present."
  (cond
    (json-clean? s *json-escape-chars*) (str "\"" s "\"")
    (json-clean? s *json-control-chars*)
      (str "\""
        (-> s
          (string/replace "\\" "\\\\")
          (string/replace "\"" "\\\""))
        "\"")
    else
      (str "\""
        (fold (range 32)
          (-> s
            (string/replace "\\" "\\\\")
            (string/replace "\"" "\\\""))
          (fn (acc cp) (string/replace acc (string/bytes-> (bytes [cp])) (json-esc-control cp))))
        "\"")))

(defability Encode
  "JSON-encode a value to its wire string."
  (encode [v] :-> string))

(impl Encode :nil (encode [_] "null"))
(impl Encode :bool (encode [b] (if b "true" "false")))
(impl Encode :int (encode [n] (str n)))
(impl Encode :float (encode [n] (str n)))
(impl Encode :string (encode [s] (json-str s)))
(impl Encode :vector (encode [v] (str "[" (string/join (map v encode) ",") "]")))
(impl Encode :pair (encode [v] (str "[" (string/join (map v encode) ",") "]")))
(impl Encode :map (encode [m] (str "{" (string/join (map (%map-pairs m) encode-entry) ",") "}")))
;; Keywords, symbols, pids — and an app's own records, via the stdlib ability.
;;
;; Hatch encodes JSON in two places: `json/encode` for an HTTP body (`web/conn/json-resp`),
;; the session cookie and `web/seo`'s JSON-LD, and this `Encode` for the live wire, which
;; exists for the reasons above it — a `:default` (`json/encode` has none and raises on an
;; unknown kind, which on a socket means a dropped frame rather than a 500) and the
;; three-tier `json-str`.
;;
;; Two encoders is fine. Two *extension points* was not: `(impl JsonEncode app/money …)`
;; got `"$2.50"` in a JSON response and `"#<money …>"` in a live push, and the fix was to
;; find and implement a hatch-private ability the app had no reason to know about. A record
;; with no impl still falls here (dispatch drops a record straight to `:default`, never to
;; `:map`), so nothing that worked before changes — this only stops the wire from ignoring
;; an impl the app already wrote.
(impl Encode
  :default (encode [v] (if (satisfies? 'JsonEncode v) (json/->json v) (json-str (str v)))))
(defn- encode-entry (kv)
  (let ([k val] kv)
    (str (json-str (if (keyword? k) (->string k) (str k))) ":" (encode val))))

; ---- JSON decode (for incoming WS messages) ----

;; `json/decode` plus one deep keyword→string pass, and nothing else.
;;
;; This used to be a hand-written recursive-descent parser — nineteen functions, 175 lines —
;; written to route around two brood quadratics on a large inbound frame: `string/char-at`
;; scanning codepoints, and per-item append copying the accumulator. Both were real, and the
;; parser was a large improvement on what preceded it.
;;
;; They are not real any more, and the hand-rolled version is now the slow one. Measured on
;; the two frames a session actually sees — a tiny event and a 48 KB paste — `json/decode`
;; plus `stringify-keys` runs 2.4x and 4.2x faster respectively, INCLUDING the stringify pass.
;; So the parser was 175 lines of code, its own escape and number handling, and its own bugs,
;; to be several times slower than the function next to it.
;;
;; The keys must be strings, not the keywords `json/decode` yields: a view's `on` handler
;; reads `(get params "value")`, the same spelling a query or form param uses, and that
;; contract predates the wire protocol.
;;
;; **Malformed input now rejects the whole frame rather than degrading in place.** The old
;; parser answered U+FFFD for a lone surrogate or bad `\uXXXX`, and nil for a number token
;; like `-` or `1.2.3`, so a hand-crafted frame decoded partially and the session acted on
;; what survived. `json/decode` raises, `parse-client-frame` already catches it, and the frame
;; is ignored. The safety property is the one the old comments claimed — a crafted frame
;; cannot crash the session — reached by refusing the frame instead of guessing at it, which
;; is the better answer for input arriving off an untrusted socket.
(defn json-decode (s)
  "Parse a JSON string into a Brood value, with object keys as STRINGS (matching query/form
  params). Raises on malformed input; callers on the socket path catch it and drop the frame.

  (hatch/web/live/json-decode \"{\\\"a\\\":[1,2]}\") ;=> {\"a\" [1 2]}"
  (http/util/stringify-keys (json/decode s)))

; ---- the view spec ----
;
;; What a `deflive` module exposes, as a value. It was a thirteen-key map, and every read of
;; it — a `(get spec :render-dynamic)` or a `(get view :slot-deps)` — was a keyword one character
;; away from a silent nil. A nil there is not a crash: `render-slots` nil means "no slots",
;; so a mistyped read degrades a view to re-rendering everything, correctly, forever, with
;; nothing to see. The accessors below turn each of those into a name `nest check` knows.
;;
;; The generated accessors read a plain MAP as happily as a record, so a hand-built spec —
;; which this module has always accepted, and `web/test` documents — keeps working unchanged;
;; a spec that predates a field simply answers nil for it, exactly as `get` did.
;;
;; REORDERING THESE FIELDS MEANS EDITING `deflive` TOO. The macro builds the value with the
;; positional constructor, so the field order here and the argument order there are one
;; contract in two places. What keeps that honest is that every field is pinned by a
;; behavioural test (`web_test_test`'s drivers, `web_change_tracking_test`'s slot deps), so a
;; swap fails the suite rather than shipping a view whose ticks run its event handler.
(defrecord view-spec
  (mount render
    render-static render-dynamic render-slots slot-deps handle-event handle-tick handle-info unmount
    mount-guard handle-params ticks))

(impl Display web/live/view-spec (->string [_spec] "#<live view-spec>"))

; ---- the session view ----
;
;; One live connection's whole state: which view is mounted, its model, and the bookkeeping
;; the loop keeps around it. It was a bare map that grew a key wherever one was first needed,
;; and reading it was the same hazard the spec was — `(get view :mounted)` without the `?` is
;; nil, which reads as "not yet mounted", so every out-of-band arm silently drops its message
;; and a live view simply stops updating with nothing logged.
;;
;; The fields divide in two. `spec`/`spec-fn`/`session`/`params`/`conn`/`components` are fixed
;; when the socket connects (and replaced wholesale on a live-navigate); `model` through
;; `client-sfp` are what the loop accumulates. `generation` starts at 0 rather than nil
;; because a declared field is always present — `(session-view-generation view)` would answer nil,
;; and the tick arm compares it against a ticker's stamp.
;;
;; Built through `new-session-view` below, never positionally at a call site: fourteen
;; positional arguments is a swap waiting to happen, and the two places that make one care
;; about different halves of the list.
(defrecord session-view
  (spec spec-fn
    session params conn components model mounted? generation ticker-pids watchdog dynamics
    render-model client-sfp))

(impl Display
  web/live/session-view
  (->string [view]
    (str "#<live session "
      (if (session-view-mounted? view) "mounted" "unmounted")
      " gen="
      (session-view-generation view)
      ">")))

(defn- new-session-view (spec spec-fn session params conn)
  "A freshly connected session's view: what the connection settles at connect time, with
  everything the loop accumulates starting empty. `mounted?` is false because mount waits for
  the client's `join` frame (which carries the real URL params) — see `session-dispatch`."
  (session-view spec
    spec-fn
    session
    params
    conn
    (table/new) ; components — the session's live per-id LiveComponent state
    nil ; model
    false ; mounted?
    0 ; generation
    (list) ; ticker-pids
    nil ; watchdog
    nil ; dynamics
    nil ; render-model
    nil)) ; client-sfp
; ---- wire protocol messages ----

(defn send-msg (sock msg-map)
  "Encode `msg-map` as JSON and send it as a WebSocket text frame. Returns true on
  success, false if the write failed — a peer that vanished mid-write (broken pipe)
  then ends the session cleanly instead of crashing the worker with an uncaught error."
  (check-allow :discarded-catch
    (try (do (tcp/send sock (text-frame (encode msg-map))) true) (catch _ false))))

;; The frame reader itself is `http/websocket/recv-frame` (shared with web/channel's socket
;; actor). It answers `[:other msg buf]` for anything in the mailbox that isn't socket bytes,
;; and `session-recv` below matches those out — so the session's control vocabulary (ticks,
;; out-of-band info, component pushes, reload signals, the watchdog's reap) is written once
;; there rather than mirrored into the reader's own receive arms, which is what it was.

; ---- ticker: a steady server-side tick, independent of client traffic ----
; A `tick` interval is a native `timer/send-interval` timer (Erlang parity, prelude): a tiny
; green process on the scheduler's timer wheel that posts `[:tick ms gen]` to the session
; every `ms` and self-cleans when the session dies (it monitors the target). `ms` keys the
; beat so a session with several tickers can tell which fired; `gen` lets the session drop
; a beat left over from a view it has since navigated away from. Steady regardless of
; client traffic, and no hand-rolled monitor/receive loop to maintain — see `start-tickers`.

; ---- idle watchdog: keepalive ping + reap dead/idle connections ----

(def *ws-ping-ms*
  ; How long with no client frame before the watchdog pings (and, after a couple of
  ; unanswered pings, closes). A live browser auto-pongs a ping, which resets the timer,
  ; so an open-but-idle tab stays connected; a dead/black-hole peer is reaped.
  30000)

(defn start-watchdog (session sock)
  "Spawn the idle watchdog for `session` and return its pid.

  **`session` is a parameter, and that is the point of this function existing.** `spawn`
  evaluates its expression in the CHILD process, so `(spawn (idle-watchdog (self) sock 0))` —
  which is how this was written, and reads perfectly — hands the watchdog its OWN pid. It then
  monitors itself, and its `[:ws-send …]` ping and its `[:reap]` go to its own mailbox, where
  its `receive` has no arm for either and selective receive leaves them. The result is a
  watchdog that runs forever, resets on `[:alive]`, and does nothing: no keepalive ever reaches
  the client, and a black-holed peer is never reaped — so a half-open connection pins a session
  process and an fd indefinitely, which is the exact thing this is for.

  Nothing raises and nothing looks wrong. Taking the pid as an argument makes it the caller's
  `(self)`, evaluated where `self` means the session."
  (spawn (idle-watchdog session sock 0)))

(defn idle-watchdog (session sock misses)
  "Per-session keepalive + idle reaper. Every `*ws-ping-ms*` with no client frame, ask the
  session to send a ping (the session is the sole socket writer — we never write here);
  browsers auto-pong, which resets us via `[:alive]`. After a couple of unanswered pings,
  close the socket so a dead or silently-idle peer can't pin a reader thread + a parked
  green process forever. Monitors the session ONCE here, then loops — re-monitoring on every
  `[:alive]` (one per client frame) would stack watchers on the session pid without bound."
  (monitor session)
  (idle-watchdog-loop session sock misses))

(defn- idle-watchdog-loop (session sock misses)
  (receive
    ([:alive] (idle-watchdog-loop session sock 0))
    ([:down _ _ _] nil)
    (after *ws-ping-ms*
      (if (>= misses 2)
        ; two pings unanswered → peer is gone. Ask the SESSION to reap rather than closing the
        ; fd from here: the session is the sole socket owner, and it's parked reading, so `[:reap]`
        ; wakes it → close-session (registry + component cleanup + socket close). Then stop.
        (send session [:reap])
        (do
          (send session [:ws-send sock (ping-frame)])
          (idle-watchdog-loop session sock (+ misses 1)))))))

(defn kick-watchdog (view)
  "Tell this session's idle watchdog that a client frame arrived — resets its ping/idle
  timer. A no-op if the session has no watchdog (e.g. in a unit test)."
  (let (w (session-view-watchdog view))
    (when w (send w [:alive])))
  nil)

; ---- named singleton processes ----
; The reload registry below is "get-or-spawn a process registered under a name".

(defn- live-ensure (nm)
  "Resolve registry `nm` — the supervised child (started by the `defonce` below). If it's
  absent (supervisor never started, or torn down), (re)start the supervisor — idempotent
  via its `:name` — and wait through the brief async-start / restart window. In normal
  operation the first `whereis` hits, so nothing competes with the supervisor's child."
  (or (proc/whereis nm)
    (do
      (start-live-registries)
      (live-await nm 60)
      ;; Raise rather than answer nil — same reason as `web/registry/ensure-supervised`:
      ;; `live-register` hands the result straight to `send`, which then
      ;; fails describing the wrong thing.
      (or (proc/whereis nm)
        (error "live-ensure: " nm " did not register within the start window")))))
(sig live-ensure (any -> pid))

; ---- live-view registry: lets a hot reload push a fresh render to open sessions ----
; Hot reload already rebinds the view's globals (docs/shared-code.md); we just need
; to signal each open connection that code changed so it re-renders. A small process
; holds the open session pids; `deflive` emits a sentinel that calls `notify-reload`
; on every (re)load of the view module, and the registry forwards a [:reload] to each
; session. No-op until a session connects.

(defn- live-registry-loop (pids)
  (receive
    ([:register p] (live-registry-loop (cons p pids)))
    ([:unregister p] (live-registry-loop (seq/filter pids (fn (q) (not (= q p))))))
    ([:reload] (dolist (p pids) (send p [:reload])) (live-registry-loop pids))
    ([:reload-css] (dolist (p pids) (send p [:reload-css])) (live-registry-loop pids))))

(defn- live-registry ()
  "The reload-registry pid — the supervised `:hatch-live` (see `start-live-registries`),
  waiting through a restart window; lazily spawned only if no supervisor is running."
  (live-ensure :hatch-live))

(defn- live-register (pid) (send (live-registry) [:register pid]) nil)

(defn- live-unregister (pid)
  (let (r (proc/whereis :hatch-live)) (when r (send r [:unregister pid])))
  nil)

(defn notify-reload ()
  "Signal every open live session to re-render with freshly hot-reloaded code. A
  `deflive` sentinel calls this on each (re)load of the view module; a no-op when no
  registry/sessions are running (e.g. the first load at startup)."
  (let (r (proc/whereis :hatch-live)) (when r (send r [:reload])))
  nil)

(defn notify-reload-css ()
  "Signal every open live session to hot-swap its stylesheet — no re-render, so live
  state is untouched (the client just re-stamps each <link rel=stylesheet> href). The
  asset watcher (web/assets) calls this on each finished CSS rebuild; a no-op when no
  registry/sessions are running."
  (let (r (proc/whereis :hatch-live)) (when r (send r [:reload-css])))
  nil)

; ---- session actor ----

(defn start-tickers (ticks gen)
  "Start one native `timer/send-interval` timer per interval in `ticks`, each posting
  `[:tick ms gen]` to this (the calling) session on a steady beat, stamped with the session
  generation `gen`. Returns their timer handles so they can be cancelled when the session
  navigates to another view (otherwise the old view's tickers would linger and accumulate
  across navigations); each is self-cleaning if the session dies first."
  (let (me (self))
    (map (or ticks (list)) (fn (ms) (timer/send-interval ms me [:tick ms gen])))))

(defn stop-tickers (handles)
  "Cancel the given interval timers — used when a session swaps to a different view."
  (dolist (h handles) (timer/cancel h)))

;; ---- the connection's Conn, reachable from view code ----------------------------------
;; A live view's `mount`/`render`/handlers take only their own arguments, so until now the
;; read-only Conn built from the WebSocket upgrade request was reachable *only* by
;; `on-mount-guard`, which is handed it explicitly. That left a real hole: anything a view
;; needs to know about the connection itself — the session cookie, and through it the CSRF
;; token, the request headers, the peer address — was simply unavailable, and the workaround
;; (an HTTP endpoint the page fetches to bootstrap the value) is boilerplate every app would
;; rewrite.
;;
;; Rather than widen `mount`/`render`'s signature — a breaking change to every existing view,
;; for something most views never touch, and one the `LiveModule` behaviour already had to be
;; contorted for once (see the `&optional` arity wart) — the Conn is exposed as a dynamic
;; binding, bound ONCE around the whole session loop in `start-session`. It is therefore in
;; scope for every hook the session ever runs (`mount`, `render`, `handle-event`,
;; `handle-info`, `handle-tick`, `handle-params`, `unmount`) with no per-call-site plumbing,
;; and it costs a view that never asks for it nothing.
;;
;; One binding frame per session, not per iteration: the receive loop recurses to itself,
;; inside the binding, and never returns through it.

(defdyn *live-conn* nil)

(defn live-conn ()
  "The read-only Conn for this live session's connection — built once from the WebSocket
  upgrade request (so its cookies and headers are the ones the browser sent when it
  connected) and carried unchanged across live-navigations, which reuse the same socket.

  Callable from any live-view hook. Returns nil outside a live session — including in a
  `web/test` driver, which calls a spec's functions directly rather than running a session —
  so a view that reads it must tolerate nil rather than assume a connection.

  It is deliberately a *read-only* view of the connection: a WebSocket has no response to
  attach a `Set-Cookie` to, so nothing written onto this Conn can reach the client. Read
  from it (see `web/csrf/live-token`); don't try to mutate the session through it."
  *live-conn*)

(defn send-safely (pid msg)
  "Send `msg` to `pid`, swallowing a failure — the shared delivery guarantee behind
  `send-info` and `web/component/send-update`: a fan-out caller (a PubSub/Presence
  registry looping over subscribers) must not crash because one of them just vanished —
  the registry's monitor cleans the stale pid up moments later anyway."
  (check-allow :discarded-catch (try (send pid msg) (catch _ nil)))
  nil)

(defn send-info (session payload)
  "Deliver an out-of-band `payload` to a live `session` process; it arrives at the view's
  `handle-info`, which returns a new model and triggers a re-render. This is the delivery
  primitive PubSub/Presence (and one-off timers) build on. `session` is a live session pid
  — the value `(self)` has inside a running session, e.g. captured in `mount` to subscribe.
  Sending to an already-dead session is swallowed — see `send-safely`."
  (send-safely session [:info payload]))

; ---- handler-initiated effects (push event / navigate / redirect) ----
; A view handler (`on`/`tick`/`handle-info`) returns the next model — the declarative path.
; But some things are imperative: "after save, go to /thanks", "on this event, focus a
; field". These helpers let a handler queue a one-off message to the client alongside its
; model update. They run in the session process (handlers are called there), so they just
; post `[:push-effect …]` to `(self)`; the session flushes the queue to the socket right
; after pushing the model diff (see `flush-effects`). The handler still returns a model, so
; nothing about the model-in/model-out contract or the diffing changes.

(defn js (commands)
  "Encode `commands` for a `data-js-<event>` attribute — the client-side operations
  brood_live.js runs locally, with no frame and no round trip.

  Each command is `[op selector & args]`; a selector of `\"this\"` means the element the
  attribute is on. The ops are `toggle` / `show` / `hide`, `add-class` / `remove-class` /
  `toggle-class`, `set-attr` / `remove-attr`, `focus` / `blur`, and `dispatch` (a CustomEvent
  for the page's own JavaScript).

      [:button {:data-js-click (live/js [[:toggle \"#menu\"]])} \"Menu\"]

      ;; a local change and a server event on one control: the panel opens immediately, the
      ;; save travels
      [:button {:data-on-click \"save\"
                :data-js-click (live/js [[:add-class \"#form\" \"saving\"]])}
        \"Save\"]

  Opening a dropdown does not need the server to know about it, and a round trip to find out
  is latency the user can feel. This is for the changes that are genuinely only visual — a
  change the server must know about is an event.

  (hatch/web/live/js [[:toggle \"#menu\"]]) ;=> \"[[\\\"toggle\\\",\\\"#menu\\\"]]\"
  (hatch/web/live/js [[:add-class \"this\" \"open\"]]) ;=> \"[[\\\"add-class\\\",\\\"this\\\",\\\"open\\\"]]\""
  (encode (mapv commands
            (fn (command) (mapv command (fn (part) (if (keyword? part) (->string part) part)))))))

(defn push-event (name &optional (payload {}))
  "From inside a live handler, tell the client to dispatch a `brood:event` CustomEvent
  (`detail = {name, payload}`). App JS listens for it — the escape hatch for client effects a
  re-render can't express (focus a field, start an animation, call into a JS lib)."
  (send (self) [:push-effect {:event "push" :name name :payload payload}])
  nil)

(defn push-title (title)
  "From inside a live handler, set the browser tab's title.

  **This is the answer to Q10** — head updates are an effect, not a diffable region of the
  layout, and the reasoning is worth keeping because the other option looks tidier.

  A `<head>` slot would mean the live template covering the whole document rather than the
  view's own markup, and `<head>` is the one place DOM morphing behaves badly: re-touching a
  `<link rel=stylesheet>` can re-fetch and re-apply it (a flash of unstyled content on a
  title change), and a re-inserted `<script>` re-executes. The title is also the only part of
  the head a live view realistically changes — a count in the tab, the name of the thing being
  viewed — and it is a single string with a single native setter.

  So: an effect, on the channel `push-event` and `push-navigate` already use, flushed right
  after the handler's model diff so the tab and the body change in one visual step.

      (on \"select\" (params model)
        (let (chosen (get params \"name\"))
          (live/push-title (str chosen \" · hatch\"))
          (assoc model :chosen chosen)))

  A live-navigate to another view sets the new view's title from its own mount page, so this
  is for a title that changes *within* a view."
  (send (self) [:push-effect {:event "title" :title title}])
  nil)

(defn push-navigate (path)
  "From inside a live handler, navigate the client to `path` over the live socket — the
  server-initiated equivalent of the user clicking a `data-nav` link (a live view morphs in
  place, a non-live path falls back to a full load), with the address bar updated."
  (send (self) [:push-effect {:event "nav" :path path :sfp nil}])
  nil)

(defn push-redirect (url)
  "From inside a live handler, force the client to do a full page load to `url` (leaving the
  live socket) — e.g. after logout, or to cross a live-session/auth boundary."
  (send (self) [:push-effect {:event "redirect" :path url :sfp nil}])
  nil)

(defn flush-effects (sock)
  "Drain every `[:push-effect …]` the just-run handler queued to this session (via
  `push-event`/`push-navigate`/`push-redirect`) and send each to the client. Non-blocking
  (`after 0`): it only pulls push-effect messages, leaving frames/ticks/info untouched, and
  returns the moment none remain. Run at the top of `session-recv`, so effects go out right
  after the model diff and before the session blocks for the next client frame."
  (receive
    ([:push-effect msg] (do (send-msg sock msg) (flush-effects sock)))
    (after 0 nil)))

(defn- live-handler-error (phase key e fallback)
  "A view lifecycle handler (`phase` = \"event\"/\"tick\"/\"info\"/\"unmount\", `key` its
  event/message key) raised. Emit a `[:hatch :live :exception]` telemetry event — the same
  observability seam http/server uses for a raising request handler — so the failure is
  logged/traced by whatever's attached (a no-op until an app attaches a handler) instead of
  vanishing. Returns `fallback` (the prior model) so the session survives the bad callback."
  (telemetry/emit [:hatch :live :exception]
    {}
    {:phase phase :key (str key) :error (error-message e)})
  fallback)

(defn session-loop (sock view buf)
  "Per-connection WebSocket event loop.
  `view` is a map {:mount :render :handle-event :handle-tick :ticks :model :ticker-pids}."
  ; The socket is already in binary mode: http/server's upgrade path flips it
  ; *before* it sends the 101 (and before this handler runs), so byte-faithful
  ; reads/writes are guaranteed for the very first client frame. Setting it here
  ; instead would be a race — the client can send a frame the moment it sees the
  ; 101, before this handler (which may do a registry lookup first) reaches here.
  ; Register so a hot reload can push a fresh render here.
  (live-register (self))
  ; The view is not mounted yet — mount, the initial render, and this view's tickers all wait
  ; for the client's `join` frame (which carries the real URL params), so each happens exactly
  ; once (see the `join` arm of session-dispatch). Start only the idle watchdog so a peer that
  ; connects but never joins is still pinged and eventually reaped. Enter the recv loop.
  ;; `:generation` needs no setting here — `new-session-view` starts it at 0, which is what
  ;; the tick arm compares a ticker's stamp against.
  (let (view (assoc view :watchdog (start-watchdog (self) sock)))
    (session-recv sock view buf)))

; The loop's one render-and-reply step: set the new model on the view, push a frame
; ("render" for a full page, "diff" for an update), and go back to listening. Every
; state transition below funnels through here.
(defn push-update (sock view buf kind model)
  "Set `model` on the view and push to the client: a full `join` (static skeleton + every
  dynamic slot) for `kind` \"render\", else a minimal `diff` (only the changed slots). Keeps
  listening on `buf`; a failed write (peer gone) ends the session."
  (let (view (assoc view :model (stream-effects model)))
    (if (= kind "render")
      (push-full sock view buf)
      (push-diff sock view buf))))

(defn- stream-effects (model)
  "Queue any stream deletions the handler asked for, and hand back the model to render.

  A `web/streams` delete cannot be expressed by rendering what is left — the server is not
  holding the collection, which is the whole point of a stream — so it travels as an effect
  frame naming the ids, on the same channel `push-event` uses. Queued HERE, before the render,
  so it is flushed by the same `session-recv` that follows the patch and the row disappears in
  one visual step rather than a frame later.

  A model with no streams in it pays one `map?` and a scan of its own keys, which is why the
  guard is a separate cheap test rather than the work itself."
  (when (web/streams/holds-streams? model)
    (let (ids (web/streams/pending-deletes model))
      (when (not (empty? ids))
        (send (self) [:push-effect {:event "stream-delete" :ids (vec ids)}]))))
  model)

(defn- flush-streams (view)
  "The view with every stream in its model emptied — what was just rendered has been sent, and
  keeping it is the cost `web/streams` exists to avoid.

  Run immediately after a frame goes out, which is the only moment at which 'already on
  screen' becomes true. It also clears the reset flag, so the next patch merges rather than
  emptying the list this one just filled."
  (let (model (session-view-model view))
    (if (web/streams/holds-streams? model)
      (assoc view :model (web/streams/flush model))
      view)))

(defn- audit-live-render (spec model)
  "Run `web/audit`'s live-markup rules over this view's rendered document. Dev only, and on a
  FULL render only — a join, not every diff — so the cost is one extra render per connection
  rather than one per event.

  It renders a second time rather than reusing the statics and dynamics just computed, for one
  reason: those are a split, and a `data-hook` element's attributes can straddle the boundary
  between a static and the slot next to it, so the audit would be reading half a tag. A second
  render is the honest way to get a document, and it is paid only in dev.

  The component table it renders with is a FRESH one, never the session's. `render-slot`
  writes component state into the table it is handed, and re-rendering through the live one
  would mount every component on the page a second time — an audit must not be able to change
  what it is auditing.

  Wrapped whole: a render that throws here has already been reported by the real render beside
  it, and an audit is the last thing that should be able to end a session."
  (when (web/audit/dev?)
    (check-allow :discarded-catch
      (try
        (web/audit/warn-live-markup! (web/template/render ((view-spec-render spec) model
                                                            (table/new))))
        (catch _ nil))))
  nil)

(defn push-full (sock view buf)
  "Send the whole view — `{:event \"join\" :s statics :d dynamics :f fingerprint}` — and record
  the dynamic slots (and the model they were rendered from) so later updates diff and
  change-track against them. The client assembles the HTML and morphs. Any `(component …)`
  holes read/write the session's live component table (`:components`) as they render — see
  web/component.

  **Statics are omitted when the client already has them.** A reconnecting client replays the
  fingerprint of the statics it cached (`:client-sfp`, off its join frame); if it matches this
  view's, the frame carries only `:d` and `:f`, and the client reuses what it holds. The
  statics are the bulk of a join — a page's entire literal skeleton — so a flaky connection
  stops re-downloading its own markup on every drop. A mismatch (a first connect, a
  live-navigate to a different view, a hot-reloaded template) sends them as usual, so the
  client can never be left weaving against a stale skeleton."
  (let (spec (session-view-spec view)
        statics (view-spec-render-static spec)
        model (session-view-model view)
        ; Guard the render like every other view hook: a template that throws (a nil deref, a
        ; bad `get`) fails to an isolated, logged `[:hatch :live :exception]` and ends the
        ; session, rather than crashing the whole session process with no telemetry.
        dynamics (try
                   ((view-spec-render-dynamic spec) model (session-view-components view))
                   (catch e (live-handler-error "render" :render e nil))))
    (if (nil? dynamics)
      (close-session sock view)
      (let (_audit (audit-live-render spec model)
            view (assoc view :dynamics dynamics :render-model model)
            fp (web/parts/statics-fingerprint statics)
            ; the client's claim is consumed by this join and not carried forward: a later
            ; re-join on the same socket (a live-navigate) is a fresh negotiation
            cached? (= fp (session-view-client-sfp view))
            frame (if cached?
                    {:event "join" :d dynamics :f fp}
                    {:event "join" :s statics :d dynamics :f fp}))
        (if (send-msg sock frame)
          ;; cleared, not dissoc'd: every field of the record stays present, and the claim is
          ;; consumed by this join either way
          (session-recv sock (flush-streams (assoc view :client-sfp nil)) buf)
          (close-session sock view))))))

(defn slot-dirty? (dep old-model model)
  "True if a slot with dependency descriptor `dep` must re-render: `:all` (an opaque model
  use) always re-renders; otherwise only when one of its dependency keys changed value."
  (if (= dep :all)
    true
    (slot-dirty?-at dep old-model model 0 (count dep))))

(defn- slot-dirty?-at (dep old-model model i n)
  (if (>= i n)
    false
    (if (not (= (get old-model (nth dep i)) (get model (nth dep i))))
      true
      (slot-dirty?-at dep old-model model (+ i 1) n))))

(defn recompute-dynamics (view old model)
  "The new dynamic slot values, re-rendering only the slots whose model dependencies changed
  since `old` was rendered and reusing the prior value for the rest (Phoenix HEEx-style
  change tracking). Falls back to a full re-render when the tracking metadata is absent (an
  older spec) or no prior model was recorded. `components` (the session's live component
  table) is threaded through every slot call, same as `push-full` — a component-holding
  slot's dependency is always `:all` (see web/parts' `deps-of`), so it's never skipped here,
  but it still needs the table to actually render."
  (let (spec (session-view-spec view)
        slots (view-spec-render-slots spec)
        deps (view-spec-slot-deps spec)
        old-model (session-view-render-model view)
        components (session-view-components view))
    (if (or (nil? slots) (nil? deps) (nil? old-model))
      ((view-spec-render-dynamic spec) model components)
      (into []
        (map (range (count old))
          (fn (i)
            (if (slot-dirty? (nth deps i) old-model model)
              ((nth slots i) model components)
              (nth old i))))))))

(defn push-diff (sock view buf)
  "Re-render the dynamic slots that a state change actually touched and send only those that
  changed — `{:event \"diff\" :d {idx val}}`. No prior dynamics (no join yet) → a full push;
  nothing changed → send nothing."
  (if (nil? (session-view-dynamics view))
    (push-full sock view buf)
    (let (old (session-view-dynamics view)
          model (session-view-model view)
          ; Guard the re-render (see push-full). On a throw, keep the prior render and keep
          ; listening — a transient bad model shouldn't tear down the session.
          dynamics (try
                     (recompute-dynamics view old model)
                     (catch e (live-handler-error "render" :render e nil))))
      (if (nil? dynamics)
        (session-recv sock view buf)
        (let (changed (web/parts/diff-dynamics old dynamics)
              ;; Streams are emptied whether or not anything went out. A render happened —
              ;; their items reached the wire, or produced no change because they were already
              ;; there — and carrying them into the next diff would render the same rows twice.
              view (flush-streams (assoc view :dynamics dynamics :render-model model)))
          (if (= (count changed) 0)
            ;; Nothing to patch, but the client is still holding the loading state it put up
            ;; when it sent the event — `brood-loading`, and a `data-disable-with` control
            ;; disabled and relabelled — and it clears that only when a patch arrives. A
            ;; handler that renders identically (a no-op save, a toggle already in that state,
            ;; a re-submitted unchanged form) would otherwise leave the button disabled and
            ;; the container dimmed until some unrelated later patch, which on a view with no
            ;; ticker is never. An empty diff is cheap and says "I am done".
            (if (send-msg sock {:event "diff" :d {}})
              (session-recv sock view buf)
              (close-session sock view))
            (if (send-msg sock {:event "diff" :d changed})
              (session-recv sock view buf)
              (close-session sock view))))))))

(defn close-socket (sock)
  "Send a close frame and close the TCP socket. Best-effort throughout — the peer may
  already be gone (a broken pipe), so a failed write here is never itself an error."
  (check-allow :discarded-catch (try (tcp/send sock (close-frame)) (catch _ nil)))
  (check-allow :discarded-catch (try (tcp/close sock) (catch _ nil)))
  nil)

(defn close-session (sock view)
  "Drop out of the reload registry, delete any half-finished upload spools, free the session's
  live component table (web/component), and close the socket.

  The upload sweep is the one piece of cleanup here that touches the filesystem, and it is
  what makes an abandoned upload free: a user who picks a 40 MB file and closes the tab leaves
  a spool file behind otherwise, with nothing that would ever delete it. `web/upload/cleanup`
  reads the model and deletes what it still references — an upload consumed by a handler is
  already gone from the model, so nothing live is touched."
  (live-unregister (self))
  (check-allow :discarded-catch
    (try (web/upload/cleanup (session-view-model view)) (catch _ nil)))
  (check-allow :discarded-catch (try (table/drop (session-view-components view)) (catch _ nil)))
  (close-socket sock))

(defn redirect-and-close (sock path)
  "Send the client a redirect (brood_live.js does a full `window.location.href` load to
  `path`) and close the socket. Used when an `on-mount-guard` vetoes a fresh connect, before
  any session state exists — so there's no live-registry registration to undo, unlike
  `close-session`."
  (check-allow :discarded-catch
    (try (send-msg sock {:event "redirect" :path path :sfp nil}) (catch _ nil)))
  (close-socket sock))

(defn redirect-and-continue (sock view buf path)
  "Send the client a redirect to `path` (a full page load — an unknown/cross-group
  navigate target, or a target view's on-mount-guard veto) and, if the send succeeds,
  keep listening on the *current*, still-live `view` — the socket doesn't have to
  cross the boundary itself, the browser's own reload does. A failed send means the peer
  is already gone, so end the session instead."
  (if (send-msg sock {:event "redirect" :path path :sfp nil})
    (session-recv sock view buf)
    (close-session sock view)))

(defn sync-registry (nm)
  "Synchronously round-trip the named registry (`:hatch-pubsub` / `:hatch-presence`), if it's
  running, so anything it queued for THIS session before our just-sent unsubscribe/untrack has
  been delivered to our mailbox by the time it replies — a barrier a following `drain-oob` then
  relies on. A no-op when the registry isn't up (this app doesn't use it); bounded by a short
  timeout so a wedged registry can't hang a navigate."
  (let (reg (proc/whereis nm))
    (when reg
      (let (r (ref))
        (send reg [:sync (self) r])
        (receive ([:sync ^r] :ok) (after 200 :ok))))))

(defn drain-oob ()
  "Discard out-of-band messages (PubSub/Presence broadcasts, component updates) already queued
  for the OLD view before a live-navigate swaps in a new one. The old view unsubscribes in its
  unmount; `sync-registry` (called first) barriers the registries so every broadcast queued
  before that unsubscribe has landed here, and this then drops them — so none reaches the NEW
  view's `handle-info` (or a carried-over component), and no incoming-view message is lost."
  (receive
    ([:info _] (drain-oob))
    ([:update-component _ _] (drain-oob))
    ([:tick-component _ _] (drain-oob))
    (after 0 nil)))

(defn session-recv (sock view buf)
  ; Flush any effects the last handler queued (push-event/navigate/redirect) before we block
  ; for the next frame — so they reach the client right after that handler's model diff.
  (flush-effects sock)
  (match (recv-frame sock buf)
    ; client close
    ([:ok 8 _ _] (close-session sock view))
    ; ping → pong (any client frame also kicks the idle watchdog alive). The pong send
    ; is best-effort: a failed write means the peer is gone, so end the session.
    ;
    ; `remainder`, NOT `buf`. `recv-frame` answers from the buffer without touching the
    ; socket, so re-entering with the buffer the ping came out of re-parses that same ping
    ; forever: a pong per iteration, a core pinned, and the loop never reaching a `receive`
    ; — so `[:reap]` and every out-of-band message pile up unread while `kick-watchdog`
    ; fires each time round, disarming the one thing that would have reaped it. A client
    ; writing `[text][ping]` in one TCP segment is enough, since the text arm threads its
    ; remainder here. Every sibling arm already threads it; this one did not.
    ([:ok 9 payload remainder] (kick-watchdog view)
      (if (check-allow :discarded-catch
            (try (do (tcp/send sock (pong-frame payload)) true) (catch _ false)))
        (session-recv sock view remainder)
        (close-session sock view)))
    ; client message
    ([:ok 1 payload remainder] (kick-watchdog view) (session-dispatch sock view remainder payload))
    ; a binary frame: one chunk of a live upload. Binary is the whole reason this arm exists —
    ; a file sent as JSON has to be base64'd, which costs a third more bytes on the wire and a
    ; decode per chunk, for a transport that already carries bytes natively.
    ([:ok 2 payload remainder] (kick-watchdog view) (session-chunk sock view remainder payload))
    ; other opcodes (e.g. a pong, opcode 0xA) — ignored, but still client liveness
    ([:ok _ _ remainder] (kick-watchdog view) (session-recv sock view remainder))
    ; anything in the mailbox that isn't socket bytes — a tick, an out-of-band message, a
    ; reload signal, the watchdog. `recv-frame` hands it back untouched with the bytes read
    ; so far; this session's own vocabulary is in `session-control`.
    ([:other msg buf2] (session-control sock view buf2 msg))
    ; the peer already closed the TCP connection (no WS close frame) — same cleanup as
    ; close-session (registry + the session's component table), its socket-write calls are
    ; already best-effort/try-caught so they're harmless to make on an already-dead socket
    ([:closed] (close-session sock view) nil)
    ([:error _] (close-session sock view))))

(defn parse-chunk-frame (payload)
  "Split an upload chunk frame into `[ref bytes]`, or nil if it is malformed.

  The framing is one length byte, that many bytes of ASCII ref, then the file bytes — chosen
  so a chunk needs no encoding at all. A ref is 32 hex characters, comfortably inside the
  byte, and the length is read before it is trusted: a declared ref longer than the frame is
  refused rather than sliced past the end.

  (hatch/web/live/parse-chunk-frame (bytes/concat [2 97 98 1 2 3])) ;=> [\"ab\" (bytes [1 2 3])]
  (hatch/web/live/parse-chunk-frame (bytes [9 97])) ;=> nil
  (hatch/web/live/parse-chunk-frame (bytes [])) ;=> nil"
  (let (total (count payload))
    (if (< total 1)
      nil
      (let (reflen (bytes/at payload 0))
        (if (or (= reflen 0) (> (+ 1 reflen) total))
          nil
          [(string/bytes-> (bytes/slice payload 1 (+ 1 reflen)))
            (bytes/slice payload (+ 1 reflen) total)])))))

(defn- session-chunk (sock view buf payload)
  "One binary upload chunk: append it to its entry's spool file and push the resulting diff.

  A malformed frame, or a ref this session never issued, is dropped and the session reads on —
  `web/upload/receive-chunk` ignores an unknown ref by design, since an entry can be cancelled
  or consumed while its bytes are still in flight. Gated on `:mounted?` for the same reason
  every out-of-band arm is: before `join` there is no model to update."
  (if (not (session-view-mounted? view))
    (session-recv sock view buf)
    (let (parsed (parse-chunk-frame payload))
      (if (nil? parsed)
        (session-recv sock view buf)
        (let ([ref chunk] parsed)
          (push-update sock
            view
            buf
            "diff"
            (try
              (web/upload/receive-chunk (session-view-model view) ref chunk)
              (catch e (live-handler-error "upload-chunk" :ref e (session-view-model view))))))))))

(defn- session-control (sock view buf msg)
  "Handle one non-socket message `msg` delivered to the session process, then resume reading
  from `buf`. These are the session's control vocabulary — everything that drives a re-render
  without the client having said anything.

  An UNRECOGNISED message is dropped and the session reads on. It used to sit in the mailbox
  forever, because the reader's `receive` simply had no arm for it and selective receive left
  it where it lay; a stray send from app code therefore grew the session's mailbox for the
  life of the connection with nothing to see."
  (match msg
    ; the idle watchdog asks the session — the sole socket writer — to emit a keepalive ping
    ([:ws-send _ frame] (if (check-allow :discarded-catch
                              (try (do (tcp/send sock frame) true) (catch _ false)))
                          (session-recv sock view buf)
                          (close-session sock view)))
    ; A generation-stamped beat. Drop it if it's from a view we've navigated away from
    ; (its ticker was killed, but this beat was already in the mailbox) — otherwise it'd
    ; fire the new view's handle-tick with the old view's interval key.
    ([:tick key gen] (if (= gen (session-view-generation view))
                       (push-update sock
                         view
                         buf
                         "diff"
                         (try
                           ((view-spec-handle-tick (session-view-spec view)) key
                             (session-view-model view))
                           (catch e
                             (live-handler-error "tick" key e (session-view-model view)))))
                       (session-recv sock view buf)))
    ; an out-of-band message delivered via send-info (PubSub/Presence/timer) → run the
    ; view's handle-info and push the resulting diff. A view without a handle-info clause
    ; (or one that throws) keeps its current model, so a stray message is harmless.
    ; Gated on :mounted? — before the client's `join` (which mounts) there is no :model, and
    ; rendering nil would push a bogus frame or crash the session; just keep listening. (Pre-
    ; join, an :info/:update-component can't arrive anyway — mount is what subscribes — but a
    ; `:reload` CAN, since the reload registry holds this pid from connect.)
    ([:info payload] (if (session-view-mounted? view)
                       (push-update sock
                         view
                         buf
                         "diff"
                         (let (h (view-spec-handle-info (session-view-spec view)))
                           (if h
                             (try
                               (h payload (session-view-model view))
                               (catch e
                                 (live-handler-error "info" :message e (session-view-model view))))
                             (session-view-model view))))
                       (session-recv sock view buf)))
    ; a web/component/send-update push: merge into that component's stored state (a no-op
    ; if cid names no mounted component) and re-render — the parent's :model is untouched,
    ; but its next render-dynamic pass picks up the component's fresh state.
    ([:update-component cid changes] (if (session-view-mounted? view)
                                       (do
                                         (try
                                           (web/component/apply-update (session-view-components view)
                                             cid changes)
                                           (catch e
                                             (live-handler-error "update-component" cid e nil)))
                                         (push-update sock
                                           view
                                           buf
                                           "diff"
                                           (session-view-model view)))
                                       (session-recv sock view buf)))
    ; A component's own beat (web/component's `tick` clause): run that component's handle-tick
    ; over its stored state and re-render. Structurally `:update-component`, with the component
    ; computing its own changes rather than being handed them — and like it, the parent's model
    ; is untouched, so what reaches the wire is the component's own inner-slot diff.
    ;
    ; NOT generation-stamped, unlike a view's `[:tick ms gen]`. A view's tickers are killed and
    ; restarted across live-navigate, so a stale beat must be recognised and dropped; the
    ; components table is session-wide and survives navigation by design, so a component's beat
    ; is still meant for it. A beat for an id that is no longer mounted is a no-op in
    ; `apply-tick`.
    ([:tick-component cid ms] (if (session-view-mounted? view)
                                (do
                                  (try
                                    (web/component/apply-tick (session-view-components view) cid ms)
                                    (catch e (live-handler-error "tick-component" cid e nil)))
                                  (push-update sock view buf "diff" (session-view-model view)))
                                (session-recv sock view buf)))
    ([:reload]
      (if (session-view-mounted? view)
        (let (spec (check-allow :discarded-catch
                     (try ((session-view-spec-fn view)) (catch _ nil)))
              ;; a hot reload re-resolves the view's functions; swap the whole
              ;; spec in rather than merging its keys over the view's own
              reloaded (if spec (assoc view :spec spec) view))
          (push-update sock reloaded buf "render" (session-view-model reloaded)))
        (session-recv sock view buf)))
    ; CSS-only rebuild: tell the client to re-stamp its stylesheet links — no
    ; re-render, so the live model (form state, scroll, focus) is preserved.
    ([:reload-css] (if (send-msg sock {:event "reload-css"})
                     (session-recv sock view buf)
                     (close-session sock view)))
    ; the idle watchdog reaped a dead/silent peer — clean up + close the socket (we own it)
    ([:reap] (close-session sock view))
    (_ (session-recv sock view buf))))

(defn parse-client-frame (payload)
  "Decode a client WebSocket frame `payload` (a `bytes` value of UTF-8 JSON) into
  `{:event :params}`. A bare scalar, array, or bool is valid JSON, so the decoded message —
  and its `params` — can be a non-map; both are coerced to `{}` rather than left as-is,
  because the dispatch head that consumes this runs OUTSIDE the per-hook guards and `get`
  THROWS on a non-collection. Without the coercion a single crafted frame (body `5`, `true`,
  `\"x\"`, or `[1,2,3]`) would kill the session actor before `close-session` runs, leaking its
  registry entry and component table per connection.

  (hatch/web/live/parse-client-frame (string/->bytes \"5\")) ;=> {:event \"\" :params {} :name \"\" :cid nil :path \"\" :sfp nil :files nil :ref nil :offer nil}
  (hatch/web/live/parse-client-frame (string/->bytes \"{\\\"event\\\":\\\"tick\\\"}\")) ;=> {:event \"tick\" :params {} :name \"\" :cid nil :path \"\" :sfp nil :files nil :ref nil :offer nil}"
  (let (decoded (check-allow :discarded-catch
                  (try (json-decode (string/bytes-> payload)) (catch _ nil)))
        msg (if (map? decoded) decoded {})
        raw-params (get msg "params" {}))
    ; The frame carries every field the dispatcher routes on: `:event` (the frame type) and
    ; `:params`, plus `:name`/`:cid` (a component-targeted event), `:path` (a live navigate),
    ; and `:sfp` (on a join: the fingerprint of the statics this client already holds, so
    ; push-full can omit them — see statics-fingerprint).
    ; Decoding them ALL here is what keeps `session-dispatch` from reaching back to the raw map.
    {:event (get msg "event" "")
     :params (if (map? raw-params) raw-params {})
     :name (get msg "name" "")
     :cid (get msg "cid" nil)
     :path (get msg "path" "")
     :sfp (get msg "f" nil)
     ; the upload frames: `:files` on an upload-init (the browser's description of what the
     ; user chose), `:ref` on a done/cancel. A non-list `files` is coerced away for the same
     ; reason `params` is — the dispatch head that reads it runs outside the hook guards.
     :files (let (raw (get msg "files" (list)))
              (if (or (list? raw) (vector? raw)) raw (list)))
     :ref (get msg "ref" nil)
     ; the client's id for THIS offer of files, echoed back on the upload-ready that answers
     ; it — one upload name can have two offers in flight, and the refs belong to one of them
     :offer (get msg "offer" nil)}))

(defn session-dispatch (sock view buf payload)
  ; `payload` is a `bytes` value (bytes-native parser) holding the client's UTF-8 JSON —
  ; `parse-client-frame` decodes it and hardens a non-object message against the throw that
  ; would otherwise crash this (unguarded) dispatch head.
  (let (frame (parse-client-frame payload)
        event (get frame :event)
        params (get frame :params))
    (match event
      ; The first client frame: mount (exactly once, with the real URL params), start this
      ; view's tickers, mark the view mounted, and push the initial render. `mount` runs
      ; client-controlled params, so it's guarded like every other hook — a throw ends the
      ; session cleanly (no model to render) instead of crashing it. A SECOND `join` (a buggy
      ; or hostile client) is ignored: re-running `mount` would fire its side effects twice and
      ; skip unmount/generation-bump — a re-mount is what `navigate` is for.
      ("join"
        (if (session-view-mounted? view)
          (session-recv sock view buf)
          (let (model (try
                        ((view-spec-mount (session-view-spec view)) params)
                        (catch e (live-handler-error "mount" :mount e :hatch/mount-error))))
            (if (= model :hatch/mount-error)
              (close-session sock view)
              (push-update sock
                (assoc view
                  :mounted? true
                  ; what statics this client says it still holds (nil on a first
                  ; connect) — push-full drops them from the frame if they match
                  :client-sfp (get frame :sfp)
                  :ticker-pids
                    (start-tickers (view-spec-ticks (session-view-spec view))
                      (session-view-generation view)))
                buf
                "render"
                model)))))
      ; A component-targeted event carries a `cid` (brood_live.js reads the nearest
      ; ancestor's data-cid) — route it to that component's own handle-event instead of
      ; the parent's, and re-render with the parent's :model unchanged (the component's
      ; slot picks up its fresh state on the next render-dynamic pass).
      ("event" (let (name (get frame :name)
                     cid (get frame :cid)
                     model (session-view-model view))
                 (if cid
                   (do
                     (try
                       (web/component/dispatch-event (session-view-components view) cid name params)
                       (catch e (live-handler-error "event" name e nil)))
                     (push-update sock view buf "diff" model))
                   (push-update sock
                     view
                     buf
                     "diff"
                     (try
                       ((view-spec-handle-event (session-view-spec view)) name params model)
                       (catch e (live-handler-error "event" name e model)))))))
      ; ---- live uploads ----
      ;
      ; Three frames and one binary channel. `upload-init` offers the files the user picked
      ; and is answered with the refs the client may send bytes for; the bytes themselves
      ; arrive as binary frames (see `session-recv`'s opcode-2 arm); `upload-done` closes one
      ; entry off. All three only ever produce a new MODEL, which is the point — the progress
      ; bar is an ordinary slot of an ordinary model key, so it diffs like everything else and
      ; the renderer knows nothing about uploads. See web/upload.
      ;
      ; `upload-init` is the only one that answers the client, because the refs it issues are
      ; the capability to write: a ref is unguessable and belongs to this session's model, so
      ; a client cannot invent one or reach another session's entry.
      ;; Both gated on :mounted? — before the client's `join` there is no model, and offering
      ;; files into nil or chunking against it would push a frame rendered from nothing. A
      ;; well-behaved client cannot get here (it has no refs and no markup yet); one that
      ;; sends these frames out of order simply gets no answer.
      ("upload-init" (if (not (session-view-mounted? view))
                       (session-recv sock view buf)
                       (let (upload-name (get frame :name)
                             result (try
                                      (web/upload/offer (session-view-model view)
                                        upload-name
                                        (get frame :files))
                                      (catch e
                                        (live-handler-error "upload-init"
                                          upload-name
                                          e
                                          [(session-view-model view) (list)]))))
                         (let ([next-model refs] result)
                           (send (self)
                             [:push-effect
                               {:event "upload-ready"
                                :name upload-name
                                :offer (get frame :offer)
                                :refs (vec refs)}])
                           (push-update sock view buf "diff" next-model)))))
      ("upload-done" (if (not (session-view-mounted? view))
                       (session-recv sock view buf)
                       (push-update sock
                         view
                         buf
                         "diff"
                         (try
                           (web/upload/finish (session-view-model view) (get frame :ref))
                           (catch e
                             (live-handler-error "upload-done" :ref e (session-view-model view)))))))
      ; Live-patch: the client already updated the URL/history itself (session.patch in
      ; brood_live.js); this just runs handle-params against the *current* view/model — no
      ; lookup-live, no unmount/remount, no ticker restart, the lightest possible update.
      ("patch" (push-update sock
                 view
                 buf
                 "diff"
                 (try
                   ((view-spec-handle-params (session-view-spec view)) params
                     (session-view-model view))
                   (catch e (live-handler-error "patch" :params e (session-view-model view))))))
      ; Live navigation: switch this session to the live view registered at `path`
      ; WITHOUT a page reload — stop the old view's tickers, mount the target, start
      ; its tickers, and push a full render (the client swaps the live container and
      ; updates the URL). A path with no registered live view → tell the client to do
      ; a normal navigation (full load), the dead-view fallback.
      ("navigate"
        (let (path (get frame :path)
              entry (lookup-live path))
          (if (and entry (= (get entry :session) (session-view-session view)))
            ; same live-session group → run the target's on-mount-guard (against the Conn
            ; built once at connect time) before swapping the view over this socket. The
            ; whole check-and-swap is try-wrapped: a throwing guard (or spec-fn) has no
            ; sensible redirect target to fall back to (redirecting to the very path that
            ; just threw could loop), so it fails closed — the session ends — rather than
            ; crashing, matching how every other optional hook (handle-info/tick/unmount)
            ; is guarded against a user-code exception.
            (try
              (let (spec-fn (get entry :spec)
                    spec (spec-fn)
                    guard-result ((view-spec-mount-guard spec) (session-view-conn view)))
                (if guard-result
                  ; the target view vetoed — redirect there (full reload) instead of
                  ; swapping, and stay on the current view (mirrors the cross-group
                  ; fallback below)
                  (redirect-and-continue sock view buf guard-result)
                  (let (
                        ; let the OLD view clean up (pubsub/unsubscribe, presence/untrack, …)
                        ; before it's replaced — the session process lives on across a navigate,
                        ; so the monitor-based cleanup never fires for it. Runs here in the session
                        ; process, so (self) is the same pid that mount subscribed/tracked.
                        ;; Sweep the outgoing model's upload spools. `:model` is replaced a
                        ;; few lines down and the old one was the only thing holding an
                        ;; `entry-path`; the socket stays open, so `close-session` later
                        ;; sweeps the NEW model and finds nothing. `cleanup`'s own docstring
                        ;; names this case — "navigated away from" — and had no caller for it.
                        _spools (check-allow :discarded-catch
                                  (try
                                    (web/upload/cleanup (session-view-model view))
                                    (catch _ nil)))
                        _unmount (try
                                   ((view-spec-unmount (session-view-spec view)) (session-view-model view))
                                   (catch e (live-handler-error "unmount" :unmount e nil)))
                        _ (stop-tickers (session-view-ticker-pids view))
                        ; barrier the pubsub/presence registries so every broadcast queued before
                        ; the old view's unsubscribe (run in unmount above) has landed here, THEN
                        ; drop those stale out-of-band messages so none reaches the new view.
                        _sync (do (sync-registry :hatch-pubsub) (sync-registry :hatch-presence))
                        _drain (drain-oob)
                        ; free the old view's LiveComponent table and start the new view with a
                        ; fresh one: carrying it leaked every navigated-away view's component
                        ; state and let a same-id component in the new view silently reuse it.
                        _drop (check-allow :discarded-catch
                                (try (table/drop (session-view-components view)) (catch _ nil)))
                        ; bump the generation so a beat still queued from the OLD view's ticker
                        ; (killed just above, but a message already sent lingers) is dropped
                        ; rather than dispatched into the new view's handle-tick.
                        gen (+ 1 (session-view-generation view))
                        model ((view-spec-mount spec) params)
                        ; a fresh view over the same connection: the Conn carries across (same
                        ; socket, same session lifetime) and the component table starts empty
                        new-view (assoc (new-session-view spec
                                          spec-fn
                                          (get entry :session)
                                          params
                                          (session-view-conn view))
                                   :model model
                                   ; the target view is mounted here (its mount ran above), so
                                   ; out-of-band arms stay ungated after the swap
                                   :mounted? true
                                   :generation gen
                                   :ticker-pids (start-tickers (view-spec-ticks spec) gen)
                                   ; the idle watchdog is the socket's, not the view's
                                   :watchdog (session-view-watchdog view)))
                    (push-update sock new-view buf "render" model))))
              (catch _ (close-session sock view)))
            ; unknown path, OR a different live-session group → full reload, which
            ; re-enters the HTTP pipeline (and that group's auth). The socket can't
            ; cross the boundary on its own.
            (redirect-and-continue sock view buf path))))
      (_ (session-recv sock view buf)))))

; ---- session start ----

(defn start-session (sock request entry)
  "Run a live session for the registry `entry` (`{:spec :session}`) on a freshly-upgraded
  socket: build a read-only Conn from `request` (cookies parsed, so an `on-mount-guard` can
  read a session) and run the target spec's guard. A veto sends a redirect and closes the
  socket, never entering the session loop. Otherwise build the initial model from the request
  params and enter the per-connection event loop. The session remembers its `:session` group,
  so live navigation can refuse to cross into another group (forcing a full reload that re-runs
  that group's auth); the Conn is carried in `view` so live-navigate can re-run a guard too."
  (let (spec-fn (get entry :spec)
        params (get request :params {})
        spec (spec-fn)
        conn (build request)
        ; a throwing guard has no session yet to fail into and no sensible redirect
        ; target, so it fails closed — the raw socket is just closed, no session ever
        ; starts — rather than crashing, matching how every other optional hook
        ; (handle-info/tick/unmount) is guarded against a user-code exception
        guard-result (try ((view-spec-mount-guard spec) conn) (catch _ :hatch/guard-error)))
    (cond
      (= guard-result :hatch/guard-error)
        (check-allow :discarded-catch (try (tcp/close sock) (catch _ nil)))
      guard-result (redirect-and-close sock guard-result)
      ; Do NOT mount here: the paramless upgrade request (the WS URL carries no query string)
      ; would build the model with the wrong params, and the client's first frame — `join` —
      ; carries the real URL params and mounts anyway, so mounting here runs `mount` (and its
      ; side effects) twice. Enter the loop unmounted; the `join` arm mounts exactly once.
      else
      ;; the component table it starts with lives for the socket's lifetime and is reset on
      ;; a live-navigate — see `new-session-view`
        (let (view (new-session-view spec spec-fn (get entry :session) params conn))
          ; Bind the connection's Conn for the whole session — every hook the loop ever runs
          ; is inside this frame, so `(live-conn)` works in mount/render/handlers without
          ; widening any signature (see *live-conn* above). The loop recurses to itself
          ; inside the binding, so this is one frame for the socket's lifetime.
          ; the bytes-native frame parser reads a `bytes` buffer — start empty
          (binding (*live-conn* conn) (session-loop sock view (bytes [])))))))

; ---- live-route registry: path → live-spec thunk, for router-driven WS dispatch ----
; `(live path module)` in `defrouter` registers a view's spec thunk here at load; the
; server's single ws-handler (`live-dispatcher`) looks the path up per connection.
;
; The table is a GLOBAL, not a process, and that is load-bearing rather than a style call.
; Globals are shared across green processes, so a process bought nothing on that front —
; and it lost on two others. A process dies: this table used to be mirrored to a vault,
; monitored, re-pulled on restart and supervised, a Tier-3 apparatus that existed only to
; recover state that a global never loses. And a process does not survive a **startup
; image** (ADR-218): an imaged boot re-runs no module top-level, so `(live …)` never
; re-registered, while `live-ensure` happily spawned a fresh EMPTY registry — every live
; view answered its WebSocket upgrade by closing the socket, and the client sat in a
; reconnect loop showing `brood-disconnected`. The first run of a project worked and the
; second did not, which is the signature of state kept somewhere the image cannot follow.
; A global's value travels in the image with the module that defines it, so the routes an
; imaged boot restores are exactly the ones the imaged load registered.
;
; `defonce` (not `def`) so hot-reloading THIS module keeps the routes an app already
; registered; `%swap-registry!` because a plain `def` inside a function is not how a global
; is updated, and the kernel op is atomic against a concurrent registration.

(defonce *live-routes* {})

; The name `def` actually BINDS `*live-routes*` under — the loading module's namespace and,
; because hatch ships as a package, its prefix too: `hatch/web/live/*live-routes*`. The CAS
; below needs that exact symbol, and neither spelling a literal would give is it. A bare
; `*live-routes*` names a ROOT global that does not exist, so the compare-and-swap can never
; succeed and `%registry-swap!` retries forever — a hang, not an error. A hand-written
; `web/live/*live-routes*` misses the package prefix and quietly registers into a SECOND,
; unread global. `reflect/current-ns` is evaluated here, at load, where it is the module being
; loaded — the same trick `defonce` itself uses to find the binding its `bound?` must test.
(def- live-routes-global-name
  (symbol (str (->string (reflect/current-ns)) "/*live-routes*")))

(defn- live-await (nm tries)
  "Block until `nm` is registered (the supervisor starts children asynchronously), so the
  caller can rely on the registries being up. Gives up after `tries` × 5ms."
  (cond
    (proc/whereis nm) :ok
    (<= tries 0) :ok
    else (do (sleep 5) (live-await nm (- tries 1)))))

(defn start-live-registries ()
  "Start the live reload registry under a supervisor and block until it's up. Idempotent —
  reload-stable via the supervisor's `:name`, so a hot reload returns the existing one.
  Called once at module load by the `defonce`.

  The route table is deliberately NOT here: it is a global (`*live-routes*`), because a
  supervisor cannot carry load-time state across a startup image."
  (let (reload {:id :hatch-live
                :name :hatch-live
                :restart :permanent
                :start (fn () (spawn (live-registry-loop nil)))}
        sup (supervisor/start [reload] {:name :hatch-live-sup :strategy :one-for-one}))
    (live-await :hatch-live 60)
    sup))

; Start the supervised reload registry at module load, so it owns its name before any
; session registers. `defonce` + the supervisor `:name` make this safe under hot reload.
(defonce *live-registries* (start-live-registries))

(defn register-live (path spec-fn session)
  "Register live view `spec-fn` (a 0-arg spec thunk) for WebSocket dispatch at `path`,
  in live-session group `session` (any value; nil = the default group). Views in the
  same group can live-navigate between each other; crossing groups forces a full
  reload — the auth boundary. `(live path module …)` calls this at load; idempotent,
  so a hot reload just re-puts. Returns nil."
  (%registry-swap! live-routes-global-name
    (fn () *live-routes*)
    (fn (m) (assoc m path {:spec spec-fn :session session})))
  nil)

(defn lookup-live (path)
  "The registry entry `{:spec :session}` for `path`, or nil if no live view is there."
  (get *live-routes* path))

(defn- live-ws-path (req-path)
  "The app path a `/live/ws<path>` WebSocket URL targets. brood_live.js connects to
  `/live/ws` + the page's `data-live` path, so `/live/ws/counter` → `/counter`."
  (let (prefix "/live/ws")
    (if (string/starts-with? req-path prefix)
      (string/substring req-path (string/length prefix) (string/length req-path))
      req-path)))

(defn live-dispatcher ()
  "The server's single ws-handler: route each `/live/ws<path>` upgrade to the live view
  registered at `<path>` (via `(live path module)` in the router); close the socket on
  an unknown path. The CSWSH origin check runs a layer up, in http/server before the 101
  (see `http/websocket/origin-allowed?` and the `:check-origin` config), so every ws-handler
  is covered — this dispatcher doesn't repeat it. Wire it in the endpoint:
    (server/start port adapter (live/live-dispatcher))"
  (fn (sock request)
    (let (entry (lookup-live (live-ws-path (get request :path))))
      (if entry
        (start-session sock request entry)
        (tcp/close sock)))))

; ---- the LiveModule behaviour ----
; The contract a live-view module satisfies — exactly what `deflive` generates.
; A module that says `(:implements web/live/LiveModule)` is checked (at edit time, by
; the advisory type-checker) to define each of these at the right arity. Named
; LiveModule, not LiveView, to avoid colliding with Phoenix's `LiveView`.

(defbehaviour LiveModule
  "A live view: build a model from params, render it, and handle client events."
  (mount [params])
  (render [model &optional (live-components (table/new))])
  (handle-event [name params model]))

; ---- shared macro-time expansion, used by both deflive and deflive-component ----

(defn- deflive-clause (tag clauses)
  "The single clause in `clauses` headed by symbol `tag` (e.g. `'mount`), or nil — the
  singular clauses (`mount`/`render`/`template`/`handle-info`/`unmount`/`on-mount-guard`/
  `handle-params`), of which a deflive/deflive-component form has at most one each. A duplicate
  is a mistake (a second one would be silently ignored), so it's an error at macro-expansion."
  (let (matches (seq/filter clauses (fn (c) (= (first c) tag))))
    (if (> (count matches) 1)
      (error (str "deflive: duplicate `"
               (->string tag)
               "` clause — a view declares it at most once"))
      (first matches))))

(defn- deflive-clauses (tag clauses)
  "Every clause in `clauses` headed by symbol `tag` — the repeatable ones (`on`/`tick`),
  of which a deflive/deflive-component form can have several."
  (seq/filter clauses (fn (c) (= (first c) tag))))

(defn- deflive-render-expr (render-clause template-clause)
  "The macro-time render expression: an inline `(render …)` clause's body (`do`-wrapped
  if more than one form), or — failing that — a `(template \"file.bml\")` clause compiled
  to Hiccup here at expansion time. Shared by `deflive` and `deflive-component` so the
  inline-vs-template resolution lives in one place."
  (if render-clause
    (let (render-body (rest (rest render-clause)))
      (if (= (count render-body) 1) (first render-body) (cons 'do render-body)))
    (compile-template (first (rest template-clause)))))

(defn require-literal-interval (ms)
  "The tick interval, which must be a LITERAL number. Raises otherwise, and returns it when
  it is one.

  `handle-tick` dispatches on the interval with a `match`, and the arm is the interval exactly
  as written — so a bare symbol there does not match the beat, it BINDS it. Every tick fires
  the first clause whatever its interval, and a view with two tickers silently runs one of
  them twice; with the catch-all after it, the expansion is also an unreachable clause, which
  is what the compiler reports.

  The message that produced is `match: unreachable clause after a catch-all`, pointing at the
  `(deflive` form, with nothing connecting it to `(tick *every-two-seconds* …)` — which is a
  perfectly reasonable thing to write and the first thing someone reaches for on the second
  ticker. Named here so the error names the cause.

  (hatch/web/live/require-literal-interval 1000) ;=> 1000"
  (when (not (number? ms))
    (error "deflive: a (tick …) interval must be a literal number, got "
      (pr-str ms)
      " — the interval is matched against the beat, so a symbol there binds every tick "
      "instead of selecting this one"))
  ms)

(defn- deflive-handle-event-body (on-clauses)
  "The macro-time `handle-event` body: one `match` arm per `(on \"name\" (args…) …)`
  clause, keyed by the client's event name, falling through to an identity default (an
  unrecognized event name is a no-op, not an error). Shared by `deflive` and
  `deflive-component` — an `on` clause reads the same either way, just with a different
  second binding (`model` for a view, `state` for a component)."
  (let (event-arms (map on-clauses
                     (fn (c)
                       (let (ev-name (first (rest c))
                             args (first (rest (rest c)))
                             body (rest (rest (rest c))))
                         (list ev-name args body)))))
    (cons 'match
      (cons 'event-name
        (append (map event-arms
                  (fn (arm)
                    (let (ev-name (first arm)
                          args (first (rest arm))
                          body (first (rest (rest arm))))
                      (list ev-name
                        (list 'let
                          (list (first args)
                            'event-params
                            (first (rest args))
                            'event-model)
                          (cons 'do body))))))
          (list (list '_ 'event-model)))))))

; ---- deflive macro ----

(defmacro deflive (& clauses)
  "Define a live view in the current module.

  Expands to `mount`, `render`, `handle-event`, `handle-tick`, `live-ticks`, and the
  `live-spec` thunk. Wire it into the router with `(live path module)`, whose
  `live-dispatcher` routes WebSocket connections to this view by path.

  Multiple `(tick ms …)` clauses are allowed — each runs its own ticker at its own
  interval (use distinct ms values), so a view can update at several frequencies.

  The view's markup comes from either an inline `(render (model) …)` clause (Hiccup)
  or a `(template \"file.bml\")` clause — a sibling `.bml` file compiled to the same
  Hiccup here at expansion (its `{…}` interpolations see `model`). Give one or the
  other; an inline `render` wins if both are present.

  Syntax:
    (deflive
      (mount (params) initial-model)
      (render (model) hiccup-template)    ; — or —  (template \"view.bml\")
      (on \"event-name\" (params model) updated-model)
      (tick 1000 (model) updated-model)   ; optional: a beat every ms (repeatable)
      (handle-info (msg model) updated-model) ; optional: out-of-band messages
      (unmount (model) …)                     ; optional: cleanup on live-navigate away
      (handle-params (params model) updated-model) ; optional: live-patch (same view, new params)
      ...)

  Markup binds to `on` handlers with `:data-event` (plus `:data-params` for a JSON payload).
  A control may also carry `:data-disable-with`, which is Phoenix's `phx-disable-with`: from
  the click until the server's next patch lands, the control is disabled and shows that text.

      [:button {:data-event \"save\" :data-disable-with \"Saving…\"} \"Save\"]

  It costs nothing to skip, and skipping it means a round trip whose only feedback is
  nothing at all — where the usual result is a second click and a duplicate event. The client
  restores the control BEFORE morphing the patch in, so the server's HTML is diffed against
  what the app rendered rather than against the placeholder.

  An optional `(handle-params (params model) …)` clause runs on a live-patch —
  `web/live/send-update`'s sibling for the *view itself*: `brood_live.js`'s
  `session.patch(href)` updates the URL/history without a full reload or remount, the
  lightest possible update (Phoenix's `handle_params`, as opposed to a full `mount`). No
  ticker restart, no unmount/remount, `:model` carries over — only the new `params` are
  handed to this clause, which returns the updated model (it re-renders, like an event).
  Omit it and a patch leaves the model unchanged (the URL/history still updates
  client-side; the view just doesn't react to it).

  An optional `(handle-info (msg model) …)` clause handles out-of-band messages delivered
  to the session with `web/live/send-info` — PubSub/Presence broadcasts and timers. `msg`
  is the delivered payload; return the new model (it re-renders, like an event). Omit it and
  such messages are ignored.

  A handler (`on`/`tick`/`handle-info`) returns the next model — the declarative path. For
  imperative one-offs it can also call `web/live/push-navigate` (drive client navigation),
  `web/live/push-redirect` (force a full page load), or `web/live/push-event` (dispatch a
  `brood:event` CustomEvent for app JS) alongside returning its model — e.g. `(on \"save\"
  (params model) (do (web/live/push-navigate \"/thanks\") (save! model)))`. The effects are
  flushed to the client right after the model diff.

  An optional `(unmount (model) …)` clause runs (in the session process) when the session
  live-navigates away from this view, before the next view mounts — undo what `mount` did
  (`pubsub/unsubscribe`, `presence/untrack`, …). It's not needed for socket close: a dropped
  socket kills the session process and the registries clean up via their monitors; unmount
  covers the navigate-without-death case the monitors can't see.

  An optional `(on-mount-guard (conn) …)` clause runs before `mount`, both on the initial
  WebSocket connect and on every live-navigate into this view — `conn` is a read-only Conn
  built from the WS upgrade request (cookies parsed, so a plug like `web/session/fetch-session`
  can run against it: `((session/fetch-session (session/cookie-store secret {})) conn)`).
  Return `nil`/`false` to allow
  the mount; any other value (a path string) redirects the client there instead, via the same
  `{\"event\":\"redirect\"}` message live-navigation already sends for a cross-live-session jump
  — `brood_live.js` does a full page load, so the target path's own HTTP-side `through` plugs
  run again. Omit the clause and every view mounts unconditionally, as before."
  (let (mount-clause (deflive-clause 'mount clauses)
        render-clause (deflive-clause 'render clauses)
        template-clause (deflive-clause 'template clauses)
        on-clauses (deflive-clauses 'on clauses)
        tick-clauses (deflive-clauses 'tick clauses)
        info-clause (deflive-clause 'handle-info clauses)
        unmount-clause (deflive-clause 'unmount clauses)
        guard-clause (deflive-clause 'on-mount-guard clauses)
        params-clause (deflive-clause 'handle-params clauses)
        mount-args (first (rest mount-clause))
        mount-body (rest (rest mount-clause))
        render-args (first (rest render-clause))
        handle-body (deflive-handle-event-body on-clauses)
        ; One match arm per tick clause, keyed by its interval ms: `(MS (let (model
        ; tick-model) (do BODY)))`. handle-tick dispatches the fired ticker's ms.
        tick-arms (map tick-clauses
                    (fn (c)
                      (let (ms (require-literal-interval (first (rest c)))
                            msym (first (first (rest (rest c))))
                            body (rest (rest (rest c))))
                        (list ms
                          (list 'let
                            (list msym 'tick-model)
                            (cons 'do body))))))
        handle-tick-body (cons 'match
                           (cons 'tick-key
                             (append tick-arms (list (list '_ 'tick-model)))))
        ; render comes from an inline (render …) clause or, failing that, a
        ; (template "file.bml") clause compiled to Hiccup here at expansion time.
        ; If compiling the template throws (a missing file, or a BML syntax error),
        ; emit a render that re-raises that error when *called* rather than letting
        ; the macro throw — the latter would leave the whole `deflive` form
        ; unexpanded (an "unbound deflive" cascade in the advisory checker / LSP,
        ; which can't resolve the view's path). At real runtime the file compiles, so
        ; the error render is only reached on a genuine bad template, and loudly.
        ; The single render expression — the inline `(render …)` body or the compiled
        ; `.bml` form — computed once and reused for both the full `render` and the
        ; static/dynamic split below.
        render-expr (deflive-render-expr render-clause template-clause)
        render-dyn-args (if render-clause render-args (list 'model))
        ; Static/dynamic split for minimal-diff rendering (web/parts). On a malformed form
        ; the whole render falls back to one opaque dynamic — correct, just not granular.
        parts (try
                (web/parts/compile-parts render-expr)
                (catch _e
                  ; rewrite-components so a `(component …)` in the fallback render still compiles
                  ; to its render-slot call (same crash as an un-rewritten nested component)
                  {:statics ["" ""]
                   :dynamics (list (list 'web/template/render
                                     (web/parts/rewrite-components render-expr)))}))
        render-static-defn (list 'def 'render-static (get parts :statics))
        ; Both render and render-dynamic take one extra, optional, framework-internal arg
        ; beyond the user-facing render-dyn-args: the session's live component table (a
        ; `table`), which a `(component …)` hole (web/parts' component-form? case, or
        ; rewrite-components for a nested one) reads/writes via web/component/render-slot.
        ; Optional + defaulted so every existing view (no component holes) is unaffected —
        ; only component holes ever reference `live-components`.
        render-with-components-args (list (first render-dyn-args)
                                      '&optional
                                      (list web/parts/*component-table-param* (list 'table/new)))
        ; `render`'s contract is to return Hiccup (callers — web/test's live-render — wrap
        ; it in web/template/render themselves), so it can't just call render-dynamic
        ; (which returns an already-rendered *string*,
        ; and wrapping that in web/template/render again would double-escape it). Instead
        ; run render-expr through web/parts/rewrite-components: every `(component module
        ; assigns)` sub-form — direct child or nested inside `(if …)`/`(for …)` — becomes
        ; a `(web/template/raw (web/component/render-slot …))` call, itself a valid Hiccup
        ; node (a raw-escaped string), with a fresh, unshared component table each call —
        ; correct for a one-off render outside a live session (no persistence to offer).
        render-defn (list 'defn
                      'render
                      render-with-components-args
                      (web/parts/rewrite-components render-expr))
        render-dynamic-defn (list 'defn
                              'render-dynamic
                              render-with-components-args
                              (cons 'vector (get parts :dynamics)))
        ; Change tracking (Phoenix HEEx-style): a per-slot render fn plus, in parallel, the
        ; set of model keys each slot reads. `push-diff` re-renders only the slots whose
        ; dependencies changed and reuses the prior HTML for the rest — so a one-field update
        ; doesn't re-run every hole (or re-render a whole `:for` list). The model symbol is
        ; the render clause's first arg; if it isn't a plain symbol (e.g. a destructure), we
        ; can't track keys, so every slot is `:all` (always re-render) — correct, just not
        ; granular.
        model-sym (if (and (pair? render-dyn-args) (symbol? (first render-dyn-args)))
                    (first render-dyn-args)
                    nil)
        ; Each slot fn takes render-with-components-args, not the bare render-dyn-args: a
        ; slot compiled from a `(component …)` hole references `live-components` as a free
        ; variable (see web/parts' component-slot-form), so it must be bound as a parameter
        ; here too, exactly like render-dynamic itself.
        render-slots-defn (list 'def
                            'render-slots
                            (cons 'vector
                              (map (get parts :dynamics)
                                (fn (d) (list 'fn render-with-components-args d)))))
        slot-deps-defn (list 'def
                         'slot-deps
                         (apply vector
                           (map (get parts :dynamics)
                             (fn (d)
                               (if (nil? model-sym)
                                 :all (web/parts/form-deps d model-sym))))))
        ; Optional `(handle-info (msg model) …)` — runs when send-info delivers an
        ; out-of-band message (PubSub/Presence/timer). Absent → an identity handler, so a
        ; view that doesn't opt in just ignores such messages, keeping its model.
        handle-info-defn (if info-clause
                           (list 'defn
                             'handle-info
                             (first (rest info-clause))
                             (cons 'do (rest (rest info-clause))))
                           (list 'defn 'handle-info (list 'info-msg 'info-model) 'info-model))
        ; Optional `(unmount (model) …)` — runs (in the session process) when the session
        ; leaves this view via live-navigation, before the next view mounts. The place to
        ; undo what mount did: pubsub/unsubscribe, presence/untrack, a timer. On a dropped
        ; socket the session process dies and registries clean up via their monitors, so
        ; unmount is only needed for the navigate-without-death case. Absent → a no-op.
        unmount-defn (if unmount-clause
                       (list 'defn
                         'unmount
                         (first (rest unmount-clause))
                         (cons 'do (rest (rest unmount-clause))))
                       (list 'defn 'unmount (list 'unmount-model) nil))
        ; Optional `(on-mount-guard (conn) …)` — runs before mount (initial connect and every
        ; live-navigate into this view). Absent → a no-op guard that always allows the mount,
        ; so every existing view is unaffected.
        mount-guard-defn (if guard-clause
                           (list 'defn
                             'mount-guard
                             (first (rest guard-clause))
                             (cons 'do (rest (rest guard-clause))))
                           (list 'defn 'mount-guard (list 'guard-conn) nil))
        ; Optional `(handle-params (params model) …)` — runs on a live-patch (params/URL
        ; change on the *current* view, no remount — Phoenix's handle_params, the light
        ; sibling of a full mount). Absent → an identity handler, so a view that doesn't
        ; opt in just keeps its model unchanged on a patch.
        handle-params-defn (if params-clause
                             (list 'defn
                               'handle-params
                               (first (rest params-clause))
                               (cons 'do (rest (rest params-clause))))
                             (list 'defn
                               'handle-params
                               (list 'patch-params 'patch-model)
                               'patch-model)))
    (list 'do
      ; a (component …) hole in render-expr compiles to a call on web/component/render-slot
      ; (fully qualified — this module needn't :use web/component itself). No explicit
      ; require needed here: every view already (:use web/live) before calling deflive,
      ; and web/live now (:alias web/component) itself.
      (list 'defn 'mount mount-args (cons 'do mount-body))
      render-static-defn
      render-dynamic-defn
      render-slots-defn
      slot-deps-defn
      render-defn
      (list 'defn
        'handle-event
        (list 'event-name 'event-params 'event-model)
        handle-body)
      (list 'defn 'handle-tick (list 'tick-key 'tick-model) handle-tick-body)
      handle-info-defn
      unmount-defn
      mount-guard-defn
      handle-params-defn
      (list 'def 'live-ticks (apply vector (map tick-clauses (fn (c) (first (rest c))))))
      ; A 0-arg thunk that re-resolves the view's functions by name each call, so a
      ; session can pick up hot-reloaded code. The router's (live …) clause registers it.
      ;; Positional, in `view-spec`'s declared field order — change one and change the other.
      (list 'defn
        'live-spec
        (list)
        (list 'web/live/view-spec
          'mount 'render 'render-static 'render-dynamic 'render-slots 'slot-deps 'handle-event
          'handle-tick 'handle-info 'unmount 'mount-guard 'handle-params 'live-ticks))
      ; Sentinel: re-evaluated on every (re)load of this module (reload-defs re-runs
      ; top-level defs), so a save signals open sessions to re-render. No-op at first
      ; load (no registry yet).
      (list 'def 'live-reloaded (list 'web/live/notify-reload)))))

; ---- page chrome: helpers so apps don't copy-paste the live-view client wiring ----
; A live page needs three bits of boilerplate in its layout: the client <script>, the
; connection-status CSS, and the status pill. These helpers return that markup as
; Hiccup so a layout composes them instead of re-typing them.

(def *client-file* "brood_live.js")

;; Read once at load, and nil in a released binary — `nest release` bundles only .blsp, so
;; hatch's static/ is not there. The :static stage falls through to the app's own static dir
;; in that case; see `web/endpoint`. A per-request read would answer nil just the same.
(def *client-source* (static/bundled-source *client-file*))

(defn asset-path ()
  "Absolute path to hatch's bundled `static/brood_live.js`."
  (static/bundled-path *client-file*))

(defn client-js ()
  "The framework's brood_live.js source, or nil if it could not be located at load."
  *client-source*)

(defn client-js-handler ()
  "A conn handler that serves hatch's brood_live.js with the right content-type, so an
  app can serve the client straight from the package:
    (get \"/static/brood_live.js\" (live/client-js-handler))
  instead of copying the file into its own static/ dir."
  (static/bundled-js-handler *client-file* *client-source*))

(def *status-css*
  (str ".brood-status{position:fixed;top:.75rem;right:.75rem;z-index:9999;"
    "font:13px/1 sans-serif;background:#b91c1c;color:#fff;padding:.35rem .7rem;"
    "border-radius:999px;opacity:0;pointer-events:none;transition:opacity .2s ease;transition-delay:1s}"
    "html.brood-disconnected .brood-status{opacity:.95;transition-delay:1s}"
    "html.brood-connected .brood-status{opacity:0;transition-delay:0s}"))

(defn status-style ()
  "A `<style>` element with the connection-status CSS (put it in <head>)."
  [:style {} *status-css*])

(defn status-bar (&optional (label "● reconnecting…"))
  "The connection-status pill (put it in <body>); shown only while a live socket is
  down — brood_live.js toggles `brood-disconnected` on <html>, the CSS does the rest."
  [:div {:class "brood-status"} label])

(defn client-script (&optional (src "/static/brood_live.js"))
  "The `<script>` tag that loads the live-view client (put it in <head>)."
  [:script {:src src :defer true}])

(defn live-chrome (&optional (src "/static/brood_live.js"))
  "Everything a live page needs — the client `<script>`, the status CSS, and the
  status pill — as one list of Hiccup nodes. The router's `(live …)` clause drops this
  into its generated mount page, so only live pages carry the live-view wiring; a plain
  page's layout stays free of it."
  (list (status-style) (client-script src) (status-bar)))
