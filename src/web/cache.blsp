(defmodule web/cache
  "What a server keeps in memory between requests: memoised fragments (`fetch`, `fetch-ttl`),
  invalidated across a cluster, and the compressed bodies `web/endpoint` reuses. What a
  response tells the caches downstream of it — ETags, `Cache-Control`, `Vary` — is
  `web/http-cache`.

  **Across a cluster.** The stored copies (`fetch`, and the compressed bodies below) are
  per-node, deliberately — a cache lookup must never become a network call. What crosses the
  network is the INVALIDATION, which is small, rare and carries no data: `invalidate` and
  `clear` reach every connected peer, so a second machine cannot go on serving what the first
  has already replaced. Call `start-cluster` once at boot on every node; without it a node
  invalidates its own copy and hears nobody else\'s. Single-node apps are unaffected —
  `(node/list)` is empty and every cluster path is a no-op."
  ; ensure-supervised — the registered listener that applies peers' invalidations
  (:use web/registry)
  ; node/list — peers to replicate an invalidation to; empty when not distributed
  ; node/name — stamped into `stats` so a dashboard can say which machine answered
  (:alias node)
  ; remote-nodes — what a peer is, and whether there are any, is web/cluster's subject; all
  ; three cluster-aware modules had an identical copy of it
  (:alias web/cluster)
  ; difference — which peers have gone since the last poll
  (:use set)
  ; new-counters / bump-counter / counter-value / rate-percent — the shared tally vocabulary
  (:alias web/metrics)
  (:alias table))

;; ---- memoised fragments -----------------------------------------------------
;;
;; The other half of caching, and the one no amount of `Cache-Control` covers: work the
;; SERVER repeats. A validator makes a repeat visit cheap for the client, but the response
;; still has to be built to know its ETag — so a page whose content cannot change is
;; rebuilt, in full, for every request that asks for it.
;;
;; Measured on a hive page: rendering the shared layout chrome — nav, head, footer, byte for
;; byte identical on every page — was 2.18 ms of a 3.00 ms render. A changelog built from a
;; file baked into the image cost 290 ms per request, half parsing markdown and half
;; rendering hiccup, for output that had not changed since the image was built.
;;
;; Process-shared (Brood's `table`, the same store `web/static` memoises ETags in), so every
;; request worker sees one copy and a value is computed once per key for the life of the
;; process — not once per process.

(def- *fragments* (table/new))

;; `fetch` stores a value; `fetch-ttl` stores a value plus its deadline. They share one table,
;; so one key used with both is a real hazard, and it used to be a SILENT one: `fetch` on a
;; key `fetch-ttl` wrote answered the wrapper — so a page memoised one way and read the other
;; rendered `{:value "<div>…" :ttl-at 1757…}` into itself, correct-looking code producing
;; visible garbage with nothing raised.
;;
;; A record rather than a `{:ttl-at …}` map, for the reason `web/template/raw-node` is one: a
;; shape test can be satisfied by accident (a cached value that is itself a map with a
;; `:ttl-at` key), an identity cannot. And with the identity available, the collision can be
;; NAMED — see `expired-entry?` and the two guards below.
(defrecord ttl-entry (value deadline))

;; Captured from one sentinel at load, the way `web/template/raw-node-id` is, and for both of
;; its reasons. It is the id this record actually carries — which differs between hatch
;; standalone (`:web/cache/ttl-entry`) and hatch as a package (`:hatch/web/cache/…`), so a
;; hardcoded keyword would be false in exactly one of them. And it is captured ONCE: building
;; a throwaway record per check would put an allocation on `fetch`, which runs per fragment
;; per request.
(def- ttl-entry-id (record-id (ttl-entry nil 0)))

(defn- ttl-entry? (v)
  "True when `v` is one of `fetch-ttl`'s wrappers rather than a plain cached value."
  (and (record? v) (= (record-id v) ttl-entry-id)))

(defn- one-policy-per-key (key stored expected-ttl?)
  "Raise when `key` already holds an entry written by the OTHER of `fetch`/`fetch-ttl`.

  Two caching policies on one key is a bug in the caller, and the alternatives are worse
  than an error: served silently, the value is the wrong shape (a wrapper where a rendered
  string was expected); papered over, the TTL either applies to entries that never asked for
  one or is quietly dropped from entries that did."
  (when (not (= (ttl-entry? stored) expected-ttl?))
    (error "web/cache: key "
      (pr-str key)
      " is used with both fetch and fetch-ttl — "
      "one key, one caching policy"))
  nil)

(defn fetch (key build)
  "The cached value for `key`, computing it with `build` on the first ask.

  For output that is a pure function of something that cannot change while the process
  lives: a rendered layout, a page built from a file baked into the image, a static
  fragment. NOT for anything user-specific — one entry serves every request, so a value
  that varies per session or per user belongs nowhere near this.

  There is no expiry and no bound. That is deliberate for the intended use — a fixed set of
  keys, each computed once — and makes it the wrong tool for anything keyed by user input,
  which would grow without limit."
  (if (table/has? *fragments* key)
    (let (stored (table/get *fragments* key))
      (one-policy-per-key key stored false)
      (bump :hits)
      stored)
    (let (value (build))
      (bump :misses)
      (table/put *fragments* key value)
      value)))

(defn fetch-ttl (key ttl-ms build)
  "The cached value for `key`, recomputed once `ttl-ms` has passed since it was stored.

  The bounded-staleness sibling of [[fetch]], and the right tool for the case `fetch` is
  explicitly wrong for: output that is identical for every requester but DOES change —
  a listing of rows, a document built from the database. `fetch` has no expiry, so
  memoising such a document serves the first version of it for the life of the process
  unless something remembers to invalidate; the entry here simply ages out.

  Prefer this over `invalidate` when staleness is cheap and correctness-by-construction is
  not. An invalidation hook has to be added to every path that can change the value, and
  the failure mode of forgetting one is a document that is wrong indefinitely with nothing
  to notice it. A TTL is wrong for at most `ttl-ms`, always, no matter what changed or who
  forgot.

  Costs one `os/now` per hit. Pointing both this and `fetch` at ONE key is an error rather
  than a guess — see `one-policy-per-key`; it used to be a silent wrong-shape read.

  `invalidate` and `clear` still reach these entries, and still replicate to peers."
  (let (stored (if (table/has? *fragments* key) (table/get *fragments* key) nil)
        now (os/now))
    (when stored (one-policy-per-key key stored true))
    (if (and stored (< now (ttl-entry-deadline stored)))
      (do (bump :hits) (ttl-entry-value stored))
      (let (value (build))
        (bump :misses)
        (table/put *fragments* key (ttl-entry value (+ now ttl-ms)))
        value))))

;; Counters, so a dashboard can answer "is this cache doing anything?" — which is otherwise
;; unknowable: a cache that never hits and a cache that is never asked look identical from
;; the outside, and both look like a cache that is working.
(def- *counters* (web/metrics/new-counters))

(defn- bump (k) (web/metrics/bump-counter *counters* k))

(defn counter (k)
  "One cache counter (`:hits`, `:misses`), or 0."
  (web/metrics/counter-value *counters* k))

(defn stats ()
  "A snapshot of what the cache is holding and doing, for a dashboard or a probe.

  `:hit-rate` is nil rather than 0 when nothing has been asked yet — a cache with no traffic
  is not a cache performing badly, and showing 0% for it invites the wrong fix."
  (let (hits (counter :hits)
        misses (counter :misses)
        asked (+ hits misses))
    {:fragments (count (keys (table/snapshot *fragments*)))
     :compressed (count (compressed-entries))
     :max-compressed *max-compressed*
     :hits hits
     :misses misses
     :hit-rate (web/metrics/rate-percent hits asked)
     :node (check-allow :discarded-catch (try (node/name) (catch _e :nonode)))
     :peers (into [] (web/cluster/remote-nodes))
     :listening? (not (nil? (check-allow :discarded-catch
                              (try (proc/whereis :hatch-cache) (catch _e nil)))))}))

(defn- local-invalidate (key)
  "Drop one cached fragment on THIS node only — the half a peer's message applies."
  (table/delete *fragments* key))

(defn- local-clear ()
  "Drop every cached fragment on THIS node only."
  (dolist (key (keys (table/snapshot *fragments*)))
    (table/delete *fragments* key)))

(defn invalidate (key)
  "Drop one cached fragment, so the next `fetch` rebuilds it — on every node in the cluster.

  A cache is per-node, so on a second machine the same key is still cached and still being
  served. Invalidating locally and stopping there is how one machine starts answering with
  content the other has already replaced, indefinitely and silently."
  (local-invalidate key)
  (replicate [:invalidate key]))

(defn clear ()
  "Drop every cached fragment — for tests, for a dev reload that changed a template, and
  cluster-wide for the same reason as `invalidate`."
  (local-clear)
  (replicate [:clear]))

;; ---- cluster ----------------------------------------------------------------
;;
;; The cache is node-local by nature and that is the point: a lookup must not become a network
;; call. What has to cross the network is the INVALIDATION, which is small, rare, and carries
;; no data — so each node keeps its own copy and hears when a copy has gone stale.
;;
;; This is the shape `web/pubsub` already uses for its cross-node fan-out, deliberately: one
;; mechanism in the framework rather than two, addressed by registered name on each peer and
;; best-effort per peer, so a link that just dropped is skipped instead of failing the write.

(defn- replicate (msg)
  "Send `msg` to every peer's cache listener — once each, and never re-sent by the receiver,
  so there are no loops and a write costs O(peers) messages. Best-effort: a peer not running
  the listener, or a link that just dropped, is skipped rather than failing the invalidation."
  (dolist (n (web/cluster/remote-nodes))
    (check-allow :discarded-catch
      (try (send {:name :hatch-cache :node n} msg) (catch _e nil)))))

; How often the listener re-reads `(node/list)`. The kernel has no `[:nodeup]` —
; `monitor-node` fires only `[:nodedown]` — so a peer's RETURN can only be noticed by looking,
; which is what std/telemetry does for the same reason.
(def *cluster-poll-ms* 5000)

(defn- cache-listener (peers)
  "Apply invalidations arriving from peers, and watch for a peer coming back.

  A peer we could not see is a peer whose invalidations we did not receive, so when one
  reappears this node's cache may be stale in ways it cannot enumerate. Dropping the whole
  cache is the only honest response: it is cheap (everything rebuilds on demand) and the
  alternative is serving content we have positive reason to doubt."
  (receive
    ([:invalidate key] (do (local-invalidate key) (cache-listener peers)))
    ([:clear] (do (local-clear) (cache-listener peers)))
    (_ (cache-listener peers))
    (after *cluster-poll-ms*
      (let (now (into #{} (web/cluster/remote-nodes))
            returned (difference now peers))
        (when (not (empty? returned)) (local-clear))
        (cache-listener now)))))

(defn start-cluster ()
  "Make this node apply cache invalidations broadcast by its peers. Call it once at boot, from
  the app's entry point, on every node.

  Explicit rather than lazy, and that is the whole design: a node that only READS never
  invalidates anything, so a listener started on first invalidation would never start on
  exactly the node that most needs to hear about one. Idempotent, and harmless on a
  single-node app — the listener simply never receives.

  Returns the listener pid."
  (ensure-supervised :hatch-cache-sup
    [{:id :hatch-cache
      :name :hatch-cache
      :restart :permanent
      :start (fn () (spawn (cache-listener (into #{} (web/cluster/remote-nodes)))))}]
    :hatch-cache))

;; ---- compressed representations ---------------------------------------------

(def- *compressed* (table/new))

;; Bounded, and this one is not a formality. A key here is derived from the RESPONSE BODY,
;; and a body can vary with request input — a "no such version" page naming the version
;; someone asked for produces a distinct body per distinct query string. An unbounded store
;; keyed by that is a leak a stranger drives. At the cap the whole store is dropped rather
;; than evicted one by one: entries are large and equally valuable, the pages that matter are
;; re-cached on their next request, and the alternative is tracking recency for no benefit.
(def *max-compressed* 64)

(defn compressed (key build)
  "The compressed body for `key`, computing it with `build` on the first ask.

  Key it by something that identifies the exact bytes AND the coding — an ETag plus `\"br\"`
  is exactly that, which is why `conditional` runs first. Compressing a 437 KB page measured
  8.8ms against 0.45ms to hash it, and for a page whose content cannot change between
  requests that work is repeated verbatim every time.

  Do not use this for a response that varies per user: one entry serves everyone."
  (cond
    (table/has? *compressed* key) (table/get *compressed* key)
    else
      (let (value (build))
        (when (>= (table/count *compressed*) *max-compressed*)
          (clear-compressed))
        (table/put *compressed* key value)
        value)))

(defn compressed-entries ()
  "The compressed store as a map — for tests asserting the bound holds."
  (table/snapshot *compressed*))

(defn clear-compressed ()
  "Drop every cached compressed body."
  (dolist (key (keys (table/snapshot *compressed*))) (table/delete *compressed* key))
  nil)
