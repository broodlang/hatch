(defmodule main
  "Entry point for {{name}}."
  (:use web/server :only [serve])
  (:use web/application :only [start default-logger-opts])
  (:alias db)
  (:alias pg))

(defn main ()
  "Start logging, open the DB pool, boot the endpoint, and park."
  (start {:logger (default-logger-opts)
          :children [(fn () (db/start (pg/opts "{{name}}")))
                      (fn () (serve))]}))
