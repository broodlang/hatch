(defmodule http-server-test
  ; server/start, server/stop
  (:alias http/server)
  ; parse-frame, byte->char
  (:use http/websocket)
  (:use test))

; Regression test for the WebSocket binary-mode race.
;
; The bug: `http/server`'s upgrade path sent the 101 and handed off to the ws-handler
; while the socket was still in *text* mode. The ws-handler (a live session) only
; flipped the socket to binary AFTER a registry lookup — so a client frame that arrived
; in that window was decoded UTF-8-lossy, turning every non-UTF-8 frame byte (0x81, the
; mask, the masked payload) into U+FFFD (codepoint 65533). `parse-frame` then read
; garbage lengths and looped on `:incomplete` forever, and the session went deaf.
;
; The fix: set the socket to binary BEFORE sending the 101 (the client can't send a
; frame until it sees the 101). This test pins that invariant: the ws-handler below
; deliberately does NOT call `tcp/set-binary` itself, so a frame with a high byte is
; delivered byte-faithfully ONLY because the upgrade path already switched to binary.
; Revert the fix and `read-one-frame` sees U+FFFD → `:incomplete` → times out.

(defn carrier->bytes (carrier)
  "A byte-string carrier (one codepoint 0-255 per byte) → a `bytes` value, so a client frame
  reaches the wire intact. tcp/send UTF-8-encodes a string leaf (ADR-141), which would mangle
  every byte >= 0x80 (the 0x81 header, the mask, a high payload byte); a `bytes` value is sent
  verbatim — the same reason the server builds its frames as `bytes`."
  (bytes (map char->int (string/->list carrier))))

(defn read-one-frame (sock buf)
  "Block until one complete WebSocket frame is buffered; return its decoded payload,
  or :timeout / :closed. Mirrors the live session's read loop, minus the dispatch."
  (match (parse-frame buf)
    ([:ok _opcode payload _rem] payload)
    ([:incomplete]
      (receive
        ; binary-mode socket: `chunk` is a `bytes` value — the parser is bytes-native
        ([:tcp ^sock chunk] (read-one-frame sock (bytes-concat buf chunk)))
        ([:tcp-closed ^sock] :closed)
        (after 2000 :timeout)))
    ([:error _m] :error)))

(defn echo-one-frame (reporter)
  "A ws-handler that reads one client frame and reports its `bytes` payload to `reporter`.
  Crucially it never calls tcp/set-binary — the upgrade path must have done so."
  (fn (sock _request)
    (send reporter [:got (read-one-frame sock (bytes []))])))

(defn await-101 (sock buf)
  "Read from `sock` until the 101 handshake response (its header terminator) arrives."
  (if (includes? buf "\r\n\r\n")
    buf
    (receive
      ([:tcp ^sock chunk] (await-101 sock (str buf chunk)))
      (after 2000 :timeout))))

(defn ws-client-connect (port)
  "Open a raw client socket, send a WebSocket upgrade request, wait for the 101, then
  switch the client side to binary so it can send raw frame bytes. Returns the socket."
  (let (sock (tcp/connect "127.0.0.1" port)
        _req (tcp/send sock
               (str "GET /ws HTTP/1.1\r\n"
                 "Host: localhost\r\n" "Upgrade: websocket\r\n" "Connection: Upgrade\r\n"
                 "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n"
                 "Sec-WebSocket-Version: 13\r\n\r\n"))
        _ack (await-101 sock ""))
    (tcp/set-binary sock true)
    sock))

(defn masked-byte-frame (b)
  "A single-byte-payload masked client text frame carrying byte `b` (mask key all
  zeros, so the masked payload byte equals `b`): 0x81, 0x80|1, 00 00 00 00, b."
  (str (byte->char 129)
    (byte->char 129)
    (byte->char 0)
    (byte->char 0)
    (byte->char 0)
    (byte->char 0)
    (byte->char b)))

(describe "websocket upgrade sets binary mode before the handler reads"
  ; One server, started and stopped within the test. Fixed obscure port; the handler
  ; reports the decoded payload back to this (the test) process.
  (test "a client frame's high byte arrives byte-faithful (not U+FFFD)"
    (let (me (self)
          port 24731
          _sup (server/start port
                 (fn (_req) {:status 200 :headers {} :body "ok"})
                 (echo-one-frame me))
          client (ws-client-connect port)
          _send (tcp/send client (carrier->bytes (masked-byte-frame 255)))
          payload (receive ([:got p] p) (after 3000 :timeout)))
      (tcp/close client)
      (server/stop port)
      ; Before the fix: payload would be :timeout (frame read as U+FFFD → :incomplete).
      ; The bytes-native parser returns the payload as a `bytes` value, byte 0xFF intact.
      (assert= (bytes? payload) true)
      (assert= (count payload) 1)
      (assert= (byte-at payload 0) 255))))

(defn drain (sock buf)
  "Collect everything `sock` sends until it goes idle (keep-alive leaves it open), so a
  test can assert on the whole response — headers and body."
  (receive
    ([:tcp ^sock chunk] (drain sock (str buf chunk)))
    ([:tcp-closed ^sock] buf)
    (after 400 buf)))

(defn get-response (port path)
  "Open a client, send one GET (Connection: close, so the worker closes + exits once it
  has answered), and return the full raw response string."
  (let (sock (tcp/connect "127.0.0.1" port)
        _req (tcp/send sock
               (str "GET " path " HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"))
        resp (drain sock ""))
    (tcp/close sock)
    resp))

(defn report-response (port me)
  "Run `get-response` in this (spawned) process and report the result to `me` — lets a
  test fire a request, then act (e.g. call `stop`) while it's in flight."
  (send me [:resp (get-response port "/")]))

(defn raw-response (port raw)
  "Send an arbitrary (possibly malformed) request string and return the full raw response."
  (let (sock (tcp/connect "127.0.0.1" port)
        _req (tcp/send sock raw)
        resp (drain sock ""))
    (tcp/close sock)
    resp))

; Tier-2 (docs/robustness.md): a handler that raises must answer a generic 500 without
; leaking internals; the detail is left to telemetry / the :error-handler knob.
(describe "a raising handler doesn't leak internals (default :error-handler)"
  (test "answers a generic 500 with the exception text NOT in the body"
    (let (port 24741
          _sup (server/start port (fn (_req) (error "SECRET-internal-detail")))
          resp (get-response port "/"))
      (server/stop port)
      (assert= (includes? resp "500") true)
      (assert= (includes? resp "SECRET-internal-detail") false))))

(describe "a custom :error-handler overrides the 500 response"
  (test "the configured handler's response is sent"
    (let (port 24742
          _sup (server/start port
                 (fn (_req) (error "boom"))
                 nil
                 {:error-handler (fn (_req _err) {:status 503 :headers {} :body "maintenance"})})
          resp (get-response port "/"))
      (server/stop port)
      (assert= (includes? resp "503") true)
      (assert= (includes? resp "maintenance") true))))

; A malformed request must answer a generic 400 without echoing the (attacker-controlled)
; request line back into the body.
(describe "a malformed request doesn't reflect attacker bytes"
  (test "answers a generic 400 with the request line NOT in the body"
    (let (port 24743
          _sup (server/start port (fn (_req) {:status 200 :headers {} :body "ok"}))
          resp (raw-response port "ZZ-REFLECT-TOKEN\r\nConnection: close\r\n\r\n"))
      (server/stop port)
      (assert= (includes? resp "400") true)
      (assert= (includes? resp "ZZ-REFLECT-TOKEN") false))))

; RFC 7231 §5.1.1: a client that sends `Expect: 100-continue` withholds the body until it
; gets an interim 100 — without which it stalls until the read timeout answers 408.
(describe "Expect: 100-continue"
  (test "server sends an interim 100 before the body, then the final response"
    (let (port 24748
          _sup (server/start port
                 ; the bytes-native parser gives a raw handler the body as `bytes`; decode it
                 (fn (req)
                   {:status 200
                    :headers {}
                    :body (str "body="
                            (utf8-bytes->string (get req :body)))}))
          sock (tcp/connect "127.0.0.1" port)
          ; send only the head (with Expect + Content-Length) — the body is withheld
          _h (tcp/send sock
               (str "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n"
                 "Expect: 100-continue\r\nConnection: close\r\n\r\n"))
          interim (drain sock "")
          _b (tcp/send sock "hello")
          final (drain sock ""))
      (tcp/close sock)
      (server/stop port)
      (assert= (includes? interim "HTTP/1.1 100 Continue") true)
      (assert= (includes? final "body=hello") true))))

; Tier-2 (docs/robustness.md): graceful shutdown drains in-flight connections.
(defn slow-handler (reporter ms)
  "A handler that reports it has STARTED, then takes `ms` to finish. The report is what makes
  the graceful-stop tests deterministic: `stop` must be called while a request is genuinely
  in flight, and sleeping a guessed interval to `hope` the worker got there loses that race on
  a loaded machine (the worker may not exist yet, so there is nothing to drain)."
  (fn (_req)
    (send reporter [:handler-started])
    (sleep ms)
    {:status 200 :headers {} :body "done"}))

(describe "graceful stop lets an in-flight request finish"
  (test "a request already running when stop is called still gets its response"
    (let (me (self)
          port 24834
          _sup (server/start port (slow-handler me 200))
          _c (spawn (report-response port me))
          ; wait for the handler to actually be running — not a guessed interval
          _started (receive ([:handler-started] :ok) (after 5000 :timeout))
          ; drains: blocks until the in-flight worker finishes
          _stop (server/stop port)
          resp (receive ([:resp r] r) (after 3000 :timeout)))
      ; the slow handler ran to completion despite stop being called mid-flight
      (assert= (includes? resp "done") true))))

(describe "graceful stop kills a straggler past :shutdown-grace-ms"
  (test "a request still running after the grace window is cut off"
    (let (me (self)
          port 24744
          _sup (server/start port (slow-handler me 1000) nil {:shutdown-grace-ms 100})
          _c (spawn (report-response port me))
          ; wait for the handler to actually be running — not a guessed interval
          _started (receive ([:handler-started] :ok) (after 5000 :timeout))
          ; grace 100ms < 1000ms handler → worker killed
          _stop (server/stop port)
          resp (receive ([:resp r] r) (after 3000 :timeout)))
      (assert= (includes? resp "done") false))))

; A masked client frame (zero mask key → payload bytes unchanged); fin 0/1, payload ≤125.
(defn ws-frame (fin opcode payload)
  (str (byte->char (+ (* fin 128) opcode))
    (byte->char (+ 128 (string/length payload)))
    "\x00\x00\x00\x00"
    payload))

; Tier-2 end-to-end: a fragmented client message is reassembled across the real socket.
; Before reassembly, the server read loop saw only the first fragment ("Hel") and dropped
; the continuations; now the ws-handler receives the whole message as one payload.
(describe "websocket reassembles a fragmented message end-to-end"
  (test "three frames (FIN=0 text, FIN=0 cont, FIN=1 cont) arrive as one payload"
    (let (me (self)
          port 24751
          _sup (server/start port
                 (fn (_req) {:status 200 :headers {} :body "ok"})
                 (echo-one-frame me))
          client (ws-client-connect port)
          _send (tcp/send client
                  (carrier->bytes (str (ws-frame 0 1 "Hel")
                                    (ws-frame 0 0 "lo ")
                                    (ws-frame 1 0 "world"))))
          payload (receive ([:got p] p) (after 3000 :timeout)))
      (tcp/close client)
      (server/stop port)
      (assert= (utf8-bytes->string payload) "Hello world"))))

; Tier-3 (docs/robustness.md): server-side TLS. A full handshake needs a verification-
; skipping client (the runtime's tls/request validates against real roots), so the
; end-to-end handshake is verified out-of-band with `curl -k`; here we smoke-test that
; the TLS bind path (tls/self-signed → :tls config → tls/listen) starts and stops cleanly.
(describe "server/start serves TLS with a self-signed cert"
  (test "a :tls config binds (tls/listen) and stops without error"
    (let ([cert key] (tls/self-signed "localhost")
          port 24761
          sup (server/start port
                (fn (_req) {:status 200 :headers {} :body "ok"})
                nil
                {:tls {:cert cert :key key}}))
      (sleep 100)
      (server/stop port)
      (assert= (nil? sup) false))))

; Phase 11 — per-connection workers run under a dynamic supervisor (observable via
; `nest observe` / whereis), as :temporary children (a dead socket can't resume, so never
; restarted). The listener's own monitor still drives drain + the max-connections cap.

(defn wait-unregistered (nm tries)
  "Poll until `nm` is no longer registered — true if it went away within `tries` x 10ms."
  (cond
    (nil? (whereis nm)) true
    (<= tries 0) false
    else (do (sleep 10) (wait-unregistered nm (- tries 1)))))

(describe "connection workers are supervised and observable"
  (test "a live keep-alive connection shows up as a supervised worker"
    (let (port 24771
          _ (server/start port (fn (_r) {:status 200 :headers {} :body "ok"}))
          ; open a keep-alive connection, read the response, leave the socket OPEN so the
          ; worker is still alive (looping for the next request) when we introspect
          sock (tcp/connect "127.0.0.1" port)
          _ (tcp/send sock "GET / HTTP/1.1\r\nHost: localhost\r\n\r\n")
          _resp (drain sock "")
          sup (whereis (server/worker-supervisor-name port))
          n (supervisor/count-children sup))
      (tcp/close sock)
      (server/stop port)
      (assert= (pid? sup) true)
      (assert= (>= n 1) true)))
  (test "the worker supervisor is torn down when the server stops"
    (let (port 24772
          _ (server/start port (fn (_r) {:status 200 :headers {} :body "ok"}))
          up? (pid? (whereis (server/worker-supervisor-name port)))
          _ (server/stop port)
          ; POLL rather than sleeping a fixed 50ms: the teardown is async w.r.t. `stop`, so a
          ; fixed wait is a race that loses every ~15th run on a loaded machine (observed).
          ; Same shape as web_pubsub_test's wait-gone.
          down? (wait-unregistered (server/worker-supervisor-name port) 100))
      (assert= up? true)
      (assert= down? true))))

; Slow-loris drip: :read-timeout-ms re-arms on every byte, so a client dribbling one byte per
; (timeout-1)s never trips it. :head-timeout-ms caps the TOTAL time the head may take. Here the
; idle timeout is a comfortable 5s while the head deadline is 250ms, and the client sends a
; partial head then one more byte mid-window (resetting the idle timer but not the deadline) —
; the deadline still fires 408.
(describe "head-timeout bounds a dribbled request head"
  (test "a head that never completes is cut off with 408 at the total deadline"
    (let (port 24781
          _ (server/start port
              (fn (_r) {:status 200 :headers {} :body "ok"})
              nil
              {:head-timeout-ms 250 :read-timeout-ms 5000})
          sock (tcp/connect "127.0.0.1" port)
          _ (tcp/send sock "GET / HTTP/1.1\r\nHost: localhost\r\n")
          _ (sleep 150)
          ; Best-effort: the point of this byte is to reset the IDLE timer mid-window and show
          ; the deadline fires anyway. On a loaded machine the 150ms sleep can overshoot the
          ; 250ms deadline, in which case the socket is already closed and this send would
          ; raise — failing a test whose assertion (a 408) the server has in fact satisfied.
          _ (try (tcp/send sock "X: y\r\n") (catch _e nil))
          resp (drain sock ""))
      (tcp/close sock)
      (server/stop port)
      (assert= (includes? resp "408") true))))

; The same drip defense for the request BODY: :body-timeout-ms caps the total time the body may
; take once the head is in. Idle timeout a comfortable 5s, body deadline 250ms; the client sends
; a complete head declaring Content-Length: 10 with only part of the body, then dribbles one more
; byte mid-window (resetting the idle timer, not the deadline) — the deadline still fires 408.
(describe "body-timeout bounds a dribbled request body"
  (test "a body that never completes is cut off with 408 at the total deadline"
    (let (port 24782
          _ (server/start port
              (fn (_r) {:status 200 :headers {} :body "ok"})
              nil
              {:body-timeout-ms 250 :read-timeout-ms 5000})
          sock (tcp/connect "127.0.0.1" port)
          _ (tcp/send sock "POST / HTTP/1.1\r\nHost: localhost\r\nContent-Length: 10\r\n\r\nAB")
          _ (sleep 150)
          ; best-effort, same reason as the head-timeout case above
          _ (try (tcp/send sock "C") (catch _e nil))
          resp (drain sock ""))
      (tcp/close sock)
      (server/stop port)
      (assert= (includes? resp "408") true))))
