(defmodule http-websocket-test (:use http/websocket) (:use test))

(describe "accept-key"
  (test "rfc6455 test vector"
    (assert= (accept-key "dGhlIHNhbXBsZSBub25jZQ==")
      "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=")))

(describe "upgrade-response"
  (test "starts with 101"
    (let (r (upgrade-response "dGhlIHNhbXBsZSBub25jZQ=="))
      (assert= (starts-with? r "HTTP/1.1 101") true)))
  (test "contains Upgrade header"
    (let (r (upgrade-response "dGhlIHNhbXBsZSBub25jZQ=="))
      (assert= (includes? r "Upgrade: websocket") true)))
  (test "contains Accept header"
    (let (r (upgrade-response "dGhlIHNhbXBsZSBub25jZQ=="))
      (assert= (includes? r "Sec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=") true))))

(describe "upgrade-request?"
  (test "detects upgrade"
    (let (req {:headers {:connection "Upgrade" :upgrade "websocket"}})
      (assert= (upgrade-request? req) true)))
  (test "normal request is not upgrade"
    (let (req {:headers {:connection "keep-alive" :upgrade ""}})
      (assert= (upgrade-request? req) false)))
  (test "case insensitive"
    (let (req {:headers {:connection "upgrade" :upgrade "WebSocket"}})
      (assert= (upgrade-request? req) true))))

(describe "byte->char / byte-at"
  (test "round-trip 0"
    (assert= (byte-at (byte->char 0) 0) 0))
  (test "round-trip 65"
    (assert= (byte-at (byte->char 65) 0) 65))
  (test "round-trip 128"
    (assert= (byte-at (byte->char 128) 0) 128))
  (test "round-trip 255"
    (assert= (byte-at (byte->char 255) 0) 255)))

; lo byte: 300 mod 256 = 44
(describe "text-frame"
  (test "small frame first byte is 0x81"
    (assert= (byte-at (text-frame "hello") 0) 129))
  (test "small frame second byte is payload length"
    (assert= (byte-at (text-frame "hello") 1) 5))
  (test "text-frame returns a bytes value (sent verbatim by tcp-send, not re-encoded)"
    (assert= (bytes? (text-frame "hello")) true))
  (test "small frame payload"
    (assert= (utf8-bytes->string (bytes (drop 2 (bytes->list (text-frame "hello"))))) "hello"))
  (test "empty payload"
    (assert= (count (text-frame "")) 2))
  (test "125-byte max small frame"
    (let (payload (string-repeat "x" 125))
      (assert= (byte-at (text-frame payload) 1) 125)))
  (test "medium frame second byte is 0x7e"
    (let (payload (string-repeat "x" 200))
      (assert= (byte-at (text-frame payload) 1) 126)))
  (test "medium frame length bytes"
    (let (payload (string-repeat "x" 300))
      ; hi byte: 300 / 256 = 1
      (assert= (* (byte-at (text-frame payload) 2) 256)
        (* 1 256))
      (assert= (byte-at (text-frame payload) 3) 44))))
(describe "text-frame: multibyte uses UTF-8 byte length, not codepoint count"
  (test "− (U+2212) contributes 3 bytes to the length field"
    (assert= (byte-at (text-frame "−") 1) 3))
  ; 0x92
  (test "payload bytes are the UTF-8 encoding of −"
    (let (f (text-frame "−"))
      ; 0xE2
      (assert= (byte-at f 2) 226)
      ; 0x88
      (assert= (byte-at f 3) 136)
      (assert= (byte-at f 4) 146)))
  (test "utf8-byte-string then byte-string->utf8 round-trips multibyte text"
    (assert= (byte-string->utf8 (utf8-byte-string "café − ✓")) "café − ✓"))
  ; Regression: the frame's payload must be single-UTF-8-encoded (each multibyte char
  ; appearing exactly once). A byte-string frame would be re-encoded by tcp-send (ADR-141),
  ; doubling every byte >= 0x80 and mis-sizing the length field — this asserts it doesn't.
  (test "frame payload decodes back to the original multibyte text, length in bytes"
    (let (text "café − ✓"
          f (text-frame text)
          expected (count (string->utf8-bytes text)))
      (assert= (byte-at f 1) expected)
      (assert= (utf8-bytes->string (bytes (drop 2 (bytes->list f)))) text))))

; The inbound parser is bytes-native (ADR-141): frames are `bytes` and a parsed payload/rem
; are `bytes`. `cframe`/`masked-frame` build `bytes`; payload assertions decode via
; utf8-bytes->string.
(describe "parse-frame: masked client frames"
  (test "incomplete on empty"
    (assert= (parse-frame (bytes [])) [:incomplete]))
  (test "incomplete on 1 byte"
    (assert= (parse-frame (bytes [129])) [:incomplete]))
  (test "parses a small masked text frame"
    (let (frame (cframe 1 1 "hello")
          [tag opcode payload rem] (parse-frame frame))
      (assert= tag :ok)
      (assert= opcode 1)
      (assert= (utf8-bytes->string payload) "hello")
      (assert= (count rem) 0)))
  (test "remainder extracted correctly"
    (let (frame (bytes-concat (cframe 1 1 "abc") (cframe 1 1 "def"))
          [_ _ _ rem] (parse-frame frame))
      (assert= rem (cframe 1 1 "def")))))

(describe "parse-frame: RFC 6455 framing is enforced"
  (test "an unmasked client frame is rejected (MUST)"
    ; 0x81 text, len 5, "hello" — no mask bit
    (assert= (first (parse-frame (bytes-concat (bytes [129 5]) (string->utf8-bytes "hello")))) :error))
  (test "a set RSV bit is rejected"
    ; 0xC1 = FIN + RSV1 + text; byte1 0x80 = masked, len 0
    (assert= (first (parse-frame (bytes [193 128 0 0 0 0]))) :error))
  (test "a reserved opcode is rejected"
    ; 0x83 = FIN + opcode 3 (reserved); masked, len 0
    (assert= (first (parse-frame (bytes [131 128 0 0 0 0]))) :error))
  (test "a fragmented control frame (FIN=0 ping) is rejected"
    ; 0x09 = ping with FIN=0; masked, len 0
    (assert= (first (parse-frame (bytes [9 128 0 0 0 0]))) :error)))

; Audit #4 — a payload >64 KB must produce a valid 64-bit-length frame, not raise and
; crash the live session.
(describe "text-frame: 64-bit length for payloads > 64 KB"
  (test "uses the 0x7f marker + 8-byte big-endian length"
    (let (payload (string-repeat "x" 70000)
          f (text-frame payload))
      ; 0x81 FIN+text, 0x7f extended-64 marker
      (assert= (byte-at f 0) 129)
      (assert= (byte-at f 1) 127)
      ; 70000 = 0x0000000000011170, big-endian over bytes 2..9
      (assert= (byte-at f 2) 0)
      (assert= (byte-at f 6) 0)
      (assert= (byte-at f 7) 1)
      (assert= (byte-at f 8) 17)
      (assert= (byte-at f 9) 112)
      ; 2 header + 8 length + 70000 payload
      (assert= (count f) 70010))))

; Audit #5 — control-frame limits.
(describe "parse-frame: control-frame limits"
  (test "rejects an oversized control frame (ping with extended length)"
    ; 0x89 = FIN+ping(9); 0xFE = masked|126 (extended length) → protocol violation
    (assert= (first (parse-frame (bytes [137 254]))) :error))
  (test "accepts a normal small ping"
    ; 0x89 ping, 0x80|2 masked len 2, mask 0000, payload 2 bytes
    (let (frame (bytes [137 130 0 0 0 0 1 2])
          [tag op _ _] (parse-frame frame))
      (assert= tag :ok)
      (assert= op 9))))

(describe "pong-frame: control-frame size cap"
  (test "truncates a payload over 125 bytes"
    (let (f (pong-frame (string-repeat "x" 200)))
      (assert= (byte-at f 1) 125)
      (assert= (count f) 127)))
  (test "small payload echoed verbatim"
    ; 0x8a pong, 0x02 len, "hi" = 104 105
    (assert= (pong-frame "hi") (bytes [138 2 104 105]))))

; A masked client frame as `bytes`, zero mask key (so payload bytes pass through unchanged);
; `payload` must be <= 125 bytes so the 7-bit length form applies. `fin` is 0 or 1.
(defn cframe (fin opcode payload)
  (let (pb (string->utf8-bytes payload))
    (bytes-concat (bytes [(+ (* fin 128) opcode) (+ 128 (count pb)) 0 0 0 0]) pb)))

; Tier-2 (docs/robustness.md): reassemble fragmented messages; cap frame + message size.
(describe "parse-frame: fragmentation + size caps"
  (test "reassembles a fragmented text message into one"
    (let (buf (bytes-concat (cframe 0 1 "Hel") (cframe 0 0 "lo ") (cframe 1 0 "world"))
          [tag opcode payload rem] (parse-frame buf))
      (assert= tag :ok)
      (assert= opcode 1)
      (assert= (utf8-bytes->string payload) "Hello world")
      (assert= (count rem) 0)))
  (test "incomplete until the final (FIN) fragment arrives"
    (assert= (parse-frame (bytes-concat (cframe 0 1 "Hel") (cframe 0 0 "lo "))) [:incomplete]))
  (test "a non-continuation frame mid-message is rejected"
    (assert= (first (parse-frame (bytes-concat (cframe 0 1 "Hel") (cframe 1 1 "lo")))) :error))
  (test "a single frame over the frame cap is rejected"
    (assert= (first (parse-message (cframe 1 1 "toolong") 4 1000)) :error))
  (test "a reassembled message over the message cap is rejected"
    (assert= (first (parse-message (bytes-concat (cframe 0 1 "aaaa") (cframe 1 0 "bbbb")) 65535 6))
      :error)))

; frame-size: the length probe that lets the live reader gather one frame in O(n). It must
; agree with parse-frame's completion point (a frame is complete exactly when its bytes reach
; frame-size), and return nil while the length header is still arriving.
(describe "frame-size"
  (test "nil until the 2-byte header is present"
    (assert= (frame-size (bytes [])) nil)
    (assert= (frame-size (bytes [129])) nil))
  (test "7-bit length: header(2)+mask(4)+payload, = the full frame length"
    (let (f (cframe 1 1 "hello"))
      (assert= (frame-size f) 11)
      (assert= (frame-size f) (count f))))
  (test "sizes from the 2-byte header alone (payload not yet present)"
    (assert= (frame-size (subbytes (cframe 1 1 "hello") 0 2)) 11))
  (test "16-bit length: nil until 4 bytes, then header(4)+mask(4)+payload"
    (let (hdr (bytes [129 254]))
      (assert= (frame-size hdr) nil)
      ; length 300 (0x012c) → 8 header/mask bytes + 300
      (assert= (frame-size (bytes-concat hdr (bytes [1 44]))) 308)))
  (test "64-bit length form is not sized (unsupported; the parser raises on it)"
    (assert= (frame-size (bytes [129 255])) nil)))

; A masked frame (`bytes`) with a NON-zero key, so the XOR unmask is actually exercised
; (cframe uses a zero key, identity). Each payload byte is XORed with key[i % 4] on the wire.
(defn masked-frame (opcode payload key)
  (let (pb (string->utf8-bytes payload)
        n (count pb)
        masked (bytes (map (fn (i) (bit-xor (get pb i) (get key (mod i 4)))) (range n))))
    (bytes-concat (bytes [(+ 128 opcode) (+ 128 n)]) (bytes key) masked)))

(describe "parse-frame: unmask (non-zero key)"
  (test "recovers the original payload"
    (let (frame (masked-frame 1 "Hello, mask!" [17 34 51 68])
          [tag opcode payload _] (parse-frame frame))
      (assert= tag :ok)
      (assert= opcode 1)
      (assert= (utf8-bytes->string payload) "Hello, mask!"))))

(describe "origin-host"
  (test "strips the scheme" (assert= (origin-host "https://example.com:443") "example.com:443"))
  (test "no scheme → unchanged" (assert= (origin-host "example.com") "example.com")))

(describe "origin-allowed? (CSWSH guard)"
  (test "same-origin is allowed"
    (assert= (origin-allowed? {:headers {:origin "https://app.test" :host "app.test"}} true) true))
  (test "cross-origin is rejected"
    (assert= (origin-allowed? {:headers {:origin "https://evil.test" :host "app.test"}} true) false))
  (test "missing Origin is allowed under same-origin (non-browser client)"
    (assert= (origin-allowed? {:headers {:host "app.test"}} true) true))
  (test "policy false allows any origin"
    (assert= (origin-allowed? {:headers {:origin "https://evil.test" :host "app.test"}} false) true))
  (test "allowlist permits listed, rejects unlisted and missing"
    (assert= (origin-allowed? {:headers {:origin "https://ok.test" :host "app.test"}} (list "https://ok.test")) true)
    (assert= (origin-allowed? {:headers {:origin "https://evil.test" :host "app.test"}} (list "https://ok.test")) false)
    (assert= (origin-allowed? {:headers {:host "app.test"}} (list "https://ok.test")) false)))
