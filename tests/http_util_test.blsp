(defmodule http-util-test (:use http/util) (:use test))

(describe "content-type-base"
  (test "bare type"
    (assert= (content-type-base {:content-type "application/json"}) "application/json"))
  (test "strips charset params"
    (assert= (content-type-base {:content-type "application/json; charset=utf-8"})
      "application/json"))
  (test "lowercases and trims"
    (assert= (content-type-base {:content-type "  Application/JSON ; q=1"}) "application/json"))
  (test "absent → empty string" (assert= (content-type-base {}) "")))

(describe "hex-char->int"
  (test "digits" (assert= (hex-char->int "0") 0))
  (test "nine" (assert= (hex-char->int "9") 9))
  (test "upper-A" (assert= (hex-char->int "A") 10))
  (test "upper-F" (assert= (hex-char->int "F") 15))
  (test "lower-a" (assert= (hex-char->int "a") 10))
  (test "lower-f" (assert= (hex-char->int "f") 15)))

(describe "url-decode"
  (test "plain string" (assert= (url-decode "hello") "hello"))
  (test "plus to space" (assert= (url-decode "hello+world") "hello world"))
  (test "percent space" (assert= (url-decode "hello%20world") "hello world"))
  (test "UTF-8 two-byte" (assert= (url-decode "caf%C3%A9") "café"))
  (test "mixed" (assert= (url-decode "foo%3Dbar") "foo=bar"))
  (test "empty string" (assert= (url-decode "") ""))
  ; a %-escape that decodes to invalid UTF-8 (%ff, %c0, …) must not throw — it used to
  ; crash the worker via parse-query with no response. Fall back to the raw input.
  (test "invalid post-decode UTF-8 does not throw" (assert= (string? (url-decode "x%ffy")) true))
  (test "lone %ff falls back to the raw input" (assert= (url-decode "%ff") "%ff")))

(describe "parse-query"
  (test "single pair" (assert= (parse-query "name=Alice") {"name" "Alice"}))
  (test "two pairs" (assert= (parse-query "a=1&b=2") {"a" "1" "b" "2"}))
  (test "percent encoded key" (assert= (parse-query "n%61me=x") {"name" "x"}))
  (test "percent encoded val" (assert= (parse-query "q=caf%C3%A9") {"q" "café"}))
  (test "value-less key" (assert= (parse-query "flag") {"flag" ""}))
  (test "empty string" (assert= (parse-query "") {}))
  (test "nil" (assert= (parse-query nil) {})))


(describe "accepts-encoding?"
  (test "a browser header offers gzip"
    (assert= (accepts-encoding? "gzip, deflate, br" "gzip") true))
  (test "and br" (assert= (accepts-encoding? "gzip, deflate, br" "br") true))
  (test "a coding not listed is not offered" (assert= (accepts-encoding? "gzip" "br") false))
  (test "a missing header offers nothing" (assert= (accepts-encoding? nil "gzip") false))
  (test "an explicit q=0 is a refusal" (assert= (accepts-encoding? "gzip;q=0" "gzip") false))
  (test "q=0.0 and q=0.000 too"
    (assert= (accepts-encoding? "gzip;q=0.0" "gzip") false)
    (assert= (accepts-encoding? "gzip;q=0.000" "gzip") false))
  (test "whitespace around the weight does not hide the refusal"
    (assert= (accepts-encoding? "gzip; q=0" "gzip") false))
  (test "a refusal is per-coding, not per-header"
    (assert= (accepts-encoding? "gzip;q=0, br" "br") true))
  ; The fall-through the `includes? "0"` fast path exists to protect: a header carrying a
  ; digit zero that is not a refusal must still read as an offer.
  (test "a small positive weight is not a refusal"
    (assert= (accepts-encoding? "gzip;q=0.001" "gzip") true))
  (test "q=0.9 is not a refusal" (assert= (accepts-encoding? "gzip;q=0.9" "gzip") true)))
