(defmodule web-presence-test
  (:use web/presence)
  ; presence--* registry internals are module-private (ADR-146 `--` names); tested directly here
  (:use-internals web/presence)
  ; observer mode rides pubsub; the test barriers on a synchronous pubsub call
  (:alias web/pubsub)
  (:use test))

;; Presence is process-level: a registry tracks {topic -> members} and pushes the roster to
;; present members via send-info ([:info {:presence …}]), auto-removing a member when its
;; process dies. Roster assertions poll the synchronous `roster` (registry updates are async
;; w.r.t. the caller). The test process stays untracked for the roster tests; the
;; notification test uses relay helpers.
;;
;; Helpers idle with `(receive ([:never] _) (after …))` — a never-matching pattern that
;; blocks until killed. A bare `(receive (after …))` with no pattern can return immediately
;; when an unmatched message (e.g. this member's own roster push) is already in the mailbox,
;; which would let the helper exit and be reaped before the test observes it.

(defn snooze (ms)
  "Block ~ms with no side effect (a never-matching receive)."
  (receive ([:never] nil) (after ms nil)))

(defn roster-keys (topic)
  (map (fn (e) (get e :key)) (roster topic)))

(defn wait-key (topic key tries)
  (cond
    (member? key (roster-keys topic)) true
    (<= tries 0) false
    else (do (snooze 50) (wait-key topic key (- tries 1)))))

(defn wait-key-gone (topic key tries)
  (cond
    (not (member? key (roster-keys topic))) true
    (<= tries 0) false
    else (do (snooze 50) (wait-key-gone topic key (- tries 1)))))

(defn meta-status (topic key)
  "The :status of `key`'s roster entry on `topic`, or nil if absent."
  (let (e (first (filter (fn (x) (= (get x :key) key)) (roster topic))))
    (if e (get (get e :meta) :status) nil)))

(defn wait-meta (topic key val tries)
  "Poll until `key`'s entry has `:status` = `val`."
  (cond
    (= (meta-status topic key) val) true
    (<= tries 0) false
    else (do (snooze 50) (wait-meta topic key val (- tries 1)))))

(defn tracked-member (topic key parent)
  "Track on `topic` under `key`, barrier until the registry processed it, tell `parent`,
  then block until killed."
  (track topic key {})
  (roster topic)
  (send parent [:tracked])
  (receive ([:never] nil) (after 15000 nil)))

;; A relay helper: tracks, then forwards every roster it's pushed to `parent` as the list of
;; keys [:roster keys]. Lets the test observe notifications without being tracked itself.
(defn relay-member (topic key parent)
  (track topic key {})
  (roster topic)
  (send parent [:tracked])
  (relay-loop parent))

(defn relay-loop (parent)
  (receive
    ([:info m] (do
                 (send parent [:roster (map (fn (e) (get e :key)) (get m :presence))])
                 (relay-loop parent)))
    (after 15000 nil)))

(defn drain-roster ()
  (if (= (receive ([:roster _] :got) (after 100 :none)) :none) nil (drain-roster)))

(defn wait-roster-without (key tries)
  "Scan pushed rosters until one arrives that does NOT contain `key`."
  (if (<= tries 0)
    false
    (let (r (receive ([:roster ks] ks) (after 300 :none)))
      (cond
        (= r :none) (wait-roster-without key (- tries 1))
        (not (member? key r)) true
        else (wait-roster-without key (- tries 1))))))

(describe "track + roster"
  (test "tracking adds a member to the topic"
    (do
      (track "pres:a" "alice" {})
      (let (in? (wait-key "pres:a" "alice" 60))
        (untrack "pres:a")
        (assert= in? true))))
  (test "untrack removes the member"
    (do
      (track "pres:b" "bob" {})
      (wait-key "pres:b" "bob" 60)
      (untrack "pres:b")
      (assert= (wait-key-gone "pres:b" "bob" 60) true)))
  (test "metadata is carried in the roster"
    (do
      (track "pres:m" "m1" {:color "blue"})
      (wait-key "pres:m" "m1" 60)
      (let (e (first (filter (fn (x) (= (get x :key) "m1")) (roster "pres:m"))))
        (untrack "pres:m")
        (assert= (get (get e :meta) :color) "blue"))))
  (test "re-tracking the same process replaces its entry (updated meta, no duplicate)"
    (do
      (track "pres:r" "r1" {:status "away"})
      (wait-key "pres:r" "r1" 60)
      (track "pres:r" "r1" {:status "online"})
      ; poll until the meta reflects the update
      (assert= (wait-meta "pres:r" "r1" "online" 60) true)
      ; exactly one entry for this pid (no duplicate from re-track)
      (assert= (count (filter (fn (e) (= (get e :key) "r1")) (roster "pres:r"))) 1)
      (untrack "pres:r"))))

(describe "auto-leave on death"
  (test "a member whose process dies is removed from the roster"
    (let (me (self)
          h (spawn (tracked-member "pres:d" "leaver" me)))
      (receive ([:tracked] nil) (after 10000 nil))
      (let (was-in? (wait-key "pres:d" "leaver" 60))
        (exit h :kill)
        (assert= was-in? true)
        (assert= (wait-key-gone "pres:d" "leaver" 60) true)))))

(describe "roster push notifications"
  (test "present members are pushed an updated roster on join and leave"
    (let (me (self)
          a (spawn (relay-member "pres:n" "A" me))
          _a (receive ([:tracked] nil) (after 10000 nil))
          b (spawn (relay-member "pres:n" "B" me))
          _b (receive ([:tracked] nil) (after 10000 nil)))
      ; A was present when B joined, so the roster grows to include B
      (assert= (wait-key "pres:n" "B" 60) true)
      (drain-roster)
      (exit b :kill)
      ; after B dies, A is pushed a roster without B
      (assert= (wait-roster-without "B" 60) true)
      (exit a :kill))))

;; Cross-node roster merge. True multi-node needs two runtimes (a node is one OS process), so
;; the merge + replication is verified end-to-end by a separate two-node run; these cover the
;; pure merge logic and the single-node no-op.
(describe "cross-node roster merge"
  (test "the merged roster is local presences plus every peer's reported roster"
    (let (state (web/presence/presence-put {} "room" 1 "local-a" {})
          remotes {:nodeB {"room" (list {:key "remote-b" :meta {}})}
                   :nodeC {"room" (list {:key "remote-c" :meta {}})}}
          keys (map (fn (e) (get e :key)) (web/presence/presence-merged state remotes "room")))
      (assert= (member? "local-a" keys) true)
      (assert= (member? "remote-b" keys) true)
      (assert= (member? "remote-c" keys) true)
      (assert= (count keys) 3)))
  (test "a topic with only remote members still merges"
    (let (remotes {:nodeB {"room" (list {:key "b" :meta {}})}})
      (assert= (map (fn (e) (get e :key)) (web/presence/presence-merged {} remotes "room"))
        (list "b"))))
  (test "remote-topics-of lists the topics a departed peer was on"
    (let (remotes {:nodeB {"r1" (list {:key "b" :meta {}}) "r2" (list {:key "b" :meta {}})}}
          ts (web/presence/presence-remote-topics-of remotes :nodeB))
      (assert= (member? "r1" ts) true)
      (assert= (member? "r2" ts) true)
      (assert= (count ts) 2)))
  (test "remote-nodes is empty on a single (non-distributed) runtime"
    (assert= (remote-nodes) (list))))

(describe "presence--record-remote: peer state doesn't leak empty rosters"
  (test "a non-empty roster is recorded"
    (assert= (web/presence/presence-record-remote {} :nodeB "room" (list {:key "b" :meta {}}))
      {:nodeB {"room" (list {:key "b" :meta {}})}}))
  (test "an empty roster drops the [node topic] entry"
    (let (remotes {:nodeB {"r1" (list {:key "b" :meta {}}) "r2" (list {:key "b" :meta {}})}})
      (assert= (web/presence/presence-record-remote remotes :nodeB "r1" (list))
        {:nodeB {"r2" (list {:key "b" :meta {}})}})))
  (test "emptying a peer's last topic drops the node entirely"
    (let (remotes {:nodeB {"r1" (list {:key "b" :meta {}})}})
      (assert= (web/presence/presence-record-remote remotes :nodeB "r1" (list)) {}))))

; Crash recovery is exercised non-destructively in web_registry_test (the durable vault
; primitive) — hard-killing the shared :hatch-presence singleton would race any concurrent
; test using it (a killed process drops its in-flight mailbox).

; Empty topics are dropped, not left as dead keys (an ephemeral-topic memory leak). These
; exercise the pure state helpers directly — the public `roster` API can't observe the
; difference (a missing topic and an empty one both read as the empty roster).
(describe "presence--remove / presence--remove-pid drop emptied topics"
  (test "untracking the last member drops the topic key"
    (let (state (web/presence/presence-put {} "t" 1 "k" {}))
      (assert= (contains? (web/presence/presence-remove state "t" 1) "t") false)))
  (test "remove-pid drops the topics it empties and keeps the rest"
    (let (state (web/presence/presence-put (web/presence/presence-put (web/presence/presence-put {}
                                                                        "a"
                                                                        1
                                                                        "k"
                                                                        {})
                                             "b"
                                             1
                                             "k"
                                             {})
                  "b"
                  2
                  "k"
                  {})
          out (web/presence/presence-remove-pid state 1))
      (assert= (contains? out "a") false)
      (assert= (count (get out "b")) 1))))

;; ---- observer mode (non-present observers) ----
;; An observer subscribes to a topic's roster updates via `observe` without joining the roster:
;; it gets the same [:info {:presence …}] pushes a member does, but never appears in `roster`.

(defn observer-loop (topic parent)
  "Forward each pushed roster's keys to parent; on `:stop-observing`, unobserve and idle."
  (receive
    ([:info m] (do
                 (send parent [:roster (map (fn (e) (get e :key)) (get m :presence))])
                 (observer-loop topic parent)))
    (:stop-observing (do (unobserve topic) (snooze 100000)))
    (after 15000 nil)))

(defn observer-relay (topic parent)
  "Observe `topic` (never tracked), barrier the subscribe, tell parent it's ready, then forward
  each pushed roster's keys to parent."
  (observe topic)
  ; force the async subscribe to be registered before the test spawns a member (FIFO barrier)
  (pubsub/subscribers (observer-topic topic))
  (send parent :observing)
  (observer-loop topic parent))

(defn present-and-idle (topic key parent)
  "Track on `topic` under `key`, tell parent, then stay alive/tracked until killed."
  (track topic key {})
  ; a synchronous roster call barriers until the registry has processed the track
  (roster topic)
  (send parent :tracked)
  (snooze 100000))

(describe "observe / unobserve"
  :isolated
  (test "an observer is pushed the roster but never joins it"
    (let (me (self)
          obs (spawn (observer-relay "obs:room" me)))
      (receive (:observing nil) (after 2000 nil))
      (let (m (spawn (present-and-idle "obs:room" "alice" me)))
        (receive (:tracked nil) (after 2000 nil))
        ; the observer received a roster push containing the new member
        (receive
          ([:roster keys] (assert= (member? "alice" keys) true))
          (after 2000 (assert= :push :timeout)))
        ; and the observer itself is NOT present in the roster — only alice is
        (assert= (wait-key "obs:room" "alice" 20) true)
        (assert= (roster-keys "obs:room") (list "alice"))
        (exit m :kill))
      (exit obs :kill)))
  (test "unobserve stops the pushes (no longer a subscriber)"
    (let (me (self)
          obs (spawn (observer-relay "obs:leave" me)))
      (receive (:observing nil) (after 2000 nil))
      ; the observer subscribed; now have IT unobserve by sending it a directive
      (send obs :stop-observing)
      ; drain: after unobserve the observer must not be a subscriber of the observer topic
      (snooze 100)
      (assert= (empty? (pubsub/subscribers (observer-topic "obs:leave"))) true)
      (exit obs :kill))))
