(defmodule web-form-test
  (:use test)
  (:alias web/form)
  (:alias web/test :as web-test)
  (:alias changeset))

(def- types {:email :text :age :integer})

(describe "value"
  (test "shows what was submitted, even a value that failed to cast"
    (let (cs (changeset/cast {} {"age" "twelve"} [:age] types))
      (assert= (web/form/value cs :age) "twelve")))
  (test "falls back to the changeset's data, then to empty"
    (let (cs (changeset/cast {:email "a@b.c"} {} [:email] types))
      (assert= (web/form/value cs :email) "a@b.c")
      (assert= (web/form/value cs :age) "")))
  (test "a fresh form is blank and has no errors"
    (let (cs (changeset/change {}))
      (assert= (web/form/value cs :email) "")
      (assert= (web/form/errors? cs) false))))

(describe "error-for / field-class"
  (test "the first error, and the error class beside the base"
    (let (cs (-> (changeset/cast {} {"email" ""} [:email] types)
               (changeset/validate-required [:email])))
      (assert= (web/form/error-for cs :email) "can't be blank")
      (assert= (web/form/field-class cs :email "input" "input-error") "input input-error")
      (assert= (web/form/field-class cs :age "input" "input-error") "input"))))

(describe "validate-email"
  (test "a plausible address passes"
    (assert= (changeset/valid? (web/form/validate-email (changeset/cast {}
                                                          {"email" "ada@example.com"}
                                                          [:email]
                                                          types)
                                 :email))
      true))
  (test "a bad one carries the message"
    (assert= (web/form/error-for (web/form/validate-email (changeset/cast {}
                                                            {"email" "nope"}
                                                            [:email]
                                                            types)
                                   :email)
               :email)
      "must be a valid email address")))

(describe "email?"
  (test "a plausible email is valid" (assert= (web/form/email? "ada@example.com") true))
  (test "no @ is invalid" (assert= (web/form/email? "notanemail") false))
  (test "no domain dot is invalid" (assert= (web/form/email? "a@b") false))
  (test "a space is invalid" (assert= (web/form/email? "a b@example.com") false))
  (test "a tab is invalid" (assert= (web/form/email? "a\tb@example.com") false))
  ; a CR/LF must be rejected so a validated address can't inject a mail header
  (test "a CRLF is invalid" (assert= (web/form/email? "ada@example.com\r\nBcc: evil@x.com") false)))

(describe "honeypot"
  (test "the field is the one honeypot-filled? reads, and hidden from people"
    (let (field (web/form/honeypot))
      (assert= (get (second field) :aria-hidden) "true")
      (assert= (get (second (nth (nth field 2) 3)) :name) web/form/*honeypot-field*)))
  (test "an empty or blank field is a person; a filled one is a script"
    (is (not (web/form/honeypot-filled? (web-test/conn-for "POST"
                                          "/register"
                                          {:params {"email" "a@b.c"}}))))
    (is (not (web/form/honeypot-filled? (web-test/conn-for "POST"
                                          "/register"
                                          {:params {"website" "  "}}))))
    (is (web/form/honeypot-filled? (web-test/conn-for "POST"
                                     "/register"
                                     {:params {"website" "http://spam.example"}})))))
