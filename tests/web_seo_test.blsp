;; web/seo — the head block, robots.txt, and the router-derived sitemap.
(defmodule web-seo-test
  (:use test)
  (:use web/seo)
  (:use web/test)
  (:use web/router)
  (:use web/template :only [render]))

(def *site*
  {:url "https://example.com"
   :name "Example"
   :description "The site description."
   :image "/og.png"
   :twitter-card "summary_large_image"})

(defn- head (page) (render [:head {} (head-tags *site* page)]))

(describe "head-tags"
  (test "a page with nothing of its own falls back to the site description"
    (is (includes? (head {}) "content=\"The site description.\"")))

  (test "a page's own description wins"
    (let (out (head {:description "Just this page."}))
      (is (includes? out "Just this page."))
      (is (not (includes? out "The site description.")))))

  (test "a relative canonical is emitted absolute"
    (is (includes? (head {:canonical "/widgets"}) "href=\"https://example.com/widgets\"")))

  (test "an absolute canonical passes through unchanged"
    (is (includes? (head {:canonical "https://elsewhere.test/x"}) "https://elsewhere.test/x")))

  (test "og:url defaults to the canonical"
    (is (includes? (head {:canonical "/widgets"}) "content=\"https://example.com/widgets\"")))

  ;; The rule the module exists to enforce: `noindex` is a directive and `rel=canonical` is
  ;; a hint at the same question, and together the noindex can be carried to the canonical
  ;; target. A page that says noindex must not also nominate a canonical.
  (test "robots and canonical are never emitted together"
    (let (out (head {:robots "noindex, follow" :canonical "/widgets"}))
      (is (includes? out "noindex, follow"))
      (is (not (includes? out "rel=\"canonical\"")))))

  (test "the social card is complete"
    (let (out (head {:title "Widgets" :canonical "/widgets"}))
      (for (needle ["og:type"
                     "og:site_name" "og:title" "og:description" "og:url" "og:image" "twitter:card"
                     "twitter:title" "twitter:image"])
        (is (includes? out needle)))))

  (test "json-ld renders as a typed script element"
    (let (out (head {:json-ld {:@context "https://schema.org" :@type "SoftwareApplication"}}))
      (is (includes? out "application/ld+json"))
      (is (includes? out "SoftwareApplication"))))

  ;; A `</script>` inside a JSON string value would end the element and spill the rest of
  ;; the data into the document as markup.
  (test "json-ld cannot break out of its script element"
    (let (out (head {:json-ld {:name "</script><img src=x>"}}))
      (is (not (includes? out "</script><img")))
      (is (includes? out "<\\/script>"))))

  ;; Separate elements, not one array — that is the shape search engines read.
  (test "several json-ld blocks render as separate scripts"
    (let (out (head {:json-ld [{:@type "A"} {:@type "B"}]}))
      ;; two occurrences of the marker split the document into three pieces
      (assert= 3 (count (string/split out "application/ld+json")))
      (is (includes? out "\"A\""))
      (is (includes? out "\"B\""))))

  (test "an absent image emits no image tags"
    (is (not (includes? (render [:head {} (head-tags {:url "https://x.test"} {})]) "og:image")))))

;; A router whose table the sitemap reads — fixed paths, a `:param` route, and a splat.
(defrouter seo-test-router
  (get "/" (fn (conn) "home"))
  (get "/about" (fn (conn) "about"))
  (get "/health" (fn (conn) "ok"))
  (get "/widgets/:id" (fn (conn) "widget"))
  (get "/static/*path" (fn (conn) "asset"))
  (post "/widgets" (fn (conn) "created")))

(describe "the sitemap reads the route table"

  ;; The whole point: the URL list is the routes, not a second copy of them that goes
  ;; stale silently.
  (test "only parameterless GET routes are fixed URLs"
    (assert= ["/" "/about" "/health"] (apply vector (fixed-get-paths seo-test-router--routes))))

  (test "a :param route names unboundedly many URLs, so it is not one"
    (is (not (fixed-path? (list "widgets" :id)))))

  (test "a splat route is not one either"
    (is (not (fixed-path? (list "static" [:splat "path"])))))

  (test "machine-facing paths can be excluded"
    (assert= ["/" "/about"]
      (apply vector (sitemap-entries *site* seo-test-router--routes {:exclude ["/health"]}))))

  ;; Dynamic URLs are the app's to enumerate, and a THUNK so the listing is read per
  ;; request rather than frozen at boot.
  (test "extra urls are appended, and a thunk is called"
    (assert= ["/" "/about" "/health" "/widgets/1"]
      (apply vector
        (sitemap-entries *site* seo-test-router--routes {:extra (fn () ["/widgets/1"])}))))

  (test "the document is well-formed and absolute"
    (let (xml (sitemap-xml *site* ["/about"]))
      (is (includes? xml "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"))
      (is (includes? xml "<loc>https://example.com/about</loc>"))
      (is (includes? xml "</urlset>"))))

  (test "optional per-url hints are emitted only when given"
    (let (xml (sitemap-xml *site* [{:path "/a" :lastmod "2026-01-01" :changefreq "daily"}]))
      (is (includes? xml "<lastmod>2026-01-01</lastmod>"))
      (is (includes? xml "<changefreq>daily</changefreq>"))
      (is (not (includes? xml "<priority>")))))

  ;; The sitemap route is declared inside the very `defrouter` that defines the table, so
  ;; the handler cannot be handed a value that does not exist yet.
  (test "the table may be a thunk, read when the request arrives"
    (assert= (apply vector (fixed-get-paths seo-test-router--routes))
      (apply vector (fixed-get-paths (fn () seo-test-router--routes)))))

  ;; Freshness matters here specifically: a crawler fetches both of these before every
  ;; crawl, and with no Cache-Control each is a full round trip for bytes that change only
  ;; on redeploy.
  (test "the sitemap declares its own freshness"
    (let (resp (call (sitemap-handler *site* (fn () seo-test-router--routes) {})
                 (conn-for "GET" "/sitemap.xml")))
      (is (includes? (resp-header resp :cache-control) "max-age=3600"))
      (is (includes? (resp-header resp :cache-control) "public"))))

  (test "the handler serves xml"
    (let (resp (call (sitemap-handler *site* seo-test-router--routes {})
                 (conn-for "GET" "/sitemap.xml")))
      (assert= 200 (status resp))
      (is (includes? (resp-header resp :content-type) "application/xml"))
      (is (body-contains? resp "<urlset")))))

(describe "robots.txt"
  (test "allows everything and names the sitemap by absolute URL"
    (let (txt (robots-text *site* {}))
      (is (includes? txt "User-agent: *"))
      (is (includes? txt "Disallow:\n"))
      (is (includes? txt "Sitemap: https://example.com/sitemap.xml"))))

  (test "disallow prefixes are listed"
    (is (includes? (robots-text *site* {:disallow ["/admin" "/api"]}) "Disallow: /admin")))

  (test "the sitemap line can be omitted"
    (is (not (includes? (robots-text *site* {:sitemap nil}) "Sitemap:"))))

  (test "the handler serves plain text"
    (let (resp (call (robots-handler *site* {}) (conn-for "GET" "/robots.txt")))
      (assert= 200 (status resp))
      (is (includes? (resp-header resp :content-type) "text/plain"))
      (is (body-contains? resp "User-agent"))))

  (test "it declares its own freshness, overridable"
    (is (includes? (resp-header (call (robots-handler *site* {}) (conn-for "GET" "/robots.txt"))
                     :cache-control)
          "max-age=3600"))
    (is (includes? (resp-header (call (robots-handler *site* {:max-age 60})
                                  (conn-for "GET" "/robots.txt"))
                     :cache-control)
          "max-age=60"))))

;; llms.txt (llmstxt.org) is a curated map of a site for a language model — the few pages
;; worth starting from, each with a line saying what it is. The spec fixes the ORDER: H1,
;; then an optional blockquote, then free-form markdown with no headings in it, then
;; H2-delimited sections of markdown links. A file that gets the order wrong is not one a
;; reader can rely on, so the shape is what these assert.
(describe "llms.txt"
  (def *llms-site* {:url "https://example.com"})

  (test "the title is the H1, and it is the only required part"
    (assert= "# Acme\n" (llms-text *llms-site* {:title "Acme"})))

  (test "summary, details and sections come in the specified order"
    (assert= (str "# Acme\n"
               "\n> A widget registry.\n" "\nBuilt in a shed.\n" "\n## Docs\n\n"
               "- [Guide](https://example.com/guide): start here\n"
               "- [API](https://example.com/api)\n")
      (llms-text *llms-site*
        {:title "Acme"
         :summary "A widget registry."
         :details "Built in a shed."
         :sections [{:name "Docs"
                     :links [{:title "Guide" :url "/guide" :notes "start here"}
                              {:title "API" :url "/api"}]}]})))

  (test "relative link urls are made absolute — the file is read away from the site"
    (is (includes? (llms-text *llms-site*
                     {:title "A" :sections [{:name "S" :links [{:title "T" :url "/x"}]}]})
          "(https://example.com/x)")))

  (test "an absolute url is left alone"
    (is (includes? (llms-text *llms-site*
                     {:title "A"
                      :sections [{:name "S"
                                  :links [{:title "T" :url "https://other.example/x"}]}]})
          "(https://other.example/x)")))

  (test "the handler serves it as plain text, cacheable"
    (let (resp (call (llms-handler *llms-site* {:title "Acme"} {}) (conn-for "GET" "/llms.txt")))
      (assert= 200 (status resp))
      (is (includes? (resp-header resp :content-type) "text/plain"))
      (is (includes? (resp-header resp :cache-control) "max-age"))
      (is (includes? (body resp) "# Acme"))))

  (test "content may be a thunk, so a listing is read per request and not frozen at boot"
    (let (handler (llms-handler *llms-site* (fn () {:title "Live"}) {}))
      (is (includes? (body (call handler (conn-for "GET" "/llms.txt"))) "# Live")))))
