;; web/dashboard — the metrics page.
(defmodule web-dashboard-test
  (:use test)
  (:use web/dashboard)
  (:use web/test)
  (:alias web/metrics))

(describe "the dashboard page"
  :serial (test "says so when nothing has been recorded"
    (web/metrics/reset)
    (is (includes? (page "T") "No requests recorded yet.")))

  (test "reports each route with its latency and error counts"
    (web/metrics/reset)
    (for (i (range 3)) (web/metrics/record "GET" "/reference" "/reference" 200 12))
    (web/metrics/record "POST" "/api/v1/publish" "/api/v1/publish" 500 300)
    (let (html (page "T"))
      (is (includes? html "GET /reference"))
      (is (includes? html "POST /api/v1/publish"))
      ;; the 5xx is surfaced, not buried in a total
      (is (includes? html "err"))))

  ;; It maps the app and how well it is working — exactly what a prober wants, and never
  ;; something a search engine should hold.
  (test "is noindex and never stored"
    (web/metrics/reset)
    (is (includes? (page "T") "noindex, nofollow"))
    (let (resp (call (handler) (conn-for "GET" "/dashboard")))
      (assert= 200 (status resp))
      (assert= "no-store" (resp-header resp :cache-control))
      (is (includes? (resp-header resp :content-type) "text/html"))))

  ;; Every card group — cache, cluster, runtime — is a helper returning a VECTOR of card
  ;; forms, dropped into a child slot. `render` used to take such a vector as an element and
  ;; use its printed first card as the TAG NAME, so the page carried a literal
  ;; `<[:div {:class card} [:b {:class } 27] …]>` as text and the first card of each group
  ;; was lost. Every assertion above still passed: they all ask `includes?` for a substring,
  ;; and the substring was there — inside the garbage.
  (test "renders no raw Hiccup, and keeps the first card of every group"
    (web/metrics/reset)
    (let (html (page "T"))
      (is (not (includes? html "[:div")))
      (is (not (includes? html "[:b ")))
      (is (not (includes? html "[:span")))
      ;; the first card of each group is the one the old bug ate
      (is (includes? html "fragments")) ; cache
      (is (includes? html "node")) ; cluster
      (is (includes? html "processes")))) ; runtime
  (test "reports process-wide runtime figures, not the request process's heap"
    (web/metrics/reset)
    (let (html (page "T"))
      (is (includes? html "memory"))
      (is (includes? html "peak memory"))
      (is (includes? html "workers"))
      (is (includes? html "preempts"))
      (is (includes? html "uptime"))))

  ;; Brood's `/` on two ints is an EXACT RATIONAL, and `math/round-to` keeps it one — so the
  ;; first cut of the memory card put `337/10 MB` on the page. Same trap in the request rate.
  (test "byte counts read as decimals, never as ratios"
    (assert= (bytes-human 512) "512 B")
    (assert= (bytes-human 35389440) "33.8 MB")
    (assert= (bytes-human 2048) "2.0 KB")
    (assert= (bytes-human 3221225472) "3.00 GB")
    (is (not (includes? (bytes-human 35389440) "/"))))

  (test "the rendered page carries no ratio in a figure"
    (web/metrics/reset)
    (for (i (range 3)) (web/metrics/record "GET" "/x" "/x" 200 5))
    (let (html (page "T"))
      ;; `0/64` (compressed/max) is the one legitimate slash in a card body
      (is (not (includes? html "/10 MB")))
      (is (not (includes? html "/5 MB")))
      (is (includes? html "memory"))))

  (test "the title is the caller's"
    (web/metrics/reset)
    (is (includes? (body (call (handler {:title "hive metrics"}) (conn-for "GET" "/dashboard")))
          "hive metrics"))))

;; A limiter that never denies and one nobody reaches look identical from outside, and both
;; look like one that is working — so the dashboard carries the counters, not the config.
(describe "the dashboard reports rate limiting"
  (test "the section and its cards are on the page"
    (let (html (page "test dashboard"))
      (is (includes? html "rate limiting"))
      (is (includes? html "allowed"))
      (is (includes? html "denied"))
      (is (includes? html "deny rate"))
      ;; The number to watch: buckets are never evicted, so a key derived from user input
      ;; grows the table without bound and this is where that becomes visible.
      (is (includes? html "buckets"))))

  (test "a deny rate of nothing shows an em dash, not a confident 0%"
    ;; No traffic is not a healthy zero, and printing one invites the wrong fix.
    (web/ratelimit/reset-stats)
    (is (includes? (page "test dashboard") "—"))))
