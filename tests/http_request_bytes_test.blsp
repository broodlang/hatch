(defmodule http-request-bytes-test
  (:use http/request)
  ; parse-query — the oracle builds its request map the way the parser used to
  (:use http/util)
  ; int->hex — build chunk size lines
  (:alias http/response)
  (:use test))

;; Differential fuzz: the bytes-native parser (`try-parse-bytes`) must agree, verdict for verdict,
;; with the string-buffer parser it replaced (`reference-parse` below, fed `bytes->carrier`) on every input. The head
;; classification is literally the same code (the byte twin reuses `parse-request-line`/
;; `parse-headers` and the smuggling rejections verbatim), so any divergence can only be in body
;; slicing or de-chunking — exactly the new code. Golden assertions below also pin the new
;; parser's actual output, so a bug shared by both parsers can't pass unseen.

;; ---- the oracle: the string-buffer parser the bytes parser replaced ----------------------------
;; This was `http/request/try-parse` (with its `dechunk-step` / `dechunk-trailers`) while the
;; server read requests as a *carrier* string — one codepoint 0-255 per wire byte. Production is
;; bytes-only now, so it lives here, where its one remaining job is: an independent second
;; implementation for `try-parse-bytes` to agree with.

(defn- bytes->carrier (buffer)
  "A `bytes` value → a carrier string, one Latin-1 codepoint per byte."
  (string/codepoints-> (seq buffer)))

(defn- carrier->bytes (carrier)
  "A carrier string → the `bytes` it carries."
  (bytes (map (string/->list carrier) string/char->int)))

(defn- reference-request (method path query version headers body)
  {:method method
   :path path
   :query query
   :params (parse-query query)
   :version version
   :headers headers
   :body body})

(defn- reference-dechunk-trailers (buf pos buflen)
  "Skip any trailer headers after the last (0-size) chunk; return the index past the
  terminating empty CRLF, or -1 if the trailer section isn't fully buffered yet."
  (let (eol (index-of buf "\r\n" pos))
    (cond
      (= eol -1) -1
      (= eol pos) (+ eol 2)
      ; empty line → end of trailers
      else (reference-dechunk-trailers buf (+ eol 2) buflen))))

(defn- reference-dechunk-step (buf pos decoded dlen)
  "Incremental de-chunk: decode every chunk that is *fully present* in `buf` from `pos`,
  accumulating decoded pieces (newest-first) in `decoded` with running length `dlen`. Returns:
    `[:ok body remainder]`  — the terminating 0-size chunk was reached; `body` is the joined
                              decoded bytes, `remainder` anything after the trailers.
    `[:more tail decoded dlen]` — need more bytes; `tail` is only the *undecoded* remainder (a
                              partial chunk/size-line), so a streaming caller (server/chunked-drain)
                              feeds the next read onto `tail` and resumes without re-scanning the
                              bytes already decoded — what makes streaming O(n).
    `[:error msg]`          — malformed framing.
  Pieces are `join`ed once (at `:ok`) rather than `(str acc …)` per chunk. `reference-parse` reuses this
  on a whole buffer (`:more` → `:incomplete`), so both paths share one decoder."
  (let (buflen (string/length buf)
        eol (index-of buf "\r\n" pos))
    (if (= eol -1)
      [:more (string/substring buf pos buflen) decoded dlen]
      (let (size-line (string/substring buf pos eol)
            semi (index-of size-line ";")
            size-tok (if (= semi -1) size-line (string/substring size-line 0 semi))
            size (parse-hex (string/trim size-tok)))
        (cond
          (nil? size) [:error "invalid chunk size"]
          (= size 0)
            (let (end (reference-dechunk-trailers buf (+ eol 2) buflen))
              (if (= end -1)
                [:more (string/substring buf pos buflen) decoded dlen]
                [:ok (string/join (reverse decoded) "") (string/substring buf end buflen)]))
          else
            (let (data-start (+ eol 2)
                  data-end (+ data-start size)
                  after (+ data-end 2))
              (if (< buflen after)
                [:more (string/substring buf pos buflen) decoded dlen]
                (if (= (string/substring buf data-end after) "\r\n")
                  (reference-dechunk-step buf
                    after
                    (cons (string/substring buf data-start data-end) decoded)
                    (+ dlen size))
                  [:error "malformed chunk"]))))))))

(defn- reference-parse (buf)
  "Attempt to parse a complete HTTP/1.1 request from a string buffer.
  Returns `[:ok request-map remainder]`, `[:incomplete]`, or `[:error msg]`.
  `remainder` contains any bytes in `buf` after the parsed request (pipelined data)."
  (let (sep (index-of buf "\r\n\r\n"))
    (if (= sep -1)
      [:incomplete]
      (let (header-block (string/substring buf 0 sep)
            body-start (+ sep 4)
            lines (string/split header-block "\r\n"))
        (match lines
          (nil [:error "empty request"])
          ((req-line & header-lines)
            (if (> (count header-lines) *max-header-count*)
              [:error "too many headers"]
              (match (parse-request-line req-line)
                ([:error e] [:error e])
                ([:ok method path query version]
                  ;; Grouped ONCE — see `try-parse-head` for why.
                  (let (grouped (group-headers header-lines)
                        headers (join-grouped-headers grouped)
                        buflen (string/length buf))
                    (cond
                      ; A bare CR or LF in the head (only CRLF was split away) lets a proxy that
                      ; splits on it see a different header set — a smuggling primitive (§3.5).
                      (bare-line-break? lines) [:error "bare CR or LF in header block"]
                      ; Whitespace before a field-name colon — we'd trim it and honor the header,
                      ; a strict proxy wouldn't; a CL.TE desync (§3.2.4), same class as obs-fold.
                      (any-ws-before-colon? header-lines) [:error "whitespace before header colon"]
                      ; A header line with no colon is malformed — reject rather than silently drop.
                      (colonless-header? header-lines) [:error "header line without a colon"]
                      ; obs-fold (a header line starting with SP/HTAB) — RFC 7230 §3.2.4 says a
                      ; server must reject it in a request; folding disagreements are a header-
                      ; desync / smuggling primitive. `parse-headers` would otherwise promote a
                      ; continuation line to a standalone header.
                      (obs-fold? header-lines) [:error "obs-fold header line"]
                      ; More than one Transfer-Encoding header line is ambiguous framing: a
                      ; proxy honoring a different occurrence than we do (we keep the last) is a
                      ; smuggling vector. (A list value like "x, chunked" is already rejected
                      ; below, since `chunked?` requires the value to be exactly "chunked".)
                      (duplicate-transfer-encoding-grouped? grouped)
                        [:error "multiple Transfer-Encoding"]
                      ; Transfer-Encoding *and* Content-Length is ambiguous framing
                      ; (request smuggling) — reject outright (RFC 7230 §3.3.3).
                      (and (contains? headers :transfer-encoding)
                        (contains? headers :content-length))
                        [:error "Transfer-Encoding with Content-Length"]
                      ; Chunked Transfer-Encoding: de-chunk the body. Any other TE coding
                      ; (gzip, …) we don't decode, so reject rather than mis-frame it.
                      (contains? headers :transfer-encoding)
                        (if (chunked? (get headers :transfer-encoding))
                          ; one decoder for both paths: `reference-dechunk-step`
                          ; (its `:more` = "need more bytes" = `:incomplete`
                          ; for a single whole-buffer parse)
                          (match (reference-dechunk-step buf body-start (list) 0)
                            ([:more _tail _decoded _dlen] [:incomplete])
                            ([:error e] [:error e])
                            ([:ok body remainder] [:ok
                                                    (reference-request method
                                                      path query version headers body)
                                                    remainder]))
                          [:error "unsupported transfer-encoding"])
                      ; Conflicting Content-Length values → ambiguous framing.
                      (content-length-conflict-grouped? grouped)
                        [:error "conflicting Content-Length"]
                      ; Content-Length, when present, must be a non-negative
                      ; integer. Without this a negative value made body-end <
                      ; body-start and `substring` threw, crashing the worker.
                      (not (valid-content-length? (get headers :content-length)))
                        [:error "invalid Content-Length"]
                      else
                        (let (clen (content-length-value (get headers :content-length))
                              body-end (+ body-start clen))
                          (if (< buflen body-end)
                            [:incomplete]
                            [:ok
                              (reference-request method
                                path
                                query
                                version
                                headers
                                (string/substring buf body-start body-end))
                              (string/substring buf body-end buflen)])))))))))))))

(defn verdicts-equal? (old new)
  "True if the OLD (carrier) and NEW (bytes) verdicts are equivalent: same tag; same error
  message; for :ok the same request map (body aside) with body/remainder equal AS BYTES."
  (let (t1 (first old)
        t2 (first new))
    (cond
      (not (= t1 t2)) false
      (= t1 :incomplete) true
      (= t1 :error) (= (nth old 1) (nth new 1))
      ;; both `:ok` (the tags are equal by now); matched so each side's request map is
      ;; read under its own tag
      (= t1 :ok)
        (match [old new]
          ([[:ok r1 rem1] [:ok r2 rem2]] (and (= (dissoc r1 :body) (dissoc r2 :body))
                                           (= (carrier->bytes (get r1 :body)) (get r2 :body))
                                           (= (carrier->bytes rem1) rem2)))
          (_ false))
      else false)))

(defn agree? (buf)
  "Run `buf` (a bytes value) through both parsers; true if the verdicts are equivalent."
  (verdicts-equal? (reference-parse (bytes->carrier buf)) (try-parse-bytes buf)))

;; ---- request builders (produce raw `bytes`) ----

(defn build (line headers body)
  "A raw request `bytes`: request `line`, `headers` (a list of \"Name: Value\"), CRLF, then `body`
  (a string or bytes)."
  (bytes/concat [(str line "\r\n")
                  (string/join (map headers (fn (h) (str h "\r\n"))) "")
                  "\r\n"
                  body]))

(defn chunk-of (data)
  "One chunked-transfer chunk for `data` (string or bytes): <hexlen>CRLF data CRLF."
  (let (n (count (bytes/concat [data])))
    (bytes/concat [(str (response/int->hex n) "\r\n") data "\r\n"])))

(defn chunked-body (datas &optional (trailer ""))
  "A chunked body: one chunk per `data`, then the 0-chunk, an optional `trailer` line, and the
  terminating CRLF."
  (bytes/concat (append (map datas chunk-of) (list "0\r\n" trailer "\r\n"))))

; a binary body with bytes the carrier must round-trip exactly (NUL, high bytes, a bare CR/LF)
(def bin-body (bytes [0 1 255 13 10 200 127 128 0]))

;; ---- the corpus: one named raw request per interesting branch ----

(def corpus
  [["GET no body" (build "GET /x HTTP/1.1" ["Host: localhost"] "")]
    ["GET with query" (build "GET /x?a=1&b=2 HTTP/1.1" ["Host: localhost"] "")]
    ["Host without a space after colon" (build "GET / HTTP/1.1" ["Host:localhost"] "")]
    ["HTTP/1.0" (build "GET / HTTP/1.0" ["Host: x"] "")]
    ["HEAD" (build "HEAD / HTTP/1.1" ["Host: x"] "")]
    ["POST CL text" (build "POST /f HTTP/1.1" ["Host: x" "Content-Length: 5"] "hello")]
    ["POST CL zero" (build "POST /f HTTP/1.1" ["Host: x" "Content-Length: 0"] "")]
    ["POST CL binary body" (build "POST /f HTTP/1.1" ["Host: x" "Content-Length: 9"] bin-body)]
    ["multi-value header (XFF)"
      (build "GET / HTTP/1.1" ["Host: x" "X-Forwarded-For: 1.1.1.1" "X-Forwarded-For: 2.2.2.2"] "")]
    ["cookie combine"
      (build "GET / HTTP/1.1" ["Host: x" "Cookie: a=1" "Cookie: b=2"] "")]
    ["pipelined (a 2nd request in the remainder)"
      (bytes/concat [(build "POST /f HTTP/1.1" ["Host: x" "Content-Length: 3"] "abc")
                      (build "GET /next HTTP/1.1" ["Host: x"] "")])]
    ; chunked
    ["chunked one chunk"
      (build "POST /c HTTP/1.1"
        ["Host: x" "Transfer-Encoding: chunked"]
        (chunked-body ["hello"]))]
    ["chunked multi chunk"
      (build "POST /c HTTP/1.1"
        ["Host: x" "Transfer-Encoding: chunked"]
        (chunked-body ["Wiki" "pedia" " in\r\nchunks."]))]
    ["chunked binary data"
      (build "POST /c HTTP/1.1"
        ["Host: x" "Transfer-Encoding: chunked"]
        (chunked-body [bin-body]))]
    ["chunked with a trailer"
      (build "POST /c HTTP/1.1"
        ["Host: x" "Transfer-Encoding: chunked"]
        (chunked-body ["data"] "X-Checksum: abc"))]
    ["chunked with a chunk extension"
      (build "POST /c HTTP/1.1"
        ["Host: x" "Transfer-Encoding: chunked"]
        (bytes/concat ["5;name=value\r\nhello\r\n0\r\n\r\n"]))]
    ["chunked then pipelined"
      (bytes/concat [(build "POST /c HTTP/1.1"
                       ["Host: x" "Transfer-Encoding: chunked"]
                       (chunked-body ["ab"]))
                      (build "GET /after HTTP/1.1" ["Host: x"] "")])]
    ; incomplete
    ["incomplete: no terminator" (string/->bytes "GET / HTTP/1.1\r\nHost: x\r\n")]
    ["incomplete: CL body short" (build "POST /f HTTP/1.1" ["Host: x" "Content-Length: 10"] "abc")]
    ["incomplete: chunked not terminated"
      (build "POST /c HTTP/1.1"
        ["Host: x" "Transfer-Encoding: chunked"]
        (bytes/concat ["5\r\nhello\r\n"]))]
    ["incomplete: chunked partial data"
      (build "POST /c HTTP/1.1"
        ["Host: x" "Transfer-Encoding: chunked"]
        (bytes/concat ["5\r\nhel"]))]
    ; errors / smuggling
    ["error: bad request line" (build "GET" ["Host: x"] "")]
    ["error: obs-fold" (bytes/concat ["GET / HTTP/1.1\r\nHost: x\r\n\tfolded: y\r\n\r\n"])]
    ["error: duplicate Transfer-Encoding"
      (build "POST / HTTP/1.1"
        ["Host: x" "Transfer-Encoding: chunked" "Transfer-Encoding: chunked"]
        "0\r\n\r\n")]
    ["error: TE + CL"
      (build "POST / HTTP/1.1" ["Host: x" "Transfer-Encoding: chunked" "Content-Length: 5"] "")]
    ["error: unsupported TE (gzip)"
      (build "POST / HTTP/1.1" ["Host: x" "Transfer-Encoding: gzip"] "")]
    ["error: conflicting Content-Length"
      (build "POST / HTTP/1.1" ["Host: x" "Content-Length: 5" "Content-Length: 6"] "hello")]
    ["error: negative Content-Length"
      (build "POST / HTTP/1.1" ["Host: x" "Content-Length: -1"] "")]
    ["error: non-numeric Content-Length"
      (build "POST / HTTP/1.1" ["Host: x" "Content-Length: abc"] "")]
    ["error: invalid chunk size"
      (build "POST /c HTTP/1.1"
        ["Host: x" "Transfer-Encoding: chunked"]
        (bytes/concat ["zz\r\nhello\r\n0\r\n\r\n"]))]
    ["error: malformed chunk (bad trailing bytes)"
      (build "POST /c HTTP/1.1"
        ["Host: x" "Transfer-Encoding: chunked"]
        (bytes/concat ["5\r\nhelloXX0\r\n\r\n"]))]
    ; the smuggling rejections added in the header-hardening pass — the byte parser must inherit
    ; every one, so the corpus exercises each (a missing check here is exactly what a bare
    ; hand-copied cond would drop)
    ["error: bare CR in the header block"
      (bytes/concat ["GET / HTTP/1.1\r\nHost: x\rEvil: y\r\n\r\n"])]
    ["error: bare LF in the header block"
      (bytes/concat ["GET / HTTP/1.1\r\nHost: x\nEvil: y\r\n\r\n"])]
    ["error: whitespace before the header colon"
      (build "GET / HTTP/1.1" ["Host : x"] "")]
    ["error: header line without a colon"
      (build "GET / HTTP/1.1" ["Host: x" "NoColonHere"] "")]
    ["error: too many headers"
      (build "GET / HTTP/1.1" (map (range 0 101) (fn (i) (str "H" i ": v"))) "")]])

(describe "bytes parser agrees with the carrier parser across the corpus"
  ; one named test per case, so a divergence names the exact request that failed
  (dolist (entry corpus)
    (test (str "agrees: " (first entry))
      (is (agree? (nth entry 1))))))

;; A truncation sweep: for a few complete requests, EVERY byte-prefix must yield the same verdict
;; from both parsers (mostly :incomplete, some :error). This is the fuzz's breadth — hundreds of
;; partial inputs, exactly the boundary conditions a hand-written case list misses.

(defn fdp (buf i n)
  "Tail-recursive scan for the shortest prefix length where the parsers disagree; nil if none."
  (cond
    (> i n) nil
    (not (agree? (bytes/slice buf 0 i))) i
    else (fdp buf (+ i 1) n)))

(defn first-divergent-prefix (buf)
  "The shortest prefix length at which the two parsers disagree, or nil if they agree on all
  prefixes `buf[0..i)`, i in [1, (count buf)]."
  (fdp buf 1 (count buf)))

(describe "bytes parser agrees on every truncated prefix (boundary fuzz)"
  (dolist (entry [["CL text" (build "POST /f HTTP/1.1" ["Host: x" "Content-Length: 5"] "hello")]
                   ["CL binary" (build "POST /f HTTP/1.1" ["Host: x" "Content-Length: 9"] bin-body)]
                   ["chunked multi"
                     (build "POST /c HTTP/1.1"
                       ["Host: x" "Transfer-Encoding: chunked"]
                       (chunked-body ["ab" "cde"]))]
                   ["chunked+trailer"
                     (build "POST /c HTTP/1.1"
                       ["Host: x" "Transfer-Encoding: chunked"]
                       (chunked-body ["x"] "T: 1"))]
                   ["pipelined"
                     (bytes/concat [(build "POST /f HTTP/1.1" ["Host: x" "Content-Length: 3"] "abc")
                                     (build "GET /n HTTP/1.1" ["Host: x"] "")])]])
    (test (str "all prefixes agree: " (first entry))
      (assert= (first-divergent-prefix (nth entry 1)) nil))))

;; Golden checks — pin the NEW parser's actual output, so a bug BOTH parsers share can't slip
;; through the differential comparison.

(describe "bytes parser — golden output"
  (test "Content-Length body is returned as the exact bytes"
    (match (try-parse-bytes (build "POST /f HTTP/1.1" ["Host: x" "Content-Length: 9"] bin-body))
      ([:ok req math/rem] (assert= (get req :body) bin-body)
        (assert= (get req :method) "POST")
        (assert= (count math/rem) 0))
      (_ (is false))))
  (test "chunked body decodes to the concatenated chunk bytes"
    (match (try-parse-bytes (build "POST /c HTTP/1.1"
                              ["Host: x" "Transfer-Encoding: chunked"]
                              (chunked-body ["Wiki" "pedia"])))
      ([:ok req _] (assert= (string/bytes-> (get req :body)) "Wikipedia"))
      (_ (is false))))
  (test "the pipelined remainder is the exact trailing bytes"
    (match (try-parse-bytes (bytes/concat [(build "POST /f HTTP/1.1"
                                             ["Host: x" "Content-Length: 3"]
                                             "abc")
                                            (string/->bytes "GET /n HTTP/1.1\r\n")]))
      ([:ok _ math/rem] (assert= (string/bytes-> math/rem) "GET /n HTTP/1.1\r\n"))
      (_ (is false))))
  (test "try-parse-head-bytes classifies a chunked head without the body"
    (assert= (first (try-parse-head-bytes (build "POST /c HTTP/1.1"
                                            ["Host: x" "Transfer-Encoding: chunked"]
                                            "")))
      :chunked)))
