(defmodule web-auth-test
  (:use web/auth)
  (:use web/conn)
  ; base64-encode — build the Authorization header for the tests
  (:use encoding)
  (:use test))

(defn conn-with-auth (val)
  "A GET conn whose Authorization header is `val` (nil = no header sent)."
  (build {:method "GET" :path "/dev" :query "" :params {} :headers {:authorization val} :body ""}))

(defn basic (user pass)
  "A `Basic <base64>` Authorization header value for `user`:`pass`."
  (str "Basic " (base64-encode (str user ":" pass))))

(describe "basic-auth"
  (test "valid credentials pass through (not halted) and assign current-user"
    (let (conn ((basic-auth "admin" "admin") (conn-with-auth (basic "admin" "admin"))))
      (assert= (halted? conn) false)
      (assert= (get-assign conn :current-user) "admin")))

  (test "wrong password halts with a 401 + challenge for the realm"
    (let (conn ((basic-auth "admin" "admin" "Dev") (conn-with-auth (basic "admin" "nope"))))
      (assert= (halted? conn) true)
      (assert= (get conn :status) 401)
      (assert= (includes? (get-in conn [:resp-headers :www-authenticate]) "Dev") true)))

  (test "missing Authorization header halts with a 401"
    (let (conn ((basic-auth "admin" "admin") (conn-with-auth nil)))
      (assert= (halted? conn) true)
      (assert= (get conn :status) 401)))

  (test "a non-Basic scheme is rejected"
    (let (conn ((basic-auth "admin" "admin") (conn-with-auth "Bearer abc.def")))
      (assert= (get conn :status) 401)))

  (test "basic-auth-creds decodes the Basic header to user:pass"
    (assert= (basic-auth-creds (conn-with-auth (basic "alice" "s3cret"))) "alice:s3cret"))

  (test "malformed base64 in the header fails closed to nil (no crash → no 500 DoS)"
    (assert= (basic-auth-creds (conn-with-auth "Basic @@@not-base64@@@")) nil))

  (test "a malformed Authorization header still yields a clean 401, not an error"
    (let (conn ((basic-auth "admin" "admin") (conn-with-auth "Basic @@@")))
      (assert= (halted? conn) true)
      (assert= (get conn :status) 401)))

  (test "a realm with a quote/newline can't break the WWW-Authenticate header"
    (let (conn ((basic-auth "admin" "admin" "ev\"il\r\nX-Injected: 1") (conn-with-auth nil))
          challenge (get-in conn [:resp-headers :www-authenticate]))
      (assert= (includes? challenge "\"") true) ; the syntactic quotes remain
      (assert= (includes? challenge "evil") true) ; the realm text, minus the stray quote
      (assert= (includes? challenge "\r") false)
      (assert= (includes? challenge "\n") false))))

;; ---- address allow-lists ----------------------------------------------------
;;
;; Behind a proxy the socket peer is the PROXY, so an allow-list compared against it admits
;; everyone or no one. The address has to come from a header the proxy sets — and is only
;; trustworthy because the proxy overwrites it.
(defn- ip-conn (headers)
  (build {:method "GET" :path "/dashboard" :query "" :params {} :headers headers :body ""}))

(describe "client-ip"
  (test "prefers the proxy's own header"
    (assert= "1.2.3.4" (client-ip (ip-conn {:fly-client-ip "1.2.3.4"}))))

  (test "falls back through the other proxy headers"
    (assert= "5.6.7.8" (client-ip (ip-conn {:x-real-ip "5.6.7.8"})))
    (assert= "9.9.9.9" (client-ip (ip-conn {:cf-connecting-ip "9.9.9.9"}))))

  ;; X-Forwarded-For is a chain; the client is the first entry.
  (test "takes the first entry of a forwarded chain"
    (assert= "1.1.1.1" (client-ip (ip-conn {:x-forwarded-for "1.1.1.1, 10.0.0.1, 10.0.0.2"}))))

  (test "no header at all means unknown"
    (is (nil? (client-ip (ip-conn {}))))))

(describe "allowed-ip?"
  (test "an allowed v4 address passes"
    (is (allowed-ip? (ip-conn {:fly-client-ip "1.2.3.4"}) ["1.2.3.4"])))

  (test "a v6 address compares case-insensitively"
    (is (allowed-ip? (ip-conn {:fly-client-ip "2C0F:EF18::1"}) ["2c0f:ef18::1"])))

  (test "a bracketed or port-suffixed address still matches"
    (is (allowed-ip? (ip-conn {:fly-client-ip "1.2.3.4:5555"}) ["1.2.3.4"]))
    (is (allowed-ip? (ip-conn {:fly-client-ip "[2c0f:ef18::1]"}) ["2c0f:ef18::1"])))

  (test "a different address does not"
    (is (not (allowed-ip? (ip-conn {:fly-client-ip "1.2.3.5"}) ["1.2.3.4"]))))

  ;; A gate that cannot identify the caller must not admit them.
  (test "an unknown address is not allowed"
    (is (not (allowed-ip? (ip-conn {}) ["1.2.3.4"]))))

  (test "an empty list allows nothing"
    (is (not (allowed-ip? (ip-conn {:fly-client-ip "1.2.3.4"}) [])))))

(describe "allow-ips"
  ;; 404 rather than 403: a 403 confirms the endpoint exists and is worth attacking.
  (test "a stranger gets 404, not 403"
    (let (resp ((allow-ips ["1.2.3.4"]) (ip-conn {:fly-client-ip "9.9.9.9"})))
      (assert= 404 (get resp :status))
      (is (halted? resp))))

  (test "an allowed address passes through unhalted"
    (let (resp ((allow-ips ["1.2.3.4"]) (ip-conn {:fly-client-ip "1.2.3.4"})))
      (is (not (halted? resp))))))

;; An IPv6 privacy address rotates its HOST half — the same machine on the same network
;; appears as a different address within a day. An allow-list of exact addresses locks its
;; owner out, which is not hypothetical: it happened within an hour of the first one being
;; set on hive.
(describe "allowed-ip? matches an IPv6 prefix"
  (defn- from (address) (ip-conn {:fly-client-ip address}))

  (test "a rotated host half still matches its /64"
    (let (allowed ["2c0f:ef18:1b2e:0::/64"])
      (is (allowed-ip? (from "2c0f:ef18:1b2e:0:231b:2728:665b:78a9") allowed))
      (is (allowed-ip? (from "2c0f:ef18:1b2e:0:5d71:db2c:e7f6:f054") allowed))))

  (test "a different network does not match"
    (is (not (allowed-ip? (from "2c0f:ef18:9999:0:231b:2728:665b:78a9") ["2c0f:ef18:1b2e:0::/64"]))))

  (test "a shorter prefix matches more"
    (is (allowed-ip? (from "2c0f:ef18:9999:0:1:2:3:4") ["2c0f:ef18::/32"])))

  (test "exact addresses still work alongside prefixes"
    (let (allowed ["1.2.3.4" "2c0f:ef18:1b2e:0::/64"])
      (is (allowed-ip? (from "1.2.3.4") allowed))
      (is (allowed-ip? (from "2c0f:ef18:1b2e:0:aaaa:bbbb:cccc:dddd") allowed))
      (is (not (allowed-ip? (from "1.2.3.5") allowed)))))

  ;; Not a guess: a prefix length this cannot evaluate is not a match.
  (test "a non-multiple-of-16 prefix is refused rather than approximated"
    (is (not (allowed-ip? (from "2c0f:ef18:1b2e:0:1:2:3:4") ["2c0f:ef18:1b2e:0::/60"]))))

  (test "a v4 address never matches a v6 prefix"
    (is (not (allowed-ip? (from "1.2.3.4") ["2c0f:ef18::/32"])))))
