(defmodule web-session-test
  (:use web/session)
  ; build, get-cookie, conn->response — drive the plug end to end
  (:use web/conn)
  (:use test))

(def *secret* "test-secret-key")

(defn conn-with (cookie)
  "A fresh GET conn carrying `_hatch_session=<cookie>` (or no cookie when nil)."
  (build {:method "GET"
          :path "/"
          :query ""
          :params {}
          :headers (if (nil? cookie) {} {:cookie (str "_hatch_session=" cookie)})
          :body ""}))

(defn session-cookie-value (r)
  "The session cookie's value from a response's first Set-Cookie line (drops attributes)."
  (let (sc (first (get (get r :headers) :set-cookie))
        eq (index-of sc "=")
        tail (string/substring sc (+ eq 1) (string/length sc))
        semi (index-of tail ";"))
    (string/substring tail 0 semi)))

(describe "encode / decode round-trip"
  (test "round-trips a string-keyed map"
    (assert= (decode-session *secret* (encode-session *secret* {"user" "alice" "role" "admin"}))
      {"user" "alice" "role" "admin"}))
  (test "empty session round-trips to empty"
    (assert= (decode-session *secret* (encode-session *secret* {})) {}))
  (test "round-trips non-string values (int, bool, nested map)"
    (assert= (decode-session *secret*
               (encode-session *secret* {"n" 42 "ok" true "u" {"name" "ada"}}))
      {"n" 42 "ok" true "u" {"name" "ada"}})))

(describe "signature verification"
  (test "tampered payload is rejected → empty session"
    (let (cookie (encode-session *secret* {"user" "alice"})
          tampered (str cookie "x"))
      (assert= (decode-session *secret* tampered) {})))
  (test "wrong secret is rejected → empty session"
    (assert= (decode-session "other-secret" (encode-session *secret* {"user" "alice"})) {}))
  (test "garbage cookie → empty session"
    (assert= (decode-session *secret* "not-a-valid-cookie") {}))
  (test "absent cookie → empty session"
    (assert= (decode-session *secret* nil) {})))

(describe "fetch-session plug"
  (test "no cookie → empty :session"
    (let (conn ((fetch-session *secret*) (conn-with nil)))
      (assert= (get conn :session) {})))
  (test "loads an existing signed session"
    (let (cookie (encode-session *secret* {"user" "bob"})
          conn ((fetch-session *secret*) (conn-with cookie)))
      (assert= (get-session conn "user") "bob")))
  (test "unchanged session writes no Set-Cookie"
    (let (conn ((fetch-session *secret*) (conn-with nil))
          r (conn->response conn))
      (assert= (get (get r :headers) :set-cookie) nil)))
  (test "changed session is re-signed and round-trips"
    (let (conn (put-session ((fetch-session *secret*) (conn-with nil)) "user" "carol")
          r (conn->response conn))
      (assert= (decode-session *secret* (session-cookie-value r)) {"user" "carol"}))))

; ---- the SessionStore seam ------------------------------------------------------------
;
; A second store, server-side: the cookie carries only an id, the data is a row in a table.
; It is here rather than in `src/` because a server-side session is per-node and hatch does
; not ship one — but it is a REAL implementation of the ability, and writing it here is what
; proves the seam is usable by someone outside this module.

(def *rows* (table/new))

(defrecord table-store (secret fresh-id))

(impl SessionStore
  web-session-test/table-store
  (session-read [store conn]
    (let (id (get-cookie conn "_sid"))
      (if (nil? id) {} (table/get *rows* id {}))))
  (session-write [store conn data]
    ;; a fresh session with no cookie yet gets an id from the store's own field, so each
    ;; test can own one (the suite runs concurrently over a shared `*rows*`)
    (let (id (or (get-cookie conn "_sid") (table-store-fresh-id store)))
      (if (= (count data) 0)
        (do (table/put *rows* id {}) (delete-cookie conn "_sid"))
        (do (table/put *rows* id data) (put-cookie conn "_sid" id))))))

(defn conn-with-sid (id)
  (build {:method "GET"
          :path "/"
          :query ""
          :params {}
          :headers (if (nil? id) {} {:cookie (str "_sid=" id)})
          :body ""}))

(describe "SessionStore: fetch-session takes a store, not only a secret"
  (test "a bare secret still means the cookie store"
    (let (plug (fetch-session *secret*)
          conn (plug (conn-with nil)))
      (is (record? (get conn :session-store)))
      (assert= (->string (get conn :session-store)) "#<session cookie-store _hatch_session>")))

  (test "reads through the store's own impl"
    (do
      (table/put *rows* "sid-read" {"user" "dora"})
      (let (conn ((fetch-session (table-store *secret* "sid-read")) (conn-with-sid "sid-read")))
        (assert= (get-session conn "user") "dora"))))

  (test "writes through the store's own impl, and not into a cookie"
    (let (store (table-store *secret* "sid-write")
          conn (put-session ((fetch-session store) (conn-with-sid "sid-write")) "user" "erin")
          r (conn->response conn))
      ;; the data went to the row, and the cookie carries only the id
      (assert= (table/get *rows* "sid-write") {"user" "erin"})
      (assert= (session-cookie-value r) "sid-write")))

  (test "a fresh session gets an id from the store, with no cookie to read"
    (let (store (table-store *secret* "sid-fresh")
          conn (put-session ((fetch-session store) (conn-with-sid nil)) "user" "fay"))
      (conn->response conn)
      (assert= (table/get *rows* "sid-fresh") {"user" "fay"})))

  ;; The contract that makes logout work: an empty session is the store's cue to END the
  ;; session, not to persist a blank one.
  (test "clear-session hands the store an empty map"
    (do
      (table/put *rows* "sid-clear" {"user" "erin"})
      (let (store (table-store *secret* "sid-clear")
            conn (clear-session ((fetch-session store) (conn-with-sid "sid-clear"))))
        (conn->response conn)
        (assert= (table/get *rows* "sid-clear") {}))))

  (test "an unchanged session is never handed to the store"
    (do
      (table/put *rows* "sid-quiet" {"user" "erin"})
      (let (store (table-store *secret* "sid-quiet")
            conn ((fetch-session store) (conn-with-sid "sid-quiet"))
            r (conn->response conn))
        ;; nothing written, so no Set-Cookie at all, and the row is untouched
        (assert= (get (get r :headers) :set-cookie) nil)
        (assert= (table/get *rows* "sid-quiet") {"user" "erin"})))))

(describe "session accessors"
  (test "get-session default when absent"
    (assert= (get-session ((fetch-session *secret*) (conn-with nil)) "x" "def") "def"))
  (test "delete-session removes a key"
    (let (conn (-> ((fetch-session *secret*) (conn-with nil))
                 (put-session "a" "1")
                 (put-session "b" "2")
                 (delete-session "a")))
      (assert= (get-session conn "a") nil)
      (assert= (get-session conn "b") "2")))
  (test "clear-session expires the cookie (Max-Age=0), not an empty signed session"
    (let (cookie (encode-session *secret* {"user" "z"})
          conn (clear-session ((fetch-session *secret*) (conn-with cookie)))
          sc (first (get (get (conn->response conn) :headers) :set-cookie)))
      ; the browser is told to drop the cookie, and there's no decodable session left
      (assert= (includes? sc "Max-Age=0") true)
      (assert= (decode-session *secret* (session-cookie-value (conn->response conn))) {})))
  (test "rotate-session discards all prior keys (fixation defense) and marks dirty"
    (let (conn (-> ((fetch-session *secret*) (conn-with (encode-session *secret* {"_csrf" "leaked"})))
                 (rotate-session)
                 (put-session "user_id" "42")))
      ; the pre-auth token is gone; only the freshly-set state remains
      (assert= (get-session conn "_csrf") nil)
      (assert= (get-session conn "user_id") "42")
      (assert= (get conn :session-changed?) true))))

; A weak or missing signing secret is fine in dev but a boot-stopping error in prod — a
; forgeable signature means forgeable sessions (auth bypass).
(describe "check-secret (weak-secret guard)"
  (def strong "0123456789abcdef0123456789abcdef") ; 32 chars
  (test "a strong secret is accepted in every environment"
    (assert= (check-secret strong true) strong)
    (assert= (check-secret strong false) strong))
  (test "dev falls back to the labeled dev default only when the secret is missing"
    (assert= (check-secret nil true) *dev-secret*)
    ; a present secret is used as-is in dev, even if weak (dev is permissive)
    (assert= (check-secret "short" true) "short"))
  (test "prod raises on a missing secret"
    (assert= (check-allow :discarded-catch (try (do (check-secret nil false) false) (catch _ true)))
      true))
  (test "prod raises on a too-short secret"
    (assert= (check-allow :discarded-catch
               (try (do (check-secret "short" false) false) (catch _ true)))
      true)))

(describe "flash one-shot lifetime"
  (test "put-flash on request 1 → readable on request 2 → gone on request 3"
    (let (
          ; request 1: stash a flash, redirect (write session cookie)
          c1 (put-flash ((fetch-session *secret*) (conn-with nil)) "info" "Saved!")
          cookie1 (session-cookie-value (conn->response c1))
          ; request 2: fetch-flash exposes it, then clears it from the session
          c2 (fetch-flash ((fetch-session *secret*) (conn-with cookie1)))
          cookie2 (session-cookie-value (conn->response c2))
          ; request 3: the flash is gone
          c3 (fetch-flash ((fetch-session *secret*) (conn-with cookie2))))
      (assert= (get-flash c2 "info") "Saved!")
      (assert= (get-flash c3 "info") nil)))
  (test "get-flash default when no flash"
    (assert= (get-flash (fetch-flash ((fetch-session *secret*) (conn-with nil))) "info" "—") "—"))
  (test "multiple flash keys both survive to the next request"
    (let (c1 (-> ((fetch-session *secret*) (conn-with nil))
               (put-flash "info" "saved")
               (put-flash "error" "careful"))
          cookie (session-cookie-value (conn->response c1))
          c2 (fetch-flash ((fetch-session *secret*) (conn-with cookie))))
      (assert= (get-flash c2 "info") "saved")
      (assert= (get-flash c2 "error") "careful"))))

(describe "session cookie Secure flag"
  ; Default tracks the environment: not Secure in dev (so local HTTP works), Secure outside
  ; dev. The test env has no $HATCH_ENV, so it reads as dev.
  (test "dev default is not Secure"
    (assert= (secure-cookie-default?) false)
    (assert= (get (session-cookie-opts {}) :secure) false))
  (test "an explicit :secure opt overrides the default"
    (assert= (get (session-cookie-opts {:secure true}) :secure) true)))

(describe "session expiry (__exp__)"
  (test "an expired cookie decodes to an empty session"
    (let (cookie (encode-session *secret* {"user" "x" "__exp__" 1}))
      ; exp = 1ms past epoch
      (assert= (decode-session *secret* cookie) {})))
  (test "a live cookie decodes to the data with __exp__ stripped"
    (let (cookie (encode-session *secret* {"user" "x" "__exp__" (+ (os/now) 100000)}))
      (assert= (decode-session *secret* cookie) {"user" "x"})))
  (test "with-expiry always stamps __exp__ (default lifetime when no :max-age)"
    ; a signed session must always carry a deadline — a captured cookie can't be valid forever
    (let (default (with-expiry {"a" "1"} {}))
      (assert= (get default "a") "1")
      (assert= (> (get default "__exp__") (os/now)) true))
    (let (stamped (with-expiry {"a" "1"} {:max-age 60}))
      (assert= (get stamped "a") "1")
      (assert= (> (get stamped "__exp__") (os/now)) true)))
  ; a legacy cookie signed with no __exp__ still decodes (can't retroactively change issued
  ; cookies) — but every newly WRITTEN session now carries one via with-expiry above
  (test "a cookie with no __exp__ still decodes (legacy compatibility)"
    (assert= (decode-session *secret* (encode-session *secret* {"user" "y"})) {"user" "y"})))

;; A SIGNED cookie proves the value came from this app; it does not hide it. The payload is
;; base64 anyone holding the cookie can read, which matters as soon as a session carries
;; something the holder should not see — a one-shot token in a flash, an email, a role.
;; `:encrypt true` seals it instead. ChaCha20-Poly1305 authenticates as well as encrypts, so
;; a sealed cookie needs no separate signature.
(describe "encrypted sessions"
  (def *sec* "a-strong-enough-secret-for-tests-0123456789")

  (test "a sealed cookie round-trips"
    (let (cookie (encode-session *sec* {"user_id" 7 "role" "admin"} {:encrypt true}))
      (assert= {"user_id" 7 "role" "admin"} (decode-session *sec* cookie))))

  ;; The property the whole thing exists for.
  (test "the contents are not readable from the cookie"
    (let (cookie (encode-session *sec* {"token" "super-secret-value"} {:encrypt true})
          last-dot (string/last-index-of cookie ".")
          ciphertext (encoding/base64-url-decode-bytes (string/substring cookie
                                                         (+ last-dot 1)
                                                         (string/length cookie)))
          plaintext (string/->bytes (json/encode {"token" "super-secret-value"})))
      (is (not (includes? cookie "super-secret-value")))
      ;; compared as BYTES: the ciphertext is not text, which is the point — decoding it as
      ;; UTF-8 raises, so the check is that it is not the plaintext rather than what it reads as
      (is (bytes? ciphertext))
      (is (not (= (vec (if (bytes? ciphertext) ciphertext (bytes))) (vec plaintext))))))

  (test "a signed cookie, by contrast, is readable — which is why this option exists"
    (let (cookie (encode-session *sec* {"token" "super-secret-value"} {})
          payload (string/substring cookie 0 (index-of cookie ".")))
      (let (decoded (encoding/base64-url-decode payload))
        (is (string? decoded))
        (is (includes? (if (string? decoded) decoded "") "super-secret-value")))))

  (test "a tampered ciphertext does not open"
    (let (cookie (encode-session *sec* {"user_id" 7} {:encrypt true})
          flipped (str (string/substring cookie 0 (- (string/length cookie) 2)) "AA"))
      (assert= {} (decode-session *sec* flipped))))

  (test "another secret does not open it"
    (let (cookie (encode-session *sec* {"user_id" 7} {:encrypt true}))
      (assert= {} (decode-session "a-different-secret-entirely-9876543210" cookie))))

  (test "a truncated or malformed sealed cookie reads as an empty session, not an error"
    (assert= {} (decode-session *sec* "E1."))
    (assert= {} (decode-session *sec* "E1.notbase64!!.alsonot"))
    (assert= {} (decode-session *sec* "E1.onlyonepart")))

  ;; Turning encryption on must not sign everyone out: the cookies already in browsers are
  ;; signed, and each is replaced with a sealed one the next time its session changes.
  (test "a signed cookie still opens when the app has switched to sealing"
    (let (signed (encode-session *sec* {"user_id" 7} {}))
      (assert= {"user_id" 7} (decode-session *sec* signed))))

  (test "expiry is enforced for a sealed cookie too"
    (let (expired (encode-session *sec* {"user_id" 7 "__exp__" (- (os/now) 1000)} {:encrypt true}))
      (assert= {} (decode-session *sec* expired))))

  ;; The key derivation is a 600k-iteration pbkdf2 — right to pay once, absurd per request.
  (test "the derived key is memoised, so sealing is not a KDF per write"
    (let (t0 (os/now)
          _ (for (i (range 20)) (encode-session *sec* {"n" i} {:encrypt true}))
          elapsed (- (os/now) t0))
      (is (< elapsed 500)))))
