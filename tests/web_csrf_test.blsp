(defmodule web-csrf-test
  (:use web/csrf)
  (:alias web/session)
  (:use web/conn)
  (:use test))

(def secret "csrf-test-secret")

(defn form-encode (m)
  "Encode a string→string map as an x-www-form-urlencoded body (test values are token-safe)."
  (string/join "&" (map (fn (kv) (str (nth kv 0) "=" (nth kv 1))) (map-pairs m))))

(defn fresh (method opts)
  "A conn that has run fetch-session (empty session) for `method`. `opts` may carry:
   :params      — query-string params (string-keyed);
   :body-params — form body params (string-keyed), sent as x-www-form-urlencoded;
   :headers     — request headers (keyword-keyed)."
  (let (bp (get opts :body-params {})
        headers (if (empty? bp)
                  (get opts :headers {})
                  (assoc (get opts :headers {})
                    :content-type "application/x-www-form-urlencoded")))
    ((session/fetch-session secret) (build {:method method
                                            :path "/x"
                                            :query ""
                                            :params (get opts :params {})
                                            :headers headers
                                            :body (form-encode bp)}))))

(describe "protect-from-forgery"
  (test "GET is never blocked and mints a session token"
    (let (conn (protect-from-forgery (fresh "GET" {})))
      (assert= (halted? conn) false)
      (assert= (nil? (token conn)) false)))
  (test "POST without a token is rejected — 403, halted, and mints no token (no cookie churn)"
    (let (conn (protect-from-forgery (fresh "POST" {})))
      (assert= (halted? conn) true)
      (assert= (get conn :status) 403)
      ; a rejected unsafe request must not mint a token / dirty the session
      (assert= (nil? (token conn)) true)))
  (test "POST with the matching token (in the form body) passes"
    (let (conn (session/put-session (fresh "POST" {:body-params {"_csrf_token" "tok-123"}})
                 "_csrf" "tok-123")
          out (protect-from-forgery conn))
      (assert= (halted? out) false)))
  (test "POST with a wrong token is rejected"
    (let (conn (session/put-session (fresh "POST" {:body-params {"_csrf_token" "wrong"}})
                 "_csrf" "right")
          out (protect-from-forgery conn))
      (assert= (halted? out) true)
      (assert= (get out :status) 403)))
  (test "a token supplied only in the query string is NOT accepted (would leak via the URL)"
    (let (conn (session/put-session (fresh "POST" {:params {"_csrf_token" "tok-123"}})
                 "_csrf" "tok-123")
          out (protect-from-forgery conn))
      (assert= (halted? out) true)
      (assert= (get out :status) 403)))
  (test "the token may be supplied via the X-CSRF-Token header"
    (let (conn (session/put-session (fresh "POST" {:headers {:x-csrf-token "h-tok"}})
                 "_csrf" "h-tok")
          out (protect-from-forgery conn))
      (assert= (halted? out) false)))
  (test "PUT/PATCH/DELETE are also protected"
    (assert= (halted? (protect-from-forgery (fresh "PUT" {}))) true)
    (assert= (halted? (protect-from-forgery (fresh "DELETE" {}))) true)))

(describe "token reuse"
  (test "ensure-token keeps the same token across requests (no churn)"
    (let (g (protect-from-forgery (fresh "GET" {}))
          tok (token g))
      ; a conn whose session already has the token is left unchanged
      (assert= (token (protect-from-forgery (session/put-session (fresh "GET" {}) "_csrf" tok)))
        tok))))

(describe "csrf-input"
  (test "renders a hidden field with the session token"
    (let (conn (session/put-session (fresh "GET" {}) "_csrf" "abc")
          node (csrf-input conn))
      (assert= node [:input {:type "hidden" :name "_csrf_token" :value "abc"}]))))
