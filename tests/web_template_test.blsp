(defmodule web-template-test (:use web/template) (:use test))

(describe "escape-html"
  (test "ampersand" (assert= (escape-html "&") "&amp;"))
  (test "less-than" (assert= (escape-html "<") "&lt;"))
  (test "greater-than" (assert= (escape-html ">") "&gt;"))
  (test "double-quote" (assert= (escape-html "\"") "&quot;"))
  (test "single-quote" (assert= (escape-html "'") "&#39;"))
  (test "mixed" (assert= (escape-html "<b>") "&lt;b&gt;"))
  (test "safe string" (assert= (escape-html "hello") "hello"))
  (test "amp first" (assert= (escape-html "a&b<c") "a&amp;b&lt;c")))

(describe "raw"
  (test "bypass escaping"
    (assert= (render (raw "<b>bold</b>")) "<b>bold</b>"))
  (test "raw? predicate"
    (assert= (raw? (raw "x")) true))
  (test "plain string is not raw"
    (assert= (raw? "x") false))
  (test "a look-alike map does NOT bypass escaping"
    ;; raw is identified by record identity, so a map that merely carries the wrapper key
    ;; (an app model, a decoded JSON body) is ordinary data and gets escaped.
    (is (not (raw? {:__raw__ "<script>alert(1)</script>"})))
    (is (includes? (render {:__raw__ "<script>alert(1)</script>"}) "&lt;script&gt;")))
  (test "a raw node prints as itself, not as its wrapper"
    (assert= (->string (raw "<b>")) "#<raw \"<b>\">")))

;; The extension seam: a type the framework has never heard of renders itself.
(defrecord money (cents))

(impl Renderable
  web-template-test/money
  (render-html [m] (str "<span class=\"money\">$" (math/quot (get m :cents) 100) "</span>")))

(defrecord plain-thing (v))

(describe "Renderable"
  (test "a record with an impl renders as its own HTML"
    (assert= (render (money 250)) "<span class=\"money\">$2</span>"))
  (test "it composes inside an element and a list"
    (assert= (render [:p "cost: " (money 500)])
      "<p>cost: <span class=\"money\">$5</span></p>"))
  (test "render-html is callable directly"
    (assert= (render-html (money 100)) "<span class=\"money\">$1</span>"))
  (test "a record with NO impl falls back to the escaped str, exactly as before"
    ;; the provided default — unchanged behaviour for every type that has not opted in
    (is (includes? (render (plain-thing "<x>")) "&lt;x&gt;"))))

(describe "render: primitives"
  (test "nil is empty" (assert= (render nil) ""))
  (test "string escaped" (assert= (render "<x>") "&lt;x&gt;"))
  (test "integer" (assert= (render 42) "42"))
  (test "float" (assert= (render 3.14) "3.14")))

(describe "render: simple elements"
  (test "div no attrs"
    (assert= (render [:div {} "hello"]) "<div>hello</div>"))
  (test "span with class"
    (assert= (render [:span {:class "foo"} "bar"]) "<span class=\"foo\">bar</span>"))
  (test "empty element"
    (assert= (render [:p {}]) "<p></p>"))
  (test "nested children"
    (assert= (render [:div {} [:span {} "a"] [:span {} "b"]])
      "<div><span>a</span><span>b</span></div>"))
  (test "text escaping in children"
    (assert= (render [:p {} "<script>"]) "<p>&lt;script&gt;</p>")))

(describe "render: void elements"
  (test "br" (assert= (render [:br {}]) "<br>"))
  (test "hr" (assert= (render [:hr {}]) "<hr>"))
  (test "input starts with tag"
    (assert= (string/starts-with? (render [:input {:type "text"}]) "<input") true))
  (test "input contains type attr"
    (assert= (includes? (render [:input {:type "text"}]) "type=\"text\"") true))
  (test "img is void"
    (assert= (includes? (render [:img {:src "/x.png" :alt "X"}]) "<img") true))
  (test "img src attr"
    (assert= (includes? (render [:img {:src "/x.png" :alt "X"}]) "src=\"/x.png\"") true))
  (test "img alt attr"
    (assert= (includes? (render [:img {:src "/x.png" :alt "X"}]) "alt=\"X\"") true))
  (test "link rel attr"
    (assert= (includes? (render [:link {:rel "stylesheet" :href "/x.css"}]) "rel=\"stylesheet\"")
      true)))

(describe "render: boolean attrs"
  (test "checked true present"
    (assert= (includes? (render [:input {:type "checkbox" :checked true}]) "checked") true))
  (test "disabled false omitted"
    (assert= (includes? (render [:input {:type "text" :disabled false}]) "disabled") false))
  (test "attr nil omitted"
    (assert= (render [:span {:id nil} "x"]) "<span>x</span>")))

(describe "render: class vector"
  (test "class list joined"
    (assert= (render [:div {:class ["foo" "bar"]} "x"])
      "<div class=\"foo bar\">x</div>")))

(describe "render: URL-attribute scheme sanitization"
  (test "javascript: href is neutralized to #"
    (assert= (includes? (render [:a {:href "javascript:alert(1)"}]) "href=\"#\"") true))
  (test "obfuscated javascript: (leading space, mixed case) is neutralized"
    (assert= (includes? (render [:a {:href "  JaVaScRiPt:alert(1)"}]) "href=\"#\"") true))
  (test "whitespace-split javascript: scheme is neutralized"
    (assert= (safe-url "java\tscript:alert(1)") "#"))
  (test "a normal https href passes through"
    (assert= (includes? (render [:a {:href "https://example.com/x"}])
               "href=\"https://example.com/x\"")
      true))
  (test "a relative href passes through"
    (assert= (includes? (render [:a {:href "/dashboard"}]) "href=\"/dashboard\"") true))
  (test "a legitimate data: image src passes through"
    (assert= (includes? (render [:img {:src "data:image/png;base64,AAAA"}])
               "src=\"data:image/png;base64,AAAA\"")
      true))
  (test "a data:text/html href (script document) is neutralized to #"
    (assert= (includes? (render [:a {:href "data:text/html,<script>alert(1)</script>"}])
               "href=\"#\"")
      true))
  (test "a data:image/svg+xml URL (SVG can carry script) is neutralized to #"
    (assert= (safe-url "data:image/svg+xml,<svg onload=alert(1)>") "#"))
  (test "a type-less data: URL is neutralized to #"
    (assert= (safe-url "data:,hello") "#"))
  (test "an obfuscated data:text/html (leading space, mixed case) is neutralized"
    (assert= (safe-url "  DaTa:text/html,<script>alert(1)</script>") "#"))
  (test "a non-URL attribute is not treated as a URL"
    (assert= (includes? (render [:div {:title "javascript:not-a-url"}]) "javascript:not-a-url")
      true))
  ; an attribute NAME derived from untrusted input that tries to break out is dropped
  (test "an attribute name containing a quote/space is dropped entirely"
    (assert= (render [:div {(keyword "x\" onmouseover=\"alert(1)") "y"}]) "<div></div>"))
  (test "a normal hyphenated data- attribute name is kept"
    (assert= (includes? (render [:div {:data-cid "c1"}]) "data-cid=\"c1\"") true)))

(describe "render: lists of children"
  (test "list rendered as concatenation"
    (let (items ["a" "b" "c"]
          node [:ul {} (map (fn (x) [:li {} x]) items)])
      (assert= (render node) "<ul><li>a</li><li>b</li><li>c</li></ul>")))
  (test "nested list flattened"
    (assert= (render [:div {} (list [:span {} "1"] [:span {} "2"])])
      "<div><span>1</span><span>2</span></div>")))

(describe "render: no attrs shorthand"
  (test "attrs map optional"
    (assert= (render [:p {} "hi"]) "<p>hi</p>")))

(describe "html"
  (test "prepends doctype"
    (let (r (html [:html {} [:body {} "x"]]))
      (assert= (string/starts-with? r "<!DOCTYPE html>") true)))
  (test "contains element content"
    (let (r (html [:p {} "hello"]))
      (assert= (includes? r "<p>hello</p>") true))))

(describe "stylesheet"
  (test "renders a void rel=stylesheet link to the href"
    (let (r (render (stylesheet "/static/app.css")))
      (assert= (string/starts-with? r "<link") true)
      (assert= (includes? r "rel=\"stylesheet\"") true)
      (assert= (includes? r "href=\"/static/app.css\"") true))))
