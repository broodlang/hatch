;; web/cache — validators and freshness for dynamic responses.
;;
;; The failure this module exists for is silent: `no-cache` is CORRECT on a page whose nav
;; changes with the session, but with no validator on it every mandated revalidation is a
;; full 200 with the whole body. Nothing errors; the bytes just go out again, forever.
(defmodule web-cache-test (:use test) (:use web/cache) (:use web/conn) (:alias web/cluster))

(defn- req (&optional (headers {}))
  (build {:method "GET" :path "/" :query "" :params {} :headers headers :body ""}))

(defn- resp (&optional (body "hello world") (headers {}))
  {:status 200 :body body :headers headers})

(describe "strong-etag"
  (test "is content-addressed — same bytes, same tag"
    (assert= (strong-etag "abc") (strong-etag "abc")))
  (test "different bytes, different tag"
    (is (not (= (strong-etag "abc") (strong-etag "abd")))))
  (test "is quoted, as an entity-tag must be"
    (is (string/starts-with? (strong-etag "abc") "\""))
    (is (string/ends-with? (strong-etag "abc") "\""))))

;; RFC 9110 §8.8.3: an ETag identifies a REPRESENTATION. A br body and a gzip body of the
;; same page are different representations; a validator that ignored the coding would match
;; across them, and a client could revalidate a br entity over a gzip connection, be told
;; 304, and decode the wrong bytes.
(describe "etag-for distinguishes content codings"
  (test "each coding gets its own tag"
    (let (identity-tag (etag-for "body" nil)
          gzip-tag (etag-for "body" "gzip")
          br-tag (etag-for "body" "br"))
      (is (not (= identity-tag gzip-tag)))
      (is (not (= gzip-tag br-tag)))
      (is (not (= identity-tag br-tag)))))
  (test "the coding rides inside the quotes"
    (is (string/ends-with? (etag-for "body" "br") "-br\"")))
  (test "an empty coding is identity"
    (assert= (etag-for "body" nil) (etag-for "body" ""))))

(describe "not-modified?"
  (test "an exact match"
    (is (not-modified? (req {:if-none-match (strong-etag "x")}) (strong-etag "x"))))
  (test "a different tag does not match"
    (is (not (not-modified? (req {:if-none-match "\"other\""}) (strong-etag "x")))))
  (test "one tag among a list matches"
    (is (not-modified? (req {:if-none-match "\"a\", \"b\", \"c\""}) "\"b\"")))
  ;; §13.1.2 prescribes WEAK comparison for If-None-Match, so W/ matches its strong twin.
  (test "a weak tag matches its strong twin"
    (is (not-modified? (req {:if-none-match "W/\"abc\""}) "\"abc\"")))
  (test "the wildcard matches anything"
    (is (not-modified? (req {:if-none-match "*"}) "\"whatever\"")))
  (test "no header means no match"
    (is (not (not-modified? (req) "\"abc\"")))))

(describe "conditional"
  (test "a first request is tagged and sent"
    (let ([outcome tagged] (conditional (req) (resp) nil))
      (assert= :send outcome)
      (is (not (nil? (get (get tagged :headers) :etag))))))

  (test "a client holding the representation gets a bodyless 304"
    (let ([_ tagged] (conditional (req) (resp) "br")
          tag (get (get tagged :headers) :etag)
          [outcome not-modified] (conditional (req {:if-none-match tag}) (resp) "br"))
      (assert= :not-modified outcome)
      (assert= 304 (get not-modified :status))
      (assert= "" (get not-modified :body))
      (assert= tag (get (get not-modified :headers) :etag))))

  ;; Holding the gzip representation says nothing about the br one.
  (test "a tag from another coding does not satisfy the request"
    (let ([_ gzipped] (conditional (req) (resp) "gzip")
          gzip-tag (get (get gzipped :headers) :etag)
          [outcome _] (conditional (req {:if-none-match gzip-tag}) (resp) "br"))
      (assert= :send outcome)))

  (test "the 304 keeps caching metadata and drops content headers"
    (let (source (resp "hello world"
                   {:cache-control "private, no-cache"
                    :vary "Cookie"
                    :content-type "text/html"})
          [_ tagged] (conditional (req) source nil)
          tag (get (get tagged :headers) :etag)
          [_ not-modified] (conditional (req {:if-none-match tag}) source nil)
          headers (get not-modified :headers))
      (assert= "private, no-cache" (get headers :cache-control))
      (assert= "Cookie" (get headers :vary))
      (is (nil? (get headers :content-type)))))

  (test "an ETag a handler already chose is left alone"
    (let ([_ untouched] (conditional (req) (resp "b" {:etag "\"handler\""}) nil))
      (assert= "\"handler\"" (get (get untouched :headers) :etag))))

  (test "a non-string body is passed through untagged"
    (let ([outcome untouched] (conditional (req)
                                {:status 200 :body (string/->bytes "x") :headers {}}
                                nil))
      (assert= :send outcome)
      (is (nil? (get (get untouched :headers) :etag)))))

  (test "a redirect is not tagged"
    (let ([_ untouched] (conditional (req) {:status 302 :body "" :headers {}} nil))
      (is (nil? (get (get untouched :headers) :etag))))))

(describe "cache-control constructors"
  (test "immutable never revalidates"
    (is (includes? (immutable) "immutable"))
    (is (includes? (immutable) "max-age=31536000")))
  (test "public-for bounds staleness"
    (assert= "public, max-age=60" (public-for 60)))
  ;; no-store is not no-cache: one forbids keeping it, the other requires revalidating it.
  (test "no-store forbids storage"
    (assert= "no-store" (no-store)))
  (test "put-cache-control never overrides a handler's own choice"
    (assert= "public, max-age=5"
      (get (get (put-cache-control {:headers {:cache-control "public, max-age=5"}} "no-store")
             :headers)
        :cache-control))))

;; ---- memoised fragments -----------------------------------------------------
;;
;; The half of caching no `Cache-Control` covers: work the SERVER repeats. A validator makes
;; a repeat visit cheap for the client, but the response must still be built to know its
;; ETag — so a page whose content cannot change is rebuilt in full for every request.
; :serial, and a key of its own per test. The cache is one process-wide table, so `clear`
; reaches into every other test in this group: run in parallel on a shared key `:k`, a
; neighbour's `clear` lands between this test's `fetch` and its assertion and the rebuild it
; asserts never happens. That failed roughly one run in four before both halves of this were
; fixed — rare enough to read as a fluke, which is how a flaky test earns its keep.
(describe "fetch"
  :serial (test "computes once and reuses"
    (invalidate :reuse)
    (let (to (self)
          build (fn () (send to :built) :value))
      (assert= :value (fetch :reuse build))
      (assert= :value (fetch :reuse build))
      (assert= :value (fetch :reuse build))
      ;; exactly one build, however many asks
      (assert= 1 (receive (:built (receive (:built 2) (after 20 1))) (after 20 0)))))

  (test "keys are independent"
    (invalidate :ka)
    (invalidate :kb)
    (assert= :a (fetch :ka (fn () :a)))
    (assert= :b (fetch :kb (fn () :b)))
    (assert= :a (fetch :ka (fn () :never))))

  (test "a cached nil is still a hit, not a miss"
    (invalidate :n)
    (let (to (self))
      (fetch :n (fn () (send to :built) nil))
      (assert= nil (fetch :n (fn () (send to :built) :recomputed)))))

  (test "invalidate forces one rebuild"
    (invalidate :inv)
    (fetch :inv (fn () :first))
    (invalidate :inv)
    (assert= :second (fetch :inv (fn () :second))))

  ;; The one test `clear` is the subject of, rather than the setup — so it is also the only
  ;; one that may call it.
  (test "clear drops everything"
    (fetch :cleared (fn () :first))
    (clear)
    (assert= :second (fetch :cleared (fn () :second)))))

;; ---- compressed representations ---------------------------------------------
(describe "compressed"
  :serial (test "compresses once per key"
    (clear-compressed)
    (let (to (self)
          build (fn () (send to :built) "COMPRESSED"))
      (assert= "COMPRESSED" (compressed ["\"abc\"" "br"] build))
      (assert= "COMPRESSED" (compressed ["\"abc\"" "br"] build))
      (assert= 1 (receive (:built (receive (:built 2) (after 20 1))) (after 20 0)))))

  ;; The same bytes under a different coding are a different representation.
  (test "coding is part of the key"
    (clear-compressed)
    (assert= "br" (compressed ["\"abc\"" "br"] (fn () "br")))
    (assert= "gzip" (compressed ["\"abc\"" "gzip"] (fn () "gzip"))))

  ;; A key derives from the response BODY, and a body can vary with request input — so an
  ;; unbounded store here is a leak a stranger drives.
  (test "it is bounded"
    (clear-compressed)
    (for (i (range (+ *max-compressed* 5)))
      (compressed [(str "etag" i) "br"] (fn () (str "body" i))))
    (is (<= (count (keys (compressed-entries))) *max-compressed*))))

;; The half of caching that is charged to everyone: a page marked `private, no-cache` costs a
;; network round trip per navigation, and most visitors to most sites are signed out looking
;; at a page that is identical for all of them.
(describe "html-freshness"
  ;; Built the way the server builds one, so the cookie parsing under test is the real one.
  (defn- conn-with (method cookie)
    (web/conn/build {:method method
                     :path "/"
                     :headers (if (nil? cookie) {} {:cookie (str "_hatch_session=" cookie)})}))

  (defn- cc (resp) (get (get resp :headers {}) :cache-control))

  (test "an anonymous GET may be reused without asking"
    (let (out (html-freshness (conn-with "GET" nil) {:status 200 :headers {} :body "<h1>hi</h1>"}))
      (is (includes? (cc out) "public"))
      (is (includes? (cc out) "max-age=60"))
      (is (includes? (cc out) "stale-while-revalidate=600"))
      (is (includes? (get (get out :headers) :vary) "Cookie"))))

  (test "a request carrying a session cookie does not"
    (assert= "private, no-cache"
      (cc (html-freshness (conn-with "GET" "abc") {:status 200 :headers {} :body "<h1>hi</h1>"}))))

  ;; A login is a 200 with a Set-Cookie. Caching it publicly would hand one visitor another's
  ;; session, so it is checked on the RESPONSE as well as the request.
  (test "a response that sets a cookie is never public"
    (assert= "private, no-cache"
      (cc (html-freshness (conn-with "GET" nil)
            {:status 200 :headers {:set-cookie "_hatch_session=x"} :body "<h1>hi</h1>"}))))

  (test "only GET and HEAD, only 200"
    (assert= "private, no-cache"
      (cc (html-freshness (conn-with "POST" nil) {:status 200 :headers {} :body "ok"})))
    (assert= "private, no-cache"
      (cc (html-freshness (conn-with "GET" nil) {:status 404 :headers {} :body "no"})))
    (assert= "private, no-cache"
      (cc (html-freshness (conn-with "GET" nil) {:status 302 :headers {} :body ""}))))

  (test "a handler's own choice and a non-HTML body are both left alone"
    (assert= "no-store"
      (cc (html-freshness (conn-with "GET" nil)
            {:status 200 :headers {:cache-control "no-store"} :body "x"})))
    (assert= nil
      (cc (html-freshness (conn-with "GET" nil)
            {:status 200 :headers {:content-type "application/json"} :body "{}"}))))

  (test "vary merges rather than replacing"
    (assert= "Accept-Encoding, Cookie"
      (get (get (html-freshness (conn-with "GET" nil)
                  {:status 200 :headers {:vary "Accept-Encoding"} :body "<p>x</p>"})
             :headers)
        :vary))
    ;; already present, in any case — left as the other layer wrote it
    (assert= "cookie"
      (get (get (html-freshness (conn-with "GET" nil)
                  {:status 200 :headers {:vary "cookie"} :body "<p>x</p>"})
             :headers)
        :vary)))

  ;; `get-cookie` reads the PARSED `:cookies` that `web/conn/build` fills in. A conn that
  ;; never went through it has no `:cookies` at all, and reading that as "no session" would
  ;; publish a signed-in page to a shared cache — so the raw header is the backstop.
  (test "an unparsed conn is read from its raw Cookie header, not treated as anonymous"
    (assert= "private, no-cache"
      (cc (html-freshness {:method "GET" :headers {:cookie "_hatch_session=abc"}}
            {:status 200 :headers {} :body "<h1>hi</h1>"})))
    (assert= true (session-cookie? {:headers {:cookie "a=1; _hatch_session=abc"}} "_hatch_session"))
    (assert= false (session-cookie? {:headers {:cookie "a=1; b=2"}} "_hatch_session"))
    (assert= false (session-cookie? {:headers {}} "_hatch_session"))))

;; `*` is an ALTERNATIVE to the entity-tag list in RFC 9110's grammar
;; (`If-None-Match = "*" / #entity-tag`), not a member of it — and `W/` is immediately
;; followed by the opaque-tag. Both readings used to differ between this module and
;; web/static, which is the drift that unifying them removed. Strictness is the safe
;; direction: a wrongly-issued 304 leaves a client holding a stale copy, while a
;; wrongly-issued 200 only costs bytes.
(describe "not-modified?: the malformed cases"
  (defn- inm (h) {:headers {:if-none-match h}})

  (test "* matches only as the whole header value"
    (assert= true (not-modified? (inm "*") "\"abc\""))
    (assert= true (not-modified? (inm "  *  ") "\"abc\""))
    (assert= false (not-modified? (inm "\"a\", *") "\"abc\""))
    (assert= false (not-modified? (inm "*, \"a\"") "\"abc\""))
    (assert= false (not-modified? (inm "**") "\"abc\"")))

  (test "W/ must be immediately followed by the tag"
    (assert= true (not-modified? (inm "W/\"abc\"") "\"abc\""))
    (assert= false (not-modified? (inm "W/ \"abc\"") "\"abc\"")))

  (test "the ordinary cases are unchanged"
    (assert= true (not-modified? (inm "\"abc\"") "\"abc\""))
    (assert= true (not-modified? (inm "\"x\", \"abc\", \"y\"") "\"abc\""))
    (assert= true (not-modified? (inm "  \"abc\"  ") "\"abc\""))
    (assert= false (not-modified? (inm "\"other\"") "\"abc\""))
    (assert= false (not-modified? (inm "\"abcd\"") "\"abc\""))
    (assert= false (not-modified? {:headers {}} "\"abc\""))))

;; A cache is per-node by nature, and that is the point — a lookup must not become a network
;; call. What has to cross the network is the INVALIDATION: small, rare, carrying no data.
;; Invalidating locally and stopping there is how one machine serves content another has
;; already replaced, indefinitely and silently.
(describe "cluster-aware invalidation"
  :serial (test "the listener starts, is idempotent, and survives being asked twice"
    (let (a (start-cluster)
          b (start-cluster))
      ;; `pid?`, not `(not (nil? a))`: `start-cluster` cannot answer nil now, so the old
      ;; form was true by construction and asserted nothing.
      (is (pid? a))
      (assert= a b)))

  ;; Everything here must be a no-op on a single node — most apps are one node, and a cache
  ;; that needed a cluster to work would be a cache nobody could use.
  (test "a runtime that is not a distributed node has no peers"
    (assert= [] (into [] (web/cluster/remote-nodes))))

  (test "invalidate and clear still work locally with no cluster"
    (fetch :cluster-a (fn () :first))
    (assert= :first (fetch :cluster-a (fn () :second)))
    (invalidate :cluster-a)
    (assert= :second (fetch :cluster-a (fn () :second)))
    (fetch :cluster-b (fn () :x))
    (clear)
    (assert= :rebuilt (fetch :cluster-b (fn () :rebuilt))))

  ;; The listener applies what a peer sends. Sending to it directly is exactly what a peer's
  ;; `replicate` does, so this exercises the receiving half without needing a second runtime.
  (test "a peer's invalidate message drops the entry here"
    (let (listener (start-cluster))
      (fetch :from-peer (fn () :original))
      (assert= :original (fetch :from-peer (fn () :changed)))
      (send listener [:invalidate :from-peer])
      ;; the listener is a separate process; give it a moment to apply
      (receive (after 50 nil))
      (assert= :changed (fetch :from-peer (fn () :changed)))))

  (test "a peer's clear drops everything here"
    (let (listener (start-cluster))
      (fetch :wiped-1 (fn () :a))
      (fetch :wiped-2 (fn () :b))
      (send listener [:clear])
      (receive (after 50 nil))
      (assert= :rebuilt-1 (fetch :wiped-1 (fn () :rebuilt-1)))
      (assert= :rebuilt-2 (fetch :wiped-2 (fn () :rebuilt-2)))))

  ;; An unknown message must not kill the listener — it is permanent, and a peer running a
  ;; newer hatch may send something this node does not know yet.
  (test "an unrecognised message leaves the listener alive"
    (let (listener (start-cluster))
      (send listener [:something-from-the-future 1 2 3])
      (receive (after 50 nil))
      (fetch :still-alive (fn () :v))
      (send listener [:invalidate :still-alive])
      (receive (after 50 nil))
      (assert= :rebuilt (fetch :still-alive (fn () :rebuilt))))))

;; ---- fetch-ttl ---------------------------------------------------------------
;;
;; `fetch` has no expiry, which makes it wrong for a document built from the database:
;; memoised, the first version of it is served for the life of the process unless something
;; remembers to invalidate. A TTL is wrong for at most its window, always — no matter what
;; changed or who forgot to add a hook.

(defn- counting-build (calls value)
  (fn ()
    (table/put calls :n (+ 1 (table/get calls :n 0)))
    value))

(describe "fetch-ttl"
  (test "computes once within the window"
    (let (calls (table/new)
          build (counting-build calls "v1"))
      (assert= (fetch-ttl [:ttl-test :within] 60000 build) "v1")
      (assert= (fetch-ttl [:ttl-test :within] 60000 build) "v1")
      (assert= (table/get calls :n) 1)))

  (test "recomputes once the window has passed"
    ;; A zero window expires immediately, which is the boundary worth pinning: the check is
    ;; `now < stored-deadline`, so a deadline of now is already past.
    (let (calls (table/new)
          build (counting-build calls "v1"))
      (fetch-ttl [:ttl-test :expired] 0 build)
      (fetch-ttl [:ttl-test :expired] 0 build)
      (assert= (table/get calls :n) 2)))

  (test "a fresh key always computes"
    (let (calls (table/new))
      (assert= (fetch-ttl [:ttl-test :fresh] 60000 (counting-build calls "v")) "v")
      (assert= (table/get calls :n) 1)))

  (test "invalidate reaches a ttl entry, so an explicit hook still works"
    (let (calls (table/new)
          build (counting-build calls "v"))
      (fetch-ttl [:ttl-test :invalidated] 60000 build)
      (invalidate [:ttl-test :invalidated])
      (fetch-ttl [:ttl-test :invalidated] 60000 build)
      (assert= (table/get calls :n) 2)))

  (test "it stores the value, not the wrapper — a caller never sees the bookkeeping"
    (assert= (fetch-ttl [:ttl-test :shape] 60000 (fn () {:rows [1 2 3]})) {:rows [1 2 3]}))

  (test "nil is a value and is cached like any other"
    (let (calls (table/new)
          build (counting-build calls nil))
      (assert= (fetch-ttl [:ttl-test :nil] 60000 build) nil)
      (assert= (fetch-ttl [:ttl-test :nil] 60000 build) nil)
      (assert= (table/get calls :n) 1)))

  (test "two keys do not share an entry"
    (let (calls (table/new))
      (assert= (fetch-ttl [:ttl-test :a] 60000 (counting-build calls "a")) "a")
      (assert= (fetch-ttl [:ttl-test :b] 60000 (counting-build calls "b")) "b")
      (assert= (table/get calls :n) 2))))

;; `fetch` and `fetch-ttl` share one table but store different things — a bare value, and a
;; value with its deadline. One key used with both used to read back the WRAPPER: a fragment
;; memoised one way and read the other rendered `{:value "<div>…" :ttl-at 1757…}` straight
;; into the page. Correct-looking code, visible garbage, nothing raised.
(describe "one key, one caching policy"
  (test "fetch on a key fetch-ttl wrote is an error, not a wrapper"
    (fetch-ttl [:policy :a] 60000 (fn () "the value"))
    (assert= (check-allow :discarded-catch
               (try (fetch [:policy :a] (fn () "other")) (catch _e :raised)))
      :raised))

  (test "fetch-ttl on a key fetch wrote is an error too"
    (fetch [:policy :b] (fn () "the value"))
    (assert= (check-allow :discarded-catch
               (try (fetch-ttl [:policy :b] 60000 (fn () "other")) (catch _e :raised)))
      :raised))

  ;; the whole point: neither ever hands back the other's storage shape
  (test "each still returns a plain value on its own key"
    (assert= (fetch [:policy :c] (fn () "plain")) "plain")
    (assert= (fetch [:policy :c] (fn () "rebuilt")) "plain")
    (assert= (fetch-ttl [:policy :d] 60000 (fn () "timed")) "timed")
    (assert= (fetch-ttl [:policy :d] 60000 (fn () "rebuilt")) "timed"))

  ;; a cached value that is ITSELF a map with the old marker key is just a value — which is
  ;; why the wrapper is a record and not a `{:ttl-at …}` map
  (test "a cached value shaped like the old wrapper is still just a value"
    (let (look-alike {:value "not a wrapper" :ttl-at 1})
      (assert= (fetch [:policy :e] (fn () look-alike)) look-alike)
      (assert= (fetch [:policy :e] (fn () "rebuilt")) look-alike))))
