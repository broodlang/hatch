(defmodule web-test-test
  (:use web/test)
  ; defrouter + the make-route/dispatch its expansion calls
  (:use web/router)
  ; html-resp, send-resp, halt, assign, get-assign
  (:use web/conn)
  ; deflive — an inline live view to drive
  (:use web/live)
  (:use test))

; ---- a sample router to dispatch against -----------------------------------

(defn home (conn) (html-resp conn "<h1>Home</h1>"))
; bare-string return
(defn shout (conn) "plain string body")
; no status set → defaults to 200
(defn raw (conn) conn)
(defn tag-plug (conn) (assign conn :who "admin"))
(defn whoami (conn) (html-resp conn (or (get-assign conn :who) "anon")))
(defn deny (conn) (halt (send-resp conn 403 "nope")))

(defrouter h-router
  (get "/" home)
  (get "/shout" shout)
  (get "/raw" raw)
  (through [tag-plug] (get "/me" whoami))
  (through [deny] (get "/x" (fn (conn) (html-resp conn "secret")))))

; ---- conn-for --------------------------------------------------------------

(describe "conn-for"
  (test "upcases the method"
    (assert= (get (conn-for "get" "/") :method) "GET"))
  (test "carries path, params, query, headers, body"
    (let (c (conn-for "POST"
              "/x"
              {:params {"id" "7"} :query "a=1" :headers {:host "h"} :body "hi"}))
      (assert= (get c :path) "/x")
      (assert= (get c :params) {"id" "7"})
      (assert= (get c :query) "a=1")
      (assert= (get c :headers) {:host "h"})
      (assert= (get c :body) "hi"))))

; ---- request / call --------------------------------------------------------

(describe "request"
  (test "dispatches a route and exposes status + body"
    (let (resp (request h-router "GET" "/"))
      (assert= (status resp) 200)
      (assert= (body-contains? resp "Home") true)))
  (test "a bare-string handler return becomes a 200 body"
    (assert= (body (request h-router "GET" "/shout")) "plain string body"))
  (test "status defaults to 200 when the handler sets none"
    (assert= (status (request h-router "GET" "/raw")) 200))
  (test "an unknown path is a 404"
    (assert= (status (request h-router "GET" "/nope")) 404))
  (test "a non-halting through plug enriches the conn the handler sees"
    (assert= (body (request h-router "GET" "/me")) "admin"))
  (test "a halting through plug short-circuits with its own response"
    (let (resp (request h-router "GET" "/x"))
      (assert= (status resp) 403)
      (assert= (body resp) "nope"))))

(describe "call"
  (test "invokes one handler without a router"
    (assert= (body (call home (conn-for "GET" "/"))) "<h1>Home</h1>"))
  (test "coerces a bare-string return"
    (assert= (body (call shout (conn-for "GET" "/"))) "plain string body")))

; ---- live views ------------------------------------------------------------

(deflive
  (mount (params) {:count (string/->number (get params "start" "0"))})
  (render (model) [:div {:class "c"} [:span {} (str (get model :count))]])
  (on "inc" (params model) (assoc model :count (inc (get model :count))))
  (tick 1000 (model) (assoc model :count (+ (get model :count) 10)))
  (handle-info (msg model) (assoc model :count (+ (get model :count) msg)))
  (unmount (model) (send (self) [:unmounted (get model :count)]))
  (on-mount-guard (conn) (if (get-cookie conn "session") nil "/login"))
  (handle-params (params model) (assoc model :page (string/->number (get params "page" "1")))))

(describe "live-view harness"
  (test "live-mount builds the initial model from params"
    (assert= (live-mount (live-view) {"start" "5"}) {:count 5}))
  (test "live-event advances the model"
    (assert= (live-event (live-view) "inc" {} {:count 5}) {:count 6}))
  (test "live-tick advances the model"
    (assert= (live-tick (live-view) 1000 {:count 5}) {:count 15}))
  (test "live-info applies an out-of-band message"
    (assert= (live-info (live-view) 7 {:count 5}) {:count 12}))
  (test "live-unmount runs the view's cleanup (in the caller's process)"
    (do
      (live-unmount (live-view) {:count 9})
      (assert= (receive ([:unmounted n] n) (after 1000 :timeout)) 9)))
  (test "live-render lowers the view to HTML"
    (assert= (includes? (live-render (live-view) {:count 42}) "<span>42</span>") true))
  (test "live-html mounts then renders in one step"
    (assert= (includes? (live-html (live-view) {"start" "7"}) "<span>7</span>") true))
  (test "on-mount-guard vetoes without the guarded cookie"
    (assert= (live-guard (live-view) (conn-for "GET" "/")) "/login"))
  (test "on-mount-guard allows the mount once its condition is met"
    (assert= (live-guard (live-view) (conn-for "GET" "/" {:headers {:cookie "session=1"}}))
      nil))
  (test "live-patch runs handle-params against the current model, keeping other fields"
    (assert= (live-patch (live-view) {"page" "3"} {:count 5}) {:count 5 :page 3})))

(describe "static/dynamic parts (minimal diffs)"
  ; The invariant the wire protocol relies on: assembling the static skeleton with the
  ; rendered dynamic slots reproduces the full render exactly, for any model.
  (test "weave(static, dynamic(model)) == full render"
    (let (view (live-view))
      (assert= (web/parts/weave (view-render-static view)
                 (view-render-dynamic view {:count 7} (table/new)))
        (live-render view {:count 7}))
      (assert= (web/parts/weave (view-render-static view)
                 (view-render-dynamic view {:count -3} (table/new)))
        (live-render view {:count -3})))))

;; ---- a view is a value with a LiveModule impl ------------------------------------------
;;
;; `deflive` expands to a field-less record, `live-view`, and an impl of `web/live/LiveModule`
;; for it. The session, the router and these drivers all hold that value and call the ability's
;; ops on it, so a view written by hand — a record and an impl, no macro — is a first-class
;; view, with the ability's provided ops standing in for every clause it leaves out.

(defrecord hand-written-view ())

(impl LiveModule
  hand-written-view
  (view-mount (_view params) {:n (or (get params "n") 1)})
  (view-render (_view model _components) [:b {} (str (get model :n))])
  (view-handle-event (_view _name _params model) (assoc model :n 99)))

;; Only two of the three required ops: the runtime half of the contract — `satisfies?` asks
;; whether every op resolves for a value — says no.
;;
;; `nest check` says nothing about this impl, and that is a brood gap rather than a choice: the
;; checker verifies an impl's ops only against an ability declared in the SAME file, and
;; `LiveModule` lives in web/live. A same-file ability gets "impl is missing op"; a hand-written
;; view in its own module, the real case, gets no finding until the session calls the missing op
;; and dispatch raises a no-impl.
(defrecord incomplete-view ())

(impl LiveModule
  incomplete-view
  (view-mount (_view _params) {})
  (view-render (_view _model _components) [:b {} "x"]))

(describe "a live view is a value"
  (test "deflive defines a field-less record that satisfies LiveModule"
    (is (record? (live-view)))
    (assert= (record-id (live-view)) :web-test-test/live-view)
    (assert= (fields (live-view)) {})
    (is (satisfies? 'LiveModule (live-view))))

  (test "every op the session calls answers for it, with the clauses deflive compiled"
    (let (view (live-view))
      (assert= (view-ticks view) [1000])
      (assert= (count (view-render-static view)) 2)
      (assert= (view-slot-deps view) [[:count]])
      (assert= (view-render-slot view 0 {:count 3} (table/new)) "3")
      (assert= (view-handle-info view 2 {:count 1}) {:count 3})))

  ;; The seam is open: a hand-written impl drives the harness exactly as one from the macro.
  (test "a hand-written view drives the harness"
    (let (view (hand-written-view))
      (assert= (live-mount view {"n" 4}) {:n 4})
      (assert= (live-render view {:n 4}) "<b>4</b>")
      (assert= (live-event view "anything" {} {:n 4}) {:n 99})
      (is (satisfies? 'LiveModule view))))

  (test "a hand-written view gets every provided op as the default a missing clause means"
    (let (view (hand-written-view))
      (assert= (view-ticks view) [])
      (assert= (view-slot-deps view) nil)
      (assert= (view-render-static view) ["" ""])
      (assert= (view-render-dynamic view {:n 4} (table/new)) ["<b>4</b>"])
      (assert= (view-render-slot view 0 {:n 4} (table/new)) "<b>4</b>")
      (assert= (live-tick view 1000 {:n 4}) {:n 4})
      (assert= (live-info view :message {:n 4}) {:n 4})
      (assert= (live-patch view {"page" "2"} {:n 4}) {:n 4})
      (assert= (live-guard view (conn-for "GET" "/")) nil)
      (assert= (live-unmount view {:n 4}) nil)))

  (test "an impl missing a required op does not satisfy the ability"
    (is (not (satisfies? 'LiveModule (incomplete-view))))))

(describe "json-body"
  (defn- answering (text) (send-resp (conn-for "GET" "/") 200 text))
  (test "an object is a map with keyword keys, an array a vector"
    (assert= (json-body (answering "{\"a\":1}")) {:a 1})
    (assert= (json-body (answering "[1,2]")) [1 2]))
  (test "a scalar, or a body that is not JSON, raises with the body"
    (is (includes? (try (json-body (answering "42")) (catch e (error-message e))) "42"))
    (is (includes? (try (json-body (answering "not json")) (catch e (error-message e)))
          "web/test/json-body"))))
