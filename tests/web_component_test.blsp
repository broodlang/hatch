(defmodule web-component-test (:use web/component) (:use web/template) (:use test))

; ---- a fixture component to drive ----

(deflive-component
  (mount (id assigns) {:n (or (get assigns "start") 0)})
  (render (state) [:span {} (str (get state :n))])
  (on "bump" (params state) (assoc state :n (inc (get state :n))))
  (on "set" (params state) (assoc state :n (get params "value"))))

;; A second component, written by hand — a record and an impl, no macro. It is what a
;; different module reusing an id looks like to the components table: another value.
(defrecord other-component ())

(impl LiveComponentModule
  other-component
  (component-mount (_component _id assigns) {:n (* 100 (or (get assigns "start") 0))})
  (component-render (_component state) [:i {} (str (get state :n))])
  (component-handle-event (_component _name _params state) state))

(describe "deflive-component"
  (test "mount builds state from id + assigns"
    (assert= (component-mount (live-component) "x" {"start" 5}) {:n 5}))
  (test "mount defaults when assigns carries no start"
    (assert= (component-mount (live-component) "x" {}) {:n 0}))
  (test "render lowers state to HTML"
    (assert= (web/template/render (component-render (live-component) {:n 7})) "<span>7</span>"))
  (test "on dispatches by event name"
    (assert= (component-handle-event (live-component) "bump" {} {:n 5}) {:n 6})
    (assert= (component-handle-event (live-component) "set" {"value" 9} {:n 5}) {:n 9}))
  (test "an unrecognized event name is a no-op"
    (assert= (component-handle-event (live-component) "nope" {} {:n 5}) {:n 5})))

(describe "render-slot"
  (test "mounts on first render, wrapping the component's HTML in [data-cid]"
    (let (table (table/new)
          html (render-slot-html (live-component) {"id" "c1" "start" 3} table))
      (assert= html "<div data-cid=\"c1\"><span>3</span></div>")
      (assert= (get (table/get table "c1") :state) {:n 3})))
  (test "reuses stored state on later renders, ignoring changed assigns"
    (let (table (table/new))
      (render-slot (live-component) {"id" "c2" "start" 1} table)
      (assert= (render-slot-html (live-component) {"id" "c2" "start" 99} table)
        "<div data-cid=\"c2\"><span>1</span></div>")))
  ;; The value stored beside the state is read back through the table's deep clone, and must
  ;; still be equal to the one the next render passes — or every render would remount.
  (test "the stored component value survives the table round trip as itself"
    (let (table (table/new))
      (render-slot (live-component) {"id" "kept" "start" 1} table)
      (assert= (get (table/get table "kept") :component) (live-component))))
  (test "a different component reusing the same id remounts fresh instead of reusing foreign state"
    (let (table (table/new))
      (render-slot (live-component) {"id" "shared" "start" 1} table)
      (assert= (render-slot-html (other-component) {"id" "shared" "start" 7} table)
        "<div data-cid=\"shared\"><i>700</i></div>")
      (assert= (get (table/get table "shared") :component) (other-component)))))

(describe "dispatch-event"
  (test "routes to the component's own handle-event and stores the result"
    (let (table (table/new))
      (render-slot (live-component) {"id" "c3" "start" 0} table)
      (dispatch-event table "c3" "bump" {})
      (assert= (get (table/get table "c3") :state) {:n 1})
      ; the next render picks up the mutated state
      (assert= (render-slot-html (live-component) {"id" "c3" "start" 0} table)
        "<div data-cid=\"c3\"><span>1</span></div>")))
  (test "a stale/unknown cid is a safe no-op"
    (assert= (dispatch-event (table/new) "nope" "bump" {}) nil)))

(describe "apply-update"
  (test "merges changes into stored state (send-update's session-side handler)"
    (let (table (table/new))
      (render-slot (live-component) {"id" "c4" "start" 0} table)
      (apply-update table "c4" {:n 42})
      (assert= (get (table/get table "c4") :state) {:n 42})))
  (test "a stale/unknown cid is a safe no-op"
    (assert= (apply-update (table/new) "nope" {:n 1}) nil)))

(describe "send-update"
  (test "delivers an [:update-component cid changes] envelope to the session pid"
    (do
      (assert= (send-update (self) "c1" {:n 1}) nil)
      (assert= (receive ([:update-component cid changes] [cid changes]) (after 1000 :timeout))
        ["c1" {:n 1}]))))

;; The component's half of web_test_test's "a live view is a value".
(describe "a live component is a value"
  (test "deflive-component defines a field-less record that satisfies LiveComponentModule"
    (is (record? (live-component)))
    (assert= (record-id (live-component)) :web-component-test/live-component)
    (assert= (fields (live-component)) {})
    (is (satisfies? 'LiveComponentModule (live-component))))
  (test "deflive-component overrides the render ops with its compiled split"
    (assert= (component-render-static (live-component)) ["<span>" "</span>"])
    (assert= (component-render-dynamic (live-component) {:n 3}) ["3"]))
  ;; A hand-written component gets the provided ops: one opaque slot, no beats, a tick that
  ;; keeps its state — and still renders through render-slot like a compiled one.
  (test "a hand-written component gets every provided op"
    (assert= (component-render-static (other-component)) ["" ""])
    (assert= (component-render-dynamic (other-component) {:n 3}) ["<i>3</i>"])
    (assert= (component-ticks (other-component)) [])
    (assert= (component-handle-tick (other-component) 1000 {:n 3}) {:n 3})
    (let (table (table/new))
      (assert= (render-slot-html (other-component) {"id" "hand" "start" 1} table)
        "<div data-cid=\"hand\"><i>100</i></div>"))))

;; A component with no `tick` clause starts no timer. It used to start one anyway: the beats
;; were started with `dolist` over the spec's interval vector, and `dolist` over an EMPTY
;; vector runs its body once with nil — so every tickless mount spawned a nil-interval timer
;; process that never fired and lived as long as the session.
(describe "a component without ticks"
  (test "keeps no timer handles"
    (let (table (table/new))
      (render-slot (live-component) {"id" "quiet"} table)
      (assert= (get (table/get table "quiet") :tick-handles) []))))
