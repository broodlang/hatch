(defmodule web-audit-test
  (:use web/audit)
  (:alias web/mcp)
  (:alias web/template)
  (:use test))

;; The bug this exists for: a page that is complete, correct, 200-OK HTML and still does
;; nothing when a person uses it. brood.fly.dev served its language reference with a
;; `Filter…` search box for months — present in the markup, focusable, wired to nothing,
;; because the fragment carrying the input and the script driving it came from one renderer
;; and the host page inlined only the stylesheet.

(defn- page-with (body) (str "<html><body>" body "</body></html>"))

(describe "audit: inert controls"
  (test "an id'd control with no form, no handler and no script is inert"
    (let (found (inert-controls (page-with "<input id=\"q\" type=\"search\">")))
      (assert= (count found) 1)
      (assert= (get (first found) :tag) "input")
      (assert= (get (first found) :id) "q")))

  ;; The exact shape that shipped: input in the fragment, script never inlined.
  (test "the reference-page regression: a filter box with no script on the page"
    (let (found (inert-controls (page-with (str "<div class=\"docsite\"><aside>"
                                             "<input id=\"docsite-filter\" type=\"search\" placeholder=\"Filter…\">"
                                             "</aside></div>"))))
      (assert= (count found) 1)
      (assert= (get (first found) :id) "docsite-filter")))

  (test "the same page is clean once the companion script is present"
    (assert= (inert-controls (page-with (str "<input id=\"docsite-filter\" type=\"search\">"
                                          "<script>document.getElementById('docsite-filter')"
                                          ".addEventListener('input',function(){});</script>")))
      nil))

  (test "a control inside a form submits, so it is never inert"
    (assert= (inert-controls (page-with "<form method=\"get\" action=\"/packages\"><input name=\"q\"><button>Go</button></form>"))
      nil))

  (test "an inline on-handler counts as reachable"
    (assert= (inert-controls (page-with "<button id=\"b\" onclick=\"go()\">Go</button>")) nil)))

(describe "audit: what it refuses to judge"
  ;; Every one of these is a case the rule cannot PROVE, and a lint that guesses is a lint
  ;; people stop reading. Each must stay silent.
  (test "a fragment is the embedding page's business, not ours"
    (assert= (inert-controls "<div><input id=\"q\"></div>") nil))

  (test "an external script's contents are unreadable, so nothing is judged"
    (assert= (inert-controls (page-with "<input id=\"q\"><script src=\"/static/app.js\"></script>"))
      nil))

  ;; The same refusal, with an attribute BEFORE the `src`. Matching the literal
  ;; `<script src="` saw only the shape above, so a page whose control is driven by a
  ;; `type="module"` script was judged — and reported inert on every render.
  (test "an external script is still external when an attribute precedes its src"
    (assert= (inert-controls (page-with (str "<input id=\"module-filter\">"
                                          "<script type=\"module\" src=\"/static/reference-index.js\"></script>")))
      nil))

  (test "a control with no id may be reached by a tag or class selector"
    (assert= (inert-controls (page-with "<input type=\"search\"><script>document.querySelector('input')</script>"))
      nil))

  (test "an id that appears anywhere in script text is treated as reached"
    (assert= (inert-controls (page-with "<textarea id=\"editor\"></textarea><script>var x='editor';</script>"))
      nil)))

(describe "audit: warn-inert! is a pass-through"
  (test "it returns the document unchanged so it drops into a render pipeline"
    (let (document (page-with "<input id=\"q\">"))
      (assert= (warn-inert! document) document))))

;; ---- first flight -----------------------------------------------------------
;;
;; TCP cannot send more than the initial congestion window (10 segments, ~14 KB) before the
;; client acknowledges. `initcwnd` is a kernel route setting no server process can raise —
;; what hatch can do is say when a page has stopped fitting, which nothing else reports.

(describe "first-flight measures the document against the congestion window"

  (test "a small page fits in one round trip"
    (let (report (first-flight "<html><head></head><body>hello</body></html>"))
      (is (not (get report :over?)))
      (is (< (get report :compressed) (get report :budget)))))

  ;; Incompressible bytes, so the gzipped size really is over budget — a page of repeated
  ;; text would compress to nothing and prove the opposite of what this asserts.
  (test "a page past the window is reported as over"
    (let (big (apply str (map (range 3000) (fn (_) (uuid/v4))))
          report (first-flight (str "<html><head></head><body>" big "</body></html>")))
      (is (get report :over?))
      (is (> (get report :compressed) (get report :budget)))))

  ;; Compression only shrinks, so a document already inside the budget is inside it whatever
  ;; it compresses to — and this audit runs on every response in dev.
  (test "a document already inside the budget is not compressed to find out"
    (let (small "<html><head></head><body>small</body></html>"
          report (first-flight small))
      (assert= (count small) (get report :bytes))
      (assert= (count small) (get report :compressed))
      (is (not (get report :over?)))))

  (test "the compressed size is measured, not estimated"
    ;; a highly compressible page is far smaller on the wire than its byte count
    (let (document (str "<html><head></head><body>" (string/repeat "a" 60000) "</body></html>")
          report (first-flight document))
      (assert= (count document) (get report :bytes))
      (is (< (get report :compressed) 1000))
      (is (not (get report :over?))))))

(describe "first-flight finds what blocks the first paint"

  (test "a third-party stylesheet in the head blocks"
    (let (blocking (get (first-flight "<html><head><link rel=\"stylesheet\" href=\"https://fonts.example/x.css\"></head><body></body></html>")
                     :blocking))
      (assert= 1 (count blocking))
      (assert= "stylesheet" (get (first blocking) :kind))))

  (test "a classic third-party script in the head blocks"
    (is (= 1
          (count (get (first-flight "<html><head><script src=\"https://cdn.example/a.js\"></script></head><body></body></html>")
                   :blocking)))))

  ;; The hints are the mitigation, not the problem — reporting them would be the kind of
  ;; false positive that makes a lint unreadable.
  (test "preconnect and dns-prefetch block nothing"
    (is (empty? (get (first-flight "<html><head><link rel=\"preconnect\" href=\"https://fonts.example\"><link rel=\"dns-prefetch\" href=\"https://fonts.example\"></head><body></body></html>")
                  :blocking))))

  (test "async, defer and module scripts do not block"
    (for (tag ["<script src=\"https://cdn.example/a.js\" async></script>"
                "<script src=\"https://cdn.example/a.js\" defer></script>"
                "<script src=\"https://cdn.example/a.js\" type=\"module\"></script>"])
      (is (empty? (get (first-flight (str "<html><head>" tag "</head><body></body></html>"))
                    :blocking)))))

  (test "a same-origin relative asset is not an extra connection"
    (is (empty? (get (first-flight "<html><head><link rel=\"stylesheet\" href=\"/static/app.css\"></head><body></body></html>")
                  :blocking))))

  (test "only the head is scanned — a body script blocks nothing above it"
    (is (empty? (get (first-flight "<html><head></head><body><script src=\"https://cdn.example/a.js\"></script></body></html>")
                  :blocking)))))

(describe "audit: warn-first-flight! and warn-page! are pass-throughs"
  (test "the document is returned unchanged"
    (let (document "<html><head><link rel=\"stylesheet\" href=\"https://fonts.example/x.css\"></head><body></body></html>")
      (assert= (warn-first-flight! document) document)
      (assert= (warn-page! document) document))))

;; A stylesheet link is render-blocking, but the browser paints its own canvas before the
;; sheet arrives. Without an early `color-scheme` that is a flash on every navigation —
;; the bug this audit exists to name, reported on hive's /reference tabs.
(describe "canvas-flash audit"
  (test "a head that links a stylesheet and says nothing about colour scheme is flagged"
    (let (head "<head><link rel=\"stylesheet\" href=\"/app.css\"></head>")
      (is (not (web/audit/declares-color-scheme? (web/audit/head-of head))))))

  (test "a meta color-scheme ahead of the link settles it"
    (let (head "<head><meta name=\"color-scheme\" content=\"light dark\"><link rel=\"stylesheet\" href=\"/a.css\"></head>")
      (is (web/audit/declares-color-scheme? (web/audit/head-of head)))))

  (test "an inline style carrying color-scheme settles it too"
    (let (head "<head><style>:root{color-scheme:light dark;background:#262130}</style><link rel=\"stylesheet\" href=\"/a.css\"></head>")
      (is (web/audit/declares-color-scheme? (web/audit/head-of head)))))

  (test "the audit returns its document unchanged"
    (let (doc "<head><link rel=\"stylesheet\" href=\"/a.css\"></head><body></body>")
      (assert= doc (web/audit/warn-canvas-flash! doc)))))

;; ---- tool coverage ----------------------------------------------------------
;;
;; The documents here embed a REAL tool block (`web/mcp/tools-script` rendered), not a
;; hand-written one, so the audit is read against the shape the framework actually emits —
;; including the key renaming `validated-tool` does on the way out.

(defn- search-tool ()
  {:name "searchPackages"
   :description "Search the registry by name or description."
   :input-schema {:type "object"
                  :properties {:q {:type "string" :description "search text"}}
                  :required ["q"]}
   :endpoint {:method "GET" :url "/api/v1/packages" :query ["q"]}})

(defn- lookup-tool ()
  {:name "getPackage"
   :description "Look up one package by its exact name."
   :input-schema {:type "object" :properties {:name {:type "string" :description "exact name"}}}
   :endpoint {:method "GET" :url "/api/v1/packages/{name}"}})

(defn- with-tools (tools body)
  "A document carrying `body` and a rendered tool block for `tools`."
  (str "<!DOCTYPE html><html><body>"
    body
    (web/template/render (web/mcp/tools-script tools))
    "</body></html>"))

(def- *search-form*
  "<form action=\"/packages\" method=\"get\"><input name=\"q\" type=\"search\"><button type=\"submit\">Go</button></form>")

(describe "uncovered-forms declines to judge a page that made no claim"
  (test "a page with no tool block is not audited, however many forms it has"
    (assert= (uncovered-forms (str "<!DOCTYPE html><html><body>" *search-form* "</body></html>"))
      []))
  (test "a page with tools and no form at all is clean"
    (assert= (uncovered-forms (with-tools [(search-tool)] "<p>nothing to submit</p>")) []))
  (test "a hand-written block that will not decode is not reported as a coverage problem"
    ;; web/mcp raises on anything it cannot render, so an undecodable block means someone
    ;; wrote one by hand — guessing at their intent is how a lint earns distrust.
    (assert= (uncovered-forms (str "<!DOCTYPE html><html><body>"
                                *search-form*
                                "<script type=\"application/json\" id=\"hatch-mcp-tools\">{not json</script>"
                                "</body></html>"))
      [])))

(describe "uncovered-forms on a page that did opt in"
  (test "a covered search form is clean"
    (assert= (uncovered-forms (with-tools [(search-tool)] *search-form*)) []))

  (test "an uncovered field is reported, with the action and the fields"
    (let (form "<form action=\"/find\" method=\"get\"><input name=\"term\" type=\"search\"></form>"
          findings (uncovered-forms (with-tools [(search-tool)] form)))
      (assert= (count findings) 1)
      (assert= (get (first findings) :action) "/find")
      (assert= (get (first findings) :fields) ["term"])))

  (test "coverage counts the endpoint's query parameters, not only the schema"
    ;; `limit` is a query parameter with no schema property of its own.
    (let (tool (assoc (search-tool)
                 :input-schema
                   {:type "object" :properties {:q {:type "string" :description "text"}}}
                 :endpoint {:method "GET" :url "/api/v1/packages" :query ["q" "limit"]})
          form "<form method=\"get\"><input name=\"q\"><input name=\"limit\"></form>")
      (assert= (uncovered-forms (with-tools [tool] form)) [])))

  (test "one form is one action — two tools covering half the fields each is not coverage"
    (let (form "<form method=\"get\"><input name=\"q\"><input name=\"name\"></form>"
          findings (uncovered-forms (with-tools [(search-tool) (lookup-tool)] form)))
      (assert= (count findings) 1)))

  (test "several uncovered forms are each reported"
    (let (form-a "<form action=\"/a\" method=\"get\"><input name=\"alpha\"></form>"
          form-b "<form action=\"/b\" method=\"get\"><input name=\"beta\"></form>"
          findings (uncovered-forms (with-tools [(search-tool)] (str form-a *search-form* form-b))))
      (assert= (count findings) 2)
      (assert= (map findings (fn (f) (get f :action))) (list "/a" "/b"))))

  (test "select and textarea count as fields too"
    (let (form "<form method=\"get\"><select name=\"kind\"><option>a</option></select></form>")
      (assert= (count (uncovered-forms (with-tools [(search-tool)] form))) 1))
    (let (form "<form method=\"get\"><textarea name=\"body\"></textarea></form>")
      (assert= (count (uncovered-forms (with-tools [(search-tool)] form))) 1))))

(describe "uncovered-forms judges only the forms where absence is a mistake"
  (test "a POST form is a mutation, and whether an agent may do it is not a lint's call"
    (let (form "<form action=\"/login\" method=\"post\"><input name=\"email\"><input name=\"password\" type=\"password\"></form>")
      (assert= (uncovered-forms (with-tools [(search-tool)] form)) [])))

  (test "a method in any casing is read the same way"
    (let (form "<form action=\"/login\" method=\"POST\"><input name=\"email\"></form>")
      (assert= (uncovered-forms (with-tools [(search-tool)] form)) [])))

  (test "an absent method is GET, per HTML, so it IS judged"
    (let (form "<form action=\"/find\"><input name=\"term\"></form>")
      (assert= (count (uncovered-forms (with-tools [(search-tool)] form))) 1)))

  (test "a form with nothing but a hidden token and a submit button has no arguments"
    ;; Counting a CSRF token as an argument would make every form permanently uncoverable.
    (let (form "<form method=\"get\"><input type=\"hidden\" name=\"_csrf_token\" value=\"x\"><button type=\"submit\">Go</button></form>")
      (assert= (uncovered-forms (with-tools [(search-tool)] form)) [])))

  (test "a hidden field alongside a covered one does not break coverage"
    (let (form "<form method=\"get\"><input type=\"hidden\" name=\"_csrf_token\" value=\"x\"><input name=\"q\"></form>")
      (assert= (uncovered-forms (with-tools [(search-tool)] form)) [])))

  (test "an unnamed input cannot be submitted, so it is not an argument"
    (let (form "<form method=\"get\"><input type=\"search\" placeholder=\"unused\"></form>")
      (assert= (uncovered-forms (with-tools [(search-tool)] form)) []))))

(describe "warn-tool-coverage!"
  (test "returns the document unchanged, so it drops into a render pipeline"
    (let (document (with-tools [(search-tool)] "<form method=\"get\"><input name=\"nope\"></form>"))
      (assert= (warn-tool-coverage! document) document)))
  (test "and on a clean page too"
    (let (document (with-tools [(search-tool)] *search-form*))
      (assert= (warn-tool-coverage! document) document))))

;; ---- document outline -------------------------------------------------------
;;
;; A heading level is size in CSS and structure in HTML. Going h1 -> h3 tells a reader
;; navigating by heading that they are inside an h2 section, and they are not — the classic
;; defect that looks perfect: the page renders, the sizes are what the designer asked for,
;; and the document says something nobody meant.

(describe "heading-levels reads the outline, and only the outline"
  (test "in source order"
    (assert= (heading-levels "<h1>a</h1><h2>b</h2><h3>c</h3>") (list 1 2 3)))
  (test "attributes do not hide a heading"
    (assert= (heading-levels "<h1 class=\"x\">a</h1><h2 id=\"y\">b</h2>") (list 1 2)))
  (test "<hr>, <html> and <header> are not headings"
    (assert= (heading-levels "<html><header><hr><h2>only me</h2></header></html>") (list 2)))
  (test "h7 does not exist"
    (assert= (heading-levels "<h7>nope</h7>") (list)))
  (test "a document with no headings has no outline"
    (assert= (heading-levels "<p>text</p>") (list))))

(describe "skipped-headings"
  (test "a clean outline reports nothing"
    (assert= (skipped-headings "<h1>a</h1><h2>b</h2><h3>c</h3><h2>d</h2>") []))
  (test "h1 straight to h3 is a skip"
    (let (findings (skipped-headings "<h1>a</h1><h3>b</h3>"))
      (assert= (count findings) 1)
      (assert= (first findings) {:from 1 :to 3})))
  (test "the real case: an h1, a run of h3s, then an h2 much later"
    ;; hive's home page, exactly — seven feature cards marked h3 for their size.
    (let (findings (skipped-headings "<h1>Brood</h1><h3>a</h3><h3>b</h3><h3>c</h3><h2>A taste</h2>"))
      (assert= (count findings) 1)
      (assert= (first findings) {:from 1 :to 3})))
  (test "coming back up any distance is ordinary, not a skip"
    (assert= (skipped-headings "<h1>a</h1><h2>b</h2><h3>c</h3><h4>d</h4><h2>e</h2>") []))
  (test "a page whose outline starts at h3 has skipped h2"
    (assert= (skipped-headings "<h3>first thing</h3>") [{:from 1 :to 3}]))
  (test "starting at h1 is not a skip"
    (assert= (skipped-headings "<h1>fine</h1>") []))
  (test "starting at h2 is not a skip either — that is an ordinary page, and a fragment"
    ;; The rule declines to judge what it cannot prove: a section heading rendered on its
    ;; own, or a page whose h1 is its title, both legitimately open at h2.
    (assert= (skipped-headings "<h2>a section</h2><h3>within it</h3>") []))
  (test "two separate skips are both reported"
    (assert= (count (skipped-headings "<h1>a</h1><h3>b</h3><h2>c</h2><h5>d</h5>")) 2))
  (test "a document with no headings reports nothing"
    (assert= (skipped-headings "<p>no headings here</p>") [])))

(describe "warn-headings!"
  (test "returns the document unchanged"
    (let (document "<h1>a</h1><h3>b</h3>")
      (assert= (warn-headings! document) document))))

;; ---- the icon ---------------------------------------------------------------

(describe "declares-icon?"
  (test "a plain icon link counts"
    (is (declares-icon? "<head><link rel=\"icon\" href=\"/f.svg\"></head>")))
  (test "so do the other spellings"
    (is (declares-icon? "<head><link rel=\"shortcut icon\" href=\"/f.ico\"></head>"))
    (is (declares-icon? "<head><link rel=\"apple-touch-icon\" href=\"/f.png\"></head>")))
  (test "a stylesheet is not an icon"
    (is (not (declares-icon? "<head><link rel=\"stylesheet\" href=\"/a.css\"></head>"))))
  (test "an empty head declares nothing"
    (is (not (declares-icon? "<head></head>")))))

(describe "warn-favicon!"
  (test "returns the document unchanged, with or without an icon"
    (let (with-icon "<html><head><link rel=\"icon\" href=\"/f.svg\"></head><body></body></html>"
          without "<html><head><title>t</title></head><body></body></html>")
      (assert= (warn-favicon! with-icon) with-icon)
      (assert= (warn-favicon! without) without))))

;; ---- the declarative half ----------------------------------------------------
;;
;; A form annotated with `toolname` IS the tool — the browser derives the schema from the
;; fields, and no JSON block or JavaScript is involved. It is also static HTML, so unlike the
;; imperative API a crawler or a scanner that never runs the page can still see it.

(def- *annotated-form*
  "<form action=\"/packages\" method=\"get\" toolname=\"searchPackages\" tooldescription=\"Search.\"><input name=\"q\"></form>")

(describe "an annotated form is covered by itself"
  (test "it needs no JSON tool to cover it"
    (assert= (uncovered-forms (str "<!DOCTYPE html><html><body>" *annotated-form* "</body></html>"))
      []))

  (test "and an annotated form is itself a declaration, so the page IS audited"
    ;; Without this, a page using only the declarative API would opt out of the audit
    ;; entirely and its UNannotated forms would go unreported.
    (let (document (str "<!DOCTYPE html><html><body>"
                     *annotated-form*
                     "<form action=\"/other\" method=\"get\"><input name=\"zzz\"></form>"
                     "</body></html>")
          findings (uncovered-forms document))
      (assert= (count findings) 1)
      (assert= (get (first findings) :action) "/other")))

  (test "the two halves coexist: a JSON tool covers one form, an annotation the other"
    (let (document (str "<!DOCTYPE html><html><body>"
                     *search-form*
                     "<form action=\"/x\" method=\"get\" toolname=\"other\" tooldescription=\"d\"><input name=\"zzz\"></form>"
                     (web/template/render (web/mcp/tools-script [(search-tool)]))
                     "</body></html>"))
      (assert= (uncovered-forms document) []))))

(describe "form-tool builds the annotations"
  (test "name and description"
    (assert= (web/mcp/form-tool {:name "searchPackages" :description "Search."})
      {:toolname "searchPackages" :tooldescription "Search."}))
  (test "autosubmit is opt-in — right for a search, wrong for anything that spends money"
    (assert= (get (web/mcp/form-tool {:name "s" :description "d" :autosubmit true}) :toolautosubmit)
      true)
    (assert= (get (web/mcp/form-tool {:name "s" :description "d"}) :toolautosubmit) nil))
  (test "a tool with no name or no description is refused, as in the imperative API"
    (assert= (try (do (web/mcp/form-tool {:description "d"}) :no-error) (catch _e :error)) :error)
    (assert= (try (do (web/mcp/form-tool {:name "s"}) :no-error) (catch _e :error)) :error))
  (test "a name an agent cannot select on is refused"
    (assert= (try
               (do (web/mcp/form-tool {:name "bad name!" :description "d"}) :no-error)
               (catch _e :error))
      :error))
  (test "it renders as real attributes, boolean and all"
    (let (html (web/template/render [:form
                                      (web/mcp/form-tool {:name "s"
                                                          :description "d"
                                                          :autosubmit true})
                                      "x"]))
      (is (includes? html "toolname=\"s\""))
      (is (includes? html "tooldescription=\"d\""))
      ;; a bare boolean attribute, not toolautosubmit="true" — wherever it lands among the
      ;; attributes (a map's order is not a contract)
      (is (or (includes? html " toolautosubmit ") (includes? html " toolautosubmit>")))
      (refute (includes? html "toolautosubmit=")))))
