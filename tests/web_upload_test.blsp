(defmodule web-upload-test
  (:use web/upload)
  (:alias http/server)
  (:alias web/pubsub)
  (:use test))

;; web/upload is two halves that meet at a telemetry event:
;;   http/server  — reads ?upload_token= off the head, emits [:hatch :upload :progress]
;;                  as the body lands (throttled, plus one unthrottled final event)
;;   web/upload   — a telemetry handler that broadcasts each event to the token's pubsub
;;                  topic, so a subscribed live session gets it at handle-info
;; The pure helpers are unit-tested; the end-to-end test drives a real socket, sending the
;; body in slices so more than one event has to fire.

(defn b (s) (string->utf8-bytes s))

;; ---- pure helpers ----

(describe "topic + action"
  (test "topic namespaces the token"
    (assert= (topic "abc") "upload:abc"))
  (test "action appends the token as a query param"
    (assert= (action "/upload" "abc") "/upload?upload_token=abc"))
  (test "action uses & when the path already has a query string"
    (assert= (action "/upload?a=1" "abc") "/upload?a=1&upload_token=abc"))
  (test "new-token mints distinct tokens"
    (assert= (= (new-token) (new-token)) false)))

(describe "percent"
  (test "a whole percent of the declared total" (assert= (percent 512 1024) 50))
  (test "rounds down rather than overshooting" (assert= (percent 1 3) 33))
  (test "a complete body is 100" (assert= (percent 1024 1024) 100))
  (test "an unknown total is 0, not a division by zero" (assert= (percent 5 0) 0))
  (test "a nil total is 0" (assert= (percent 5 nil) 0))
  (test "clamps over-reporting to 100" (assert= (percent 2000 1024) 100)))

(describe "progress-message"
  (test "carries token, counts and percent"
    (assert= (progress-message {:got 50 :total 200} {:token "t1"})
      {:upload {:token "t1" :got 50 :total 200 :percent 25 :done? false}}))
  (test "marks the final event done?"
    (assert= (get (get (progress-message {:got 200 :total 200} {:token "t1"}) :upload) :done?)
      true))
  (test "a zero total is never done? (nothing was declared to finish)"
    (assert= (get (get (progress-message {:got 0 :total 0} {:token "t1"}) :upload) :done?)
      false)))

(describe "upload-token"
  (test "reads the opt-in query param off a parsed head"
    (assert= (server/upload-token {:query "upload_token=abc"}) "abc"))
  (test "nil when the request didn't ask for progress"
    (assert= (server/upload-token {:query "a=1"}) nil))
  (test "nil for a request with no query string at all"
    (assert= (server/upload-token {}) nil)))

;; ---- end to end: a real upload reports its progress to a subscribed process ----

(defn drain (sock acc)
  (receive
    ([:tcp ^sock chunk] (drain sock (str acc (utf8-bytes->string chunk))))
    ([:tcp-closed ^sock] acc)
    (after 1500 acc)))

(defn collect-progress (acc tries)
  "Collect `{:upload …}` payloads until the done? one arrives (or we run out of patience).
  Returns them oldest-first."
  (if (<= tries 0)
    (reverse acc)
    (receive
      ([:info payload] (let (up (get payload :upload)
                             acc2 (if up (cons up acc) acc))
                         (if (and up (get up :done?))
                           (reverse acc2)
                           (collect-progress acc2 (- tries 1)))))
      (after 5000 (reverse acc)))))

(defn collect-for-token (token ms)
  "Drain `:info` payloads for `ms`, returning only those carrying `token` — so an unrelated
  event from a concurrently-running case can't be mistaken for one about this upload."
  (receive
    ([:info payload] (let (up (get payload :upload))
                       (if (and up (= (get up :token) token))
                         (cons up (collect-for-token token ms))
                         (collect-for-token token ms))))
    (after ms (list))))

(defn ok-handler (reporter)
  (fn (_request)
    (send reporter [:handled])
    {:status 200 :headers {} :body "ok"}))

(defn send-slices (sock slices)
  "Send each slice with a gap, so the server sees several distinct reads (one progress
  event per read at :progress-interval-ms 0) rather than one."
  (when (not (empty? slices))
    (tcp-send sock (first slices))
    (sleep 30)
    (send-slices sock (rest slices))))

(describe "end-to-end upload progress"
  (test "a tokened upload reports incremental progress, ending at 100%"
    (let (me (self)
          tok "test-upload-token-1"
          ; a distinct handler id per test: these run concurrently, and a shared
          ; default id would let whichever finishes first detach the others' handler
          hid :upload-test-1
          _att (attach-progress {:id hid})
          _sub (watch tok)
          port 24791
          _sup (server/start port
                 (ok-handler me)
                 nil
                 {:spool-threshold 8 :spool-dir "/tmp" :progress-interval-ms 0})
          client (tcp-connect "127.0.0.1" port)
          ; 30-byte body, sent as three 10-byte slices
          slice (b "0123456789"))
      (tcp-set-binary client true)
      (tcp-send client
        (b (str "POST /up?upload_token="
             tok " HTTP/1.1\r\n" "Host: x\r\n" "Content-Length: 30\r\n" "Connection: close\r\n\r\n")))
      (send-slices client [slice slice slice])
      (let (events (collect-progress (list) 20)
            _resp (drain client "")
            final (first (reverse events)))
        (tcp-close client)
        (server/stop port)
        (unwatch tok)
        (detach-progress {:id hid})
        ; at least one event, and never more than one per read. We deliberately do NOT assert
        ; ">= 2 events" even though the body is sent as three spaced slices: how many *reads*
        ; those become is the kernel's call, and under load the loopback stack coalesces them
        ; into one — which is correct behaviour, not a progress bug. The properties worth
        ; pinning are the ones below: scoped to our token, bounded, monotonic, and finishing
        ; at exactly 100%.
        (assert= (>= (count events) 1) true)
        ; every event is for our token, and counts never exceed the declared total
        (assert= (filterv (fn (e) (not (= (get e :token) tok))) events) [])
        (assert= (filterv (fn (e) (> (get e :got) 30)) events) [])
        ; monotonic: a bar must never go backwards
        (assert= (map (fn (e) (get e :got)) events)
          (sort (map (fn (e) (get e :got)) events)))
        ; the final event is unthrottled and complete, so a bar always lands on 100%
        (assert= (get final :got) 30)
        (assert= (get final :total) 30)
        (assert= (get final :percent) 100)
        (assert= (get final :done?) true))))

  (test "the in-memory (non-spooled) body path reports progress too"
    (let (me (self)
          tok "test-upload-token-3"
          ; a distinct handler id per test: these run concurrently, and a shared
          ; default id would let whichever finishes first detach the others' handler
          hid :upload-test-3
          _att (attach-progress {:id hid})
          _sub (watch tok)
          port 24793
          ; no :spool-threshold → buffered-drain, the other instrumented body reader
          _sup (server/start port (ok-handler me) nil {:progress-interval-ms 0})
          client (tcp-connect "127.0.0.1" port)
          slice (b "0123456789"))
      (tcp-set-binary client true)
      (tcp-send client
        (b (str "POST /up?upload_token="
             tok " HTTP/1.1\r\n" "Host: x\r\n" "Content-Length: 20\r\n" "Connection: close\r\n\r\n")))
      (send-slices client [slice slice])
      (let (events (collect-progress (list) 20)
            _resp (drain client "")
            final (first (reverse events)))
        (tcp-close client)
        (server/stop port)
        (unwatch tok)
        (detach-progress {:id hid})
        (assert= (>= (count events) 1) true)
        (assert= (get final :got) 20)
        (assert= (get final :percent) 100)
        (assert= (get final :done?) true))))

  (test "an upload with no token emits nothing (progress is strictly opt-in)"
    (let (me (self)
          tok "test-upload-token-2"
          ; a distinct handler id per test: these run concurrently, and a shared
          ; default id would let whichever finishes first detach the others' handler
          hid :upload-test-2
          _att (attach-progress {:id hid})
          _sub (watch tok)
          port 24792
          _sup (server/start port
                 (ok-handler me)
                 nil
                 {:spool-threshold 8 :spool-dir "/tmp" :progress-interval-ms 0})
          client (tcp-connect "127.0.0.1" port))
      (tcp-set-binary client true)
      (tcp-send client
        (b (str "POST /up HTTP/1.1\r\n"
             "Host: x\r\n" "Content-Length: 10\r\n" "Connection: close\r\n\r\n" "0123456789")))
      ; wait for the request to be fully handled, then check no progress arrived FOR OUR
      ; TOKEN. Deliberately not "no :info at all": these tests run concurrently and share the
      ; pubsub registry, so a sibling's late event (or a subscription of ours not yet torn
      ; down) can land in this mailbox without saying anything about the claim under test,
      ; which is that an UNTOKENED upload emits nothing.
      (let (handled (receive ([:handled] :yes) (after 5000 :timeout))
            _resp (drain client "")
            stray (collect-for-token tok 300))
        (tcp-close client)
        (server/stop port)
        (unwatch tok)
        (detach-progress {:id hid})
        (assert= handled :yes)
        (assert= stray (list))))))
