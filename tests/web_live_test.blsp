;; Reaches into web/live internals (ADR-146 `--` names: live--register/unregister,
;; live--ws-path, recv-frame--loop) to test them directly — hence (:use-internals web/live).
(defmodule web-live-test
  (:use web/live)
  (:use-internals web/live)
  (:use web/template)
  (:use web/conn)
  (:use test))

(defn client-js-conn ()
  (build {:method "GET" :path "/static/brood_live.js" :query "" :params {} :headers {} :body ""}))

(describe "deflive--clause: a duplicate singular clause is rejected"
  (test "two render clauses error at expansion"
    (assert-error (web/live/deflive-clause 'render
                    (list (list 'render '(m) "a") (list 'render '(m) "b")))))
  (test "a single clause is returned"
    (assert= (web/live/deflive-clause 'render (list (list 'render '(m) "a")))
      (list 'render '(m) "a")))
  (test "no clause is nil"
    (assert= (web/live/deflive-clause 'render (list (list 'mount '(p) 1))) nil)))

(describe "json-str: escapes all C0 control characters (RFC 8259)"
  (test "named escapes" (assert= (json-str "a\nb\tc") "\"a\\nb\\tc\""))
  (test "quote and backslash" (assert= (json-str "a\"\\b") "\"a\\\"\\\\b\""))
  ; a backspace/ESC/NUL in user text must be \u-escaped, not emitted raw (raw → invalid JSON
  ; → the client's JSON.parse drops the whole frame). \b = U+0008, ESC = U+001B, NUL = U+0000.
  (test "backspace → \\b" (assert= (json-str (utf8-bytes->string (bytes [8]))) "\"\\b\""))
  (test "ESC → \\u001b" (assert= (json-str (utf8-bytes->string (bytes [27]))) "\"\\u001b\""))
  (test "NUL → \\u0000" (assert= (json-str (utf8-bytes->string (bytes [0]))) "\"\\u0000\""))
  (test "vertical tab → \\u000b"
    (assert= (json-str (utf8-bytes->string (bytes [11]))) "\"\\u000b\"")))

(describe "client-script"
  (test "default src + defer"
    (let (h (render (client-script)))
      (assert= (starts-with? h "<script") true)
      (assert= (includes? h "src=\"/static/brood_live.js\"") true)
      (assert= (includes? h "defer") true)))
  (test "custom src"
    (assert= (includes? (render (client-script "/assets/live.js")) "src=\"/assets/live.js\"") true)))

(describe "status-bar"
  (test "default pill"
    (let (h (render (status-bar)))
      (assert= (includes? h "class=\"brood-status\"") true)
      (assert= (includes? h "reconnecting") true)))
  (test "custom label"
    (assert= (includes? (render (status-bar "offline")) ">offline<") true)))

(describe "live-chrome"
  (test "bundles the client script, status style, and status pill"
    (let (h (render (live-chrome)))
      (assert= (includes? h "src=\"/static/brood_live.js\"") true)
      (assert= (includes? h ".brood-status") true)
      (assert= (includes? h "reconnecting") true)))
  (test "custom client src"
    (assert= (includes? (render (live-chrome "/x.js")) "src=\"/x.js\"") true)))

(describe "status-style"
  (test "style element with the status class"
    (let (h (render (status-style)))
      (assert= (starts-with? h "<style>") true)
      (assert= (includes? h ".brood-status") true))))

(describe "client-js"
  (test "serves the bundled client source"
    (let (js (client-js))
      (assert= (string? js) true)
      (assert= (includes? js "BroodLive") true))))

(describe "client-js-handler"
  (test "serves the client as JS"
    (let (resp ((client-js-handler) (client-js-conn)))
      (assert= (get resp :status) 200)
      (assert= (get (get resp :resp-headers) :content-type) "text/javascript; charset=utf-8")))
  (test "revalidates (no stale cached client)"
    (let (resp ((client-js-handler) (client-js-conn)))
      (assert= (get (get resp :resp-headers) :cache-control) "no-cache"))))

(describe "live--ws-path"
  (test "strips the /live/ws prefix"
    (assert= (web/live/live-ws-path "/live/ws/counter") "/counter"))
  (test "root live path" (assert= (web/live/live-ws-path "/live/ws/") "/"))
  (test "passes non-ws paths through" (assert= (web/live/live-ws-path "/counter") "/counter")))

; recv-frame--loop must reassemble a WebSocket message that arrives split across many TCP reads,
; in O(n): once the length header is in, `frame-size` sizes the frame and the reader gathers the
; remaining reads into a list, joining once (no O(n²) re-`str`ing of the whole buffer per read).
; A 300-byte masked frame (16-bit length, non-zero key) is delivered here in small chunks.

(defn ws-masked-frame (opcode payload-vals key)
  "A masked client frame (16-bit length form) as a `bytes` value: FIN+opcode, masked|126, the
  big-endian length, the 4-byte mask, then payload XORed with key[i%4]."
  (let (n (count payload-vals)
        masked (map (fn (i) (bit-xor (nth payload-vals i) (nth key (mod i 4)))) (range n)))
    (bytes (append [(+ 128 opcode) (+ 128 126) (quot n 256) (mod n 256)] key masked))))

(defn feed-tcp (sock frame chunk)
  "Post `frame` (bytes) to this process's mailbox as `[:tcp sock …]` reads of `chunk` bytes each,
  as the socket layer would deliver them."
  (let (flen (byte-length frame))
    (fold (fn (_ k)
            (send (self) [:tcp sock (subbytes frame (* k chunk) (min flen (* (+ k 1) chunk)))]))
      nil
      (range (quot (+ flen (- chunk 1)) chunk)))))

(describe "recv-frame--loop: a large frame gathered across many reads"
  (test "reassembles a 300-byte masked text frame split into 50-byte reads"
    (let (payload (into [] (map (fn (i) (mod i 100)) (range 300)))
          frame (ws-masked-frame 1 payload [17 34 51 68])
          sock :sock
          _ (feed-tcp sock frame 50))
      (match (web/live/recv-frame-loop sock (bytes []))
        ([:ok opcode payload-out rem] (do
                                        (assert= opcode 1)
                                        (assert= (count rem) 0)
                                        (assert= (into [] (bytes->list payload-out)) payload)))
        (o (assert= o :ok)))))
  (test "also reassembles when delivered one byte per read (header assembled incrementally)"
    (let (payload (into [] (map (fn (i) (mod (+ i 7) 100)) (range 200)))
          frame (ws-masked-frame 1 payload [9 88 200 3])
          sock :sock
          _ (feed-tcp sock frame 1))
      (match (web/live/recv-frame-loop sock (bytes []))
        ([:ok _opcode payload-out rem] (do
                                         (assert= (count rem) 0)
                                         (assert= (into [] (bytes->list payload-out)) payload)))
        (o (assert= o :ok))))))

; :isolated — registering and looking up both touch the shared :hatch-live-routes process,
; and running concurrently with other suites (especially the crash test below) would race its
; kill/restart window. Isolated units run alone, serially, first — mirroring production, where
; the router registers every route at load, before any connection looks a path up.
(describe "live-route registry"
  :isolated
  (test "register, look up, and miss"
    (do
      (register-live "/reg-test" (fn () {:ok true}) :admin)
      ; its live-session group
      (let (e (lookup-live "/reg-test"))
        ; the registered spec thunk
        (assert= ((get e :spec)) {:ok true})
        (assert= (get e :session) :admin))
      (assert= (lookup-live "/never-registered-xyz") nil))))

; Tier-3 (docs/robustness.md): the route table survives the registry process crashing —
; it mirrors to a supervised vault and re-seeds from it on restart.
(describe "live-route registry survives a crash"
  :isolated
  (test "a registered route is still there after the registry process is killed"
    (do
      (register-live "/crash-test" (fn () {:ok true}) :customer)
      (assert= (get (lookup-live "/crash-test") :session) :customer)
      ; hard-kill the route registry; the supervisor restarts it and it re-seeds from the vault
      (exit (whereis :hatch-live-routes) :kill)
      ; wait for the supervised restart + re-seed (lookup itself also waits out the window)
      (sleep 80)
      (let (e (lookup-live "/crash-test"))
        (assert= (nil? e) false)
        (assert= ((get e :spec)) {:ok true})
        (assert= (get e :session) :customer)))))

(describe "reload broadcast"
  ; notify-reload fans a [:reload] out to every registered session via the :hatch-live
  ; reload registry — the code-hot-reload sibling of notify-reload-css. A `deflive`
  ; sentinel (`(def live--reloaded (notify-reload))`) fires it on every module (re)load,
  ; and `nest run --watch src/` drives that reload on each save; the session's [:reload]
  ; handler then re-resolves fresh code via spec-fn and re-renders. Register this test
  ; process as a stand-in session, fire the notify, and confirm the message arrives.
  ; Unregister after so we don't leak into other tests.
  (test "notify-reload is a safe no-op before any session registers"
    (assert= (notify-reload) nil))
  (test "a registered session receives [:reload]"
    (do
      (web/live/live-register (self))
      (notify-reload)
      (let (got (receive ([:reload] :got) (after 1000 :timeout)))
        (web/live/live-unregister (self))
        (assert= got :got)))))

(describe "reload-css broadcast"
  ; notify-reload-css fans a [:reload-css] out to every registered session via the
  ; :hatch-live reload registry. Register this test process as a stand-in session, fire
  ; the notify, and confirm the message arrives — the same path the asset watcher drives
  ; on each CSS rebuild. Unregister after so we don't leak into other tests.
  (test "notify-reload-css is a safe no-op before any session registers"
    (assert= (notify-reload-css) nil))
  (test "a registered session receives [:reload-css]"
    (do
      (web/live/live-register (self))
      (notify-reload-css)
      (let (got (receive ([:reload-css] :got) (after 1000 :timeout)))
        (web/live/live-unregister (self))
        (assert= got :got)))))

(describe "send-info"
  ; send-info is the delivery primitive PubSub/Presence build on: it posts an [:info
  ; payload] envelope to a session pid, which the session loop routes to handle-info. Use
  ; this test process as a stand-in session and confirm the envelope arrives intact.
  (test "delivers an [:info payload] envelope to the session pid"
    (do
      (send-info (self) {:topic "room:1" :event "joined"})
      (assert= (receive ([:info payload] payload) (after 1000 :timeout))
        {:topic "room:1" :event "joined"})))
  (test "returns nil and the payload can be any term"
    (let (ret (send-info (self) :ping)
          drained (receive ([:info p] p) (after 1000 :timeout)))
      (assert= ret nil)
      (assert= drained :ping))))

; Inbound WS event params arrive as JSON; the decoder must handle every escape JSON.stringify
; can emit — including \uXXXX (control chars) and the named \b/\f — and must never crash the
; session process on a hostile escape (a lone surrogate, bad hex), falling back to U+FFFD.
(describe "json-decode string escapes"
  (test "named escapes n/r/t/b/f and backslash/quote/slash"
    (assert= (json-decode "\"a\\nb\\tc\\\\d\\\"e\\/f\"") "a\nb\tc\\d\"e/f"))
  (test "\\uXXXX decodes to the codepoint (lowercase and uppercase hex)"
    (assert= (json-decode "\"\\u0041\\u00e9\\u00C9\"") (str "A" (int->char 233) (int->char 201))))
  (test "\\u of a control char round-trips (e.g. tab via \\u0009)"
    (assert= (json-decode "\"x\\u0009y\"") "x\ty"))
  (test "a lone surrogate falls back to U+FFFD instead of crashing"
    (assert= (json-decode "\"\\uD83D\"") (int->char 65533)))
  (test "malformed hex falls back to U+FFFD"
    (assert= (json-decode "\"\\uZZZZ\"") (int->char 65533)))
  (test "\\u inside an object value"
    (assert= (json-decode "{\"k\":\"\\u0041\"}") {"k" "A"})))

; The decoder threads an index cursor (linear, no per-char substring). Cover the shapes
; brood_live.js sends — objects/arrays/numbers/booleans with insignificant whitespace.
(describe "json-decode structures"
  (test "object with whitespace around tokens"
    (assert= (json-decode "  { \"event\" : \"inc\" , \"params\" : { \"value\" : \"3\" } }  ")
      {"event" "inc" "params" {"value" "3"}}))
  (test "array of mixed scalars"
    (assert= (json-decode "[1, 2.5, true, false, null, \"x\"]") [1 2.5 true false nil "x"]))
  (test "empty object and array"
    (assert= (json-decode "{}") {})
    (assert= (json-decode "[]") []))
  (test "nested array in object"
    (assert= (json-decode "{\"a\":[1,[2,3]]}") {"a" [1 [2 3]]}))
  (test "negative and exponent numbers"
    (assert= (json-decode "[-5, 1e3]") [-5 1000.0])))

; Handler effects queue a [:push-effect …] to the session process (here, the test process),
; which flush-effects later forwards to the client. Assert each helper posts the right frame.
(describe "handler effects"
  (test "push-event queues a client push-effect"
    (push-event "focus" {"id" "field"})
    (receive
      ([:push-effect m] (assert= (get m :event) "push")
        (assert= (get m :name) "focus")
        (assert= (get m :payload) {"id" "field"}))
      (after 200 (assert= "no push-effect received" false))))
  (test "push-navigate queues a nav effect"
    (push-navigate "/next")
    (receive
      ([:push-effect m] (assert= (get m :event) "nav") (assert= (get m :path) "/next"))
      (after 200 (assert= "no nav effect received" false))))
  (test "push-redirect queues a redirect effect"
    (push-redirect "/logout")
    (receive
      ([:push-effect m] (assert= (get m :event) "redirect") (assert= (get m :path) "/logout"))
      (after 200 (assert= "no redirect effect received" false)))))

(describe "parse-client-frame: a non-object frame can't crash the session actor"
  ; the frame carries every dispatch field (:event/:params/:name/:cid/:path); absent ones default
  (test "a bare scalar decodes to an empty event (no throw)"
    (assert= (parse-client-frame (string->utf8-bytes "5"))
      {:event "" :params {} :name "" :cid nil :path "" :sfp nil}))
  (test "a bare bool decodes to an empty event"
    (assert= (parse-client-frame (string->utf8-bytes "true"))
      {:event "" :params {} :name "" :cid nil :path "" :sfp nil}))
  (test "a bare string decodes to an empty event"
    (assert= (parse-client-frame (string->utf8-bytes "\"x\""))
      {:event "" :params {} :name "" :cid nil :path "" :sfp nil}))
  (test "a JSON array decodes to an empty event"
    (assert= (parse-client-frame (string->utf8-bytes "[1,2,3]"))
      {:event "" :params {} :name "" :cid nil :path "" :sfp nil}))
  (test "unparseable garbage decodes to an empty event"
    (assert= (parse-client-frame (string->utf8-bytes "}{not json"))
      {:event "" :params {} :name "" :cid nil :path "" :sfp nil}))
  (test "a well-formed object keeps its event and params"
    (assert= (parse-client-frame (string->utf8-bytes "{\"event\":\"tick\",\"params\":{\"n\":1}}"))
      {:event "tick" :params {"n" 1} :name "" :cid nil :path "" :sfp nil}))
  (test "a non-object params is coerced to an empty map"
    (assert= (parse-client-frame (string->utf8-bytes "{\"event\":\"go\",\"params\":5}"))
      {:event "go" :params {} :name "" :cid nil :path "" :sfp nil}))
  (test "a component-targeted event carries its name, cid, and params"
    (assert= (parse-client-frame (string->utf8-bytes "{\"event\":\"event\",\"name\":\"click\",\"cid\":\"3\",\"params\":{\"x\":1}}"))
      {:event "event" :params {"x" 1} :name "click" :cid "3" :path "" :sfp nil}))
  (test "a navigate frame carries its path"
    (assert= (parse-client-frame (string->utf8-bytes "{\"event\":\"navigate\",\"path\":\"/next\"}"))
      {:event "navigate" :params {} :name "" :cid nil :path "/next" :sfp nil})))
