(defmodule web-assets-test (:use web/assets) (:alias web/static) (:use test))
(describe "proc-opts"
  (test "empty when no cwd/env"
    (assert= (proc-opts {:cmd ["x"]}) {}))
  (test "carries cwd"
    (assert= (proc-opts {:cmd ["x"] :cwd "/tmp"}) {:cwd "/tmp"}))
  (test "carries cwd and env"
    (assert= (proc-opts {:cmd ["x"] :cwd "/tmp" :env {"A" "1"}})
      {:cwd "/tmp" :env {"A" "1"}})))

(describe "run-each / build"
  (test "no commands is a no-op"
    (assert= (build {}) nil))
  (test "a zero-exit command succeeds"
    (assert= (build {:build [["sh" "-c" "exit 0"]]}) nil))
  (test "a non-zero exit raises"
    (assert-error (build {:build [["sh" "-c" "exit 3"]]})))
  (test "install runs its commands too"
    (assert= (install {:install [["sh" "-c" "exit 0"]]}) nil)))

(describe "on-output: per-line logging + residual buffering"
  ; No live registry running in the test, so a CSS-reload signal is a safe no-op — we assert
  ; the RETURN (the trailing incomplete line carried to the next chunk) and that it never blows
  ; up. Complete lines (before the last \n) are consumed; the partial tail is returned.
  (test "a complete line leaves an empty residual"
    (assert= (on-output "Done in 5ms\n" "Done in") ""))
  (test "an incomplete trailing line is returned as the residual"
    (assert= (on-output "Rebuilding" "Done in") "Rebuilding"))
  (test "complete lines are consumed, the partial tail carried forward"
    (assert= (on-output "line1\nline2\npart" "Done in") "part"))
  (test "marker absent still returns the residual, no crash"
    (assert= (on-output "Rebuilding...\n" "Done in") "")))

(describe "fingerprint-name"
  (test "inserts the digest before the extension"
    (assert= (fingerprint-name "app.css" "deadbeef") "app.deadbeef.css"))
  (test "keeps subdirectories"
    (assert= (fingerprint-name "css/app.css" "deadbeef") "css/app.deadbeef.css"))
  (test "no extension → append the digest"
    (assert= (fingerprint-name "robots" "deadbeef") "robots.deadbeef")))

(describe "fingerprint"
  (test "writes content-addressed copies and a manifest"
    (let (dir "/tmp/hatch-assets-fp-test"
          _ (check-allow :discarded-catch (try (file/mkdir dir) (catch _ nil)))
          content "body{color:red}"
          _ (file/spit (str dir "/app.css") content)
          manifest (fingerprint {:dir dir :files ["app.css"]})
          fp (get manifest "app.css"))
      (assert= fp (fingerprint-name "app.css" (string/substring (hash/sha256 content) 0 8)))
      (assert= (file/exists? (str dir "/" fp)) true)
      (assert= (file/slurp (str dir "/" fp)) content)
      (assert= (static/parse-manifest (file/slurp (str dir "/cache-manifest"))) manifest)
      ; the atomic write renames its temp file into place — none should be left behind
      (assert= (file/exists? (str dir "/cache-manifest.tmp")) false)
      (file/rm (str dir "/app.css"))
      (file/rm (str dir "/" fp))
      ; fingerprinting a compressible asset also emits best-effort .br and .gz siblings
      (when (file/exists? (str dir "/" fp ".gz")) (file/rm (str dir "/" fp ".gz")))
      (when (file/exists? (str dir "/" fp ".br")) (file/rm (str dir "/" fp ".br")))
      (file/rm (str dir "/cache-manifest")))))

(describe "compressible?"
  (test "text assets are compressible"
    (assert= (compressible? "app.css") true)
    (assert= (compressible? "app.js") true)
    (assert= (compressible? "icon.svg") true))
  ;; wasm READS as a binary and so is easy to file with the already-compressed ones, but it is
  ;; a plain container of bytecode and section names: a 7.0 MB wasm-bindgen build gzips to
  ;; 2.5 MB. This test used to assert the opposite, which is why it is spelled out here.
  (test "wasm is compressible, despite being binary"
    (assert= (compressible? "app.wasm") true))
  (test "already-compressed binaries are not"
    (assert= (compressible? "logo.png") false)
    (assert= (compressible? "font.woff2") false)
    (assert= (compressible? "bundle.gz") false)))

(describe "fingerprint precompression"
  ; precompress compresses in-process (no external CLI), writing both a brotli .br and a gzip .gz
  ; sibling — assert each exists, is smaller, and round-trips back to the original bytes.
  (test "a fingerprinted compressible asset gets smaller .br and .gz siblings"
    (let (dir "/tmp/hatch-fp-gz-test"
          _ (check-allow :discarded-catch (try (file/mkdir dir) (catch _ nil)))
          body (string/join (map (range 0 200) (fn (_) "body { color: red; }\n")) "")
          _ (file/spit (str dir "/app.css") body)
          fp (fingerprint-file dir "app.css")
          gz (str dir "/" fp ".gz")
          br (str dir "/" fp ".br"))
      (assert= (file/exists? gz) true)
      (assert= (file/exists? br) true)
      (assert= (< (count (file/slurp-bytes gz)) (count (string/->bytes body))) true)
      (assert= (< (count (file/slurp-bytes br)) (count (string/->bytes body))) true)
      ; each variant is valid and recovers the exact source bytes
      (assert= (string/bytes-> (zlib/gunzip (file/slurp-bytes gz))) body)
      (assert= (string/bytes-> (zlib/unbrotli (file/slurp-bytes br))) body)
      (file/rm (str dir "/app.css"))
      (file/rm (str dir "/" fp))
      (when (file/exists? gz) (file/rm gz))
      (when (file/exists? br) (file/rm br)))))

;; A name-pinned asset (one whose name another asset has baked in) gets sidecars WITHOUT being
;; renamed — the case `:precompress` exists for.
(describe "precompress-spec"
  (test "writes .br/.gz siblings and leaves the file's own name alone"
    (let (dir "/tmp/hatch-precompress-spec-test"
          _ (check-allow :discarded-catch (try (file/mkdir dir) (catch _ nil)))
          body (string/join (map (range 0 200) (fn (_) "some repeated payload bytes\n")) "")
          _ (file/spit (str dir "/mod_bg.wasm") body))
      (precompress-spec {:dir dir :files ["mod_bg.wasm"]})
      (assert= (file/exists? (str dir "/mod_bg.wasm")) true)
      (assert= (file/exists? (str dir "/mod_bg.wasm.br")) true)
      (assert= (file/exists? (str dir "/mod_bg.wasm.gz")) true)
      (is (< (count (file/slurp-bytes (str dir "/mod_bg.wasm.br")))
            (count (file/slurp-bytes (str dir "/mod_bg.wasm")))))
      (dolist (f ["mod_bg.wasm" "mod_bg.wasm.br" "mod_bg.wasm.gz"])
        (when (file/exists? (str dir "/" f)) (file/rm (str dir "/" f)))))))

;; Re-running the step must be a no-op, not the work again. `serve` calls `prepare` on every
;; prod boot, so if this regresses, an app whose image precompressed a large asset pays the
;; full compression cost on the boot path of whatever machine it lands on.
(describe "precompress is idempotent"
  (test "an up-to-date sibling is left alone, a stale one is rebuilt"
    (let (dir "/tmp/hatch-precompress-idem-test"
          _ (check-allow :discarded-catch (try (file/mkdir dir) (catch _ nil)))
          path (str dir "/asset.css"))
      ;; Big enough that compressing it takes well over the millisecond `file/mtime` resolves
      ;; to — otherwise the sibling can share a timestamp with its source and read as stale.
      (file/spit path
        (string/join (map (range 0 20000) (fn (i) (str "body { --n" i ": red; }\n"))) ""))
      (precompress path)
      (assert= (fresh-sibling? (str path ".br") path) true)
      (let (first-bytes (file/slurp-bytes (str path ".br")))
        ;; second call: sibling is current, so nothing is rewritten
        (precompress path)
        (assert= (count (file/slurp-bytes (str path ".br"))) (count first-bytes))
        ;; a rewritten source makes the sibling stale again
        (file/spit path
          (string/join (map (range 0 40000) (fn (i) (str "body { --b" i ": blue; }\n"))) ""))
        (assert= (fresh-sibling? (str path ".br") path) false)
        (precompress path)
        (is (not (= (count (file/slurp-bytes (str path ".br"))) (count first-bytes)))))
      (dolist (f ["asset.css" "asset.css.br" "asset.css.gz"])
        (when (file/exists? (str dir "/" f)) (file/rm (str dir "/" f))))))

  (test "a missing sibling is not fresh"
    (assert= (fresh-sibling? "/tmp/hatch-no-such-file.br" "/tmp/hatch-no-such-file") false)))
