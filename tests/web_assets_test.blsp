(defmodule web-assets-test (:use web/assets) (:alias web/static) (:use test))
(require 'hash)
(require 'zlib) ; round-trip the in-process precompressed `.gz`
(describe "proc-opts"
  (test "empty when no cwd/env"
    (assert= (proc-opts {:cmd ["x"]}) {}))
  (test "carries cwd"
    (assert= (proc-opts {:cmd ["x"] :cwd "/tmp"}) {:cwd "/tmp"}))
  (test "carries cwd and env"
    (assert= (proc-opts {:cmd ["x"] :cwd "/tmp" :env {"A" "1"}})
      {:cwd "/tmp" :env {"A" "1"}})))

(describe "run-each / build"
  (test "no commands is a no-op"
    (assert= (build {}) nil))
  (test "a zero-exit command succeeds"
    (assert= (build {:build [["sh" "-c" "exit 0"]]}) nil))
  (test "a non-zero exit raises"
    (assert-error (build {:build [["sh" "-c" "exit 3"]]})))
  (test "install runs its commands too"
    (assert= (install {:install [["sh" "-c" "exit 0"]]}) nil)))

(describe "on-output: per-line logging + residual buffering"
  ; No live registry running in the test, so a CSS-reload signal is a safe no-op — we assert
  ; the RETURN (the trailing incomplete line carried to the next chunk) and that it never blows
  ; up. Complete lines (before the last \n) are consumed; the partial tail is returned.
  (test "a complete line leaves an empty residual"
    (assert= (on-output "Done in 5ms\n" "Done in") ""))
  (test "an incomplete trailing line is returned as the residual"
    (assert= (on-output "Rebuilding" "Done in") "Rebuilding"))
  (test "complete lines are consumed, the partial tail carried forward"
    (assert= (on-output "line1\nline2\npart" "Done in") "part"))
  (test "marker absent still returns the residual, no crash"
    (assert= (on-output "Rebuilding...\n" "Done in") "")))

(describe "fingerprint-name"
  (test "inserts the digest before the extension"
    (assert= (fingerprint-name "app.css" "deadbeef") "app.deadbeef.css"))
  (test "keeps subdirectories"
    (assert= (fingerprint-name "css/app.css" "deadbeef") "css/app.deadbeef.css"))
  (test "no extension → append the digest"
    (assert= (fingerprint-name "robots" "deadbeef") "robots.deadbeef")))

(describe "fingerprint"
  (test "writes content-addressed copies and a manifest"
    (let (dir "/tmp/hatch-assets-fp-test"
          _ (try (make-dir dir) (catch _ nil))
          content "body{color:red}"
          _ (spit (str dir "/app.css") content)
          manifest (fingerprint {:dir dir :files ["app.css"]})
          fp (get manifest "app.css"))
      (assert= fp (fingerprint-name "app.css" (substring (hash/sha256 content) 0 8)))
      (assert= (file-exists? (str dir "/" fp)) true)
      (assert= (slurp (str dir "/" fp)) content)
      (assert= (static/parse-manifest (slurp (str dir "/cache-manifest"))) manifest)
      ; the atomic write renames its temp file into place — none should be left behind
      (assert= (file-exists? (str dir "/cache-manifest.tmp")) false)
      (delete-file (str dir "/app.css"))
      (delete-file (str dir "/" fp))
      ; fingerprinting a compressible asset also emits a best-effort .gz sibling
      (when (file-exists? (str dir "/" fp ".gz")) (delete-file (str dir "/" fp ".gz")))
      (delete-file (str dir "/cache-manifest")))))

(describe "compressible?"
  (test "text assets are compressible"
    (assert= (compressible? "app.css") true)
    (assert= (compressible? "app.js") true)
    (assert= (compressible? "icon.svg") true))
  (test "already-compressed binaries are not"
    (assert= (compressible? "logo.png") false)
    (assert= (compressible? "font.woff2") false)
    (assert= (compressible? "app.wasm") false)))

(describe "fingerprint precompression"
  ; precompress compresses in-process via `zlib/gzip` (no external `gzip` CLI), so the .gz is
  ; always produced — assert it exists, is smaller, and round-trips back to the original bytes.
  (test "a fingerprinted compressible asset gets a smaller .gz sibling"
    (let (dir "/tmp/hatch-fp-gz-test"
          _ (try (make-dir dir) (catch _ nil))
          body (join "" (map (fn (_) "body { color: red; }\n") (range 0 200)))
          _ (spit (str dir "/app.css") body)
          fp (fingerprint-file dir "app.css")
          gz (str dir "/" fp ".gz"))
      (assert= (file-exists? gz) true)
      (assert= (> (count (slurp-bytes gz)) 0) true)
      (assert= (< (count (slurp-bytes gz)) (count (string->utf8-bytes body))) true)
      ; the .gz is valid gzip: gunzip recovers the exact source bytes
      (assert= (utf8-bytes->string (zlib/gunzip (slurp-bytes gz))) body)
      (delete-file (str dir "/app.css"))
      (delete-file (str dir "/" fp))
      (when (file-exists? gz) (delete-file gz)))))
