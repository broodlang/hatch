(defmodule web-compress-test (:use web/compress) (:use web/conn) (:use test))

(defn req (&optional (headers {:accept-encoding "gzip"}))
  "A GET conn-request map with the given request headers."
  {:method "GET" :path "/" :query "" :params {} :headers headers :body ""})

(describe "content negotiation (brotli preferred over gzip)"
  (test "accepts? detects a coding in Accept-Encoding"
    (assert= (accepts? (req {:accept-encoding "br, gzip"}) "br") true)
    (assert= (accepts? (req {:accept-encoding "gzip"}) "br") false))
  (test "chosen-encoding prefers br, then gzip, else nil"
    (assert= (chosen-encoding (req {:accept-encoding "br, gzip"})) "br")
    (assert= (chosen-encoding (req {:accept-encoding "gzip"})) "gzip")
    (assert= (chosen-encoding (req {:accept-encoding "identity"})) nil)
    (assert= (chosen-encoding (req {})) nil)))

;; RFC 7231: `coding;q=0` is a refusal, and a substring test reads it as consent — which
;; inverts what the client asked for. A positive weight, however small, is not a refusal.
(describe "accepts? honours an explicit q=0 refusal"
  (test "a plain offer is accepted"
    (is (accepts? (build (req {:accept-encoding "gzip, br"})) "gzip"))
    (is (accepts? (build (req {:accept-encoding "gzip, br"})) "br")))

  (test "q=0 refuses that coding only"
    (let (conn (build (req {:accept-encoding "gzip;q=0, br"})))
      (is (not (accepts? conn "gzip")))
      (is (accepts? conn "br"))))

  (test "spacing and decimal zeroes are all refusals"
    (for (header ["gzip;q=0" "gzip; q=0.0" "gzip ; q=0.00" "GZIP;Q=0"])
      (is (not (accepts? (build (req {:accept-encoding header})) "gzip")))))

  (test "a small positive weight is not a refusal"
    (is (accepts? (build (req {:accept-encoding "gzip;q=0.001"})) "gzip")))

  (test "a refused brotli falls back to gzip rather than to nothing"
    (assert= "gzip" (chosen-encoding (build (req {:accept-encoding "br;q=0, gzip"})))))

  (test "no header means no compression"
    (is (nil? (chosen-encoding (build (req {})))))))

;; Three layers ask "does this client accept gzip?" — compress (compress the body?), static
;; (serve the precompressed .gz sibling?) and stream (gzip the event stream?). They each had
;; their own predicate and only compress's honoured `q=0`, so a client that spelled out
;; "do not gzip me" was refused by one layer and gzipped by the other two. They share
;; `http/util/accepts-encoding?` now; this pins that they cannot drift apart again.
(describe "the three Accept-Encoding layers agree"
  (defn- answers (accept-encoding)
    (let (conn (build (req {:accept-encoding accept-encoding})))
      [(accepts? conn "gzip")
        (web/static/accepts? conn "gzip")
        (web/stream/accepts-gzip? conn)]))
  (test "a browser header: all three say yes"
    (assert= (answers "gzip, deflate, br") [true true true]))
  (test "an explicit refusal: all three say no"
    (assert= (answers "gzip;q=0") [false false false]))
  (test "a positive weight: all three say yes"
    (assert= (answers "gzip;q=0.001") [true true true]))
  (test "no gzip on offer: all three say no"
    (assert= (answers "br") [false false false])))
