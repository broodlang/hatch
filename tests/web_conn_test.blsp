(defmodule web-conn-test (:use web/conn) (:use test))

(def *req*
  {:method "GET"
   :path "/hello"
   :query "name=world"
   :params {"name" "world"}
   :headers {:host "localhost"}
   :body ""})

(describe "build"
  (test "method" (assert= (get (build *req*) :method) "GET"))
  (test "path" (assert= (get (build *req*) :path) "/hello"))
  (test "params" (assert= (get (build *req*) :params) {"name" "world"}))
  (test "assigns" (assert= (get (build *req*) :assigns) {}))
  (test "not halted" (assert= (get (build *req*) :halted?) false)))

(describe "assign / get-assign"
  (test "round-trip"
    (let (conn (assign (build *req*) :user "alice"))
      (assert= (get-assign conn :user) "alice")))
  (test "missing key is nil"
    (assert= (get-assign (build *req*) :missing) nil)))

(describe "halt"
  (test "sets halted?"
    (assert= (halted? (halt (build *req*))) true))
  (test "fresh conn not halted"
    (assert= (halted? (build *req*)) false)))

(describe "param / header"
  (test "param by string key"
    (assert= (param (build *req*) "name") "world"))
  (test "header by keyword"
    (assert= (header (build *req*) :host) "localhost")))

(describe "send-resp"
  (test "status"
    (assert= (get (send-resp (build *req*) 200 "ok") :status) 200))
  (test "resp-body"
    (assert= (get (send-resp (build *req*) 200 "ok") :resp-body) "ok"))
  (test "returns a conn (keeps request fields)"
    (assert= (get (send-resp (build *req*) 200 "ok") :method) "GET")))

(describe "conn->response"
  (test "serializes status / headers / body"
    (let (conn (text-resp (build *req*) "hi")
          r (conn->response conn))
      (assert= (get r :status) 200)
      (assert= (get r :body) "hi")
      (assert= (get (get r :headers) :content-type) "text/plain; charset=utf-8")))
  (test "defaults status to 200 when unset"
    (assert= (get (conn->response (build *req*)) :status) 200)))

(describe "convenience response fns"
  (test "html-resp status 200"
    (assert= (get (html-resp (build *req*) "<p>hi</p>") :status) 200))
  (test "text-resp content-type"
    (let (r (text-resp (build *req*) "hello"))
      (assert= (get (get r :resp-headers) :content-type) "text/plain; charset=utf-8")))
  (test "json-resp content-type"
    (let (r (json-resp (build *req*) "{}"))
      (assert= (get (get r :resp-headers) :content-type) "application/json")))
  (test "redirect-resp status 302"
    (assert= (get (redirect-resp (build *req*) "/new") :status) 302))
  (test "redirect-resp location header"
    (assert= (get (get (redirect-resp (build *req*) "/new") :resp-headers) :location) "/new"))
  (test "not-found-resp status 404"
    (assert= (get (not-found-resp (build *req*)) :status) 404)))

(describe "body params merged into :params"
  (test "urlencoded form body"
    (let (conn (build {:method "POST"
                       :path "/x"
                       :query ""
                       :params {}
                       :headers {:content-type "application/x-www-form-urlencoded"}
                       :body "name=alice&role=admin"}))
      (assert= (param conn "name") "alice")
      (assert= (param conn "role") "admin")))
  (test "JSON object body (keys stringified)"
    (let (conn (build {:method "POST"
                       :path "/x"
                       :query ""
                       :params {}
                       :headers {:content-type "application/json"}
                       :body "{\"name\":\"bob\",\"n\":2}"}))
      (assert= (param conn "name") "bob")
      (assert= (param conn "n") 2)))
  (test "nested JSON object keys are stringified deeply (not left as keywords)"
    (let (conn (build {:method "POST"
                       :path "/x"
                       :query ""
                       :params {}
                       :headers {:content-type "application/json"}
                       :body "{\"user\":{\"name\":\"ada\"}}"}))
      (assert= (param conn "user") {"name" "ada"})))
  (test "body params override query params on a key clash"
    (let (conn (build {:method "POST"
                       :path "/x"
                       :query "q=1"
                       :params {"q" "1"}
                       :headers {:content-type "application/x-www-form-urlencoded"}
                       :body "q=2"}))
      (assert= (param conn "q") "2")))
  (test "unknown content-type leaves params untouched, body intact"
    (let (conn (build {:method "POST"
                       :path "/x"
                       :query ""
                       :params {}
                       :headers {:content-type "text/plain"}
                       :body "raw text"}))
      (assert= (get conn :params) {})
      (assert= (get conn :body) "raw text")))
  (test "malformed JSON is ignored, not fatal"
    (let (conn (build {:method "POST"
                       :path "/x"
                       :query ""
                       :params {}
                       :headers {:content-type "application/json"}
                       :body "{not json"}))
      (assert= (get conn :params) {}))))

(describe "request cookies"
  (test "parses the Cookie header into :cookies"
    (let (conn (build {:method "GET"
                       :path "/"
                       :query ""
                       :params {}
                       :headers {:cookie "a=1; b=two"}
                       :body ""}))
      (assert= (get-cookie conn "a") "1")
      (assert= (get-cookie conn "b") "two")))
  (test "missing cookie returns the default"
    (assert= (get-cookie (build *req*) "x" "none") "none")))

(describe "response cookies"
  (test "put-cookie emits a Set-Cookie with defaults"
    (let (r (conn->response (put-cookie (build *req*) "sid" "abc")))
      (assert= (get (get r :headers) :set-cookie)
        (list "sid=abc; Path=/; SameSite=Lax; HttpOnly"))))
  (test "CRLF in the Path attribute is stripped (no response splitting)"
    (let (sc (format-set-cookie "sid"
               "abc"
               {:path "/a\r\nSet-Cookie: evil=1" :same-site "Lax\r\nX: y"}))
      (assert= (includes? sc "\r") false)
      (assert= (includes? sc "\n") false)))
  (test "multiple cookies → a list (one header line each)"
    (let (conn (-> (build *req*) (put-cookie "a" "1") (put-cookie "b" "2"))
          r (conn->response conn))
      (assert= (get (get r :headers) :set-cookie)
        (list "a=1; Path=/; SameSite=Lax; HttpOnly" "b=2; Path=/; SameSite=Lax; HttpOnly"))))
  (test "opts: max-age + secure, http-only off"
    (let (r (conn->response (put-cookie (build *req*)
                              "t"
                              "v"
                              {:max-age 60 :secure true :http-only false})))
      (assert= (get (get r :headers) :set-cookie)
        (list "t=v; Path=/; Max-Age=60; SameSite=Lax; Secure"))))
  (test "delete-cookie expires with Max-Age=0"
    (let (r (conn->response (delete-cookie (build *req*) "sid")))
      (assert= (get (get r :headers) :set-cookie)
        (list "sid=; Path=/; Max-Age=0; SameSite=Lax; HttpOnly"))))
  (test "no cookies → no Set-Cookie header"
    (assert= (get (get (conn->response (build *req*)) :headers) :set-cookie) nil))
  (test "cookie name/value are sanitized against attribute/header injection"
    (let (r (conn->response (put-cookie (build *req*) "sid" "abc; Domain=evil.com\r\nX: y")))
      ; the ';' and CR/LF are stripped, so no extra attribute or header can be smuggled
      (assert= (get (get r :headers) :set-cookie)
        (list "sid=abc Domain=evil.comX: y; Path=/; SameSite=Lax; HttpOnly")))))

(describe "before-send"
  (test "callbacks run in order at conn->response time"
    (let (conn (-> (build *req*)
                 (register-before-send (fn (c) (put-resp-header c :x-a "1")))
                 (register-before-send (fn (c) (put-resp-header c :x-b "2"))))
          r (conn->response conn))
      (assert= (get (get r :headers) :x-a) "1")
      (assert= (get (get r :headers) :x-b) "2"))))

(describe "run-pipeline"
  (test "applies plugs in order"
    (let (p1 (fn (conn) (assign conn :step1 true))
          p2 (fn (conn) (assign conn :step2 true))
          conn (run-pipeline (build *req*) [p1 p2]))
      (assert= (get-assign conn :step1) true)
      (assert= (get-assign conn :step2) true)))
  (test "stops at halt"
    (let (p1 (fn (conn) (halt (assign conn :step1 true)))
          p2 (fn (conn) (assign conn :step2 "should not run"))
          conn (run-pipeline (build *req*) [p1 p2]))
      (assert= (get-assign conn :step1) true)
      (assert= (get-assign conn :step2) nil))))

; The framework's minimal request→conn→response adapter: build a conn, run the router,
; serialize. An app wires (server/start port (router->handler app-router) …).
(describe "router->handler"
  (test "adapts a conn router into an http/server response map"
    (let (router (fn (conn) (html-resp conn (str "hi " (param conn "name"))))
          handler (router->handler router)
          resp (handler *req*))
      (assert= (get resp :status) 200)
      (assert= (get resp :body) "hi world")))
  (test "a router that halts still serializes"
    (let (router (fn (conn) (send-resp conn 403 "no"))
          resp ((router->handler router) *req*))
      (assert= (get resp :status) 403)
      (assert= (get resp :body) "no"))))

(describe "json-resp"
  (test "a map body is encoded"
    (let (resp (json-resp (build *req*) {:ok true}))
      (assert= (get resp :resp-body) "{\"ok\":true}")
      (assert= (get-in resp [:resp-headers :content-type]) "application/json")
      (assert= (get resp :status) 200)))
  (test "an already-encoded string is sent as-is, not double-encoded"
    (assert= (get (json-resp (build *req*) "{\"ok\":true}") :resp-body) "{\"ok\":true}"))
  (test "a status can be given, so an error body keeps its content-type"
    ;; Without this, every JSON error path was hand-built — and one of them forgot the
    ;; content-type, which turns a parseable {"error": …} into a decoder failure.
    (let (resp (json-resp (build *req*) {:error "no such package"} 404))
      (assert= (get resp :status) 404)
      (assert= (get-in resp [:resp-headers :content-type]) "application/json")
      (assert= (get resp :resp-body) "{\"error\":\"no such package\"}")))
  (test ":cache sets Cache-Control"
    (assert= (get-in (json-resp (build *req*) {} 200 {:cache "public, max-age=60"})
               [:resp-headers :cache-control])
      "public, max-age=60"))
  (test "no :cache sets no Cache-Control — only the handler knows if a read is public"
    (assert= (get-in (json-resp (build *req*) {}) [:resp-headers :cache-control]) nil))
  (test "a list body is encoded as an array"
    (assert= (get (json-resp (build *req*) [1 2 3]) :resp-body) "[1,2,3]")))

;; ---- the Conn is a record ------------------------------------------------------------
;;
;; The reason it is: a field read now goes through a NAME. `(get conn :halted)` — one
;; character short — is a silent nil that reads as "not halted"; `(conn-halted conn)` is an
;; undefined function `nest check` reports at edit time. What is asserted here is the shape
;; that makes that safe to rely on, and the two traps it introduces.

(describe "conn as a record"
  (test "build produces a record, not a bare map"
    (is (record? (build *req*))))

  (test "it prints as itself rather than dumping its fields"
    (assert= (->string (build *req*)) "#<conn GET /hello>"))

  ;; The property the whole sweep rests on: an accessor is not a type check, so a synthetic
  ;; conn built by hand in a test — or the `{:headers {…}}` literal in a doctest — still works.
  (test "an accessor reads a plain map too"
    (assert= (conn-method {:method "POST" :path "/x"}) "POST")
    (assert= (conn-path {:method "POST" :path "/x"}) "/x"))

  ;; Trap one: a declared field is always PRESENT, so `contains?` cannot answer "was this
  ;; ever set?". conn->response depends on getting this right.
  (test "contains? is true for a declared field that is nil"
    (is (contains? (build *req*) :route))
    (assert= (conn-route (build *req*)) nil))

  (test "a fresh conn stamps no :route or :stream onto the response"
    (let (r (conn->response (build *req*)))
      (assert= (contains? r :route) false)
      (assert= (contains? r :stream) false)))

  (test "a routed conn still does"
    (assert= (get (conn->response (assoc (build *req*) :route "/hello/:id")) :route) "/hello/:id"))

  ;; Trap two: nominal equality. A conn is not `=` to a map with the same fields, so a test
  ;; may not compare one against a map literal.
  (test "a conn is not = to a bare map of its fields"
    (assert= (= (build *req*) (fields (build *req*))) false))

  ;; An app's own keys still work, and the value stays a conn.
  (test "assoc of an undeclared key keeps it a record"
    (let (c (assoc (build *req*) :tenant-id 7))
      (is (record? c))
      (assert= (get c :tenant-id) 7)
      (assert= (conn-method c) "GET")))

  ;; Session and flash start empty rather than nil, so the accessors that used to coerce a
  ;; missing map to `{}` keep answering a map.
  (test "session and flash start as empty maps, not nil"
    (assert= (conn-session (build *req*)) {})
    (assert= (conn-flash (build *req*)) {})))

;; ---- secure? now has a scheme to fall back to ----------------------------------------
;;
;; `secure?`'s "the server terminated TLS itself" branch read `:scheme`, which nothing ever
;; set — so it could not fire, and an app serving its own HTTPS reported every request as
;; insecure. That suppressed HSTS and cleared the session cookie's Secure flag on exactly
;; the deployment that had earned both. http/server stamps it now, and `build` carries it.

(describe "build carries the request scheme"
  (test "an https listener's request is secure"
    (is (secure? (build (assoc *req* :scheme "https")))))
  (test "a plaintext listener's is not"
    (assert= (secure? (build (assoc *req* :scheme "http"))) false))
  (test "a proxy header still wins over the listener's own scheme"
    (is (secure? (build (assoc *req* :scheme "http" :headers {:x-forwarded-proto "https"})))))
  (test "and no scheme at all is still not secure"
    (assert= (secure? (build *req*)) false)))
