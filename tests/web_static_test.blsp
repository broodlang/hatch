(defmodule web-static-test (:use web/static) (:use web/conn) (:use test))

(defn conn-with (params &optional (headers {}))
  (build {:method "GET" :path "/static" :query "" :params params :headers headers :body ""}))

(describe "extension"
  (test "js" (assert= (extension "app.js") "js"))
  (test "nested path" (assert= (extension "css/site.min.css") "css"))
  (test "uppercase normalized" (assert= (extension "LOGO.SVG") "svg"))
  (test "no extension" (assert= (extension "README") "")))

(describe "mime-type"
  (test "js" (assert= (mime-type "x.js") "text/javascript; charset=utf-8"))
  (test "css" (assert= (mime-type "x.css") "text/css; charset=utf-8"))
  (test "unknown fallback" (assert= (mime-type "x.bin") "application/octet-stream")))

(describe "safe-segments"
  (test "normal path" (assert= (safe-segments "css/app.css") (list "css" "app.css")))
  (test "rejects .." (assert= (safe-segments "../secret") nil))
  (test "rejects nested .." (assert= (safe-segments "a/../b") nil))
  (test "rejects ." (assert= (safe-segments "./x") nil))
  ; percent-decode is per-segment, and traversal checks run on the DECODED value
  (test "decodes %20 into the segment"
    (assert= (safe-segments "my%20file.css") (list "my file.css")))
  (test "rejects encoded .. (%2e%2e)" (assert= (safe-segments "%2e%2e/secret") nil))
  (test "rejects a decoded separator (%2f) merging segments"
    (assert= (safe-segments "..%2f..%2fetc") nil))
  (test "rejects a NUL/control byte segment" (assert= (safe-segments "a%00b") nil)))

(describe "serve"
  (test "traversal attempt is 404"
    (assert= (get (serve (conn-with {}) "static" "../CLAUDE.md") :status) 404))
  (test "missing file is 404"
    (assert= (get (serve (conn-with {}) "static" "does-not-exist.js") :status) 404))
  (test "existing file is 200"
    (assert= (get (serve (conn-with {}) "static" "brood_live.js") :status) 200))
  (test "existing file sets MIME"
    (assert= (get (get (serve (conn-with {}) "static" "brood_live.js") :resp-headers) :content-type)
      "text/javascript; charset=utf-8"))
  (test "existing file revalidates (no stale cached copy)"
    (assert= (get (get (serve (conn-with {}) "static" "brood_live.js") :resp-headers)
               :cache-control)
      "no-cache")))

(describe "handler"
  (test "reads the splat param"
    (let (h (handler "static")
          conn (conn-with {"path" "brood_live.js"}))
      (assert= (get (h conn) :status) 200)))
  (test "missing maps to 404"
    (let (h (handler "static")
          conn (conn-with {"path" "nope.css"}))
      (assert= (get (h conn) :status) 404))))

(describe "etag"
  (test "quoted, stable, content-addressed"
    (assert= (= (etag "hello") (etag "hello")) true)
    (assert= (string/starts-with? (etag "hello") "\"") true)
    (assert= (not (= (etag "hello") (etag "world"))) true)))

(describe "cached-etag"
  (test "matches a direct hash, reuses it, and re-tags after the file changes"
    (let (dir "/tmp/hatch-etag-test"
          _ (try (file/mkdir dir) (catch _ nil))
          f (str dir "/a.txt")
          _ (file/spit f "hello")
          t1 (cached-etag f "hello"))
      (assert= t1 (etag "hello"))
      ; unchanged file → same tag (served from the cache)
      (assert= (cached-etag f "hello") t1)
      ; content changes (size differs → stat differs) → recomputed tag
      (file/spit f "different content, longer")
      (let (t2 (cached-etag f "different content, longer"))
        (assert= (= t2 t1) false)
        (assert= t2 (etag "different content, longer")))
      (file/rm f))))

(describe "prod?"
  (test "false by default (dev is the zero-config default)"
    (assert= (prod?) false)))

(describe "fingerprint-shaped?"
  (test "name.<hash>.ext is shaped"
    (assert= (fingerprint-shaped? "/static/app.1a2b3c4d.css") true))
  (test "longer hash too"
    (assert= (fingerprint-shaped? "app.deadbeefcafe.js") true))
  (test "plain name is not"
    (assert= (fingerprint-shaped? "/static/app.css") false))
  (test "short/non-hex middle segment is not"
    (assert= (fingerprint-shaped? "app.v2.css") false)
    (assert= (fingerprint-shaped? "app.zzzzzzzz.css") false)))

(describe "fingerprinted? (manifest-backed)"
  ; Only a name hatch actually produced (a manifest value) is immutable — a fingerprint-
  ; shaped look-alike that isn't in the manifest must NOT be cached forever.
  (test "manifest value → yes; shaped look-alike & plain name → no"
    (let (dir "/tmp/hatch-fp2-test"
          _ (try (file/mkdir dir) (catch _ nil))
          _ (file/spit (str dir "/cache-manifest") "app.css\tapp.1a2b3c4d.css\n"))
      (assert= (fingerprinted? (str dir "/app.1a2b3c4d.css") dir) true)
      (assert= (fingerprinted? (str dir "/chunk.deadbeef.js") dir) false)
      (assert= (fingerprinted? (str dir "/app.css") dir) false)
      (file/rm (str dir "/cache-manifest"))))
  (test "no manifest → nothing is fingerprinted"
    (assert= (fingerprinted? "/tmp/hatch-fp2-test/app.1a2b3c4d.css" "/tmp/hatch-fp2-empty") false)))

(describe "cache-control"
  (test "dev revalidates everything (no stale assets, no manifest read)"
    (assert= (cache-control "app.css" "static") "no-cache")
    (assert= (cache-control "app.1a2b3c4d.css" "static") "no-cache")))

(describe "parse-range"
  (test "bytes=a-b" (let ([s e] (parse-range "bytes=0-3" 10)) (assert= s 0) (assert= e 3)))
  (test "bytes=a- runs to end"
    (let ([s e] (parse-range "bytes=5-" 10)) (assert= s 5) (assert= e 9)))
  (test "bytes=-n suffix" (let ([s e] (parse-range "bytes=-3" 10)) (assert= s 7) (assert= e 9)))
  (test "end clamped to last byte"
    (let ([s e] (parse-range "bytes=0-100" 10)) (assert= s 0) (assert= e 9)))
  (test "start past end is unsatisfiable" (assert= (parse-range "bytes=20-" 10) :unsatisfiable))
  (test "absent → nil" (assert= (parse-range nil 10) nil))
  (test "multi-range → nil (ignored)" (assert= (parse-range "bytes=0-1,5-7" 10) nil))
  (test "non-bytes unit → nil" (assert= (parse-range "items=0-3" 10) nil))
  ; A float/hex/signed offset must be rejected, not coerced — a float index would throw in
  ; `substring` and turn a crafted Range header into a 500.
  (test "float offset → nil" (assert= (parse-range "bytes=0-1.5" 10) nil))
  (test "float suffix → nil" (assert= (parse-range "bytes=-1.5" 10) nil))
  (test "hex offset → nil" (assert= (parse-range "bytes=0x1-2" 10) nil))
  (test "signed offset → nil" (assert= (parse-range "bytes=+1-2" 10) nil)))

(describe "if-none-match?"
  (test "exact single tag matches"
    (assert= (if-none-match? (conn-with {} {:if-none-match "\"abc\""}) "\"abc\"") true))
  (test "wildcard matches any tag"
    (assert= (if-none-match? (conn-with {} {:if-none-match "*"}) "\"abc\"") true))
  (test "our tag as one entry of a comma-separated list matches (RFC multi-tag)"
    (assert= (if-none-match? (conn-with {} {:if-none-match "\"x\", \"abc\", \"y\""}) "\"abc\"")
      true))
  (test "a weak W/ validator still matches our strong tag (weak comparison)"
    (assert= (if-none-match? (conn-with {} {:if-none-match "W/\"abc\""}) "\"abc\"") true))
  (test "a different single tag does not match"
    (assert= (if-none-match? (conn-with {} {:if-none-match "\"other\""}) "\"abc\"") false))
  (test "no If-None-Match header → false"
    (assert= (if-none-match? (conn-with {}) "\"abc\"") false)))

(describe "serve — revalidation without reading the body"
  (test "a matching If-None-Match answers 304 from the stat/etag cache (no re-slurp)"
    ; prime the cache with a real file, then revalidate with its tag
    (let (_ (serve (conn-with {}) "static" "brood_live.js")
          tag (fresh-cached-etag "static/brood_live.js")
          resp (serve (conn-with {} {:if-none-match tag}) "static" "brood_live.js"))
      (assert= (nil? tag) false)
      (assert= (get resp :status) 304)
      (assert= (get resp :resp-body) "")
      (assert= (get (get resp :resp-headers) :etag) tag))))

(describe "serve-body"
  (test "200 carries etag, cache-control, nosniff, accept-ranges"
    (let (resp (serve-body (conn-with {}) "text/css; charset=utf-8" "body{}" "app.css")
          h (get resp :resp-headers))
      (assert= (get resp :status) 200)
      (assert= (get h :cache-control) "no-cache")
      (assert= (get h :x-content-type-options) "nosniff")
      (assert= (get h :accept-ranges) "bytes")
      (assert= (string/blank? (get h :etag)) false)))
  (test "matching If-None-Match → bodyless 304"
    (let (tag (etag "body{}")
          resp (serve-body (conn-with {} {:if-none-match tag}) "text/css" "body{}" "app.css"))
      (assert= (get resp :status) 304)
      (assert= (get resp :resp-body) "")
      (assert= (get (get resp :resp-headers) :etag) tag)))
  (test "If-None-Match * → 304"
    (assert= (get (serve-body (conn-with {} {:if-none-match "*"}) "text/css" "x" "app.css") :status)
      304))
  (test "Range on an ASCII body → 206 with Content-Range"
    (let (resp (serve-body (conn-with {} {:range "bytes=0-3"}) "text/plain" "0123456789" "f.txt")
          h (get resp :resp-headers))
      (assert= (get resp :status) 206)
      (assert= (get resp :resp-body) "0123")
      (assert= (get h :content-range) "bytes 0-3/10")))
  (test "suffix Range → final bytes"
    (let (resp (serve-body (conn-with {} {:range "bytes=-3"}) "text/plain" "0123456789" "f.txt"))
      (assert= (get resp :status) 206)
      (assert= (get resp :resp-body) "789")))
  (test "unsatisfiable Range → 416 carrying validators + nosniff (not a bare error)"
    (let (resp (serve-body (conn-with {} {:range "bytes=99-"}) "text/plain" "0123456789" "f.txt")
          h (get resp :resp-headers))
      (assert= (get resp :status) 416)
      (assert= (get h :content-range) "bytes */10")
      (assert= (string/blank? (get h :etag)) false)
      (assert= (get h :cache-control) "no-cache")
      (assert= (get h :x-content-type-options) "nosniff")))
  (test "Range on a multibyte body falls back to a full 200"
    (let (
          ; em-dash: 3 bytes, 1 char
          body (str "ab" (string/int->char 8212) "cd")
          resp (serve-body (conn-with {} {:range "bytes=0-2"}) "text/plain" body "f.txt"))
      (assert= (get resp :status) 200)
      (assert= (get resp :resp-body) body)))
  (test "a crafted (float) Range serves a full 200 — never a 500"
    (let (resp (serve-body (conn-with {} {:range "bytes=0-1.5"}) "text/plain" "0123456789" "f.txt"))
      (assert= (get resp :status) 200)
      (assert= (get resp :resp-body) "0123456789"))))

(describe "asset-path"
  (test "dev returns the plain logical path"
    (assert= (asset-path "app.css") "/static/app.css"))
  (test "honours a custom dir"
    (assert= (asset-path "app.css" "assets") "/assets/app.css")))

(describe "manifest"
  (test "render/parse round-trips a logical→fingerprinted map"
    (let (m {"app.css" "app.1a2b3c4d.css" "app.js" "app.deadbeef.js"})
      (assert= (parse-manifest (render-manifest m)) m)))
  (test "parse ignores blank lines"
    (assert= (parse-manifest "\napp.css\tapp.abcd1234.css\n\n") {"app.css" "app.abcd1234.css"})))

(describe "load-manifest (memoized)"
  (test "reads once, serves from cache even after the file is removed; clear re-reads"
    (let (dir "/tmp/hatch-manifest-memo-test"
          _ (try (file/mkdir dir) (catch _ nil))
          _ (file/spit (str dir "/cache-manifest") "app.css\tapp.abcd1234.css\n")
          loaded (load-manifest dir))
      (assert= loaded {"app.css" "app.abcd1234.css"})
      ; remove the file — a memoized read still returns the cached map
      (file/rm (str dir "/cache-manifest"))
      (assert= (load-manifest dir) {"app.css" "app.abcd1234.css"})
      ; clearing forces a fresh (now-empty) read
      (clear-manifest-cache)
      (assert= (load-manifest dir) {}))))

(describe "accepts-gzip?"
  (test "true when Accept-Encoding offers gzip"
    (assert= (accepts-gzip? (conn-with {} {:accept-encoding "gzip, deflate, br"})) true))
  (test "false when the header is absent"
    (assert= (accepts-gzip? (conn-with {})) false)))

(describe "serve-encoded (gzip content negotiation)"
  ; The .gz bytes are opaque to serve — it never inflates them — so a plain-text stand-in is
  ; a fine fixture; we assert on the negotiation, headers, and which body is chosen.
  (test "Accept-Encoding: gzip + a .gz sibling → the gzip variant"
    (let (dir "/tmp/hatch-gz-serve-test"
          _ (try (file/mkdir dir) (catch _ nil))
          _ (file/spit (str dir "/x.css") "body{color:red}")
          _ (file/spit (str dir "/x.css.gz") "PRECOMPRESSED-BYTES")
          resp (serve (conn-with {} {:accept-encoding "gzip"}) dir "x.css")
          headers (get resp :resp-headers))
      (assert= (get resp :status) 200)
      (assert= (get headers :content-encoding) "gzip")
      (assert= (get headers :content-type) "text/css; charset=utf-8")
      (assert= (get headers :vary) "Accept-Encoding")
      ; the compressed representation is sent whole — no Range advertised
      (assert= (get headers :accept-ranges) nil)
      (assert= (> (count (get resp :resp-body)) 0) true)
      (file/rm (str dir "/x.css.gz"))
      (file/rm (str dir "/x.css"))))
  (test "no Accept-Encoding → identity body, but still Vary: Accept-Encoding"
    (let (dir "/tmp/hatch-gz-serve-test2"
          _ (try (file/mkdir dir) (catch _ nil))
          _ (file/spit (str dir "/x.css") "body{color:red}")
          _ (file/spit (str dir "/x.css.gz") "PRECOMPRESSED-BYTES")
          resp (serve (conn-with {}) dir "x.css")
          headers (get resp :resp-headers))
      (assert= (get resp :status) 200)
      (assert= (get headers :content-encoding) nil)
      (assert= (get headers :vary) "Accept-Encoding")
      (assert= (get resp :resp-body) "body{color:red}")
      (file/rm (str dir "/x.css.gz"))
      (file/rm (str dir "/x.css"))))
  (test "Accept-Encoding: gzip but no .gz on disk → identity"
    (let (dir "/tmp/hatch-gz-serve-test3"
          _ (try (file/mkdir dir) (catch _ nil))
          _ (file/spit (str dir "/y.css") "body{color:blue}")
          resp (serve (conn-with {} {:accept-encoding "gzip"}) dir "y.css")
          headers (get resp :resp-headers))
      (assert= (get resp :status) 200)
      (assert= (get headers :content-encoding) nil)
      (assert= (get resp :resp-body) "body{color:blue}")
      (file/rm (str dir "/y.css")))))

(describe "serve-encoded (brotli content negotiation, preferred over gzip)"
  (test "Accept-Encoding: br + a .br sibling → the brotli variant"
    (let (dir "/tmp/hatch-br-serve-test"
          _ (try (file/mkdir dir) (catch _ nil))
          _ (file/spit (str dir "/x.css") "body{color:red}")
          _ (file/spit (str dir "/x.css.br") "BROTLI-BYTES")
          resp (serve (conn-with {} {:accept-encoding "br, gzip"}) dir "x.css")
          headers (get resp :resp-headers))
      (assert= (get resp :status) 200)
      (assert= (get headers :content-encoding) "br")
      (assert= (get headers :vary) "Accept-Encoding")
      (assert= (string/bytes-> (get resp :resp-body)) "BROTLI-BYTES")
      (file/rm (str dir "/x.css.br"))
      (file/rm (str dir "/x.css"))))
  (test "br preferred over gzip when the client accepts both and both siblings exist"
    (let (dir "/tmp/hatch-br-serve-test2"
          _ (try (file/mkdir dir) (catch _ nil))
          _ (file/spit (str dir "/x.css") "body{color:red}")
          _ (file/spit (str dir "/x.css.gz") "GZIP-BYTES")
          _ (file/spit (str dir "/x.css.br") "BROTLI-BYTES")
          resp (serve (conn-with {} {:accept-encoding "gzip, deflate, br"}) dir "x.css")
          headers (get resp :resp-headers))
      (assert= (get headers :content-encoding) "br")
      (assert= (string/bytes-> (get resp :resp-body)) "BROTLI-BYTES")
      (file/rm (str dir "/x.css.gz"))
      (file/rm (str dir "/x.css.br"))
      (file/rm (str dir "/x.css"))))
  (test "Accept-Encoding: br but only a .gz on disk → falls back to gzip"
    (let (dir "/tmp/hatch-br-serve-test3"
          _ (try (file/mkdir dir) (catch _ nil))
          _ (file/spit (str dir "/x.css") "body{color:red}")
          _ (file/spit (str dir "/x.css.gz") "GZIP-BYTES")
          resp (serve (conn-with {} {:accept-encoding "br, gzip"}) dir "x.css")
          headers (get resp :resp-headers))
      (assert= (get headers :content-encoding) "gzip")
      (assert= (string/bytes-> (get resp :resp-body)) "GZIP-BYTES")
      (file/rm (str dir "/x.css.gz"))
      (file/rm (str dir "/x.css")))))
