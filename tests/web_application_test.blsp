;; Unit tests for web/application: valid-level/start-children (the boot helpers) and the
;; log-line formatters `default-logger-opts` wires into the logger backend. The formatters
;; were previously only exercised indirectly (hatch-demo's req_log_test.blsp tested a
;; demo-local copy of this logic that predated the refactor moving it into the framework)
;; with no coverage in this repo; this restores that coverage at its new, correct location.
;; The formatters are private (`application--*`, so `default-logger-opts` picks one without
;; exposing all three as public API) — referenced fully-qualified here, bypassing the
;; `:use`-refer-all "unused import"-style privacy convention, which only governs bare-name
;; resolution.
(defmodule web-application-test
  (:use web/application)
  ; the application--* log-line formatters are module-private (ADR-146 `--` names);
  ; this test exercises them directly
  (:use-internals web/application)
  (:use test)
  (:use json :only [json-parse]))

(describe "valid-level"
  (test "known levels pass through"
    (assert= (valid-level "debug") :debug)
    (assert= (valid-level "info") :info)
    (assert= (valid-level "warn") :warn)
    (assert= (valid-level "error") :error))
  (test "missing → debug"
    (assert= (valid-level nil) :debug))
  (test "an unrecognized value falls back to debug (not a dead unknown level)"
    (assert= (valid-level "infoo") :debug)
    (assert= (valid-level "verbose") :debug)))

(describe "start-children"
  (test "calls each child thunk in order"
    (do
      (start-children [(fn () (send (self) :first))
                       (fn () (send (self) :second))]
        0)
      (assert= (receive (m m) (after 200 :timeout)) :first)
      (assert= (receive (m m) (after 200 :timeout)) :second)))
  (test "no children is a no-op"
    (assert= (start-children [] 0) nil))
  (test "a failing child aborts the boot naming which child and why"
    (let (msg (try
                (do (start-children [(fn () nil) (fn () (error "db unreachable"))] 0) nil)
                (catch e (error-message e))))
      (assert= (includes? msg "child #1") true)
      (assert= (includes? msg "db unreachable") true))))

(defn rec (level msg meta)
  {:level level :msg msg :meta meta})

(describe "application--text-line"
  (test "renders [LEVEL] msg with a trailing newline, no ANSI color"
    (assert= (web/application/application--text-line (rec :debug "hello" {}))
      "[DEBUG] hello\n"))
  (test "each level gets its own label"
    (assert= (web/application/application--text-line (rec :info "x" {})) "[INFO] x\n")
    (assert= (web/application/application--text-line (rec :warn "x" {})) "[WARN] x\n")
    (assert= (web/application/application--text-line (rec :error "x" {})) "[ERROR] x\n")))

(describe "application--color-line"
  (test "wraps the text-line body in the level's ANSI color + reset"
    (let (line (web/application/application--color-line (rec :error "boom" {})))
      (assert= (includes? line "\x1b[31m") true)
      (assert= (includes? line "[ERROR] boom") true)
      (assert= (includes? line "\x1b[0m") true))))

(describe "application--json-line"
  (test "one NDJSON object per record, meta fields flattened alongside timestamp/level/message"
    (let (line (web/application/application--json-line
                 {:level :warn :msg "slow" :ts 1000 :meta {:request_id "r1" :duration_ms 4.2}})
          parsed (json-parse line))
      (assert= (get parsed :timestamp) 1000)
      (assert= (get parsed :level) "warn")
      (assert= (get parsed :message) "slow")
      (assert= (get parsed :request_id) "r1")
      (assert= (get parsed :duration_ms) 4.2)
      (assert= (includes? line "\n") true)))
  (test "an unrecognized level falls back to \"info\""
    (assert= (get (json-parse (web/application/application--json-line {:level :bogus :msg "x" :ts 0 :meta {}}))
               :level)
      "info")))

(describe "default-logger-opts"
  (test "picks :level from $LOG_LEVEL, defaulting to :debug"
    (assert= (get (web/application/default-logger-opts) :level) :debug))
  (test "always returns exactly one fn-backend"
    (assert= (count (get (web/application/default-logger-opts) :backends)) 1)))
