;; web/http-cache — validators and freshness for dynamic responses.
;;
;; The failure this module exists for is silent: `no-cache` is CORRECT on a page whose nav
;; changes with the session, but with no validator on it every mandated revalidation is a
;; full 200 with the whole body. Nothing errors; the bytes just go out again, forever.
(defmodule web-http-cache-test (:use test) (:use web/http-cache) (:use web/conn))

(defn- req (&optional (headers {}))
  (build {:method "GET" :path "/" :query "" :params {} :headers headers :body ""}))

(defn- resp (&optional (body "hello world") (headers {}))
  {:status 200 :body body :headers headers})

(describe "strong-etag"
  (test "is content-addressed — same bytes, same tag"
    (assert= (strong-etag "abc") (strong-etag "abc")))
  (test "different bytes, different tag"
    (is (not (= (strong-etag "abc") (strong-etag "abd")))))
  (test "is quoted, as an entity-tag must be"
    (is (string/starts-with? (strong-etag "abc") "\""))
    (is (string/ends-with? (strong-etag "abc") "\""))))

;; RFC 9110 §8.8.3: an ETag identifies a REPRESENTATION. A br body and a gzip body of the
;; same page are different representations; a validator that ignored the coding would match
;; across them, and a client could revalidate a br entity over a gzip connection, be told
;; 304, and decode the wrong bytes.
(describe "etag-for distinguishes content codings"
  (test "each coding gets its own tag"
    (let (identity-tag (etag-for "body" nil)
          gzip-tag (etag-for "body" "gzip")
          br-tag (etag-for "body" "br"))
      (is (not (= identity-tag gzip-tag)))
      (is (not (= gzip-tag br-tag)))
      (is (not (= identity-tag br-tag)))))
  (test "the coding rides inside the quotes"
    (is (string/ends-with? (etag-for "body" "br") "-br\"")))
  (test "an empty coding is identity"
    (assert= (etag-for "body" nil) (etag-for "body" ""))))

(describe "not-modified?"
  (test "an exact match"
    (is (not-modified? (req {:if-none-match (strong-etag "x")}) (strong-etag "x"))))
  (test "a different tag does not match"
    (is (not (not-modified? (req {:if-none-match "\"other\""}) (strong-etag "x")))))
  (test "one tag among a list matches"
    (is (not-modified? (req {:if-none-match "\"a\", \"b\", \"c\""}) "\"b\"")))
  ;; §13.1.2 prescribes WEAK comparison for If-None-Match, so W/ matches its strong twin.
  (test "a weak tag matches its strong twin"
    (is (not-modified? (req {:if-none-match "W/\"abc\""}) "\"abc\"")))
  (test "the wildcard matches anything"
    (is (not-modified? (req {:if-none-match "*"}) "\"whatever\"")))
  (test "no header means no match"
    (is (not (not-modified? (req) "\"abc\"")))))

(describe "conditional"
  (test "a first request is tagged and sent"
    (let ([outcome tagged] (conditional (req) (resp) nil))
      (assert= :send outcome)
      (is (not (nil? (get (get tagged :headers) :etag))))))

  (test "a client holding the representation gets a bodyless 304"
    (let ([_ tagged] (conditional (req) (resp) "br")
          tag (get (get tagged :headers) :etag)
          [outcome not-modified] (conditional (req {:if-none-match tag}) (resp) "br"))
      (assert= :not-modified outcome)
      (assert= 304 (get not-modified :status))
      (assert= "" (get not-modified :body))
      (assert= tag (get (get not-modified :headers) :etag))))

  ;; Holding the gzip representation says nothing about the br one.
  (test "a tag from another coding does not satisfy the request"
    (let ([_ gzipped] (conditional (req) (resp) "gzip")
          gzip-tag (get (get gzipped :headers) :etag)
          [outcome _] (conditional (req {:if-none-match gzip-tag}) (resp) "br"))
      (assert= :send outcome)))

  (test "the 304 keeps caching metadata and drops content headers"
    (let (source (resp "hello world"
                   {:cache-control "private, no-cache"
                    :vary "Cookie"
                    :content-type "text/html"})
          [_ tagged] (conditional (req) source nil)
          tag (get (get tagged :headers) :etag)
          [_ not-modified] (conditional (req {:if-none-match tag}) source nil)
          headers (get not-modified :headers))
      (assert= "private, no-cache" (get headers :cache-control))
      (assert= "Cookie" (get headers :vary))
      (is (nil? (get headers :content-type)))))

  (test "an ETag a handler already chose is left alone"
    (let ([_ untouched] (conditional (req) (resp "b" {:etag "\"handler\""}) nil))
      (assert= "\"handler\"" (get (get untouched :headers) :etag))))

  (test "a non-string body is passed through untagged"
    (let ([outcome untouched] (conditional (req)
                                {:status 200 :body (string/->bytes "x") :headers {}}
                                nil))
      (assert= :send outcome)
      (is (nil? (get (get untouched :headers) :etag)))))

  (test "a redirect is not tagged"
    (let ([_ untouched] (conditional (req) {:status 302 :body "" :headers {}} nil))
      (is (nil? (get (get untouched :headers) :etag))))))

(describe "cache-control constructors"
  (test "immutable never revalidates"
    (is (includes? (immutable) "immutable"))
    (is (includes? (immutable) "max-age=31536000")))
  (test "public-for bounds staleness"
    (assert= "public, max-age=60" (public-for 60)))
  ;; no-store is not no-cache: one forbids keeping it, the other requires revalidating it.
  (test "no-store forbids storage"
    (assert= "no-store" (no-store)))
  (test "put-cache-control never overrides a handler's own choice"
    (assert= "public, max-age=5"
      (get (get (put-cache-control {:headers {:cache-control "public, max-age=5"}} "no-store")
             :headers)
        :cache-control))))

;; The half of caching that is charged to everyone: a page marked `private, no-cache` costs a
;; network round trip per navigation, and most visitors to most sites are signed out looking
;; at a page that is identical for all of them.
(describe "html-freshness"
  ;; Built the way the server builds one, so the cookie parsing under test is the real one.
  (defn- conn-with (method cookie)
    (web/conn/build {:method method
                     :path "/"
                     :headers (if (nil? cookie) {} {:cookie (str "_hatch_session=" cookie)})}))

  (defn- cc (resp) (get (get resp :headers {}) :cache-control))

  (test "an anonymous GET may be reused without asking"
    (let (out (html-freshness (conn-with "GET" nil) {:status 200 :headers {} :body "<h1>hi</h1>"}))
      (is (includes? (cc out) "public"))
      (is (includes? (cc out) "max-age=60"))
      (is (includes? (cc out) "stale-while-revalidate=600"))
      (is (includes? (get (get out :headers) :vary) "Cookie"))))

  (test "a request carrying a session cookie does not"
    (assert= "private, no-cache"
      (cc (html-freshness (conn-with "GET" "abc") {:status 200 :headers {} :body "<h1>hi</h1>"}))))

  ;; A login is a 200 with a Set-Cookie. Caching it publicly would hand one visitor another's
  ;; session, so it is checked on the RESPONSE as well as the request.
  (test "a response that sets a cookie is never public"
    (assert= "private, no-cache"
      (cc (html-freshness (conn-with "GET" nil)
            {:status 200 :headers {:set-cookie "_hatch_session=x"} :body "<h1>hi</h1>"}))))

  (test "only GET and HEAD, only 200"
    (assert= "private, no-cache"
      (cc (html-freshness (conn-with "POST" nil) {:status 200 :headers {} :body "ok"})))
    (assert= "private, no-cache"
      (cc (html-freshness (conn-with "GET" nil) {:status 404 :headers {} :body "no"})))
    (assert= "private, no-cache"
      (cc (html-freshness (conn-with "GET" nil) {:status 302 :headers {} :body ""}))))

  (test "a handler's own choice and a non-HTML body are both left alone"
    (assert= "no-store"
      (cc (html-freshness (conn-with "GET" nil)
            {:status 200 :headers {:cache-control "no-store"} :body "x"})))
    (assert= nil
      (cc (html-freshness (conn-with "GET" nil)
            {:status 200 :headers {:content-type "application/json"} :body "{}"}))))

  (test "vary merges rather than replacing"
    (assert= "Accept-Encoding, Cookie"
      (get (get (html-freshness (conn-with "GET" nil)
                  {:status 200 :headers {:vary "Accept-Encoding"} :body "<p>x</p>"})
             :headers)
        :vary))
    ;; already present, in any case — left as the other layer wrote it
    (assert= "cookie"
      (get (get (html-freshness (conn-with "GET" nil)
                  {:status 200 :headers {:vary "cookie"} :body "<p>x</p>"})
             :headers)
        :vary)))

  ;; `get-cookie` reads the PARSED `:cookies` that `web/conn/build` fills in. A conn that
  ;; never went through it has no `:cookies` at all, and reading that as "no session" would
  ;; publish a signed-in page to a shared cache — so the raw header is the backstop.
  (test "an unparsed conn is read from its raw Cookie header, not treated as anonymous"
    (assert= "private, no-cache"
      (cc (html-freshness {:method "GET" :headers {:cookie "_hatch_session=abc"}}
            {:status 200 :headers {} :body "<h1>hi</h1>"})))
    (assert= true (session-cookie? {:headers {:cookie "a=1; _hatch_session=abc"}} "_hatch_session"))
    (assert= false (session-cookie? {:headers {:cookie "a=1; b=2"}} "_hatch_session"))
    (assert= false (session-cookie? {:headers {}} "_hatch_session"))))

;; `*` is an ALTERNATIVE to the entity-tag list in RFC 9110's grammar
;; (`If-None-Match = "*" / #entity-tag`), not a member of it — and `W/` is immediately
;; followed by the opaque-tag. Both readings used to differ between this module and
;; web/static, which is the drift that unifying them removed. Strictness is the safe
;; direction: a wrongly-issued 304 leaves a client holding a stale copy, while a
;; wrongly-issued 200 only costs bytes.
(describe "not-modified?: the malformed cases"
  (defn- inm (h) {:headers {:if-none-match h}})

  (test "* matches only as the whole header value"
    (assert= true (not-modified? (inm "*") "\"abc\""))
    (assert= true (not-modified? (inm "  *  ") "\"abc\""))
    (assert= false (not-modified? (inm "\"a\", *") "\"abc\""))
    (assert= false (not-modified? (inm "*, \"a\"") "\"abc\""))
    (assert= false (not-modified? (inm "**") "\"abc\"")))

  (test "W/ must be immediately followed by the tag"
    (assert= true (not-modified? (inm "W/\"abc\"") "\"abc\""))
    (assert= false (not-modified? (inm "W/ \"abc\"") "\"abc\"")))

  (test "the ordinary cases are unchanged"
    (assert= true (not-modified? (inm "\"abc\"") "\"abc\""))
    (assert= true (not-modified? (inm "\"x\", \"abc\", \"y\"") "\"abc\""))
    (assert= true (not-modified? (inm "  \"abc\"  ") "\"abc\""))
    (assert= false (not-modified? (inm "\"other\"") "\"abc\""))
    (assert= false (not-modified? (inm "\"abcd\"") "\"abc\""))
    (assert= false (not-modified? {:headers {}} "\"abc\""))))
