(defmodule web-ratelimit-test
  (:use web/ratelimit)
  (:use-internals web/ratelimit)
  (:alias web/conn)
  (:use test))

(def cfg {:rate 1 :per 1000 :burst 2})

(describe "refill"
  (test "a fresh key starts full (capacity)"
    (assert= (get (web/ratelimit/refill {} cfg 0) :tokens) 2.0))
  (test "accrues tokens over elapsed time, capped at burst"
    ; rate 1 / 1000ms → 0.001 tok/ms; 500ms from empty → 0.5
    (assert= (get (web/ratelimit/refill {:tokens 0.0 :ts 0} cfg 500) :tokens) 0.5))
  (test "never exceeds capacity"
    (assert= (get (web/ratelimit/refill {:tokens 1.0 :ts 0} cfg 100000) :tokens) 2.0)))

(describe "spend"
  (test "spends a token when the bucket has one"
    (let (result (web/ratelimit/spend {} cfg 1 0))
      (assert= (nth result 1) :ok)
      (assert= (get (nth result 0) :tokens) 1.0)))
  (test "an empty bucket denies with the ms until a token frees"
    (let (result (web/ratelimit/spend {:tokens 0.0 :ts 0} cfg 1 0))
      (assert= (nth result 1) [:deny 1000])))
  (test "the burst allows N immediate requests, then denies"
    ; two tokens → two :ok, third denied (no time elapses between them)
    (let (a (web/ratelimit/spend {} cfg 1 0)
          b (web/ratelimit/spend (nth a 0) cfg 1 0)
          c (web/ratelimit/spend (nth b 0) cfg 1 0))
      (assert= (nth a 1) :ok)
      (assert= (nth b 1) :ok)
      (assert= (first (nth c 1)) :deny))))

(describe "client-key"
  (test "prefers the first X-Forwarded-For hop"
    (assert= (client-key {:headers {:x-forwarded-for "1.2.3.4, 10.0.0.1"}}) "1.2.3.4"))
  (test "falls back to X-Real-IP"
    (assert= (client-key {:headers {:x-real-ip "9.9.9.9"}}) "9.9.9.9"))
  (test "else a single global bucket"
    (assert= (client-key {:headers {}}) "global")))

(defn conn-for (key)
  "A conn whose client-key resolves to `key` (via X-Real-IP)."
  (conn/build {:method "GET" :path "/" :query "" :params {} :headers {:x-real-ip key} :body ""}))

; :isolated — the plug hits the shared :hatch-ratelimit singleton.
(describe "rate-limit plug (end to end)"
  :isolated (test "passes the burst, then 429s with Retry-After"
    (let (plug (rate-limit {:rate 1 :per 100000 :burst 2 :key-fn client-key})
          ; a key unique to this test so other buckets can't interfere
          k "e2e-burst-1"
          r1 (plug (conn-for k))
          r2 (plug (conn-for k))
          r3 (plug (conn-for k)))
      ; first two pass (not halted, no status set by the plug)
      (assert= (conn/halted? r1) false)
      (assert= (conn/halted? r2) false)
      ; third is throttled
      (assert= (conn/halted? r3) true)
      (assert= (get r3 :status) 429)
      (assert= (not (nil? (get-in r3 [:resp-headers :retry-after]))) true)))
  (test "separate keys have separate buckets"
    (let (plug (rate-limit {:rate 1 :per 100000 :burst 1 :key-fn client-key})
          a1 (plug (conn-for "sep-A"))
          b1 (plug (conn-for "sep-B")))
      ; each key's first request passes despite burst 1
      (assert= (conn/halted? a1) false)
      (assert= (conn/halted? b1) false))))

;; The key now comes from `web/auth/client-ip`, so the rate limiter and the address gate
;; agree on which header names the caller. This module used to answer it itself and answered
;; it differently — no `Fly-Client-IP` at all, and `X-Forwarded-For` (which the CLIENT writes)
;; preferred over the headers a proxy overwrites.
(describe "client-key follows the proxy headers, not the client's"
  (test "Fly-Client-IP is honoured, and beats X-Forwarded-For"
    (assert= "5.5.5.5" (client-key {:headers {:fly-client-ip "5.5.5.5"}}))
    (assert= "5.5.5.5"
      (client-key {:headers {:fly-client-ip "5.5.5.5" :x-forwarded-for "1.2.3.4"}})))

  (test "a proxy-set X-Real-IP beats a client-supplied X-Forwarded-For"
    (assert= "9.9.9.9"
      (client-key {:headers {:x-real-ip "9.9.9.9" :x-forwarded-for "1.2.3.4"}})))

  (test "X-Forwarded-For's first hop is still the fallback"
    (assert= "1.2.3.4" (client-key {:headers {:x-forwarded-for "1.2.3.4, 10.0.0.1"}})))

  (test "no identifying header means one shared bucket"
    (assert= "global" (client-key {:headers {}}))))

;; ---- keying by network, not by address --------------------------------------
;;
;; An address is not a client. IPv6 privacy extensions rotate the host half, and a caller
;; can cycle through a /64 far faster than the rotation does — so a per-address bucket is
;; escaped by picking a new address, which is the one thing an abuse control must not allow.

(defn- conn-from (headers)
  (conn/build {:method "GET" :path "/api" :query "" :params {} :headers headers :body ""}))

(describe "ipv6-network"
  (test "a full address collapses to its first four groups"
    (assert= (ipv6-network "2c0f:ef18:1b2e:0:231b:1:2:3") "2c0f:ef18:1b2e:0000::/64"))
  (test "a compressed run is expanded before the prefix is taken"
    (assert= (ipv6-network "2c0f:ef18::1") "2c0f:ef18:0000:0000::/64")
    (assert= (ipv6-network "::1") "0000:0000:0000:0000::/64"))
  (test "groups are zero-padded, so two spellings of one network agree"
    (assert= (ipv6-network "2c0f:ef18:1b2e:0::1") (ipv6-network "2c0f:ef18:1b2e:0000::2")))
  (test "casing does not matter"
    (assert= (ipv6-network "2C0F:EF18:1B2E:0::1") (ipv6-network "2c0f:ef18:1b2e:0::1")))
  (test "a bracketed address is read the same way"
    (assert= (ipv6-network "[2c0f:ef18:1b2e:0::1]") (ipv6-network "2c0f:ef18:1b2e:0::1")))
  (test "IPv4 has no host/network split to take"
    (assert= (ipv6-network "10.0.0.1") nil))
  (test "nonsense is nil rather than a raised error"
    (assert= (ipv6-network "not-an-address") nil)))

(describe "network-key"
  (test "two addresses in one /64 share a bucket"
    ;; The rotation case: same machine, same network, different address tomorrow.
    (assert= (network-key (conn-from {:fly-client-ip "2c0f:ef18:1b2e:0:231b:1:2:3"}))
      (network-key (conn-from {:fly-client-ip "2c0f:ef18:1b2e:0:5d71:9:9:9"}))))

  (test "a different /64 is a different bucket"
    (is (not (= (network-key (conn-from {:fly-client-ip "2c0f:ef18:1b2e:0::1"}))
               (network-key (conn-from {:fly-client-ip "2c0f:ef18:1b2f:0::1"}))))))

  (test "an IPv4 client is keyed by its address, unchanged"
    (assert= (network-key (conn-from {:fly-client-ip "203.0.113.7"})) "203.0.113.7"))

  (test "no client header falls back to the shared global bucket, as client-key does"
    (assert= (network-key (conn-from {})) "global"))

  (test "it reads the same headers the auth gate does"
    ;; Whichever header identifies a caller for the gate must identify them for the limiter.
    (assert= (network-key (conn-from {:x-real-ip "203.0.113.7"})) "203.0.113.7")))

; :isolated — the plug hits the shared :hatch-ratelimit singleton. The networks below are
; unique to this test, so no reset is needed and nothing else can spend their tokens.
(describe "rate-limit with :key-fn network-key"
  :isolated (test "a rotating address inside one /64 cannot escape the bucket"
    (let (plug (rate-limit {:rate 2 :per 100000 :burst 2 :key-fn network-key})
          hit (fn (address) (conn/halted? (plug (conn-from {:fly-client-ip address})))))
      ;; two tokens, spent from two DIFFERENT addresses in the same network
      (is (not (hit "2c0f:aaaa:1b2e:0:1:1:1:1")))
      (is (not (hit "2c0f:aaaa:1b2e:0:2:2:2:2")))
      ;; a third address in the same /64 finds the bucket empty — the rotation bought nothing
      (is (hit "2c0f:aaaa:1b2e:0:3:3:3:3"))
      ;; while a different network still has its own tokens
      (is (not (hit "2c0f:bbbb:1b2e:0:1:1:1:1"))))))
