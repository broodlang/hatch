(defmodule web-parts-test
  (:use web/parts)
  (:use test))

;; compile-parts is a macro-time function but is a plain defn, so we can call it on quoted
;; Hiccup forms here. We check the static skeleton (strings, easy to assert) and the hole
;; count; the full round-trip (statics + rendered dynamics == direct render) is checked
;; against real deflive views in web_test_test.

(describe "compile-parts — statics"
  (test "a fully literal element is one static, no dynamics"
    (let (p (compile-parts '[:p {} "hi"]))
      (assert= (get p :statics) ["<p>hi</p>"])
      (assert= (count (get p :dynamics)) 0)))
  (test "a literal attr folds into the static"
    (let (p (compile-parts '[:div {:class "x"} "y"]))
      (assert= (get p :statics) ["<div class=\"x\">y</div>"])
      (assert= (count (get p :dynamics)) 0)))
  (test "a dynamic child splits the statics around the hole"
    (let (p (compile-parts '[:div {:class "x"} (get model :count)]))
      (assert= (get p :statics) ["<div class=\"x\">" "</div>"])
      (assert= (count (get p :dynamics)) 1)))
  (test "a dynamic attr value becomes its own hole"
    (let (p (compile-parts '[:div {:class (str "btn " (get model :kind))} "y"]))
      (assert= (get p :statics) ["<div" ">y</div>"])
      (assert= (count (get p :dynamics)) 1)))
  (test "a void element has no closing tag"
    (let (p (compile-parts '[:input {:value (get model :v)}]))
      (assert= (get p :statics) ["<input" ">"])
      (assert= (count (get p :dynamics)) 1)))
  (test "nested literal elements stay fully static"
    (assert= (get (compile-parts '[:ul {} [:li {} "a"] [:li {} "b"]]) :statics)
      ["<ul><li>a</li><li>b</li></ul>"]))
  (test "an ambiguous attrs-position form makes the whole element opaque"
    (let (p (compile-parts '[:div attrs-var "y"]))
      (assert= (get p :statics) ["" ""])
      (assert= (count (get p :dynamics)) 1))))

(describe "compile-parts — component holes"
  (test "a (component module assigns) form gets its own dynamic hole"
    (let (p (compile-parts '[:div {} (component web/components/like-button {"id" "x"})]))
      (assert= (get p :statics) ["<div>" "</div>"])
      (assert= (count (get p :dynamics)) 1)))
  (test "the hole resolves module/live-component-spec and threads live--components"
    (let (p (compile-parts '(component web/components/like-button assigns-var)))
      (assert= (get p :dynamics)
        (list (list 'web/component/render-slot
                (list 'quote 'web/components/like-button)
                'web/components/like-button/live-component-spec
                'assigns-var
                'live-components))))))

(describe "weave"
  (test "one hole" (assert= (weave ["a" "b"] ["X"]) "aXb"))
  (test "no holes" (assert= (weave ["only"] []) "only"))
  (test "two holes" (assert= (weave ["a" "b" "c"] ["X" "Y"]) "aXbYc")))

(describe "diff-dynamics"
  (test "one slot changed" (assert= (diff-dynamics ["a" "b"] ["a" "c"]) {1 "c"}))
  (test "nothing changed" (assert= (diff-dynamics ["a" "b"] ["a" "b"]) {}))
  (test "all changed" (assert= (diff-dynamics ["a" "b"] ["x" "y"]) {0 "x" 1 "y"}))
  (test "first only" (assert= (diff-dynamics ["a" "b"] ["x" "b"]) {0 "x"})))

;; form-deps statically finds the model keys a dynamic slot reads, so the session can
;; re-render only the slots a state change actually touches. It over-approximates: any
;; opaque model use yields :all (always re-render).
(describe "form-deps — change tracking"
  (test "a pinned (get model :k) collects that key"
    (assert= (form-deps '(web/template/render (get model :count)) 'model) [:count]))
  (test "multiple pinned reads collect every key"
    (assert= (form-deps '(str (get model :a) (get model :b)) 'model) [:a :b]))
  (test "reads inside a map literal (attrs) are collected"
    (assert= (form-deps '(web/template/render [:li {:class (get model :c)} "x"]) 'model) [:c]))
  (test "a comprehension collects its collection's key"
    (assert= (form-deps '(web/parts/comp-slot (for (x (get model :items))
                                                (web/template/render [:li {} x])))
               'model)
      [:items]))
  (test "a default expression's reads are also collected"
    (assert= (form-deps '(get model :a (get model :b)) 'model) [:a :b]))
  (test "a bare model use is opaque → :all"
    (assert= (form-deps '(some-helper model) 'model) :all))
  (test "a dynamic (get model k) key is opaque → :all"
    (assert= (form-deps '(get model k) 'model) :all))
  (test "no model reference → empty deps (a constant slot never re-renders)"
    (assert= (form-deps '(str "static") 'model) []))
  (test "honours a non-default model symbol"
    (assert= (form-deps '(get m :count) 'm) [:count])))

;; A `(for …)` comprehension compiles to a single per-item comprehension slot.
(describe "compile-parts — comprehensions"
  (test "a (for …) becomes one comprehension dynamic between the statics"
    (let (p (compile-parts '[:ul {} (for (x coll) [:li {} x])]))
      (assert= (get p :statics) ["<ul>" "</ul>"])
      (assert= (count (get p :dynamics)) 1)
      ; the dynamic is (web/parts/comp-slot (for (x coll) (web/template/render [:li {} x])))
      (assert= (first (first (get p :dynamics))) 'web/parts/comp-slot)
      (assert= (first (first (rest (first (get p :dynamics))))) 'for))))

(describe "comprehension slots"
  (test "comp tags a list of item HTML"
    (assert= (comp? (comp-slot ["a" "b"])) true)
    (assert= (comp? "plain") false)
    (assert= (comp-items (comp-slot ["a" "b"])) ["a" "b"]))
  (test "slot->html joins comp items, leaves scalars alone"
    (assert= (slot->html (comp-slot ["a" "b" "c"])) "abc")
    (assert= (slot->html "plain") "plain"))
  (test "weave joins a comprehension slot inline (full HTML unchanged)"
    (assert= (weave ["<ul>" "</ul>"] [(comp-slot ["<li>a</li>" "<li>b</li>"])])
      "<ul><li>a</li><li>b</li></ul>")))

;; A changed comprehension slot ships a per-item diff, not the whole list.
(describe "diff-dynamics — comprehensions"
  (test "one changed item → a per-item cdiff carrying just that item"
    (assert= (diff-dynamics [(comp-slot ["a" "b" "c"])] [(comp-slot ["a" "X" "c"])])
      {0 {:__cdiff__ {1 "X"} :n 3}}))
  (test "an appended item is reported with the new count"
    (assert= (diff-dynamics [(comp-slot ["a" "b"])] [(comp-slot ["a" "b" "c"])])
      {0 {:__cdiff__ {2 "c"} :n 3}}))
  (test "a removed item shrinks the count, no item payload"
    (assert= (diff-dynamics [(comp-slot ["a" "b" "c"])] [(comp-slot ["a" "b"])])
      {0 {:__cdiff__ {} :n 2}}))
  (test "an unchanged comprehension yields no diff"
    (assert= (diff-dynamics [(comp-slot ["a" "b"])] [(comp-slot ["a" "b"])]) {}))
  (test "a scalar slot beside a comprehension still diffs scalar-wise"
    (assert= (diff-dynamics ["x" (comp-slot ["a"])] ["y" (comp-slot ["a"])]) {0 "y"})))
