(defmodule web-page-test
  (:use web/page)
  (:use web/conn)
  (:use web/template :only [render])
  (:use test))

(defn conn-for ()
  (build {:method "GET" :path "/" :query "" :params {} :headers {} :body ""}))

(describe "page"
  (test "renders a Hiccup node to a 200 HTML-document response"
    (let (resp (page (conn-for) [:h1 {} "Hello"]))
      (assert= (get resp :status) 200)
      (assert= (get resp :resp-body) "<!DOCTYPE html><h1>Hello</h1>")))

  (test "escapes text content"
    (let (resp (page (conn-for) [:p {} "<script>"]))
      (assert= (includes? (get resp :resp-body) "&lt;script&gt;") true)
      (assert= (includes? (get resp :resp-body) "<script>") false)))

  ;; A rendered page must be able to carry a status. It went through `html-resp`, which
  ;; passes a literal 200 to `send-resp`, so `put-status` was overwritten and a themed 404
  ;; could not exist — the app had to pick the page or the status code.
  (test "honours a status set with put-status, so a rendered page can be a 404"
    (let (resp (page (put-status (conn-for) 404) [:h1 {} "Not found"]))
      (assert= (get resp :status) 404)
      (assert= (get resp :resp-body) "<!DOCTYPE html><h1>Not found</h1>")))

  (test "still defaults to 200 when no status was set"
    (assert= (get (page (conn-for) [:p {} "hi"]) :status) 200)))

;; `defhtml` compiles a Hiccup body to statics + dynamic holes at EXPANSION time, so a
;; request joins prebaked fragments instead of walking a tree. The contract that matters is
;; that it produces exactly what `render` would have.
(defhtml dh-greeting
  (name)
  [:div
    {:class "greet"}
    [:h1 {} "Hello"]
    [:span {:class "who"} (str name)]
    [:p {} "static prose"]])

(defhtml dh-nested
  (items)
  [:ul {:class "list"} (map items (fn (i) [:li {} (str i)]))])

(describe "defhtml"
  (test "produces exactly what render would have"
    (assert= (web/template/render [:div
                                    {:class "greet"}
                                    [:h1 {} "Hello"]
                                    [:span {:class "who"} "ada"]
                                    [:p {} "static prose"]])
      (web/template/render (dh-greeting "ada"))))

  (test "the dynamic hole is evaluated per call, the statics are not"
    (is (includes? (web/template/render (dh-greeting "ada")) "ada"))
    (is (includes? (web/template/render (dh-greeting "grace")) "grace")))

  (test "a value in a hole is HTML-escaped, as render escapes it"
    (is (includes? (web/template/render (dh-greeting "<script>")) "&lt;script&gt;"))
    (is (not (includes? (web/template/render (dh-greeting "<script>")) "<script>"))))

  (test "it answers raw HTML, so it composes inside another Hiccup form"
    (assert= (web/template/render [:section {} (dh-greeting "ada")])
      (str "<section>" (web/template/render (dh-greeting "ada")) "</section>")))

  (test "a comprehension still renders every item"
    (assert= (web/template/render [:ul {:class "list"} [:li {} "1"] [:li {} "2"]])
      (web/template/render (dh-nested [1 2])))))

;; ---- the shell, rendered once -----------------------------------------------

;; Every test uses a key of its own, because the store is process-shared and lives for the
;; life of the runtime — two tests sharing a key would be testing each other's entry.

(defn- shell-for (label)
  "A shell builder: `label` in the nav, the placeholder where the body goes, a fixed footer."
  (fn (placeholder) [:html {} [:body {} [:nav {} label] placeholder [:footer {} "end"]]]))

(describe "shell-halves"
  (test "splits the chrome at the placeholder"
    (let ([prefix suffix] (shell-halves [:shell-test :split] (shell-for "nav")))
      (assert= (includes? prefix "<nav>nav</nav>") true)
      (assert= (includes? suffix "<footer>end</footer>") true)
      ;; the marker itself never reaches either half
      (assert= (includes? prefix "hatch-body") false)
      (assert= (includes? suffix "hatch-body") false)))

  (test "a builder that drops the placeholder yields the whole render as the prefix"
    ;; Degrades to a chrome-only page rather than to a page with a stray marker in it.
    (let ([prefix suffix] (shell-halves [:shell-test :no-marker]
                            (fn (_placeholder) [:html {} [:body {} "no body slot"]])))
      (assert= (includes? prefix "no body slot") true)
      (assert= suffix "")))

  (test "the same key answers the same halves — that is the point of the cache"
    (assert= (shell-halves [:shell-test :stable] (shell-for "a"))
      (shell-halves [:shell-test :stable] (shell-for "b"))))

  (test "a different key is a different shell, so two users never share a prefix"
    (let ([prefix-a _sa] (shell-halves [:shell-test :user "a@example.com"]
                           (shell-for "a@example.com"))
          [prefix-b _sb] (shell-halves [:shell-test :user "b@example.com"]
                           (shell-for "b@example.com")))
      (assert= (includes? prefix-a "a@example.com") true)
      (assert= (includes? prefix-b "b@example.com") true)
      (assert= (= prefix-a prefix-b) false))))

(describe "with-shell"
  (test "the body is rendered into the cached chrome"
    (let (html (render (with-shell [:shell-test :with] (shell-for "nav") [:main {} "content"])))
      (assert= (includes? html "<nav>nav</nav><main>content</main><footer>end</footer>") true)))

  (test "the chrome is reused across bodies while the body is not"
    (let (one (render (with-shell [:shell-test :reuse] (shell-for "nav") [:main {} "first"]))
          two (render (with-shell [:shell-test :reuse] (shell-for "nav") [:main {} "second"])))
      (assert= (includes? one "first") true)
      (assert= (includes? two "second") true)
      (assert= (includes? two "first") false)))

  (test "the result is usable as a node inside `page`"
    (let (resp (page (conn-for)
                 (with-shell [:shell-test :in-page] (shell-for "nav") [:main {} "x"])))
      (assert= (get resp :status) 200)
      (assert= (includes? (get resp :resp-body) "<main>x</main>") true))))

(describe "cached"
  (test "a cacheable page is stored, so a second call does not rebuild it"
    (let (built (table/new)
          build (fn ()
                  (table/put built :n (+ 1 (or (table/get built :n) 0)))
                  [:p {} "page"])
          first (cached [:shell-test :cached] build true)
          second (cached [:shell-test :cached] build true))
      (assert= first second)
      (assert= (table/get built :n) 1)))

  (test "an uncacheable page is rebuilt every time — the caller says which it is"
    ;; The predicate is an argument and never a guess: one entry serves everyone who asks
    ;; for the key, so a page carrying anything about the viewer must not be stored.
    (let (built (table/new)
          build (fn ()
                  (table/put built :n (+ 1 (or (table/get built :n) 0)))
                  [:p {} "page"])
          _first (cached [:shell-test :uncached] build false)
          _second (cached [:shell-test :uncached] build false))
      (assert= (table/get built :n) 2)))

  (test "the default is cacheable"
    (assert= (cached [:shell-test :default] (fn () [:p {} "x"]))
      (cached [:shell-test :default] (fn () [:p {} "y"]))))

  (test "the value is rendered HTML, ready to send"
    (assert= (cached [:shell-test :rendered] (fn () [:p {} "hi"]) false) "<p>hi</p>")))
