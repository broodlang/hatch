;; Component-level wire diffing: a LiveComponent gets its own static/dynamic split, so a
;; state change ships only the component's changed inner slots — not its whole subtree, and
;; not the parent's.
;;
;; The parent's side of this is exercised via `render-slot` + `web/parts`' diff directly
;; rather than through a `deflive` view, because `deflive-component` and `deflive` both
;; define `render`/`mount` in the enclosing module and would collide in one file (the same
;; reason web_live_component_integration_test hand-writes its spec). What matters here is
;; the slot value and how two of them diff, which is exactly what these call.
(defmodule web-component-diff-test
  (:use web/component)
  (:alias web/parts)
  ; encode — the JSON codec the diff actually reaches the client through
  (:alias web/live)
  (:use web/template)
  (:use test))

; Two dynamic holes — a label and a count — so a change to one can be shown NOT to ship the
; other. The literal markup around them is static and never crosses the wire twice.
(deflive-component (mount (id assigns) {:label (get assigns "label" "hi") :n 0})
  (render (state)
    [:div {} [:span {:class "label"} (get state :label)] [:b {} (str (get state :n))]])
  (on "bump" (params state) (assoc state :n (inc (get state :n))))
  (on "relabel" (params state) (assoc state :label (get params "text"))))

(defn slot-for (t id)
  (render-slot 'web-component-diff-test live-component-spec {"id" id} t))

(describe "deflive-component compiles its own static/dynamic split"
  (test "the spec carries render-static and render-dynamic, like a view's"
    (let (spec (live-component-spec))
      (assert= (vector? (web/component/component-spec-render-static spec)) true)
      (assert= (nil? (web/component/component-spec-render-dynamic spec)) false)))
  (test "statics and dynamics satisfy the weave invariant against the plain render"
    (let (spec (live-component-spec)
          state {:label "hi" :n 3})
      (assert= (web/parts/weave (web/component/component-spec-render-static spec)
                 ((web/component/component-spec-render-dynamic spec) state))
        ; web/template/render qualified: deflive-component defines `render` in THIS module
        ; (the component's own), which would shadow the template one
        (web/template/render ((web/component/component-spec-render spec) state))))))

(describe "render-slot returns a diffable component slot"
  (test "it is a component slot tagged with the cid, not an opaque string"
    (let (t (table/new)
          v (slot-for t "c1"))
      (assert= (web/parts/kslot? v) true)
      (assert= (get v :cid) "c1")))
  (test "the data-cid wrapper is baked into the statics, so weaving alone reproduces it"
    (let (t (table/new)
          v (slot-for t "c1"))
      (assert= (includes? (nth (get v :s) 0) "<div data-cid=\"c1\">") true)
      (assert= (includes? (last (get v :s)) "</div>") true)))
  (test "slot->html is byte-identical to the whole-component HTML render-slot-html returns"
    (let (t (table/new)
          t2 (table/new))
      (assert= (web/parts/slot->html (slot-for t "c1"))
        (render-slot-html 'web-component-diff-test live-component-spec {"id" "c1"} t2))))
  (test "and to what the pre-split implementation produced"
    (let (t (table/new))
      (assert= (web/parts/slot->html (slot-for t "c1"))
        ; the inner <div> is the fixture component's own root; the outer one is the
        ; data-cid wrapper render-slot guarantees around whatever a component returns
        "<div data-cid=\"c1\"><div><span class=\"label\">hi</span><b>0</b></div></div>"))))

(describe "a component's state change ships only its changed inner slot"
  (test "bumping the count diffs the count slot alone — the label doesn't cross the wire"
    (let (t (table/new)
          before (slot-for t "c1")
          _ (dispatch-event t "c1" "bump" {})
          after (slot-for t "c1")
          d (web/parts/slot-diff before after))
      ; a per-inner-slot patch, not the whole re-rendered component
      (assert= (nil? (get d :__kdiff__)) false)
      (assert= (get d :cid) "c1")
      ; exactly one inner slot changed — the count. The label slot is absent entirely.
      (assert= (count (get d :__kdiff__)) 1)
      (assert= (get (get d :__kdiff__) 1) "1")))
  (test "changing the label diffs the label slot alone"
    (let (t (table/new)
          before (slot-for t "c2")
          _ (dispatch-event t "c2" "relabel" {"text" "bye"})
          after (slot-for t "c2")
          d (web/parts/slot-diff before after))
      (assert= (count (get d :__kdiff__)) 1)
      (assert= (get (get d :__kdiff__) 0) "bye")))
  (test "an untouched component produces an equal slot, so the parent ships nothing for it"
    (let (t (table/new)
          a (slot-for t "c3")
          b (slot-for t "c3"))
      (assert= a b)
      (assert= (web/parts/diff-dynamics [a] [b]) {})))
  (test "a parent re-render around an untouched component still ships nothing for it"
    (let (t (table/new)
          c (slot-for t "c4"))
      ; the parent's own slot 0 changed; the component in slot 1 did not
      (assert= (web/parts/diff-dynamics ["old" c] ["new" c]) {0 "new"}))))

(describe "a slot that stops being the same component is replaced, not patched"
  (test "a different cid ships the whole new slot rather than a kdiff"
    (let (t (table/new)
          a (slot-for t "c5")
          b (slot-for t "c6")
          d (web/parts/slot-diff a b))
      ; patching one component's inner slots onto another's would splice two unrelated
      ; renders together, so the whole slot is sent instead
      (assert= (nil? (get d :__kdiff__)) true)
      (assert= (web/parts/kslot? d) true)
      (assert= (get d :cid) "c6")))
  (test "a component replacing a plain string slot ships the whole slot"
    (let (t (table/new)
          a (slot-for t "c7")
          d (web/parts/slot-diff "was just text" a))
      (assert= (web/parts/kslot? d) true))))

(describe "the slot values survive the wire codec"
  ; The diff reaches brood_live.js as JSON, so the tags/keys the client branches on have to
  ; encode as it expects. Cheap to get wrong (a keyword key, a bool tag) and invisible to
  ; every test above, which all work on the Brood values directly.
  (test "a component slot encodes with the keys the client reads"
    (let (t (table/new)
          json (web/live/encode (slot-for t "c8")))
      (assert= (includes? json "\"__kslot__\":true") true)
      (assert= (includes? json "\"cid\":\"c8\"") true)
      (assert= (includes? json "\"s\":[") true)
      (assert= (includes? json "\"d\":[") true)))
  (test "a component diff encodes with the keys the client reads"
    (let (t (table/new)
          before (slot-for t "c9")
          _ (dispatch-event t "c9" "bump" {})
          json (web/live/encode (web/parts/slot-diff before (slot-for t "c9"))))
      (assert= (includes? json "\"__kdiff__\":{") true)
      (assert= (includes? json "\"cid\":\"c9\"") true))))

;; A component inside an `(if …)` used to be part of its enclosing opaque dynamic and
;; re-shipped whole on any change. The runtime could always carry it — `slot-diff` falls
;; through to the whole value when a slot "just became" a component, and `slot->html` renders
;; any slot kind — so the limit was only ever what `compile-parts` chose to emit: the generic
;; else branch wraps the form in `render`, which forces a string and discards the structure.
(describe "a component inside a conditional keeps its own split"
  (defn- compiled (form) (web/parts/compile-parts form))

  (test "the conditional becomes one dynamic, as before"
    (assert= (count (get (compiled '[:div {} (if flag (component some-mod {"id" "c1"}) "")])
                      :dynamics))
      1))

  ;; The shape of the emitted form is the whole change: an `if` whose branches evaluate to
  ;; slot values, rather than a `render` call wrapping the lot.
  (test "and it compiles to an `if` over slot values, not to a render of the whole form"
    (let (dyn (first (get (compiled '[:div {} (if flag (component some-mod {"id" "c1"}) "")])
                       :dynamics)))
      (assert= (first dyn) 'if)
      ;; the taken branch is the component's slot call, not a string render
      (assert= (first (nth (apply vector dyn) 2)) 'web/component/render-slot)))

  ;; A missing else must still occupy the slot with a string. It goes through `render` like
  ;; any other non-component branch — which is the point: a literal branch stays escaped
  ;; rather than being passed through raw because it happens to sit opposite a component.
  (test "a missing else branch renders to an empty string, not to nil"
    (let (dyn (first (get (compiled '[:div {} (if flag (component some-mod {"id" "c1"}))])
                       :dynamics))
          else-branch (nth (apply vector dyn) 3))
      (assert= (first else-branch) 'web/template/render)
      (assert= (reflect/eval else-branch) "")))

  (test "`when` is handled too"
    (let (dyn (first (get (compiled '[:div {} (when flag (component some-mod {"id" "c1"}))])
                       :dynamics)))
      (assert= (first dyn) 'if)
      (assert= (first (nth (apply vector dyn) 2)) 'web/component/render-slot)))

  ;; Narrow on purpose: a conditional with no component in it has nothing to preserve and
  ;; must keep compiling exactly as it did.
  (test "a conditional with no component is left as one opaque render"
    (let (dyn (first (get (compiled '[:div {} (if flag "yes" "no")]) :dynamics)))
      (assert= (first dyn) 'web/template/render)))

  ;; The change-tracking rule comes along for free, and it has to: a component's own state
  ;; changes without any model key changing, so its slot must always count as dirty.
  (test "the slot is :all-dependent, so a component's own state change still reaches it"
    (let (dyn (first (get (compiled '[:div {} (if flag (component some-mod {"id" "c1"}) "")])
                       :dynamics)))
      (assert= (web/parts/deps-of dyn 'model) :all))))

;; The runtime half, on real slot values: the same component across two renders diffs per
;; inner slot, and a branch flip ships the whole new value rather than splicing.
(describe "a conditional slot diffs like any other component slot"
  (test "same component, one inner slot changed — only that slot ships"
    (let (t (table/new)
          before (slot-for t "c1")
          _ (apply-update t "c1" {:n 7})
          after (slot-for t "c1")
          d (web/parts/slot-diff before after))
      (assert= (get d :cid) "c1")
      ;; one inner hole changed (the count), not both
      (assert= (count (keys (get d :__kdiff__))) 1)))

  (test "component replaced by a plain string — the whole new value ships"
    (let (t (table/new))
      (assert= (web/parts/slot-diff (slot-for t "c1") "") "")))

  (test "a different component in the same hole ships whole, never a spliced kdiff"
    (let (t (table/new)
          a (slot-for t "c1")
          b (slot-for t "c2")
          d (web/parts/slot-diff a b))
      (assert= (web/parts/kslot? d) true)
      (assert= (get d :cid) "c2")
      (assert= (contains? d :__kdiff__) false))))
