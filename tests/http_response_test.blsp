;; format-response returns a `bytes` value (ADR-141: tcp-send writes bytes verbatim but
;; UTF-8-encodes a string leaf). `rtext` decodes it back to text for the string assertions.
(defmodule http-response-test (:use http/response) (:use http/websocket) (:use test))

(defn rtext (out)
  "Decode a format-response `bytes` value back to text for assertions."
  (utf8-bytes->string out))

(describe "capitalize"
  (test "lowercase word" (assert= (capitalize "content") "Content"))
  (test "already upper" (assert= (capitalize "Content") "Content"))
  (test "empty string" (assert= (capitalize "") ""))
  (test "single char" (assert= (capitalize "x") "X")))

(describe "format-header"
  (test "scalar value → one line"
    (assert= (format-header [:host "localhost"]) "Host: localhost\r\n"))
  (test "list value → one line per element (multiple Set-Cookie)"
    (assert= (format-header [:set-cookie (list "a=1; Path=/" "b=2; Path=/")])
      "Set-Cookie: a=1; Path=/\r\nSet-Cookie: b=2; Path=/\r\n")))

(describe "format-response with cookies"
  (test "emits a Set-Cookie line per list element"
    (let (out (rtext (format-response {:status 200
                                       :body ""
                                       :headers {:set-cookie (list "a=1" "b=2")}})))
      (assert= (includes? out "Set-Cookie: a=1\r\n") true)
      (assert= (includes? out "Set-Cookie: b=2\r\n") true))))

(describe "format-response: byte-faithful output for a binary-mode socket"
  ; http/server puts every connection in binary mode; tcp-send writes a `bytes` value to the
  ; wire verbatim but UTF-8-encodes a string leaf (ADR-141). So format-response must return
  ; `bytes` — a string body carrying any multibyte char (an em dash, an arrow, any non-ASCII
  ; prose) would otherwise be double-encoded and truncated at a too-short Content-Length.
  (test "returns a bytes value"
    (assert= (bytes? (format-response (ok "em dash — arrow → done"))) true))
  (test "the body round-trips through UTF-8 decoding back to the original text"
    (let (out (format-response (ok "em dash — arrow →")))
      (assert= (includes? (rtext out) "em dash — arrow →") true)))
  ; 0xC3, the 1st — not a doubled C3 82…
  (test "the multibyte body is encoded exactly once (no doubling)"
    ; the wire bytes must equal the single UTF-8 encoding of header + body, byte for byte
    (let (out (format-response (ok "é")))
      (assert= (ends-with? (rtext out) "é") true)
      ; last byte = 0xA9, the 2nd byte of é
      (assert= (byte-at out (- (count out) 1)) 169)
      (assert= (byte-at out (- (count out) 2)) 195)))
  (test "Content-Length reports UTF-8 byte length, matching the encoded body actually sent"
    (let (out (format-response (ok "é")))
      ; 1 codepoint, 2 UTF-8 bytes
      (assert= (includes? (rtext out) "Content-Length: 2") true))))

(describe "header-name"
  (test "single segment" (assert= (header-name :host) "Host"))
  (test "content-type" (assert= (header-name :content-type) "Content-Type"))
  (test "content-length" (assert= (header-name :content-length) "Content-Length"))
  (test "x-request-id" (assert= (header-name :x-request-id) "X-Request-Id")))

(describe "ok"
  (test "status 200"
    (assert= (get (ok "hi") :status) 200))
  (test "body preserved"
    (assert= (get (ok "hi") :body) "hi")))

(describe "ok-text"
  (test "status 200"
    (assert= (get (ok-text "hi") :status) 200))
  (test "content-type header"
    (assert= (get (get (ok-text "hi") :headers) :content-type) "text/plain; charset=utf-8")))

(describe "ok-json"
  (test "content-type application/json"
    (assert= (get (get (ok-json "{}") :headers) :content-type) "application/json")))

(describe "not-found"
  (test "status 404"
    (assert= (get (not-found) :status) 404))
  (test "custom body"
    (assert= (get (not-found "gone") :body) "gone")))

(describe "redirect"
  (test "default 302"
    (assert= (get (redirect "/new") :status) 302))
  (test "custom 301"
    (assert= (get (redirect "/new" 301) :status) 301))
  (test "location header"
    (assert= (get (get (redirect "/new") :headers) :location) "/new")))

(describe "error-resp"
  (test "status 500"
    (assert= (get (error-resp "oops") :status) 500))
  (test "body includes message"
    (let (body (get (error-resp "oops") :body))
      (assert= (includes? body "oops") true))))

(describe "server-error-resp"
  (test "status 500"
    (assert= (get (server-error-resp) :status) 500))
  (test "body is generic — leaks no exception detail"
    (let (body (get (server-error-resp) :body))
      (assert= (includes? body "500") true)
      (assert= (includes? body "<pre>") false))))

(describe "format-response"
  (test "starts with status line"
    (let (r (rtext (format-response (ok "hello"))))
      (assert= (includes? r "HTTP/1.1 200 OK") true)))
  (test "includes content-length"
    (let (r (rtext (format-response (ok "hello"))))
      (assert= (includes? r "Content-Length: 5") true)))
  (test "body at end"
    (let (r (rtext (format-response (ok "hello"))))
      (assert= (includes? r "\r\n\r\nhello") true)))
  (test "404 status line"
    (let (r (rtext (format-response (not-found "gone"))))
      (assert= (includes? r "HTTP/1.1 404 Not Found") true)))
  (test "custom header included"
    (let (r (rtext (format-response (redirect "/new"))))
      (assert= (includes? r "Location: /new") true)))
  (test "does not force a Connection header (http/server sets it)"
    (let (r (rtext (format-response (ok "hi"))))
      (assert= (includes? r "Connection:") false)))
  (test "emits whatever Connection the caller set"
    (let (r (rtext (format-response {:status 200 :body "hi" :headers {:connection "close"}})))
      (assert= (includes? r "Connection: close") true))))

(describe "format-response: bodyless statuses (RFC 7230)"
  (test "204 carries no body or Content-Length"
    (let (r (rtext (format-response {:status 204 :body "should be dropped"})))
      (assert= (includes? r "HTTP/1.1 204 No Content") true)
      (assert= (includes? r "Content-Length:") false)
      (assert= (includes? r "should be dropped") false)))
  (test "304 carries no body or Content-Length"
    (let (r (rtext (format-response {:status 304 :body "x"})))
      (assert= (includes? r "Content-Length:") false)
      (assert= (includes? r "\r\n\r\nx") false))))

(describe "format-response: HEAD"
  (test "keeps the GET Content-Length but drops the body"
    (let (r (rtext (format-response (ok "hello") true)))
      (assert= (includes? r "Content-Length: 5") true)
      (assert= (includes? r "\r\n\r\nhello") false)
      (assert= (ends-with? r "\r\n\r\n") true))))

; Audit #2 — HTTP response splitting. A header value carrying CR/LF must not inject a
; new header line; format-header strips them.
(describe "format-header: CRLF injection guard"
  (test "strips CR and LF from the value"
    (assert= (format-header [:location "/next\r\nSet-Cookie: evil=1"])
      "Location: /nextSet-Cookie: evil=1\r\n"))
  (test "a normal value is unchanged"
    (assert= (format-header [:content-type "text/html"]) "Content-Type: text/html\r\n"))
  (test "an injected redirect Location does not become its own header line"
    (let (r (rtext (format-response (redirect "/ok\r\nSet-Cookie: x=1"))))
      ; the bytes survive inside the Location value, but never after a CRLF (a new header)
      (assert= (includes? r "\r\nSet-Cookie:") false))))
