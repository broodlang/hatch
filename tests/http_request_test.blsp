(defmodule http-request-test (:use http/request) (:use test))

(describe "parse-request-line"
  (test "GET no query"
    (assert= (parse-request-line "GET / HTTP/1.1") [:ok "GET" "/" "" "1.1"]))
  (test "GET with query"
    (assert= (parse-request-line "GET /search?q=foo HTTP/1.1") [:ok "GET" "/search" "q=foo" "1.1"]))
  (test "POST path"
    (assert= (parse-request-line "POST /users HTTP/1.1") [:ok "POST" "/users" "" "1.1"]))
  (test "lowercase method normalized"
    (assert= (parse-request-line "get / HTTP/1.1") [:ok "GET" "/" "" "1.1"]))
  (test "HTTP/1.0 version parsed"
    (assert= (parse-request-line "GET / HTTP/1.0") [:ok "GET" "/" "" "1.0"]))
  (test "garbage returns error"
    (let (r (parse-request-line "GARBAGE"))
      (assert= (first r) :error))))

(describe "try-parse: incomplete"
  (test "empty buffer" (assert= (try-parse "") [:incomplete]))
  (test "partial header" (assert= (try-parse "GET / HTTP/1.1\r\n") [:incomplete])))

(describe "try-parse: errors"
  (test "bad request line"
    (let (r (try-parse "GARBAGE\r\n\r\n"))
      (assert= (first r) :error)))
  ; Smuggling primitives (RFC 7230): reject obs-fold continuation lines and duplicate
  ; Transfer-Encoding, which a fronting proxy might resolve differently than we do.
  (test "obs-fold continuation line is rejected"
    (assert= (first (try-parse "GET / HTTP/1.1\r\nHost: x\r\n\tfolded: y\r\n\r\n")) :error))
  (test "duplicate Transfer-Encoding is rejected"
    (assert= (first (try-parse "POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\nTransfer-Encoding: identity\r\n\r\n"))
      :error))
  ; Whitespace before the field-name colon (§3.2.4): we'd trim it and honor the header, a
  ; strict proxy would treat the line as unknown — a CL.TE desync, so reject it outright.
  (test "whitespace before the header colon is rejected"
    (assert= (first (try-parse "POST / HTTP/1.1\r\nHost: x\r\nTransfer-Encoding : chunked\r\n\r\n"))
      :error))
  ; A bare LF in the head (§3.5): a proxy that splits on it sees a second Content-Length we
  ; treat as part of a value — a CL desync, so reject any bare CR/LF that survived the split.
  (test "a bare LF inside the header block is rejected"
    (assert= (first (try-parse "POST / HTTP/1.1\r\nHost: x\r\nX: y\nContent-Length: 5\r\nContent-Length: 6\r\n\r\nhello"))
      :error))
  (test "a bare CR inside the header block is rejected"
    (assert= (first (try-parse "GET / HTTP/1.1\r\nHost: x\rSmuggled: 1\r\n\r\n")) :error))
  ; A normal value with no space after the colon still parses (no regression).
  (test "a colon with no following space still parses"
    (assert= (first (try-parse "GET / HTTP/1.1\r\nHost:localhost\r\n\r\n")) :ok))
  ; A header line with no colon at all is malformed — rejected, not silently dropped.
  (test "a header line without a colon is rejected"
    (assert= (first (try-parse "GET / HTTP/1.1\r\nHost: x\r\nGarbageHeaderNoColon\r\n\r\n")) :error)))

(describe "try-parse: successful GET"
  (test "returns :ok"
    (let (r (try-parse "GET /hello?name=world HTTP/1.1\r\nHost: localhost\r\n\r\n"))
      (assert= (first r) :ok)))
  (test "method"
    (let ([_ req _] (try-parse "GET /hello HTTP/1.1\r\nHost: x\r\n\r\n"))
      (assert= (get req :method) "GET")))
  (test "path"
    (let ([_ req _] (try-parse "GET /hello?x=1 HTTP/1.1\r\nHost: x\r\n\r\n"))
      (assert= (get req :path) "/hello")))
  (test "query"
    (let ([_ req _] (try-parse "GET /p?a=b HTTP/1.1\r\nHost: x\r\n\r\n"))
      (assert= (get req :query) "a=b")))
  (test "params parsed"
    (let ([_ req _] (try-parse "GET /p?name=Alice HTTP/1.1\r\nHost: x\r\n\r\n"))
      (assert= (get (get req :params) "name") "Alice")))
  (test "header keyword-ized"
    (let ([_ req _] (try-parse "GET / HTTP/1.1\r\nContent-Type: text/html\r\n\r\n"))
      (assert= (get (get req :headers) :content-type) "text/html")))
  (test "empty remainder when no pipeline"
    (let ([_ _ rem] (try-parse "GET / HTTP/1.1\r\nHost: x\r\n\r\n"))
      (assert= rem ""))))

(describe "try-parse: POST with body"
  (test "body extracted"
    (let (raw "POST /data HTTP/1.1\r\nContent-Length: 5\r\n\r\nhello"
          [_ req _] (try-parse raw))
      (assert= (get req :body) "hello")))
  (test "remainder empty after full body"
    (let (raw "POST /data HTTP/1.1\r\nContent-Length: 5\r\n\r\nhello"
          [_ _ rem] (try-parse raw))
      (assert= rem "")))
  (test "incomplete when body not yet fully arrived"
    (let (raw "POST /data HTTP/1.1\r\nContent-Length: 100\r\n\r\nshort")
      (assert= (try-parse raw) [:incomplete]))))

(describe "try-parse: pipelined requests"
  (test "remainder is second request"
    (let (raw (str "GET /first HTTP/1.1\r\nHost: x\r\n\r\n"
                "GET /second HTTP/1.1\r\nHost: x\r\n\r\n")
          [_ _ rem] (try-parse raw))
      (assert= rem "GET /second HTTP/1.1\r\nHost: x\r\n\r\n"))))

; Audit hardening — see docs/tcp-http-audit.md (#3 Content-Length, #6 Transfer-Encoding,
; #10 header colon). Each malformed input must NOT crash the worker; it returns :error
; (→ 400) or parses correctly.
(describe "try-parse: chunked Transfer-Encoding"
  (test "decodes a chunked body"
    (let ([tag req _] (try-parse (str "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n"
                                   "4\r\nWiki\r\n5\r\npedia\r\n0\r\n\r\n")))
      (assert= tag :ok)
      (assert= (get req :body) "Wikipedia")))
  (test "a chunked body missing its terminator is incomplete"
    (assert= (first (try-parse (str "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n"
                                 "4\r\nWiki\r\n")))
      :incomplete))
  (test "chunk extensions on the size line are ignored"
    (let ([tag req _] (try-parse (str "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n"
                                   "4;name=val\r\nWiki\r\n0\r\n\r\n")))
      (assert= tag :ok)
      (assert= (get req :body) "Wiki")))
  (test "trailers are consumed and the pipelined remainder preserved"
    (let ([tag req rem] (try-parse (str "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n"
                                     "4\r\nWiki\r\n0\r\nX-Trailer: y\r\n\r\nNEXT")))
      (assert= tag :ok)
      (assert= (get req :body) "Wiki")
      (assert= rem "NEXT")))
  (test "Transfer-Encoding + Content-Length is rejected (smuggling guard)"
    (assert= (first (try-parse (str "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n"
                                 "Content-Length: 4\r\n\r\nWiki")))
      :error))
  (test "a non-chunked Transfer-Encoding (gzip) is rejected, not mis-framed"
    (assert= (first (try-parse "POST / HTTP/1.1\r\nTransfer-Encoding: gzip\r\n\r\n"))
      :error))
  ; try-parse-head is the actual server (spool) path — it must reject a non-chunked coding
  ; the same way, not route it to the chunked drain (a request-smuggling surface).
  (test "try-parse-head rejects a non-chunked Transfer-Encoding (gzip)"
    (assert= (first (try-parse-head "POST / HTTP/1.1\r\nTransfer-Encoding: gzip\r\n\r\n"))
      :error))
  (test "try-parse-head still accepts chunked"
    (assert= (first (try-parse-head "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n"))
      :chunked)))

(describe "parse-headers: repeated headers coalesce in order (O(n), not O(n^2))"
  (test "a header repeated across lines joins with ', ' in wire order"
    (assert= (get (parse-headers (list "X-F: a" "X-F: b" "X-F: c")) :x-f) "a, b, c"))
  (test "Cookie repeats join with '; '"
    (assert= (get (parse-headers (list "Cookie: a=1" "Cookie: b=2")) :cookie) "a=1; b=2"))
  (test "Content-Length keeps the first (identical dup collapses)"
    (assert= (get (parse-headers (list "Content-Length: 5" "Content-Length: 5")) :content-length)
      "5")))

(describe "try-parse: header-count cap"
  (test "a request with more than *max-header-count* header lines is rejected"
    (let (head (string/join "" (map (fn (i) (str "X-" i ": v\r\n")) (range 150))))
      (assert= (first (try-parse (str "GET / HTTP/1.1\r\n" head "\r\n"))) :error))))

; The incremental de-chunker behind the server's O(n) chunked drain: decode each chunk exactly
; once and keep only the undecoded tail across reads (vs `try-parse` re-decoding the whole body
; every read). These pin that it matches `try-parse`'s decoding while never re-scanning decoded
; bytes.
(describe "dechunk-step: incremental de-chunk"
  (test "decodes complete chunks and returns the body + pipelined remainder at the terminator"
    (match (dechunk-step "5\r\nhello\r\n0\r\n\r\nNEXT" 0 (list) 0)
      ([:ok body rem] (do (assert= body "hello") (assert= rem "NEXT")))
      (o (assert= o :ok))))
  (test "returns :more with only the undecoded tail — decoded pieces are carried, not re-scanned"
    (match (dechunk-step "5\r\nhello\r\n3\r\nab" 0 (list) 0)
      ([:more tail _decoded dlen]
        (do
          ; "hello" is already decoded (dlen 5); the tail is just the partial second chunk
          (assert= tail "3\r\nab")
          (assert= dlen 5)))
      (o (assert= o :more))))
  (test "resuming from a :more tail completes the body without re-decoding the first chunk"
    (match (dechunk-step "5\r\nhello\r\n3\r\nab" 0 (list) 0)
      ([:more tail decoded dlen] (match (dechunk-step (str tail "c\r\n0\r\n\r\n") 0 decoded dlen)
                                   ([:ok body rem] (do (assert= body "helloabc") (assert= rem "")))
                                   (o (assert= o :ok))))
      (o (assert= o :more))))
  (test "an incomplete size line yields :more (needs the rest of the line)"
    (match (dechunk-step "5\r\nhello\r\n1" 0 (list) 0)
      ([:more tail _decoded dlen] (do (assert= tail "1") (assert= dlen 5)))
      (o (assert= o :more))))
  (test "chunk extensions on the size line are ignored, like try-parse"
    (match (dechunk-step "4;name=val\r\nWiki\r\n0\r\n\r\n" 0 (list) 0)
      ([:ok body _rem] (assert= body "Wiki"))
      (o (assert= o :ok))))
  (test "a malformed chunk size errors"
    (assert= (first (dechunk-step "zz\r\ndata\r\n" 0 (list) 0)) :error)))

(describe "try-parse: hardening"
  (test "rejects negative Content-Length (#3 — used to crash on substring)"
    (assert= (first (try-parse "POST / HTTP/1.1\r\nContent-Length: -5\r\n\r\n")) :error))
  (test "rejects non-integer Content-Length (#3)"
    (assert= (first (try-parse "POST / HTTP/1.1\r\nContent-Length: 1.5\r\n\r\n")) :error))
  (test "accepts a valid Content-Length and reads the body"
    (let ([tag req _] (try-parse "POST / HTTP/1.1\r\nContent-Length: 5\r\n\r\nhello"))
      (assert= tag :ok)
      (assert= (get req :body) "hello")))
  (test "header with no space after the colon is kept (#10)"
    (let ([_ req _] (try-parse "GET / HTTP/1.1\r\nHost:localhost\r\n\r\n"))
      (assert= (get (get req :headers) :host) "localhost")))
  (test "rejects conflicting Content-Length (#12)"
    (assert= (first (try-parse (str "POST / HTTP/1.1\r\nContent-Length: 5\r\n"
                                 "Content-Length: 6\r\n\r\nhello")))
      :error))
  (test "duplicate identical Content-Length is accepted (#12)"
    (let ([tag _ _] (try-parse (str "POST / HTTP/1.1\r\nContent-Length: 5\r\n"
                                 "Content-Length: 5\r\n\r\nhello")))
      (assert= tag :ok))))
