(defmodule bench-page
  "Page render only, through the PUBLIC api — so the same file benchmarks any version."
  (:alias web/template))
(defn- now-ms () (datetime/->epoch-ms (datetime/utc-now)))
(defn- loop-n (n f) (if (<= n 0) nil (do (f) (loop-n (- n 1) f))))
(defn- timed (label n f)
  (let (t0 (now-ms) _ (loop-n n f) el (- (now-ms) t0))
    (io/puts (str "  " (string/pad-right label 30) (math/round-to (/ (* 1000.0 el) n) 1) " us"))))

(def page
  [:html
    {}
    [:head {} [:title {} "hatch"] [:meta {:charset "utf-8"}]]
    [:body
      {:class "min-h-screen bg-base-100"}
      [:nav {:class "navbar"} [:a {:href "/"} "brood"] [:a {:href "/docs"} "docs"]]
      [:main
        {:class "container mx-auto"}
        [:h1 {:class "text-2xl"} "Packages"]
        (map (range 0 40)
          (fn (i)
            [:div
              {:class "card border p-4"}
              [:h2 {:class "font-mono"} (str "package-" i)]
              [:p {:class "opacity-70"} "A short description with <escapable> & \"quoted\" text."]
              [:span {:class "badge"} (str "v0." i ".0")]]))]]])

(defn main ()
  (io/puts "")
  (timed "FULL PAGE" 3000 (fn () (web/template/render page)))
  (io/puts (str "    (" (string/length (web/template/render page)) " bytes)")))
