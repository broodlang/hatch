;; hatch — a Brood project.
(project
  :name "hatch"
  :version "0.23.1"
  :brood ">= 0.38.0"
  :description
    "A Phoenix/LiveView-inspired web framework for Brood: HTTP + WebSocket server, server-rendered live components, sessions, CSRF, presence, and pubsub. Pure Brood."
  :repository "https://github.com/broodlang/hatch"
  :dependencies [[store :version "^0.4.0"]]
  ;; Formatter rules for Hatch's macros. A depending project opts in with
  ;; macros correctly. Each entry is head-symbol → how many args ride the head line
  ;; when the form breaks: deflive 0 (every clause on its own line); mount/render 1
  ;; (the arg-list rides); on/tick 2 (the event-name|ms + the arg-list ride).
  ;;
  ;; A macro missing from this table is not a style question: the formatter pulls its first
  ;; clause up onto the head line, so `(defchannel (join …)` ends up reading as though the
  ;; join were part of the definition form rather than the first of several peers. Every
  ;; clause-taking macro hatch defines belongs here.
  ;;
  ;; They apply to this repo too: a project's own `:format-headers` sit on top of its
  ;; plugins' rules, so hatch's sources and tests are formatted the way a consumer's are.
  ;; The rules match on head symbol alone, so a data list that happens to start with one of
  ;; these names — `view-spec`'s field list starts with `mount` — is laid out one per line.
  :format-headers
    {deflive 0
     deflive-component 0
     defchannel 0
     mount 1
     render 1
     join 1
     handle-info 1
     handle-out 1
     handle-params 1
     terminate 1
     unmount 1
     on-mount-guard 1
     on 2
     tick 2})

;; To depend on other Brood packages, add a :dependencies vector to the form
;; above (ADR-037). Dep names are bare symbols (no quoting):
;;
;;   :dependencies [[pretty :git "https://github.com/you/brood-pretty.git" :ref "v1.0.0"]
;;                  [shared :path "../shared"]]
;;
;; Then any `nest` command resolves them. project.lock.blsp is committed;
;; _deps/ (the cache) is gitignored.
